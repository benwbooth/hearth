#!/usr/bin/env python3
"""Menus of apps that export none, read from their in-window menu bar over
AT-SPI (the accessibility bus): Firefox, Thunderbird, Electron on Wayland
(Claude Desktop, VS Code, Cursor...). Run by hearth-appmenu, whose JSON
lines it speaks:

stdin:  {"cmd": "watch", "key": K, "title": T, "pid": N}
        {"cmd": "open", "id": N} / {"cmd": "click", "id": N} / {"cmd": "unwatch"}
stdout: {"type": "menu", "key": K, "source": "atspi", "menu": ITEM}
        {"type": "none", "key": K}   no accessible menu bar
        {"type": "error", "message": str}

Its own process: libatspi and dbus-python share libdbus, and in one process
a blocking AT-SPI call could deadlock against hearth-appmenu's D-Bus main
loop (seen: the helper stuck, Chromium left with a half-open menu).
"""
import json
import os
import sys

# The AT-SPI typelibs (at-spi2-core, and DBus-1.0 from
# gobject-introspection), for this process only: the shell's own
# environment, which apps it starts inherit, doesn't carry them.
if os.environ.get("HEARTH_ATSPI_TYPELIB"):
    os.environ["GI_TYPELIB_PATH"] = os.pathsep.join(
        os.environ["HEARTH_ATSPI_TYPELIB"].split(os.pathsep)
        + [p for p in os.environ.get("GI_TYPELIB_PATH", "").split(os.pathsep) if p])

import re  # noqa: E402
import time  # noqa: E402

current = None


def out(obj):
    try:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        sys.exit(0)


def err(e):
    out({"type": "error", "message": str(e)})


def strip_mnemonic(s):
    res, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "_":
            if i + 1 < len(s) and s[i + 1] == "_":
                res.append("_")
                i += 2
                continue
            i += 1
            continue
        res.append(c)
        i += 1
    return "".join(res)


def named_item(nid, name):
    """An entry pressed by its accessible name later: shown without the
    shortcut GTK 4 appends after a newline ("Zoom out\nCtrl + Minus"),
    the name kept for the lookup."""
    label, _, sc = name.partition("\n")
    if not sc:
        label, sc = split_shortcut(name)
    sc = re.sub(r"\s*\+\s*", "+", sc.split(",")[0].strip())
    return item(nid, label.strip(), shortcut=sc, name=name)


def item(nid, label="", **kw):
    d = {"id": nid, "label": label, "enabled": True, "visible": True, "type": "standard",
         "toggleType": "", "toggleState": -1, "icon": "", "shortcut": "",
         "submenu": False, "children": []}
    d.update(kw)
    return d


GTK_KEYS = {
    "plus": "+", "minus": "-", "equal": "=", "comma": ",", "period": ".", "slash": "/",
    "backslash": "\\", "question": "?", "semicolon": ";", "apostrophe": "'", "grave": "`",
    "bracketleft": "[", "bracketright": "]", "Return": "Return", "KP_Enter": "Enter",
    "Delete": "Del", "Insert": "Ins", "Escape": "Esc", "Page_Up": "PgUp",
    "Page_Down": "PgDown", "BackSpace": "Backspace", "space": "Space",
    "KP_Add": "+", "KP_Subtract": "-", "asterisk": "*", "exclam": "!",
}
GTK_MODS = {"primary": "Ctrl", "control": "Ctrl", "ctrl": "Ctrl", "shift": "Shift",
            "alt": "Alt", "mod1": "Alt", "super": "Meta", "meta": "Meta", "hyper": "Hyper"}


def gtk_accel_text(accel):
    """'<Primary><Shift>z' -> 'Ctrl+Shift+Z'; GTK 4's 'Control+?' -> 'Ctrl+?'."""
    if "<" not in accel and "+" in accel[:-1]:
        names = {"control": "Ctrl", "ctrl": "Ctrl", "primary": "Ctrl", "super": "Meta",
                 "meta": "Meta", "shift": "Shift", "alt": "Alt"}
        mods, key = accel.rsplit("+", 1) if not accel.endswith("++") else (accel[:-2], "+")
        return "+".join([names.get(m.lower(), m) for m in mods.split("+") if m]
                        + [GTK_KEYS.get(key, key.upper() if len(key) == 1 else key)])
    return gtk_accel_text_angle(accel)


def gtk_accel_text_angle(accel):
    """'<Primary><Shift>z' -> 'Ctrl+Shift+Z' (the dbusmenu style above)."""
    mods, rest = [], accel
    while rest.startswith("<") and ">" in rest:
        m, rest = rest[1:].split(">", 1)
        mods.append(GTK_MODS.get(m.lower(), m))
    if not rest:
        return ""
    key = GTK_KEYS.get(rest, rest.upper() if len(rest) == 1 else rest)
    return "+".join(mods + [key])


# Apps that export no menu (Firefox, Thunderbird, Electron on Wayland: Claude
# Desktop, VS Code, Cursor...) still show their in-window menu bar to
# accessibility tools. This reads it over AT-SPI (the accessibility bus,
# which must be on: org.a11y.Status IsEnabled) and clicks its items through
# their accessible actions. Two kinds:
#   kept  Firefox/Thunderbird (XUL, also GTK): the top menus are "menu"
#         objects whose items exist once the menu has been opened once and
#         stay; items can be clicked while the menu is closed.
#   live  Electron/Chromium: the top menus are buttons; the items exist only
#         while the app's own popup is open.
# Either way a menu with no items yet is opened in the app for a moment
# (under hearth's own menu) to read it, then closed again.

Atspi = None


def a11y_bus():
    """The accessibility bus's address if something answers there, else
    None. libatspi aborts the whole process (SIGABRT in _atspi_bus) when it
    can't connect. And asking org.a11y.Bus with auto-start on a test's
    private session bus launches a second at-spi-bus-launcher, whose socket
    can replace the live session's ($XDG_RUNTIME_DIR/at-spi/bus_0) and dies
    with the test. So: ask without auto-start, check the socket answers, and
    hand libatspi the address (AT_SPI_BUS_ADDRESS) so it never asks itself."""
    import socket
    addr = os.environ.get("AT_SPI_BUS_ADDRESS", "")
    if not addr:
        try:
            import gi
            gi.require_version("Gio", "2.0")
            from gi.repository import Gio, GLib
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            res = bus.call_sync("org.a11y.Bus", "/org/a11y/bus", "org.a11y.Bus", "GetAddress",
                                None, GLib.VariantType("(s)"), Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
            addr = res.unpack()[0]
        except Exception as e:
            err(f"no accessibility bus: {e}")
            return None
    for part in addr.split(";"):
        kind, _, rest = part.partition(":")
        if kind != "unix":
            continue
        kv = dict(x.split("=", 1) for x in rest.split(",") if "=" in x)
        target = kv.get("path") or ("\0" + kv["abstract"] if "abstract" in kv else None)
        if not target:
            continue
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        try:
            s.connect(target)
            return addr
        except OSError as e:
            err(f"accessibility bus {addr} unreachable: {e}")
        finally:
            s.close()
    return None


def atspi():
    global Atspi
    if Atspi is None:
        # A missing bus isn't remembered: it may come back (at-spi-dbus-bus
        # restarted), and the next request tries again.
        addr = a11y_bus()
        if not addr:
            return False
        os.environ["AT_SPI_BUS_ADDRESS"] = addr
        try:
            import gi
            gi.require_version("Atspi", "2.0")
            from gi.repository import Atspi as A
            A.init()
            A.set_timeout(800, 5000)
            Atspi = A
        except Exception as e:  # no typelib
            err(f"AT-SPI unavailable: {e}")
            Atspi = False
    return Atspi


def ancestors(pid):
    seen = []
    try:
        while pid > 1 and len(seen) < 32:
            seen.append(pid)
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return seen


def flatpak_proxies(pid):
    """Pids of the xdg-dbus-proxy serving the Flatpak sandbox that process
    `pid` runs in. A sandboxed app reaches the session and accessibility
    buses through that proxy, so the buses report the proxy's pid for its
    connections (not the app's, and the two share no ancestor). The proxy
    listens on $XDG_RUNTIME_DIR/.dbus-proxy/*-bus-proxy-XXXXXX, and the
    sandbox bind-mounts exactly those sockets: match the window's mounts
    against each proxy's listening sockets. Empty outside Flatpak."""
    try:
        with open(f"/proc/{pid}/mountinfo") as f:
            names = {os.path.basename(l.split()[3]) for l in f
                     if len(l.split()) > 4 and "/.dbus-proxy/" in l.split()[3]}
    except OSError:
        return set()
    if not names:
        return set()
    inodes = set()
    try:
        with open("/proc/net/unix") as f:
            next(f, None)
            for l in f:
                p = l.split()
                if len(p) >= 8 and "/.dbus-proxy/" in p[7] and os.path.basename(p[7]) in names:
                    inodes.add(p[6])
    except OSError:
        return set()
    found = set()
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/comm") as f:
                if f.read().strip() != "xdg-dbus-proxy":
                    continue
            for fd in os.listdir(f"/proc/{p}/fd"):
                link = os.readlink(f"/proc/{p}/fd/{fd}")
                if link.startswith("socket:[") and link[8:-1] in inodes:
                    found.add(int(p))
                    break
        except OSError:
            continue
    return found


SHORTCUT_RE = None


def split_shortcut(label):
    """Electron appends the shortcut to the label: 'Save As... Ctrl+Shift+S',
    'Open Folder... [Ctrl+K Ctrl+O]'."""
    global SHORTCUT_RE
    import re
    if SHORTCUT_RE is None:
        mod = r"(?:Ctrl|Shift|Alt|Super|Meta|Cmd|Command|Option|AltGr)\+"
        # Chromium spells some keys in two words ("Ctrl+Right Arrow",
        # "Page Up"); "Space" alone (Spotify's Play).
        key = r"(?:(?:Left|Right|Up|Down) Arrow|Page (?:Up|Down)|\S+)"
        single = r"F\d{1,2}|Del|Ins|Esc|PgUp|PgDn|Backspace|Space|(?:Left|Right|Up|Down) Arrow"
        SHORTCUT_RE = re.compile(r"^(.*?\S)\s+(\[[^\]]+\]|(?:" + mod + r")+" + key + "|" + single + r")$")
    m = SHORTCUT_RE.match(label)
    if not m:
        return label, ""
    sc = re.sub(r"(Left|Right|Up|Down) Arrow", r"\1", m.group(2)).replace("Page Up", "PgUp").replace("Page Down", "PgDn")
    if sc.startswith("["):
        sc = sc[1:-1].replace(" ", ", ")
    return m.group(1), sc.replace("Super+", "Meta+")


CACHE_FILE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                          "hearth", "atspi-menus.json")

# A ☰ button: an app's whole menu behind one button (Claude Desktop, GNOME
# apps' "Main Menu", Slack...). Matched by name, in the top of the window.
def BUTTON_ROLES():
    """Buttons a ☰ can be: push and toggle buttons, and the "push button
    menu" role newer AT-SPI gives a button that opens a menu (Qt Quick /
    Kirigami overflow menus)."""
    A = Atspi
    roles = {A.Role.PUSH_BUTTON, A.Role.TOGGLE_BUTTON}
    if hasattr(A.Role, "PUSH_BUTTON_MENU"):
        roles.add(A.Role.PUSH_BUTTON_MENU)
    return roles


BURGER_NAMES = {"menu", "main menu", "application menu", "app menu", "open menu",
                "open application menu", "open main menu", "show menu", "menu button",
                "hamburger menu", "more options", "options menu", "more actions", "primary menu",
                "main menu button", "application menu button", "...", "…", "⋮", "☰",
                # Kirigami's global drawer: a side panel of the app's actions
                # (read as a "drawer", see learn_drawer).
                "open drawer", "show drawer"}
# Words a button names the app's menu with, counted only when the button
# says it opens a popup (HAS_POPUP, or the "push button menu" role): Qt's
# "Main menu (F10)" and "Menu" tool buttons, GTK 4's "Settings"/"Help &
# About" menu buttons. A content dropdown ("Sort by", "Save Profile") never
# counts.
POPUP_MENU_NAMES = {"menu", "main menu", "options", "settings", "help", "help & about", "help and about",
                    "more", "tools", "preferences", "app menu", "application menu"}


def menu_title(button):
    """A ☰ button's name as a menu title: without its shortcut ("Main Menu
    (F10)" -> "Main Menu", "Settings\nCtrl + G" -> "Settings")."""
    try:
        n = button_menu_name(button.get_name() or "")
    except Exception:
        n = ""
    return n.title() if n else "Menu"


def button_menu_name(name):
    """A button's name without its shortcut ("Settings\nCtrl + G",
    "Main menu (F10)", "Menu Alt+M"), lowercased."""
    import re
    n = (name or "").strip().split("\n")[0].strip()
    n = re.sub(r"\s*\((?:F\d{1,2}|(?:Ctrl|Alt|Shift|Super)\s*\+[^)]*)\)$", "", n, flags=re.I)
    return split_shortcut(n)[0].strip().lower()


def load_cache():
    try:
        with open(CACHE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cache(c):
    try:
        os.makedirs(os.path.dirname(CACHE_FILE), exist_ok=True)
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(c, f)
        os.replace(tmp, CACHE_FILE)
    except OSError:
        pass


class AtspiMenu:
    """One window's menus over AT-SPI. Kinds:

    kept    a menu bar of menus whose items stay once built (Gecko, GTK):
            read directly, clicked through accessible actions.
    live    Chromium/Electron's native menu bar: buttons whose menus exist
            only while their popup is open (opened with the accessible
            press, closed by pressing again).
    web     a menu bar drawn in the page (VS Code/Cursor's custom title
            bar): titles clicked through arbor (ClickWindow), the menus
            appear in the page.
    burger  no menu bar, a ☰ button (clicked through arbor, or pressed when
            it is a native widget): its popup's submenus become the menus of
            the menu bar; a flat popup becomes one menu. Its titles are kept
            in ~/.cache/hearth/atspi-menus.json, so they show without
            opening anything; the very first time, a "Menu" placeholder.
    """

    SKIP = None  # roles whose subtrees never hold a native menu bar

    def __init__(self, key, title, pid, window=0):
        self.key, self.title, self.pid = key, title, int(pid or 0)
        self.window = int(window or 0)  # arbor's id, for ClickWindow / ClosePopups
        self.refreshed = 0.0  # when the ☰ was last read again (unseen, on open)
        self.alive, self.busy, self.lazy = True, False, False
        self.app = self.mb = self.frame = self.trigger = None
        self.toolkit = ""
        self.gtk4 = False
        self.kind = None
        self.burger = None  # {"flat": bool, "labels": [...]} once known
        self.reset_burger = self.burger_open = False
        self.tree_read = False  # burger: the whole ☰ is in self.cache
        self.ids, self.paths = {}, {}
        self.cache = {}  # container path -> [item dicts] from the last look
        self.ocrbar = None
        self.find()

    def same(self, other):
        return isinstance(other, AtspiMenu) and other.key == self.key

    def stop(self):
        self.alive = False

    # -- finding the menus

    # Chromium/Electron build their tree on the first question, and VS Code
    # turns accessibility on itself some seconds after its window appears:
    # ask again for a while, between other commands (timers, not sleeps).
    RETRY = [0.3, 0.6, 1.0, 1.5, 2, 3, 4, 4, 4]

    def find(self, attempt=0):
        if not self.alive:
            return
        A = atspi()
        found = False
        if A:
            try:
                found = self.locate(A)
            except Exception as e:
                err(f"AT-SPI: {e}")
        if found:
            if self.kind == "burger" and not self.burger and not self.tree_read \
                    and not self.DRAWER.search(self.trigger.get_name() or ""):
                # A ☰ never read (no cache for this app yet): read it now,
                # unseen, and show its menus once read, never a "Menu" with
                # only "…" first (Spotify: Menu, then File… Help a moment
                # later). A drawer opens in the window, where the probe
                # can't hide it: that one waits for the menu to be opened.
                self.busy = True
                self.probe(True)
                try:
                    self.learn_burger()
                except Exception as e:
                    err(f"AT-SPI: reading the ☰: {e}")
                finally:
                    self.probe(False)
                    self.busy = False
                self.refreshed = time.monotonic()
            self.emit()
            return
        if attempt == 0:
            out({"type": "none", "key": self.key})
        # Only Chromium (lazy tree); Qt/GTK/Gecko answer the first time.
        if self.lazy and attempt < len(self.RETRY):
            later(self.RETRY[attempt], lambda: self.find(attempt + 1))
        elif attempt == 0 and self.window:
            # Nothing on the bus: a menu bar the app draws itself, read off
            # the screen (DOSBox-X, Nestopia).
            later(0.8, self.try_ocr_bar)

    def try_ocr_bar(self):
        if not self.alive or self.kind is not None:
            return
        try:
            bar = OcrBar(self)
            if bar.detect():
                self.ocrbar, self.kind = bar, "ocrbar"
                self.emit()
        except Exception as e:
            err(f"ocr menu bar: {e}")

    def apps(self, A):
        desk = A.get_desktop(0)
        # A Flatpak app's AT-SPI connection is its sandbox's D-Bus proxy.
        chain = ancestors(self.pid) + sorted(flatpak_proxies(self.pid))
        apps = []
        for i in range(desk.get_child_count()):
            a = desk.get_child_at_index(i)
            try:
                p = a.get_process_id() if a else 0
            except Exception:
                continue
            if p == self.pid:
                apps.insert(0, a)
            elif p in chain:
                apps.append(a)
        if not apps and self.title:
            # An X11 window whose client sets no _NET_WM_PID (Java's AWT):
            # the pid we were given is xwayland-satellite's. The one app
            # with a frame of exactly this window's title is it.
            byname = []
            for i in range(desk.get_child_count()):
                a = desk.get_child_at_index(i)
                try:
                    if a and any((a.get_child_at_index(k).get_name() or "") == self.title
                                 for k in range(min(a.get_child_count(), 20))):
                        byname.append(a)
                except Exception:
                    continue
            if len(byname) == 1:
                apps = byname
        return apps

    def frames(self, A, app):
        frames = [app.get_child_at_index(i) for i in range(app.get_child_count())]

        def rank(f):
            try:
                n = f.get_name() or ""
                active = f.get_state_set().contains(A.StateType.ACTIVE)
            except Exception:
                return 9
            return 0 if n == self.title else 1 if active else 2

        return sorted([f for f in frames if f], key=rank)

    def locate(self, A):
        if AtspiMenu.SKIP is None:
            R = A.Role
            AtspiMenu.SKIP = {R.DOCUMENT_WEB, R.DOCUMENT_FRAME, R.TERMINAL, R.TABLE, R.TREE_TABLE,
                              R.TREE, R.LIST, R.LIST_BOX, R.TEXT, R.ENTRY, R.PAGE_TAB_LIST,
                              R.SCROLL_PANE, R.EMBEDDED}
        apps = self.apps(A)

        def toolkit(a):
            try:
                return a.get_toolkit_name() or ""
            except Exception:
                return ""

        self.lazy = any(toolkit(a) == "Chromium" for a in apps)
        for app in apps:
            for f in self.frames(A, app):
                # 1. A native menu bar; 2. one in the page; 3. a ☰ button.
                mb = self.search(A, f, lambda o, r: r == A.Role.MENU_BAR, web=False)
                kind = None
                if mb is not None and self.has_titles(mb):
                    kind = "kept" if (mb.get_child_at_index(0).get_role() == A.Role.MENU
                                      or self.holds_closed_popup(mb.get_child_at_index(0))) else "live"
                else:
                    mb = self.search(A, f, lambda o, r: r == A.Role.MENU_BAR and self.has_titles(o),
                                     web=True)
                    if mb is not None:
                        kind = "web"
                    else:
                        # A menu bar without the menu bar role: Thunderbird's
                        # and Zen's hidden XUL menu bar shows as a toolbar of
                        # menus. Kept like a real one.
                        mb = self.search(A, f, self.is_menu_row, web=False)
                        if mb is not None:
                            kind = "kept"
                        else:
                            # AccessKit (egui: the ArtCraft apps): a "menu"
                            # of title buttons; each opens a menu under its
                            # button, as a page's menu bar does.
                            mb = self.search(A, f, self.is_button_menu_row, web=False)
                            if mb is not None:
                                kind = "web"
                trigger = None
                toolbar = None
                if kind is None:
                    trigger = self.search(A, f, self.is_burger, web=True) or self.unnamed_burger(A, f)
                    if trigger is None:
                        # 4. No menus at all, but a toolbar of named buttons
                        # (ScreenGrab's New/Save/Copy/Options/About/Quit):
                        # its buttons, as an Actions menu.
                        toolbar = self.search(A, f, lambda o, r: r == A.Role.TOOL_BAR
                                              and len(self.toolbar_buttons(o)) >= 2, web=False)
                        if toolbar is None and len(self.page_actions(A, f)) >= 2:
                            # 5. Kirigami/Qt Quick pages: a sidebar of actions
                            # (loose menu items) and the page header's
                            # buttons (Arianna, KRecorder).
                            toolbar = f
                        if toolbar is None:
                            continue
                        trigger = toolbar
                    kind = "burger"
                self.app, self.frame, self.mb, self.trigger, self.kind = app, f, mb, trigger, kind
                self.toolkit = toolkit(app)
                try:
                    self.gtk4 = self.toolkit == "GTK" and (app.get_toolkit_version() or "").startswith("4")
                except Exception:
                    self.gtk4 = False
                # Under a main loop libatspi caches children and would never
                # see a popup appear: ask the app every time.
                try:
                    app.set_cache_mask(A.Cache.NONE)
                except Exception:
                    pass
                if toolbar is not None:
                    self.read_toolbar()
                elif kind == "burger" and self.holds_items(trigger):
                    # Readable while closed (GTK 3): read now, nothing cached.
                    self.burger = {"flat": True, "labels": [(trigger.get_name() or "Menu").strip().title()]}
                    self.read(trigger, (-1,))
                    self.tree_read = True
                elif kind == "burger":
                    self.burger = load_cache().get(self.burger_key())
                    self.load_tree()
                return True
        return False

    NOT_ACTIONS = {"close", "minimize", "maximize", "restore", "back", "search", "clear", "menu",
                   "open drawer", "close drawer", "show drawer"}

    def page_actions(self, A, frame):
        """{label: accessible} of a page's commands outside any menu or
        toolbar: menu items not in a menu (a Kirigami sidebar drawer) and
        named buttons in the window's top 120 px (its page header)."""
        found = {}
        btn = set(BUTTON_ROLES())
        holders = {A.Role.MENU, A.Role.MENU_BAR, A.Role.POPUP_MENU}

        def test(o, r):
            try:
                if r not in btn and r != A.Role.MENU_ITEM:
                    return False
                name = (o.get_name() or "").strip()  # raw: clicks look it up
                short = split_shortcut(name.split("\n")[0])[0].strip().lower()
                if not name or short in self.NOT_ACTIONS or name in found or name.count("\n") > 1:
                    return False
                if not o.get_state_set().contains(A.StateType.SHOWING):
                    return False
                if r == A.Role.MENU_ITEM:
                    par = o.get_parent()
                    if par is None or par.get_role() in holders:
                        return False
                    found[name] = o
                    return False
                e = o.get_component_iface().get_extents(A.CoordType.WINDOW)
                if self.to_surface(o, e.x, e.y)[1] < 120:
                    found[name] = o
            except Exception:
                pass
            return False
        self.search(A, frame, test, web=False)
        return found

    def toolbar_buttons(self, tb):
        """{label: button} of a toolbar's showing, named buttons (the page's
        actions when the "toolbar" is the window itself)."""
        A = Atspi
        if tb is getattr(self, "frame", None) or (tb is not None and tb.get_role() == A.Role.FRAME):
            return self.page_actions(A, tb)
        roles = set(BUTTON_ROLES()) | {A.Role.TOGGLE_BUTTON}
        found = {}
        try:
            for i in range(min(tb.get_child_count(), 60)):
                c = tb.get_child_at_index(i)
                if c is None or c.get_role() not in roles:
                    continue
                name = (c.get_name() or "").strip()  # raw: clicks look it up
                if name and name not in found and c.get_state_set().contains(A.StateType.SHOWING):
                    found[name] = c
        except Exception:
            pass
        return found

    def read_toolbar(self):
        """The toolbar's buttons as one flat menu, pressed by name like a
        drawer's entries (click_drawer); read again each time it opens."""
        self.cache = {}
        items = []
        for i, label in enumerate(list(self.toolbar_buttons(self.trigger))[:40]):
            items.append(named_item(self.nid((-1, i)), label))
        self.cache[(-1,)] = items
        self.tree_read = True
        self.burger = {"flat": True, "drawer": True, "toolbar": True, "labels": ["Actions"]}

    @staticmethod
    def is_title(name):
        """A real menu title: GTK 3 parks its widgets' popup menus in an
        invisible menu bar, named "Popup menu", "Menu Popup HeaderBar"...
        (Remmina): never a title."""
        return bool(name) and "popup" not in name.lower()

    STD_TITLES = {"file", "edit", "view", "help", "tools", "go", "bookmarks", "history", "window",
                  "message", "insert", "format", "options", "settings"}

    def is_button_menu_row(self, o, r):
        """A menu bar of buttons: a "menu" container (not inside another
        menu) of mostly titled buttons, one a standard title (File, Edit,
        View...). AccessKit's egui menu bar looks like this."""
        A = Atspi
        if r != A.Role.MENU:
            return False
        try:
            p = o.get_parent()
            if p is not None and p.get_role() in (A.Role.MENU, A.Role.MENU_ITEM, A.Role.PUSH_BUTTON):
                return False
            n = o.get_child_count()
            if n < 3 or n > 30:
                return False
            kids = [o.get_child_at_index(i) for i in range(n)]
            btns = [k for k in kids if k is not None and k.get_role() == A.Role.PUSH_BUTTON
                    and self.is_title(k.get_name() or "")]
        except Exception:
            return False
        names = {(k.get_name() or "").strip().lower() for k in btns}
        return len(btns) >= 3 and len(btns) * 2 >= n and bool(names & self.STD_TITLES)

    def is_menu_row(self, o, r):
        """A container whose children are mostly titled menus, one of them a
        standard title (File, Edit, View...): a menu bar in all but role."""
        A = Atspi
        if r in (A.Role.MENU, A.Role.MENU_BAR, A.Role.MENU_ITEM):
            return False
        try:
            n = o.get_child_count()
            if n < 3 or n > 30:
                return False
            kids = [o.get_child_at_index(i) for i in range(n)]
            menus = [k for k in kids if k is not None and k.get_role() == A.Role.MENU
                     and self.is_title(k.get_name() or "")]
        except Exception:
            return False
        names = {(k.get_name() or "").strip().lower().replace("_", "") for k in menus}
        return len(menus) >= 3 and len(menus) * 2 >= n and bool(names & self.STD_TITLES)

    def has_titles(self, mb):
        try:
            return any(self.is_title(mb.get_child_at_index(i).get_name() or "")
                       for i in range(min(mb.get_child_count(), 30)))
        except Exception:
            return False

    @staticmethod
    def on_screen(o):
        """Showing, with a size: Kirigami keeps a hidden "Open drawer"
        button (0x0 at 0,0) beside the ☰ it really shows (Kalk)."""
        try:
            e = o.get_component_iface().get_extents(Atspi.CoordType.WINDOW)
            return e.width > 0 and e.height > 0 and o.get_state_set().contains(Atspi.StateType.SHOWING)
        except Exception:
            return False

    def is_burger(self, o, r):
        A = Atspi
        if r not in BUTTON_ROLES() or not self.on_screen(o):
            return False
        name = (o.get_name() or "").strip().lower()
        if name not in BURGER_NAMES and not self.holds_items(o):
            if button_menu_name(name) not in POPUP_MENU_NAMES:
                return False
            try:
                if not (o.get_state_set().contains(A.StateType.HAS_POPUP)
                        or o.get_role_name() == "push button menu"):
                    return False
            except Exception:
                return False
            # Named like the app's menu and opening one: anywhere in the
            # window (KFind's and Krename's Help in the bottom button row).
            return True
        if name in ("...", "…"):
            # Mostly a Browse… button (qt6ct's, a file field's): only one that
            # says it opens a menu counts.
            try:
                if not (o.get_state_set().contains(A.StateType.HAS_POPUP)
                        or o.get_role_name() == "push button menu" or self.holds_items(o)):
                    return False
            except Exception:
                return False
        # In the top of the window: a title bar's button, not a list's.
        try:
            e = o.get_component_iface().get_extents(A.CoordType.WINDOW)
            return self.to_surface(o, e.x, e.y)[1] < 120
        except Exception:
            return True

    def unnamed_burger(self, A, frame):
        """A ☰ without a name: many GTK 4 apps give their icon-only menu
        button no accessible name (GNOME Sound Recorder, Tweaks, 2048, Lights
        Off, LACT). A button that opens a popup (HAS_POPUP) in the window's
        top 120 px with no name; of several, the rightmost (where a header
        bar keeps its ☰)."""
        found = []

        def test(o, r):
            if r not in BUTTON_ROLES() or (o.get_name() or "").strip() or not self.on_screen(o):
                return False
            menu_role = getattr(A.Role, "PUSH_BUTTON_MENU", None)
            if r != menu_role and not o.get_state_set().contains(A.StateType.HAS_POPUP):
                return False
            try:
                e = o.get_component_iface().get_extents(A.CoordType.WINDOW)
                if self.to_surface(o, e.x, e.y)[1] < 120:
                    found.append((e.x, o))
            except Exception:
                pass
            return False  # keep looking: collect them all
        self.search(A, frame, test, web=True)  # deep: libadwaita split views nest past 14
        return max(found, key=lambda t: t[0])[1] if found else None

    @staticmethod
    def holds_closed_popup(o):
        """A Qt Widgets menu bar title: a menu item whose popup menu keeps
        its items while closed (DoomRunner's Menu), read as it is."""
        try:
            if o.get_role() != Atspi.Role.MENU_ITEM:
                return False
            for i in range(min(o.get_child_count(), 3)):
                c = o.get_child_at_index(i)
                if c is not None and c.get_role() in (Atspi.Role.POPUP_MENU, Atspi.Role.MENU) and c.get_child_count() > 0:
                    return True
        except Exception:
            pass
        return False

    @staticmethod
    def holds_items(o):
        """A GTK 3 menu button keeps its menu's items as its own children,
        built while closed (Remmina's "Actions")."""
        try:
            n = o.get_child_count()
            return n >= 2 and sum(1 for i in range(min(n, 40))
                                  if o.get_child_at_index(i).get_role() in (
                                      Atspi.Role.MENU_ITEM, Atspi.Role.CHECK_MENU_ITEM,
                                      Atspi.Role.RADIO_MENU_ITEM)) >= 2
        except Exception:
            return False

    def search(self, A, root, test, web, skip=None):
        """Breadth-first search under `root` for test(o, role); `web`: also
        into web pages. Bounded in nodes and time: each call to a busy app
        can take a while."""
        todo, seen, until = [(root, 0)], 0, time.monotonic() + 1.5
        while todo and seen < 5000 and time.monotonic() < until:
            o, d = todo.pop(0)
            seen += 1
            try:
                r = o.get_role()
                if test(o, r):
                    return o
            except Exception:
                continue
            if d >= (30 if web else 14):
                continue
            if r in (AtspiMenu.SKIP if skip is None else skip) and not (web and r in (A.Role.DOCUMENT_WEB, A.Role.DOCUMENT_FRAME,
                                                           A.Role.EMBEDDED, A.Role.SCROLL_PANE)):
                continue
            try:
                n = o.get_child_count()
            except Exception:
                continue
            for i in range(min(n, 200)):
                c = o.get_child_at_index(i)
                if c:
                    todo.append((c, d + 1))
        return None

    def burger_key(self):
        try:
            return f"{self.app.get_name()}|{self.trigger.get_name()}"
        except Exception:
            return ""

    # -- the tree

    def nid(self, path):
        k = tuple(path)
        if k not in self.ids:
            self.ids[k] = len(self.ids) + 1
            self.paths[self.ids[k]] = k
        return self.ids[k]

    def node(self, path):
        o = self.mb
        for i in path:
            o = o.get_child_at_index(i) if o else None
        return o

    def items_of(self, menu):
        """A menu's items in order. Usually its children; GTK 4 puts them
        some ten levels down (boxes and stack pages), so there they're its
        item descendants (without going into an item)."""
        A = Atspi
        roles = (A.Role.MENU_ITEM, A.Role.CHECK_MENU_ITEM, A.Role.RADIO_MENU_ITEM, A.Role.MENU)
        try:
            kids = [menu.get_child_at_index(i) for i in range(min(menu.get_child_count(), 300))]
        except Exception:
            return []
        kids = [k for k in kids if k]
        if not kids or any(k.get_role() in roles + (A.Role.SEPARATOR,) for k in kids):
            return kids
        # AccessKit (egui) menus: their items are buttons ("New… Ctrl+N").
        # (A search field may lead the menu: PhotoCraft's Help. Left out.)
        btn = {A.Role.PUSH_BUTTON, A.Role.TOGGLE_BUTTON, A.Role.CHECK_BOX}
        if menu.get_role() == A.Role.MENU and all(k.get_role() in btn | {A.Role.ENTRY} for k in kids) \
                and any(k.get_role() in btn for k in kids):
            return [k for k in kids if k.get_role() != A.Role.ENTRY]
        out, todo = [], [(k, 1) for k in reversed(kids)]
        while todo and len(out) < 300:
            o, d = todo.pop()
            try:
                r = o.get_role()
            except Exception:
                continue
            if r in roles or r == A.Role.SEPARATOR:
                if r == A.Role.SEPARATOR or o.get_state_set().contains(A.StateType.SHOWING):
                    out.append(o)
                continue
            if d < 20:
                for i in reversed(range(min(o.get_child_count(), 100))):
                    c = o.get_child_at_index(i)
                    if c:
                        todo.append((c, d + 1))
        return out

    def item_child(self, menu, idx):
        items = self.items_of(menu)
        return items[idx] if 0 <= idx < len(items) else None

    def item_label(self, o):
        """An item's label as convert() reads it."""
        try:
            label = split_shortcut(o.get_name() or "")[0]
        except Exception:
            return ""
        return label or self.labelled_by(o) or (self.label_texts(o) or [""])[0]

    @staticmethod
    def labelled_by(o):
        """The text of the label an item names as its own (GTK 4 menu items
        have no name, only a labelled-by relation)."""
        try:
            for r in o.get_relation_set():
                if r.get_relation_type() != Atspi.RelationType.LABELLED_BY:
                    continue
                for k in range(r.get_n_targets()):
                    t = r.get_target(k)
                    n = t.get_name() or ""
                    if not n:
                        try:
                            n = Atspi.Text.get_text(t, 0, -1) or ""
                        except Exception:
                            n = ""
                    if n:
                        return n
        except Exception:
            pass
        return ""

    @staticmethod
    def key_shortcut(o):
        """The ARIA-style keyshortcuts attribute (GTK 4: "Control+? Alt+k"):
        the first one that isn't the Alt+letter mnemonic."""
        try:
            ks = (o.get_attributes() or {}).get("keyshortcuts", "")
        except Exception:
            return ""
        names = {"Control": "Ctrl", "Super": "Meta", "Meta": "Meta"}
        for k in ks.split():
            parts = k.split("+")
            if len(parts) == 2 and parts[0] == "Alt" and len(parts[1]) == 1:
                continue  # the mnemonic
            return "+".join(names.get(x, x.upper() if len(x) == 1 else x) for x in parts)
        return ""

    @staticmethod
    def label_texts(o):
        """An item's own text, from its labels when it has no name (GTK 4:
        the label, then the shortcut)."""
        texts, todo = [], [(o, 0)]
        while todo and len(texts) < 4:
            x, d = todo.pop(0)
            try:
                n = x.get_name() or "" if x is not o else ""
                if n and x.get_role() in (Atspi.Role.LABEL, Atspi.Role.STATIC, Atspi.Role.TEXT,
                                          Atspi.Role.ACCELERATOR_LABEL):
                    texts.append(n)
                if d < 4:
                    for i in range(min(x.get_child_count(), 10)):
                        c = x.get_child_at_index(i)
                        if c:
                            todo.append((c, d + 1))
            except Exception:
                continue
        return texts

    def convert(self, o, path, depth=0, deep=False, closed=False):
        """An accessible menu item as an item dict; `deep`: its submenu's
        items too (kept menus, whose items exist while closed); `closed`:
        it sits in a Qt popup that's closed (neither showing nor visible,
        still its menu's item)."""
        A = Atspi
        try:
            role = o.get_role()
            name = o.get_name() or ""
            st = o.get_state_set()
        except Exception:
            return None
        if role == A.Role.SEPARATOR:
            return item(self.nid(path), type="separator")
        if not closed and not st.contains(A.StateType.SHOWING) and not st.contains(A.StateType.VISIBLE):
            return None
        label, shortcut = split_shortcut(name)
        if not label:
            label = self.labelled_by(o)
        if not label:
            texts = self.label_texts(o)
            if texts:
                label = texts[0]
                if len(texts) > 1 and texts[-1] != label:
                    shortcut = texts[-1]
        if not shortcut:
            shortcut = self.key_shortcut(o)
        try:
            a = o.get_action_iface()
            kb = a.get_key_binding(0) if a and a.get_n_actions() else ""
            parts = kb.split(";")
            if len(parts) >= 3 and parts[2]:
                shortcut = gtk_accel_text(parts[2])
        except Exception:
            pass
        qt_popup = deep and self.holds_closed_popup(o)
        sub = role == A.Role.MENU or st.contains(A.StateType.HAS_POPUP) or qt_popup
        kids = []
        if sub and deep and depth < 5:
            for i in range(min(o.get_child_count(), 300)):
                c = o.get_child_at_index(i)
                if qt_popup and c is not None and c.get_role() in (A.Role.POPUP_MENU, A.Role.MENU):
                    # Qt Widgets: the items are the closed popup's children
                    # (path through the popup, so a click finds them).
                    for j in range(min(c.get_child_count(), 300)):
                        cc = c.get_child_at_index(j)
                        k = cc and self.convert(cc, list(path) + [i, j], depth + 1, deep, closed=True)
                        if k:
                            kids.append(k)
                    continue
                k = c and self.convert(c, list(path) + [i], depth + 1, deep, closed=closed)
                if k:
                    kids.append(k)
        toggle = ("checkmark" if role == A.Role.CHECK_MENU_ITEM
                  else "radio" if role == A.Role.RADIO_MENU_ITEM else "")
        if not label and not sub:
            return None
        return item(self.nid(path), label,
                    enabled=st.contains(A.StateType.ENABLED) or st.contains(A.StateType.SENSITIVE),
                    toggleType=toggle,
                    toggleState=(1 if st.contains(A.StateType.CHECKED) else 0) if toggle else -1,
                    shortcut=shortcut, submenu=sub, children=kids)

    def read(self, menu, path):
        """The items of an open `menu`, the container at `path`."""
        kids = []
        for i, c in enumerate(self.items_of(menu)):
            k = self.convert(c, list(path) + [i])
            if k:
                kids.append(k)
        self.cache[tuple(path)] = kids
        return kids

    def filled(self, items):
        """Items with the submenus read so far put in."""
        res = []
        for it in items:
            it = dict(it)
            p = self.paths.get(it["id"])
            if p is not None and p in self.cache:
                it["children"] = self.filled(self.cache[p])
            res.append(it)
        return res

    def placeholder(self, nid):
        return [item(-1000 - abs(nid), "…", enabled=False)]

    def tops(self):
        """[(path, label, kept accessible or None)] of the menu bar's menus."""
        if self.kind == "burger":
            b = self.burger
            if not b:
                return [((-2,), menu_title(self.trigger), None)]
            if b.get("toolbar"):
                return [((-1,), "Actions", None)]
            if b.get("flat"):
                return [((-1,), menu_title(self.trigger), None)]
            return [((i,), l, None) for i, l in enumerate(b.get("labels", [])) if l]
        res = []
        for i in range(self.mb.get_child_count()):
            c = self.mb.get_child_at_index(i)
            if c and self.is_title(c.get_name() or ""):
                res.append(((i,), split_shortcut(c.get_name())[0], c if self.kind == "kept" else None))
        return res

    def emit(self):
        if not self.alive or self.kind is None:
            return
        if self.kind == "ocrbar":
            tops = []
            for path, label, _ in self.ocrbar.tops():
                nid = self.nid(path)
                kids = self.ocrbar.menu_items(path[0]) or self.placeholder(nid)
                tops.append(item(nid, label, submenu=True, children=kids))
            out({"type": "menu", "key": self.key, "source": "atspi", "menu": item(0, children=tops)})
            return
        tops = []
        try:
            for path, label, kept in self.tops():
                nid = self.nid(path)
                if kept is not None:
                    t = self.convert(kept, path, deep=True) or item(nid, label)
                    t["submenu"] = True
                else:
                    t = item(nid, label, submenu=True,
                             children=self.filled(self.cache.get(path, [])))
                if not t["children"]:
                    t["children"] = self.placeholder(nid)  # filled when it opens
                tops.append(t)
        except Exception as e:
            err(f"AT-SPI: {e}")
        out({"type": "menu", "key": self.key, "source": "atspi", "menu": item(0, children=tops)})

    # -- the app's own menus, opened for a moment

    def popups(self):
        """The app's open popup menus (frames of their own), outermost first."""
        A, found = Atspi, []
        try:
            self.app.clear_cache()
            for i in range(self.app.get_child_count()):
                f = self.app.get_child_at_index(i)
                # Popups are frames of their own (Chromium wraps each menu
                # in a "menu bar" there); the window's frame is skipped.
                if not f or f == self.frame or (f.get_name() or "") == (self.frame.get_name() or "\0"):
                    continue
                todo = [(f, 0)]
                while todo:
                    o, d = todo.pop(0)
                    r = o.get_role()
                    if r == A.Role.MENU and o.get_child_count() > 0:
                        found.append(o)
                        continue
                    if d < 12 and r not in (A.Role.DOCUMENT_WEB, A.Role.DOCUMENT_FRAME):
                        for k in range(min(o.get_child_count(), 50)):
                            c = o.get_child_at_index(k)
                            if c:
                                todo.append((c, d + 1))
        except Exception:
            pass
        if not found:
            self.pump()
            found = self.shown_popups()
        if not found and self.frame is not None and self.toolkit.startswith(("GTK", "Qt")):
            # GTK 4 popovers are in the window's own tree, under the button
            # that opened them; so are Qt Quick menus (Kirigami's overflow
            # menu), drawn inside the window.
            A = Atspi
            test = (lambda o, r: r in (A.Role.MENU, A.Role.POPUP_MENU) and o.get_child_count() > 0
                    and o.get_state_set().contains(A.StateType.SHOWING))
            m = None
            if self.trigger is not None:
                m = self.search(A, self.trigger, test, web=True)
            if m is None:
                m = self.search(A, self.frame, test, web=True)
            if m is not None:
                found.append(m)
        return found

    def page_menu(self, near):
        """A menu shown in the page (web kind): first under `near` (VS Code
        puts it in the title's element), else anywhere in its document."""
        A = Atspi
        test = (lambda o, r: r == A.Role.MENU and o.get_child_count() > 0
                and o.get_state_set().contains(A.StateType.SHOWING))
        m = self.search(A, near, test, web=True)
        if m is None:
            doc = self.document(near)
            if doc is not None:
                m = self.search(A, doc, test, web=True)
        return m

    def document(self, o):
        """The outermost web document `o` is in, or None (a native widget)."""
        A, doc = Atspi, None
        try:
            for _ in range(60):
                o = o.get_parent()
                if o is None:
                    break
                r = o.get_role()
                if r in (A.Role.DOCUMENT_WEB, A.Role.DOCUMENT_FRAME):
                    doc = o
                elif r in (A.Role.FRAME, A.Role.APPLICATION):
                    break
        except Exception:
            pass
        return doc

    def to_surface(self, o, x, y):
        """AT-SPI window coordinates -> the window surface's logical pixels.
        Chromium reports its own widgets in logical pixels but web content in
        device pixels (a 960x600 page is 1280x800 at 4/3): divide by the
        page's size over its host's."""
        doc = self.document(o) if Atspi.Accessible.get_role(o) not in (
            Atspi.Role.DOCUMENT_WEB, Atspi.Role.DOCUMENT_FRAME) else o
        if doc is None:
            return x, y
        try:
            d = doc.get_component_iface().get_extents(Atspi.CoordType.WINDOW)
            p = doc.get_parent().get_component_iface().get_extents(Atspi.CoordType.WINDOW)
            k = d.width / p.width if p.width > 0 and d.width > 0 else 1
        except Exception:
            k = 1
        return x / k, y / k

    def press(self, o):
        """Open/activate `o`: a click through arbor for page elements (they
        ignore the accessible press: they open on pointer-down), the
        accessible action for native widgets."""
        native = self.document(o) is None
        # GTK 4's buttons and menu items take the accessible action and do
        # nothing (it reports success): they always get a real click. So do
        # AccessKit's (egui: its click action opens no menu).
        if native and not self.gtk4 and self.toolkit != "AccessKit" and self.act(o):
            return True
        # A page element, or a native one without an accessible action
        # (GTK 4's buttons have none): a click through arbor.
        return self.real_click(o, native)

    def real_click(self, o, native=None):
        """A real left click on `o` through arbor (click-window)."""
        if native is None:
            native = self.document(o) is None
        if not self.window:
            return False
        try:
            e = o.get_component_iface().get_extents(Atspi.CoordType.WINDOW)
            showing = o.get_state_set().contains(Atspi.StateType.SHOWING)
        except Exception:
            return False
        # Never a click on something not on screen: it would land on what is
        # (Cursor's menu bar is in the tree behind its sign-in page).
        if e.width <= 0 or e.height <= 0 or not showing:
            return False
        x, y = self.to_surface(o, e.x + e.width / 2, e.y + e.height / 2)
        # GTK measures from the window's frame (without its client-side
        # shadow), Chromium and Qt from its surface.
        geo = ["--geometry"] if native and self.toolkit.startswith("GTK") else []
        return arbor("click-window", "--id", str(self.window), "--x", f"{x:.2f}", "--y", f"{y:.2f}", *geo)

    @staticmethod
    def role(o):
        try:
            return o.get_role()
        except Exception:
            return None

    ACTIVATE = ("press", "click", "activate", "toggle", "showmenu", "open", "jump")

    def act(self, o):
        try:
            a = o.get_action_iface()
            if a and a.get_n_actions():
                # The activating action by name, not the first one: Qt
                # Quick's page tabs (Kirigami drawers) list SetFocus first.
                n = a.get_n_actions()
                names = [(a.get_action_name(i) or "").replace(" ", "").lower() for i in range(n)]
                idx = next((i for i, nm in enumerate(names) if nm in self.ACTIVATE), 0)
                a.do_action(idx)
                return True
        except Exception as e:
            err(f"AT-SPI action: {e}")
        return False

    def wait(self, test, tries=30):
        """Poll test() every 40 ms (the app answers asynchronously)."""
        for _ in range(tries):
            self.pump()
            try:
                r = test()
            except Exception:
                r = None
            if r:
                return r
            time.sleep(0.04)
        return None

    # Qt Widgets leave their popup menus (a QToolButton's ☰, submenus) out of
    # the application's children: they're only announced, by a "showing"
    # event whose source is the popup. While a Qt ☰ is read, listen for that
    # (a second or two; no main loop: events are dispatched only here, see
    # main()) and offer what showed as the app's popups.
    def listen_popups(self, on):
        if on and getattr(self, "_pl", None) is None and self.toolkit.startswith("Qt"):
            self.shown = []
            pid = self.pid_of_app()

            def cb(e):
                try:
                    o = e.source
                    if e.detail1 and o.get_process_id() == pid and o.get_role() in (
                            Atspi.Role.POPUP_MENU, Atspi.Role.MENU):
                        self.shown.append(o)
                except Exception:
                    pass
            self._pl = Atspi.EventListener.new(cb)
            try:
                self._pl.register("object:state-changed:showing")
            except Exception as e:
                err(f"AT-SPI listener: {e}")
                self._pl = None
        elif not on and getattr(self, "_pl", None) is not None:
            try:
                self._pl.deregister("object:state-changed:showing")
            except Exception:
                pass
            self._pl = None
            self.shown = []

    def pid_of_app(self):
        try:
            return self.app.get_process_id()
        except Exception:
            return -1

    def pump(self):
        if getattr(self, "_pl", None) is None:
            return
        from gi.repository import GLib
        ctx = GLib.MainContext.default()
        for _ in range(50):
            if not ctx.iteration(False):
                break

    def shown_popups(self):
        """Qt popups announced since listen_popups(True), still showing."""
        res = []
        for o in getattr(self, "shown", []):
            try:
                if o.get_state_set().contains(Atspi.StateType.SHOWING) and o.get_child_count() > 0 and o not in res:
                    res.append(o)
            except Exception:
                continue
        return res

    def open_burger(self):
        """Click the ☰ and wait for its popup. A button that keeps its own
        open/closed state (Claude Desktop's) still thinks it is open after
        its menu was closed from outside (ClosePopups): the first click
        then only "closes" it, so click again when nothing opened."""
        if self.reset_burger:
            # We closed its menu from outside last time: one click first to
            # put its state back (it opens nothing).
            self.reset_burger = False
            self.press(self.trigger)
            time.sleep(0.12)
        for tries in (15, 25):
            if not self.press(self.trigger):
                return None
            menus = self.wait(self.popups, tries)
            if menus:
                self.burger_open = True
                return menus
        return None

    def open_chain(self, path):
        """Open the app's menus down to the container at `path` (a top menu,
        then submenus in it); returns its accessible, None on failure. Close
        with close_all()."""
        if self.kind == "burger":
            menus = self.open_burger()
            if not menus:
                return None
            menu, rest = menus[0], list(path[1:]) if path[0] < 0 else list(path)
        else:
            top = self.node(path[:1])
            if top is None or not self.press(top):
                return None
            if self.kind == "web":
                menu = self.wait(lambda: self.page_menu(top))
            else:
                menus = self.wait(self.popups)
                menu = menus[0] if menus else None
            rest = list(path[1:])
        for idx in rest:
            if menu is None:
                return None
            c = self.item_child(menu, idx)
            if c is None:
                return None
            if self.kind == "web":
                if not self.press(c):
                    return None
                menu = self.wait(lambda: self.page_menu(c))
            else:
                n = len(self.popups())
                label = self.item_label(c)
                labels0 = tuple(self.item_label(x) for x in self.items_of(menu)[:4])
                if not self.act(c):
                    return None
                cur = menu
                menus = self.wait(lambda: (lambda m: m if len(m) > n else None)(self.popups())
                                  or ([cur] if self.gtk4 and self.slid(cur, label, labels0) else None))
                menu = menus[-1] if menus else None
        return menu

    def close_all(self, path):
        if self.kind == "web":
            top = self.node(path[:1])
            if top is not None and self.page_menu(top) is not None:
                self.press(top)  # its title again closes it
        elif self.kind == "live":
            top = self.node(path[:1])
            if self.popups() and top is not None:
                self.act(top)
        elif self.burger_open or self.popups():
            # Not by asking AT-SPI first: it may not show the popup yet.
            self.burger_open = False
            arbor("close-popups", "--id", str(self.window))
            self.reset_burger = self.document(self.trigger) is not None

    def open(self, nid):
        path = self.paths.get(nid)
        if not path or self.busy or self.kind is None:
            return
        if self.kind == "ocrbar":
            self.busy = True
            self.probe(True)
            try:
                self.ocrbar.open(path)
            finally:
                self.probe(False)
                self.busy = False
            self.emit()
            return
        if self.kind == "kept":
            o = self.node(path)
            if o is None:
                return
            if o.get_child_count() > 0:
                self.emit()  # just read it again (states change)
                return
            # Never opened yet: open it in the app once (unseen), read, close.
            self.probe(True)
            try:
                if not self.act(o):
                    return
                self.wait(lambda: o.get_child_count() > 0)
                if o.get_state_set().contains(Atspi.StateType.EXPANDED):
                    self.act(o)
            finally:
                self.probe(False)
            self.emit()
            return
        if self.kind == "burger" and (self.burger or {}).get("toolbar"):
            self.read_toolbar()  # it's on screen: read it as it is now
            self.emit()
            return
        if self.kind == "burger" and self.holds_items(self.trigger):
            # Its items are there while closed: read them, open nothing.
            self.burger = {"flat": True,
                           "labels": [menu_title(self.trigger)]}
            self.tree_read = True
            self.read(self.trigger, (-1,))
            self.emit()
            return
        if self.kind == "burger":
            if path in self.cache:
                self.emit()  # at once, from the cache
                # Then read again, unseen (arbor ProbeWindow), so items the
                # app changed (recent files, toggles) show while it's open;
                # at most every 10 s.
                # (Not a drawer: it's part of the window, the probe can't
                # hide it opening; its cache is renewed when a click misses.)
                if time.monotonic() - self.refreshed > 10 and (self.refreshed == 0 or not (self.burger or {}).get("drawer")):
                    self.refreshed = time.monotonic()
                    self.busy = True
                    self.probe(True)
                    try:
                        self.learn_burger()
                    finally:
                        self.probe(False)
                        self.busy = False
                    self.emit()
                return
            if not self.tree_read:
                # The whole ☰ in one look (titles, every submenu), kept on
                # disk; later opens show the cache, then read it again.
                self.busy = True
                self.probe(True)
                try:
                    self.learn_burger()
                finally:
                    self.probe(False)
                    self.busy = False
                self.refreshed = time.monotonic()
                self.emit()
                return
        self.busy = True
        self.probe(True)
        try:
            if path == (-2,):
                self.learn_burger()
            else:
                menu = self.open_chain(path)
                if menu is not None:
                    self.read(menu, path)
                self.close_all(path)
        finally:
            self.probe(False)
            self.busy = False
        self.emit()

    def probe(self, on):
        """arbor ProbeWindow around a read that opens the app's menu: its
        popups aren't drawn and don't take the keyboard, so the read is
        unseen. (An older arbor ignores it: the menu flashes as before.)"""
        if self.window:
            arbor("probe-window", "--id", str(self.window), "--seconds", "3" if on else "0")

    @staticmethod
    def inner_label(o):
        """An unnamed row's text: its first label within two levels (GTK 3
        popover rows: list item > filler > label "Preferences")."""
        todo = [(o, 0)]
        while todo:
            x, d = todo.pop(0)
            try:
                for i in range(min(x.get_child_count(), 8)):
                    c = x.get_child_at_index(i)
                    if c is None:
                        continue
                    if c.get_role() == Atspi.Role.LABEL and (c.get_name() or "").strip():
                        return c.get_name().strip()
                    if d < 2:
                        todo.append((c, d + 1))
            except Exception:
                continue
        return ""

    def visible_actions(self):
        """Named things the user can press that are showing in the window:
        {label: accessible}."""
        A = Atspi
        roles = {A.Role.PUSH_BUTTON, A.Role.TOGGLE_BUTTON, A.Role.LIST_ITEM, A.Role.MENU_ITEM,
                 A.Role.PAGE_TAB, A.Role.LINK, A.Role.CHECK_BOX, A.Role.RADIO_BUTTON}
        if hasattr(A.Role, "PUSH_BUTTON_MENU"):
            roles.add(A.Role.PUSH_BUTTON_MENU)
        if hasattr(A.Role, "SWITCH"):
            roles.add(A.Role.SWITCH)  # GTK 4's switches (settings popovers)
        found = {}

        def test(o, r):
            if r in roles and o is not self.trigger:
                try:
                    name = (o.get_name() or "").strip()
                    if not name and r == A.Role.LIST_ITEM:
                        name = self.inner_label(o)
                    # A GTK 4 menu button is named after everything in its
                    # popover ("Zoom out\nCtrl + Minus 100% Zoom in..."):
                    # its entries are below it, not it.
                    if name.count("\n") > 1 or len(name) > 80:
                        return False
                    if name and name not in found and o.get_state_set().contains(A.StateType.SHOWING):
                        found[name] = o
                except Exception:
                    pass
            return False
        try:
            self.app.clear_cache()
        except Exception:
            pass
        # Deep: a GTK 4 popover's entries sit under its menu button, past 14.
        # Into lists too: a GTK 3 popover's rows are a list box (Catfish's ☰).
        self.search(A, self.frame, test, web=True, skip=AtspiMenu.SKIP - {A.Role.LIST, A.Role.LIST_BOX})
        return found

    def learn_drawer(self, before):
        """The ☰ opened no menu: a drawer or panel (Kirigami's global
        drawer). Its items are what became visible when it opened; they're
        read as one flat menu and pressed by name later (click_drawer)."""
        # Already open beside the page: read it as it is (pressing would
        # only fold it away).
        new = self.drawer_items()
        if not new:
            new = self.drawer_open_and_read(before)
        if not new:
            return
        self._store_drawer(new)

    def drawer_open_and_read(self, before):
        new, clicked = {}, False
        for attempt in (self.press, self.real_click):
            # GTK 3's menu buttons take the accessible press, report success
            # and open nothing (a GtkMenu/popover needs a real input event):
            # then a real click through arbor.
            if not attempt(self.trigger):
                continue
            clicked = attempt == self.real_click
            for _ in range(12):
                time.sleep(0.1)
                new = {k: v for k, v in self.visible_actions().items() if k not in before}
                if new:
                    time.sleep(0.25)  # the panel's slide-in: let it finish
                    new = {k: v for k, v in self.visible_actions().items() if k not in before}
                    break
            if new:
                break
        if new:
            # Close it again the way it opened (a popover closes on Escape
            # or a second click; the accessible press may not reach it).
            (self.real_click if clicked else self.press)(self.trigger)
        return new

    def _store_drawer(self, new):
        """The drawer's entries (KClock: Time, Timers, Stopwatch, Alarms,
        Settings; Discover: Home, Installed, Updates, the categories) as
        one flat menu, pressed by name later (click_drawer)."""
        self.cache = {}
        items = []
        for i, label in enumerate(list(new)[:40]):
            path = (-1, i)
            items.append(named_item(self.nid(path), label))
        self.cache[(-1,)] = items
        self.tree_read = True
        self.burger = {"flat": True, "drawer": True,
                       "labels": [menu_title(self.trigger)], "exe": self.exe(),
                       "tree": {"-1": [self.saved(it) for it in items]}}
        c = load_cache()
        c[self.burger_key()] = self.burger
        save_cache(c)

    def ocr_scale(self, size):
        """Capture pixels per logical pixel (the output's scale)."""
        try:
            fw = self.frame.get_component_iface().get_extents(Atspi.CoordType.WINDOW).width
        except Exception:
            fw = 0
        return size[0] / fw if size and fw > 0 else 1.0

    def point_of(self, o):
        """Where real_click would click `o`: (x, y, geometry flag) or None."""
        try:
            e = o.get_component_iface().get_extents(Atspi.CoordType.WINDOW)
            if e.width <= 0 or e.height <= 0 or not o.get_state_set().contains(Atspi.StateType.SHOWING):
                return None
        except Exception:
            return None
        x, y = self.to_surface(o, e.x + e.width / 2, e.y + e.height / 2)
        native = self.document(o) is None
        return [round(x, 1), round(y, 1), bool(native and self.toolkit.startswith("GTK"))]

    def click_point(self, pt):
        geo = ["--geometry"] if pt[2] else []
        return arbor("click-window", "--id", str(self.window), "--x", f"{pt[0]:.1f}", "--y", f"{pt[1]:.1f}", *geo)

    def twins(self):
        """The ☰ and the other showing buttons with its name (Qt Quick apps
        can expose two "Show menu" buttons; one of them opens nothing)."""
        A = Atspi
        want = button_menu_name(self.trigger.get_name() or "")
        roles = {A.Role.PUSH_BUTTON, A.Role.TOGGLE_BUTTON}
        if hasattr(A.Role, "PUSH_BUTTON_MENU"):
            roles.add(A.Role.PUSH_BUTTON_MENU)
        found = [self.trigger]

        def test(o, r):
            try:
                if r in roles and o is not self.trigger and button_menu_name(o.get_name() or "") == want \
                        and o.get_state_set().contains(A.StateType.SHOWING):
                    found.append(o)
            except Exception:
                pass
            return False
        if want:
            self.search(A, self.frame, test, web=False)
        pts, res = [], []
        for o in found:
            pt = self.point_of(o)
            if pt and pt[:2] not in pts:
                pts.append(pt[:2])
                res.append(pt)
        return res[:4]

    def learn_ocr(self):
        """Open the ☰ with a real click and read the popup off a capture of
        the window (hearth_ocr_menu): one flat menu, each item clicked at
        where it was read (click_ocr)."""
        if not self.window:
            return False
        try:
            import hearth_ocr_menu as om
        except Exception as e:
            err(f"ocr menus: {e}")
            return False
        ses = om.Session(self.window)
        found, size, at = [], None, None
        try:
            before, _ = ses.rows()
            if before is None:
                return False
            pts = self.twins()
            last = (self.burger or {}).get("at")
            if last and last[:2] in [q[:2] for q in pts]:
                pts.sort(key=lambda q: q[:2] != last[:2])  # the one that opened it last time first
            for pt in pts:
                if not self.click_point(pt):
                    continue
                time.sleep(0.6)
                found, size = ses.read_popup(before)
                if os.environ.get("HEARTH_OCR_DEBUG"):
                    err(f"ocr: ☰ at {pt}: {found}")
                if found:
                    self.click_point(pt)  # closes it again, as a second click would
                    at = pt
                    break
                arbor("close-popups", "--id", str(self.window))
        finally:
            ses.close()
        if not found:
            return False
        k = self.ocr_scale(size)
        self.cache = {}
        items = []
        for i, (label, sc, (x, y)) in enumerate(found[:40]):
            items.append(item(self.nid((-1, i)), label, shortcut=sc, pos=[round(x / k, 1), round(y / k, 1)]))
        self.cache[(-1,)] = items
        self.tree_read = True
        self.burger = {"flat": True, "ocr": True, "at": at, "labels": [menu_title(self.trigger)], "exe": self.exe(),
                       "tree": {"-1": [self.saved(it) for it in items]}}
        c = load_cache()
        c[self.burger_key()] = self.burger
        save_cache(c)
        return True

    def click_ocr(self, nid):
        """Open the ☰, check the item is still where it was read (the same
        text on that line), click it there."""
        it = next((k for k in self.cache.get((-1,), []) if k["id"] == nid), None)
        if os.environ.get("HEARTH_OCR_DEBUG"):
            err(f"ocr click {nid}: {it} window {self.window} at {(self.burger or {}).get('at')}")
        if not it or not it.get("pos") or not self.window:
            return False
        import hearth_ocr_menu as om
        ses = om.Session(self.window)
        try:
            at = (self.burger or {}).get("at")
            if not (self.click_point(at) if at else self.real_click(self.trigger)):
                return False
            time.sleep(0.5)
            # Only the item's line is read again: is it there, the same?
            p = ses.shot()
            ok = False
            if p:
                try:
                    w, h, _ = om.read_png(p)
                    k = self.ocr_scale((w, h))
                    x, y = it["pos"]
                    box = (max(0, int((x - 260) * k)), max(0, int((y - 14) * k)),
                           min(w, int((x + 260) * k)), min(h, int((y + 14) * k)))
                    want = om.norm(it["label"])
                    rows = om.ocr_rows(p, box)
                    ok = any(om.same_text(it["label"], r["text"]) for r in rows)
                    if os.environ.get("HEARTH_OCR_DEBUG"):
                        err(f"ocr click {it['label']!r} at {x},{y} (x{k:.2f}): {ok} {[r['text'] for r in rows]}")
                except Exception as e:
                    err(f"ocr menus: {e}")
            if not ok:
                self.click_point(at) if at else self.real_click(self.trigger)  # close it: the menu changed
                self.forget_tree()
                return False
            return arbor("click-window", "--id", str(self.window), "--x", f"{x:.1f}", "--y", f"{y:.1f}", "--geometry")
        finally:
            ses.close()

    def drawer_items(self):
        A = Atspi
        found = {}
        try:
            n = self.frame.get_child_count()
        except Exception:
            return found
        for i in range(min(n, 30)):
            try:
                d = self.frame.get_child_at_index(i)
                if d is None or d.get_role() != A.Role.DIALOG or \
                        not d.get_state_set().contains(A.StateType.SHOWING):
                    continue
            except Exception:
                continue
            todo = [(d, 0)]
            while todo and len(found) < 40:
                o, depth = todo.pop(0)
                try:
                    r = o.get_role()
                    name = (o.get_name() or "").strip()
                    if r in (A.Role.PAGE_TAB, A.Role.LIST_ITEM) and name:
                        if name not in found and o.get_state_set().contains(A.StateType.SHOWING):
                            found[name] = o
                        continue
                    if depth < 6:
                        for k in range(min(o.get_child_count(), 80)):
                            c = o.get_child_at_index(k)
                            if c:
                                todo.append((c, depth + 1))
                except Exception:
                    continue
        return found

    def click_drawer(self, label):
        """Open the drawer, press the item called `label`."""
        before = self.visible_actions()
        if label in before:
            self.press(before[label])
            return True
        if not self.press(self.trigger):
            return False
        for _ in range(15):
            time.sleep(0.1)
            now = self.visible_actions()
            if label in now:
                time.sleep(0.2)
                self.press(self.visible_actions().get(label) or now[label])
                return True
        self.press(self.trigger)
        return False

    def learn_burger(self):
        self.listen_popups(True)
        try:
            self._learn_burger()
        finally:
            self.listen_popups(False)
        if not self.burger and self.trigger is not self.frame:
            # The ☰ showed nothing readable (elementary Terminal's Settings
            # popover: unnamed zoom and theme buttons). The page's own
            # commands then (its header's New Tab, Find…), as Actions.
            acts = self.page_actions(Atspi, self.frame)
            acts.pop((self.trigger.get_name() or "").strip(), None)
            if len(acts) >= 2:
                self.trigger = self.frame
                self.read_toolbar()

    DRAWER = re.compile(r"\b(open|show) drawer\b", re.I)

    def _learn_burger(self):
        """Read the whole ☰ in one look: are its items submenus (they
        become the menu bar's menus) or commands (one menu), and every
        submenu's items (three levels), kept in the cache file with the
        app's binary, so the menu bar shows them without opening the ☰ again
        (Claude Desktop: each look flashes its menu and takes a second)."""
        before = self.visible_actions()
        # Kirigami's "Open drawer" opens a panel, never a menu: don't wait
        # for one (6 s).
        drawer = bool(self.DRAWER.search(self.trigger.get_name() or ""))
        menus = None if drawer else self.open_burger()
        if not menus:
            # A popup the toolkit never shows on the bus (Qt Quick's Menu in
            # its own popup window): read it off the screen.
            if not drawer and self.learn_ocr():
                return
            self.learn_drawer(before)
            return
        root = menus[0]
        labels, subs = [], 0
        for c in self.items_of(root)[:60]:
            try:
                # (Kept in place, unnamed, when the app hides it: the same
                # rule as the items read below. Spotify keeps a hidden
                # Develop menu in its ☰; named here, it became a menu of the
                # menu bar that did nothing.)
                st = c.get_state_set()
                if not st.contains(Atspi.StateType.SHOWING) and not st.contains(Atspi.StateType.VISIBLE):
                    labels.append("")
                    continue
                labels.append(split_shortcut(c.get_name() or "")[0] or self.labelled_by(c)
                              or (self.label_texts(c) or [""])[0])
                if c.get_role() == Atspi.Role.MENU or c.get_state_set().contains(Atspi.StateType.HAS_POPUP):
                    subs += 1
            except Exception:
                labels.append("")
        named = [l for l in labels if l]
        if not named and self.cache:
            # An empty look (the menu still drawing): keep the last one.
            self.close_all((-1,))
            return
        flat = subs < max(1, len(named) // 2)
        # Read into a fresh cache, then keep what this look missed (a
        # submenu slow to open) from the last one: the menu bar never shows
        # a "…" for a menu it once knew.
        old = self.cache
        self.cache = {}
        try:
            self.read_open(root, (-1,) if flat else (), 0)
        except Exception as e:
            err(f"AT-SPI: reading the ☰: {e}")
        self.close_all((-1,))
        if (self.burger or {}).get("flat", flat) == flat:
            for p, items in old.items():
                if p not in self.cache and items:
                    self.cache[p] = items
        self.tree_read = True
        self.burger = {"flat": flat, "labels": labels if named else (self.burger or {}).get("labels", labels),
                       "exe": self.exe(),
                       "tree": {",".join(map(str, p)): [self.saved(it) for it in items]
                                for p, items in self.cache.items()}}
        c = load_cache()
        c[self.burger_key()] = self.burger
        save_cache(c)

    def slid(self, menu, label, before):
        """GTK 4's popover menus open a submenu in place: the same popover
        slides to a page whose first item is a header with the submenu's
        label (pressing it slides back)."""
        try:
            items = self.items_of(menu)
            return bool(items) and self.item_label(items[0]) == label and \
                tuple(self.item_label(c) for c in items[:4]) != before
        except Exception:
            return False

    def read_open(self, menu, path, level, seen=None, header=None):
        """Read an open menu and, through it, its submenus (opened one after
        the other: opening a sibling closes the one before). A submenu counts
        as opened once a popup shows that wasn't read yet, by object and by
        its first items (Chromium may reuse one, and two submenus can have
        the same items: Claude's Go and View > Split View)."""
        seen = [] if seen is None else seen

        def sig(m):
            try:
                return tuple((c.get_name() or "") for c in self.items_of(m)[:4])
            except Exception:
                return ()

        seen.append((menu, sig(menu)))
        kids = self.read(menu, path)
        if header is not None:
            # A slid-in GTK 4 page: its first item is the way back, not a
            # command (item indices stay as the page has them).
            kids = [k for k in kids if not (self.paths.get(k["id"], (None,))[-1] == 0 and k["label"] == header)]
            self.cache[tuple(path)] = kids
        if level >= 2:
            return
        for it in kids:
            if not it["submenu"]:
                continue
            cpath = self.paths[it["id"]]
            c = self.item_child(menu, cpath[-1])
            if c is None:
                continue
            label = self.item_label(c)
            labels0 = tuple(self.item_label(x) for x in self.items_of(menu)[:4])
            before = [(m, sig(m)) for m in self.popups()]

            def test():
                for m in reversed(self.popups()):
                    if m is menu:
                        if self.gtk4 and self.slid(menu, label, labels0):
                            return menu
                        continue
                    s_ = sig(m)
                    if not any(m is o and s_ == os_ for o, os_ in before):
                        return m
                return None

            sub = None
            for _ in range(1 if self.gtk4 else 2):  # once more: it can be slow to open
                if not self.act(c):
                    break
                sub = self.wait(test, 12 if self.gtk4 else 25)
                if sub is not None:
                    break
            if sub is menu:
                self.read_open(menu, cpath, level + 1, seen, header=label)
                # Slide back to this page for the next submenu.
                back = self.item_child(menu, 0)
                if back is not None:
                    self.act(back)
                    self.wait(lambda: tuple(self.item_label(x) for x in self.items_of(menu)[:4]) == labels0, 12)
            elif sub is not None:
                self.read_open(sub, cpath, level + 1, seen)

    def saved(self, it):
        it = dict(it, path=list(self.paths.get(it["id"], ())))
        it.pop("id", None)
        it["children"] = []
        return it

    def load_tree(self):
        """The cached ☰ tree, if it was read from this same app binary."""
        b = self.burger or {}
        if not b.get("tree"):
            return
        for key, items in b["tree"].items():
            path = tuple(int(x) for x in key.split(",")) if key else ()
            self.cache[path] = [dict(it, id=self.nid(it.get("path", []))) for it in items]
        # From another build of the app (an update): shown anyway, read
        # again on the first open.
        self.tree_read = b.get("exe") == self.exe()
        if not self.tree_read:
            self.refreshed = 0

    def forget_tree(self):
        """A click found the cache out of date: read again on the next
        open. What's known stays shown (and on disk) until then: never a
        "…" in its place."""
        self.refreshed = 0

    def exe(self):
        try:
            return os.readlink(f"/proc/{self.pid}/exe")
        except OSError:
            return ""

    def close(self, nid):
        pass

    def click(self, nid):
        path = self.paths.get(nid)
        if self.kind == "ocrbar" and path and not self.busy:
            self.busy = True
            try:
                self.ocrbar.click(path)
            finally:
                self.busy = False
            return
        if os.environ.get("HEARTH_OCR_DEBUG"):
            err(f"click {nid}: path {path}, kind {self.kind}, busy {self.busy}")
        if not path or self.kind is None or len(path) < 2 and self.kind != "kept":
            return
        if self.kind == "kept":
            o = self.node(path)
            if o is not None:
                self.act(o)
            return
        if self.kind == "burger" and self.holds_items(self.trigger) and path[:1] == (-1,):
            c = self.item_child(self.trigger, path[-1])
            if c is not None:
                self.act(c)  # GTK 3's menu items take the accessible click
            return
        if self.busy:
            return
        if self.kind == "burger" and (self.burger or {}).get("ocr"):
            self.busy = True
            try:
                self.click_ocr(nid)
            finally:
                self.busy = False
            return
        if self.kind == "burger" and (self.burger or {}).get("drawer"):
            want = next((k.get("name") or k["label"] for k in self.cache.get(tuple(path[:-1]), [])
                         if k["id"] == nid), None)
            if want:
                self.busy = True
                try:
                    if not self.click_drawer(want):
                        self.forget_tree()
                finally:
                    self.busy = False
            return
        self.busy = True
        try:
            want = None
            for k in self.cache.get(tuple(path[:-1]), []):
                if k["id"] == nid:
                    want = k["label"]
            menu = self.open_chain(path[:-1])
            c = self.item_child(menu, path[-1]) if menu is not None else None
            name = self.item_label(c) if c else ""
            if os.environ.get("HEARTH_OCR_DEBUG"):
                err(f"click {nid} path {path}: menu {menu is not None}, item {name!r}, want {want!r}")
            if c is None or (want is not None and name != want):
                self.close_all(path)  # the menu changed since: don't guess
                if self.kind == "burger":
                    self.forget_tree()
                return
            if self.toolkit == "AccessKit":
                # egui acts on a click only after it has drawn the menu a
                # frame or two (an immediate click is lost).
                time.sleep(0.4)
            self.press(c)
            self.burger_open = False  # choosing an item closes the menu
        finally:
            self.busy = False


class OcrBar:
    """A menu bar the app draws itself with nothing on the accessibility
    bus (DOSBox-X's SDL menu, Nestopia's FLTK one): read off captures of
    the window (hearth_ocr_menu). Its titles from the top strip; a title's
    menu read when it opens (a click on the title, the new lines against
    the window before it); an item chosen by clicking where it was read,
    after checking that line still says the same."""

    NONE = set()  # app binaries whose windows showed no drawn menu bar

    def __init__(self, owner):
        self.o = owner
        self.titles = []  # [(title, (x, y))] in logical pixels
        self.items = {}   # title index -> [(label, shortcut, (x, y))]

    def detect(self):
        import hearth_ocr_menu as om
        exe = self.o.exe()
        if exe and exe in OcrBar.NONE:
            return False
        ses = om.Session(self.o.window)
        try:
            bar, k = ses.bar()
        finally:
            ses.close()
        self.titles = [(t, (x / k, y / k)) for t, (x, y) in bar]
        if not self.titles and exe:
            OcrBar.NONE.add(exe)
        return bool(self.titles)

    def click_at(self, x, y):
        return arbor("click-window", "--id", str(self.o.window), "--x", f"{x:.1f}", "--y", f"{y:.1f}", "--geometry")

    def read(self, i):
        """Open title i, read its menu, close it again."""
        import hearth_ocr_menu as om
        ses = om.Session(self.o.window)
        try:
            before, _ = ses.rows()
            x, y = self.titles[i][1]
            if before is None or not self.click_at(x, y):
                return
            time.sleep(0.6)
            found, size = ses.read_popup(before)
            ws = om.window_size(self.o.window)
            k = size[0] / ws[0] if size and ws and ws[0] else 1.0
            # The bar's own titles aren't the menu's.
            # The bar's own row (its highlighted title is in the changed
            # area) isn't the menu's.
            names = {om.norm(t) for t, _ in self.titles}
            self.items[i] = [(l, sc, (px / k, py / k)) for l, sc, (px, py) in found
                             if om.norm(l) not in names
                             and sum(om.norm(w) in names for w in l.split()) < 2]
            self.click_at(x, y)  # a second click on the title closes it
        finally:
            ses.close()

    def tops(self):
        return [((i,), t, None) for i, (t, _) in enumerate(self.titles)]

    def menu_items(self, i):
        res = []
        for j, (label, sc, _) in enumerate(self.items.get(i) or []):
            nid = self.o.nid((i, j))
            res.append(item(nid, label, shortcut=sc))
        return res

    def open(self, path):
        if len(path) == 1 and path[0] < len(self.titles):
            self.read(path[0])

    def click(self, path):
        import hearth_ocr_menu as om
        if len(path) != 2:
            return
        i, j = path
        its = self.items.get(i) or []
        if j >= len(its):
            return
        label, _, (ix, iy) = its[j]
        x, y = self.titles[i][1]
        ses = om.Session(self.o.window)
        try:
            if not self.click_at(x, y):
                return
            time.sleep(0.5)
            p = ses.shot()
            ok = False
            if p:
                w, h, _ = om.read_png(p)
                ws = om.window_size(self.o.window)
                k = w / ws[0] if ws and ws[0] else 1.0
                box = (max(0, int((ix - 260) * k)), max(0, int((iy - 14) * k)),
                       min(w, int((ix + 260) * k)), min(h, int((iy + 14) * k)))
                want = om.norm(label)
                ok = any(om.same_text(label, r["text"]) for r in om.ocr_rows(p, box))
            if not ok:
                self.click_at(x, y)  # the menu changed: close it, read it again next time
                self.items.pop(i, None)
                return
            self.click_at(ix, iy)
        finally:
            ses.close()


def arbor(*args):
    """`arbor msg action ...` (ClickWindow, ClosePopups)."""
    import subprocess
    try:
        return subprocess.run(["arbor", "msg", "action", *args], capture_output=True,
                              timeout=3).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


# ---------------------------------------------------------------- commands

def handle(line):
    global current
    try:
        c = json.loads(line)
    except ValueError:
        return
    cmd = c.get("cmd")
    try:
        if cmd == "watch":
            if current and current.key == c.get("key") and current.kind is not None:
                current.emit()
                return
            if current:
                current.stop()
            current = AtspiMenu(c.get("key", ""), c.get("title", ""), c.get("pid", 0),
                                c.get("window", 0))
        elif cmd == "unwatch":
            if current:
                current.stop()
            current = None
        elif current and cmd == "open":
            current.open(int(c["id"]))
        elif current and cmd == "click":
            current.click(int(c["id"]))
    except Exception as e:
        err(e)


timers = []  # (when, fn)


def later(delay, fn):
    timers.append((time.monotonic() + delay, fn))


def main():
    # No GLib main loop: under one, libatspi dispatching the apps' event
    # flood deadlocked (stuck in a futex, the next command never handled).
    # Blocking calls are fine in a process of its own; stdin and the retry
    # timers are served by select.
    import select
    try:  # go when hearth-appmenu goes, even if stuck in a call
        import ctypes
        import signal
        ctypes.CDLL(None).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
    except Exception:
        pass
    buf = b""
    fd = sys.stdin.fileno()
    while True:
        now = time.monotonic()
        due = [t for t in timers if t[0] <= now]
        for t in due:
            timers.remove(t)
            try:
                t[1]()
            except Exception as e:
                err(e)
        wait = max(0.0, min(t[0] for t in timers) - time.monotonic()) if timers else None
        r, _, _ = select.select([fd], [], [], wait)
        if not r:
            continue
        data = os.read(fd, 65536)
        if not data:
            return
        buf += data
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            handle(line.decode("utf-8", "replace"))


if __name__ == "__main__":
    main()
