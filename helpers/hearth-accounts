def env_registration(provider):
    up = provider.upper()
    cid = os.environ.get("HEARTH_%s_CLIENT_ID" % up, "")
    return {"client_id": cid, "client_secret": os.environ.get("HEARTH_%s_CLIENT_SECRET" % up, "")} if cid else None


# ------------------------------------------------------------------ storage

_lock = threading.RLock()


def load():
    with _lock:
        try:
            with open(STORE) as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        d.setdefault("version", 1)
        d.setdefault("registrations", {})
        d.setdefault("accounts", [])
        return d


def save_store(d):
    with _lock:
        os.makedirs(CONF_DIR, exist_ok=True)
        tmp = STORE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f, indent=2)
        os.chmod(tmp, 0o600)
        os.replace(tmp, STORE)


def new_id(prefix="a"):
    return prefix + format(int(time.time() * 1000), "x") + rnd.token_hex(2)


# Secrets: the Secret Service through secret-tool (or a file in tests).
SECRETS_FILE = os.path.join(TEST_DIR, "secrets.json") if TEST_DIR else ""


def secret_get(account, key):
    if SECRETS_FILE:
        try:
            with open(SECRETS_FILE) as f:
                return json.load(f).get(account + "/" + key)
        except (OSError, ValueError):
            return None
    try:
        r = subprocess.run(["secret-tool", "lookup", "application", "hearth-accounts", "account", account, "key", key],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 and r.stdout != "" else None


def secret_set(account, key, value, label):
    if SECRETS_FILE:
        with _lock:
            try:
                with open(SECRETS_FILE) as f:
                    d = json.load(f)
            except (OSError, ValueError):
                d = {}
            d[account + "/" + key] = value
            with open(SECRETS_FILE, "w") as f:
                json.dump(d, f)
        return True
    try:
        r = subprocess.run(["secret-tool", "store", "--label", label, "application", "hearth-accounts", "account", account, "key", key],
                           input=value, capture_output=True, text=True, timeout=30)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def secret_clear(account, key=None):
    if SECRETS_FILE:
        with _lock:
            try:
                with open(SECRETS_FILE) as f:
                    d = json.load(f)
            except (OSError, ValueError):
                return
            d = {k: v for k, v in d.items() if not (k.startswith(account + "/") and (key is None or k == account + "/" + key))}
            with open(SECRETS_FILE, "w") as f:
                json.dump(d, f)
        return
    args = ["secret-tool", "clear", "application", "hearth-accounts", "account", account]
    if key:
        args += ["key", key]
    try:
        subprocess.run(args, capture_output=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        pass


# ------------------------------------------------------------------ accounts

def same_account(a, b):
    """Whether two records are the same account (so a save merges)."""
    if a.get("kind") != b.get("kind"):
        return False
    k = a.get("kind")
    low = lambda s: (s or "").strip().lower()
    if k == "server":
        return all(low(a.get(f)) == low(b.get(f)) for f in ("protocol", "host", "user")) and str(a.get("port") or "") == str(b.get("port") or "") \
            and (a.get("path") or "") == (b.get("path") or "")
    if k == "nextcloud":
        return low(a.get("server")) == low(b.get("server")) and low(a.get("user")) == low(b.get("user"))
    if k in ("dropbox", "box"):
        return True
    if k == "mail":
        return low(a.get("email")) == low(b.get("email")) and low(a.get("username") or a.get("email")) == low(b.get("username") or b.get("email"))
    return low(a.get("email")) != "" and low(a.get("email")) == low(b.get("email"))


def public(a):
    """An account as apps see it: no secrets, plus what it can be used for."""
    a = json.loads(json.dumps(a))
    p = PROVIDERS.get(a.get("kind"), {})
    if a.get("kind") in PROVIDERS:
        uses = set()
        for g in a.get("grants", []):
            uses |= grant_purposes(a["kind"], g)
        a["uses"] = sorted(uses)
        a["provider_name"] = p.get("name", a["kind"])
    elif a.get("kind") == "mail":
        a["uses"] = ["mail"] + (["calendar"] if a.get("caldav_url") else []) + (["contacts"] if a.get("carddav_url") else [])
    elif a.get("kind") == "nextcloud":
        a["uses"] = ["drive", "files"]
    elif a.get("kind") == "server":
        a["uses"] = ["files"]
    for g in a.get("grants", []):
        g.pop("refresh_token", None)
    a.pop("password", None)
    return a


def grant_purposes(kind, g):
    p = PROVIDERS.get(kind, {})
    if "purposes" in p:
        have = set((g.get("scope") or "").split())
        return {purpose for purpose, need in p["purposes"].items() if have & set(need)}
    if "refresh_scope" in p:          # Microsoft: everything it signed in for
        return set(p["refresh_scope"])
    if kind == "box":
        return {"drive", "files"}
    return {"mail"}


def label_for(a):
    return "%s account: %s" % (PROVIDERS.get(a.get("kind"), {}).get("name") or a.get("kind", "").capitalize(),
                               a.get("email") or a.get("name") or a.get("host") or a.get("server") or a.get("id"))


def do_save(rec):
    """Adds or updates an account; returns its id."""
    rec = dict(rec)
    password = rec.pop("password", None)
    grants = rec.pop("grants", None)
    with _lock:
        d = load()
        cur = None
        if rec.get("id"):
            cur = next((a for a in d["accounts"] if a["id"] == rec["id"]), None)
        if cur is None:
            cur = next((a for a in d["accounts"] if same_account(a, rec)), None)
        if cur is None:
            cur = {"id": rec.get("id") or new_id(), "created": int(time.time())}
            d["accounts"].append(cur)
        app_ids = dict(cur.get("app_ids") or {})
        app_ids.update(rec.pop("app_ids", None) or {})
        rec.pop("id", None)
        for k, v in rec.items():
            if k in ("mail",) and isinstance(v, dict):
                cur.setdefault(k, {}).update(v)
            else:
                cur[k] = v
        if app_ids:
            cur["app_ids"] = app_ids
        if cur.get("kind") in PROVIDERS and "mail" not in cur and PROVIDERS[cur["kind"]].get("mail"):
            m = PROVIDERS[cur["kind"]]["mail"]
            cur["mail"] = {"imap_host": m[0], "imap_port": m[1], "smtp_host": m[2], "smtp_port": m[3]}
        if not cur.get("name"):
            cur["name"] = cur.get("email") or cur.get("host") or cur.get("server") or PROVIDERS.get(cur.get("kind"), {}).get("name", "Account")
        if password is not None:
            if password == "":
                secret_clear(cur["id"], "password")
            else:
                secret_set(cur["id"], "password", password, label_for(cur))
        if grants:
            have = cur.setdefault("grants", [])
            for g in grants:
                g = dict(g)
                tok = g.pop("refresh_token", None)
                same = next((x for x in have if x.get("client_id") == g.get("client_id") and x.get("id") == g.get("id")), None) if g.get("id") else None
                if same is None:
                    same = next((x for x in have if x.get("client_id") == g.get("client_id")), None)
                if same is None:
                    same = {"id": g.get("id") or new_id("g")}
                    have.insert(0, same)
                g.pop("id", None)
                same.update(g)
                if tok:
                    secret_set(cur["id"], "refresh:" + same["id"], tok, label_for(cur) + " (sign-in)")
            cur["signed_out"] = False
            cur["error"] = ""
        save_store(d)
        TOKENS.pop_account(cur["id"])
        return cur["id"]


def do_remove(aid):
    with _lock:
        d = load()
        d["accounts"] = [a for a in d["accounts"] if a["id"] != aid]
        save_store(d)
    secret_clear(aid)
    TOKENS.pop_account(aid)


def get_account(aid):
    d = load()
    a = next((a for a in d["accounts"] if a["id"] == aid), None)
    if a is None:
        # An app's own id works too.
        a = next((a for a in d["accounts"] if aid in (a.get("app_ids") or {}).values()), None)
    return a


def registration(provider, d=None):
    d = d or load()
    r = d["registrations"].get(provider)
    if r and r.get("client_id"):
        return r
    return env_registration(provider)


# ------------------------------------------------------------------ OAuth

class AccountError(Exception):
    def __init__(self, kind, msg):
        super().__init__(msg)
        self.kind = kind


def http(url, data=None, headers=None, timeout=60):
    req = urllib.request.Request(url, data=data, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as e:
        raise AccountError("Failed", "Couldn't reach the sign-in service: %s" % getattr(e, "reason", e))


def post_form(url, body, basic=None):
    headers = {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"}
    if basic:
        headers["Authorization"] = "Basic " + base64.b64encode(("%s:%s" % basic).encode()).decode()
    status, text = http(url, urllib.parse.urlencode(body).encode(), headers)
    try:
        v = json.loads(text)
    except ValueError:
        raise AccountError("Failed", "The sign-in service answered %d: %s" % (status, text[:200]))
    if "error" in v:
        code = v["error"] if isinstance(v["error"], str) else "error"
        desc = v.get("error_description") or ""
        if code == "invalid_grant":
            raise AccountError("SignedOut", "Signed out: %s Sign in again (Settings > Accounts)." % desc)
        hint = {"invalid_client": " (check the app's client ID and secret in Settings > Accounts)",
                "unauthorized_client": " (check the app's client ID and secret in Settings > Accounts)"}.get(code, "")
        raise AccountError("Failed", ("Sign-in failed: %s %s%s" % (code, desc, hint)).strip())
    return v


def provider_url(p, key, tenant):
    return p[key].replace("{tenant}", tenant or "common")


class TokenCache:
    def __init__(self):
        self.m = {}
        self.lock = threading.Lock()

    def get(self, key):
        with self.lock:
            v = self.m.get(key)
            return v if v and v[1] > time.time() else None

    def put(self, key, tok, secs):
        with self.lock:
            self.m[key] = (tok, time.time() + max(60, secs - 120))

    def pop_account(self, aid):
        with self.lock:
            for k in [k for k in self.m if k.startswith(aid + ":")]:
                del self.m[k]


TOKENS = TokenCache()
# One refresh at a time per account (Microsoft hands out a new refresh token
# with each one: two at once would each spend the same old one).
_refresh_locks = {}


def access_token(aid, purpose):
    a = get_account(aid)
    if a is None:
        raise AccountError("Failed", "No such account.")
    aid = a["id"]
    kind = a.get("kind")
    p = PROVIDERS.get(kind)
    if p is None:
        raise AccountError("Failed", "This account signs in with a password, not a token.")
    key = "%s:%s" % (aid, purpose)
    hit = TOKENS.get(key)
    if hit:
        return {"token": hit[0], "expires_in": int(hit[1] - time.time()), "email": a.get("email", "")}
    grants = [g for g in a.get("grants", []) if purpose in grant_purposes(kind, g)]
    if not grants:
        raise AccountError("NotAllowed", "%s isn't allowed to be used for %s: sign in again (Settings > Accounts) and allow it on %s's page."
                           % (a.get("email") or p["name"], purpose, p["name"]))
    lock = _refresh_locks.setdefault(aid, threading.Lock())
    with lock:
        hit = TOKENS.get(key)
        if hit:
            return {"token": hit[0], "expires_in": int(hit[1] - time.time()), "email": a.get("email", "")}
        last = None
        for g in grants:
            refresh = secret_get(aid, "refresh:" + g["id"])
            if not refresh:
                last = AccountError("SignedOut", "Signed out: the sign-in isn't in the keyring. Sign in again (Settings > Accounts).")
                continue
            body = {"client_id": g.get("client_id", ""), "grant_type": "refresh_token", "refresh_token": refresh}
            rs = (p.get("refresh_scope") or {}).get(purpose)
            if rs:
                body["scope"] = rs
            secret = g.get("client_secret", "")
            basic = None
            if p.get("basic") and secret:
                basic = (g.get("client_id", ""), secret)
            elif secret:
                body["client_secret"] = secret
            try:
                v = post_form(provider_url(p, "token", g.get("tenant")), body, basic)
            except AccountError as e:
                last = e
                continue
            tok = v.get("access_token")
            if not tok:
                last = AccountError("Failed", "The sign-in service gave no access token.")
                continue
            secs = int(v.get("expires_in") or 3000)
            nr = v.get("refresh_token")
            if nr and nr != refresh:
                secret_set(aid, "refresh:" + g["id"], nr, label_for(a) + " (sign-in)")
            TOKENS.put(key, tok, secs)
            if a.get("signed_out") or a.get("error"):
                mark(aid, signed_out=False, error="")
            return {"token": tok, "expires_in": secs, "email": a.get("email", "")}
        if last and last.kind == "SignedOut":
            mark(aid, signed_out=True, error=str(last))
        raise last or AccountError("Failed", "Couldn't get a token.")


def mark(aid, **kw):
    """Sets an account's state; Changed only when something really changed."""
    changed = False
    with _lock:
        d = load()
        for a in d["accounts"]:
            if a["id"] == aid and any(a.get(k) != v for k, v in kw.items()):
                a.update(kw)
                changed = True
        if changed:
            save_store(d)
    if changed and SERVICE:
        SERVICE.changed_soon()


def b64url(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def who_am_i(p, access, id_token):
    if id_token:
        try:
            payload = id_token.split(".")[1]
            v = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
            for k in ("email", "preferred_username", "upn"):
                if "@" in (v.get(k) or ""):
                    return v[k]
        except (IndexError, ValueError):
            pass
    if not p.get("userinfo") or not access:
        return ""
    try:
        _, text = http(p["userinfo"], headers={"Authorization": "Bearer " + access})
        v = json.loads(text)
    except (AccountError, ValueError):
        return ""
    for k in ("email", "mail", "userPrincipalName"):
        if v.get(k):
            return v[k]
    return ""


class SignInRound:
    """The sign-in that is waiting (only one at a time)."""
    lock = threading.Lock()
    round = 0
    pasted = None


def cancel_sign_in():
    with SignInRound.lock:
        SignInRound.round += 1


def submit_code(code):
    c = (code or "").strip()
    if "code=" in c:
        c = c.split("code=", 1)[1].split("&", 1)[0]
    SignInRound.pasted = urllib.parse.unquote(c)


PAGE = ("<html><body style='font-family:sans-serif;padding:40px'><h2>%s</h2>%s</body></html>")


def sign_in(provider, open_url, account_id=""):
    """Runs a browser sign-in; returns the account id and address."""
    if provider == "nextcloud":
        raise AccountError("Failed", "Nextcloud signs in with its server address: use nextcloud_sign_in.")
    p = PROVIDERS.get(provider)
    if p is None:
        raise AccountError("Failed", "Unknown provider %s." % provider)
    reg = registration(provider)
    if not reg:
        raise AccountError("Failed", "Set up %s sign-in first (Settings > Accounts > %s)." % (p["name"], p["name"]))
    cid, secret, tenant = reg["client_id"], reg.get("client_secret", ""), reg.get("tenant", "")
    storage = p.get("storage")
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("127.0.0.1", STORAGE_PORT if storage else 0))
    except OSError as e:
        raise AccountError("Failed", "Port %d is busy (%s): close what's using it and try again." % (STORAGE_PORT, e))
    srv.listen(4)
    srv.settimeout(0.2)
    port = srv.getsockname()[1]
    manual = p.get("paste")
    if manual:
        redirect = "oob"
    elif provider == "microsoft":
        redirect = "http://localhost:%d" % port
    else:
        redirect = "http://127.0.0.1:%d" % port
    SignInRound.pasted = None
    with SignInRound.lock:
        SignInRound.round += 1
        my_round = SignInRound.round
    verifier = b64url(rnd.token_bytes(36))
    state = b64url(rnd.token_bytes(12))
    params = {"client_id": cid, "response_type": "code", "redirect_uri": redirect, "state": state,
              "code_challenge": b64url(hashlib.sha256(verifier.encode()).digest()), "code_challenge_method": "S256"}
    if p.get("scope"):
        params["scope"] = p["scope"]
    if provider == "google":
        # Always the account chooser, so the account picked is the one listed
        # under Test users rather than whichever is signed in already.
        params.update(access_type="offline", prompt="select_account consent", include_granted_scopes="true")
    elif provider == "microsoft":
        params["prompt"] = "select_account"
    params.update(p.get("extra") or {})
    open_url(provider_url(p, "auth", tenant) + "?" + urllib.parse.urlencode(params))

    deadline = time.time() + 300
    code = None
    try:
        while code is None:
            if time.time() > deadline:
                raise AccountError("Failed", "Sign-in timed out.")
            if SignInRound.round != my_round:
                raise AccountError("Cancelled", "Sign-in stopped.")
            if SignInRound.pasted:
                code = SignInRound.pasted
                break
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            with conn:
                conn.settimeout(5)
                try:
                    line = conn.recv(8192).decode("utf-8", "replace").split("\r\n", 1)[0]
                except OSError:
                    continue
                path = line.split(" ")[1] if line.count(" ") >= 2 else ""
                q = dict(urllib.parse.parse_qsl(urllib.parse.urlsplit(path).query))
                ok = "code" in q and q.get("state") == state
                page = PAGE % (("Signed in", "You can close this page.") if ok else
                               ("Sign-in did not finish", "Go back to Settings and try again."))
                body = page.encode()
                try:
                    conn.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\nConnection: close\r\n\r\n" % len(body) + body)
                except OSError:
                    pass
                if q.get("error"):
                    hint = ""
                    if provider == "google" and q["error"] == "access_denied":
                        hint = " If Google said “Access blocked”, add your address under Test users (setup step 7), then sign in again."
                    raise AccountError("Failed", "Sign-in was not allowed: %s %s%s" % (q["error"], q.get("error_description", ""), hint))
                if ok:
                    code = q["code"]
    finally:
        srv.close()

    body = {"client_id": cid, "grant_type": "authorization_code", "code": code, "redirect_uri": redirect, "code_verifier": verifier}
    basic = None
    if p.get("basic") and secret:
        basic = (cid, secret)
    elif secret:
        body["client_secret"] = secret
    if provider == "microsoft":
        body["scope"] = MS_DATA
    v = post_form(provider_url(p, "token", tenant), body, basic)
    refresh = v.get("refresh_token")
    if not refresh:
        raise AccountError("Failed", "%s gave no lasting sign-in (refresh token)." % p["name"])
    email = "" if storage else who_am_i(p, v.get("access_token", ""), v.get("id_token", ""))
    scope = v.get("scope") or p.get("scope", "")
    if provider == "microsoft":
        scope = p["scope"]
    grant = {"client_id": cid, "client_secret": secret, "tenant": tenant, "scope": scope, "refresh_token": refresh,
             "signed_in": int(time.time())}
    rec = {"kind": provider, "grants": [grant]}
    if email:
        rec["email"] = email
    target = get_account(account_id) if account_id else None
    if target and (not email or (target.get("email") or "").lower() == email.lower()):
        # Signing in again: the new sign-in replaces the old ones.
        for g in target.get("grants", []):
            secret_clear(target["id"], "refresh:" + g["id"])
        with _lock:
            d = load()
            for a in d["accounts"]:
                if a["id"] == target["id"]:
                    a["grants"] = []
            save_store(d)
        rec["id"] = target["id"]
    aid = do_save(rec)
    return {"id": aid, "email": email, "scope": scope}


def nextcloud_sign_in(server, open_url):
    """Nextcloud's login flow v2: its page hands over an app password."""
    server = server.strip().rstrip("/")
    if not server.startswith("http"):
        server = "https://" + server
    status, text = http(server + "/index.php/login/v2", data=b"", headers={"User-Agent": "hearth"})
    try:
        v = json.loads(text)
    except ValueError:
        raise AccountError("Failed", "That doesn't look like a Nextcloud server (it answered %d)." % status)
    open_url(v["login"])
    with SignInRound.lock:
        SignInRound.round += 1
        my_round = SignInRound.round
    deadline = time.time() + 600
    while time.time() < deadline:
        if SignInRound.round != my_round:
            raise AccountError("Cancelled", "Sign-in stopped.")
        time.sleep(2)
        st, t = http(v["poll"]["endpoint"], data=urllib.parse.urlencode({"token": v["poll"]["token"]}).encode())
        if st == 200:
            r = json.loads(t)
            aid = do_save({"kind": "nextcloud", "server": r["server"], "user": r["loginName"], "name": "Nextcloud (%s)" % r["loginName"],
                           "password": r["appPassword"]})
            return {"id": aid, "email": r["loginName"]}
    raise AccountError("Failed", "Sign-in timed out.")


