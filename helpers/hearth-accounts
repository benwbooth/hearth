def out(**kw):
    print(json.dumps(kw), flush=True)


def proxy():
    import dbus
    bus = dbus.SessionBus()
    return dbus.Interface(bus.get_object(BUS_NAME, PATH), IFACE)


def call(name, *args, timeout=120):
    import dbus
    try:
        return getattr(proxy(), name)(*args, timeout=timeout)
    except dbus.DBusException as e:
        if e.get_dbus_name() in ("org.freedesktop.DBus.Error.ServiceUnknown", "org.freedesktop.DBus.Error.NameHasNoOwner"):
            out(ok=False, kind="NotInstalled",
                error="The accounts service isn't installed yet: it comes with the next system update (rebuild NixOS), then accounts can be added here.")
        else:
            out(ok=False, error=e.get_dbus_message(), kind=e.get_dbus_name().rsplit(".", 1)[-1])
        sys.exit(1)


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "serve":
        serve()
    elif cmd == "list":
        out(ok=True, accounts=json.loads(call("List")), registrations=json.loads(call("Registrations")))
    elif cmd == "save":
        rec = os.environ.get("HEARTH_ACCOUNTS_INPUT", "") if args[1] == "-" else args[1]
        out(ok=True, id=str(call("Save", rec)))
    elif cmd == "load-registration":
        try:
            with open(args[2]) as f:
                text = f.read()
            v = json.loads(text)
            v = v.get("installed") or v.get("web") or v
            reg = {"client_id": v["client_id"], "client_secret": v.get("client_secret", "")}
            if v.get("project_id"):
                reg["project"] = v["project_id"]
        except (OSError, ValueError, KeyError, AttributeError):
            out(ok=False, error="That isn't a client file: download it again with Download JSON.")
            sys.exit(1)
        call("SaveRegistration", args[1], json.dumps(reg))
        out(ok=True, client_id=reg["client_id"])
    elif cmd == "watch":
        import dbus
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        bus.add_signal_receiver(lambda: out(changed=True), "Changed", IFACE, BUS_NAME, PATH)
        out(watching=True)
        GLib.MainLoop().run()
    elif cmd == "remove":
        call("Remove", args[1])
        out(ok=True)
    elif cmd == "registration":
        call("SaveRegistration", args[1], args[2] if len(args) > 2 else "")
        out(ok=True)
    elif cmd == "sign-in":
        import dbus
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        loop = GLib.MainLoop()
        want = {}

        def opened(session, url):
            if session == want.get("s"):
                out(ok=True, opened=str(url))

        def done(session, result):
            if session == want.get("s"):
                r = json.loads(str(result))
                print(json.dumps(r), flush=True)
                want["rc"] = 0 if r.get("ok") else 1
                loop.quit()
        bus.add_signal_receiver(done, "SignInDone", IFACE, BUS_NAME, PATH)
        bus.add_signal_receiver(opened, "SignInOpened", IFACE, BUS_NAME, PATH)
        want["s"] = str(dbus.Interface(bus.get_object(BUS_NAME, PATH), IFACE).SignIn(args[1], args[2] if len(args) > 2 else ""))
        loop.run()
        sys.exit(want.get("rc", 1))
    elif cmd == "code":
        call("SubmitCode", args[1])
        out(ok=True)
    elif cmd == "cancel":
        call("CancelSignIn")
        out(ok=True)
    elif cmd == "token":
        out(ok=True, **json.loads(call("AccessToken", args[1], args[2])))
    elif cmd == "password-set":
        # (Settings types a password: it never goes on a command line.)
        pw = sys.stdin.read()
        out(ok=True, id=str(call("Save", json.dumps({"id": args[1], "password": pw}))))
    elif cmd == "test":
        out(**test_account(args[1]))
    elif cmd == "presets":
        out(ok=True, presets=PRESETS)
    elif cmd == "discover":
        out(**discover(args[1]))
    else:
        print(__doc__)
