def discover(email):
    """Servers for an address: Thunderbird's ISPDB, then the domain's own autoconfig."""
    domain = email.split("@")[-1].strip().lower()
    if not domain:
        return {"ok": False, "error": "Type the whole address first."}
    import xml.etree.ElementTree as ET
    for url in ("https://autoconfig.thunderbird.net/v1.1/" + domain,
                "https://autoconfig.%s/mail/config-v1.1.xml?emailaddress=%s" % (domain, urllib.parse.quote(email))):
        try:
            st, text = http(url, timeout=10)
        except AccountError:
            continue
        if st != 200:
            continue
        try:
            root = ET.fromstring(text)
        except ET.ParseError:
            continue
        out = {}
        for s in root.iter("incomingServer"):
            if s.get("type") in ("imap", "pop3") and "imap" not in out:
                out["incoming"] = "" if s.get("type") == "imap" else "pop"
                out["imap"] = [s.findtext("hostname"), int(s.findtext("port") or 993)]
                out["username"] = "email" if "%EMAILADDRESS%" in (s.findtext("username") or "") else "local"
        for s in root.iter("outgoingServer"):
            if "smtp" not in out:
                out["smtp"] = [s.findtext("hostname"), int(s.findtext("port") or 465)]
        if "imap" in out:
            out["ok"] = True
            return out
    return {"ok": False, "error": "Couldn't find %s's servers: type them in." % domain}


def test_account(aid):
    import imaplib
    import smtplib
    import ssl
    a = get_account(aid)
    if a is None:
        return {"ok": False, "error": "No such account."}
    if a.get("kind") == "server":
        try:
            port = int(a.get("port") or {"sftp": 22, "smb": 445, "webdav": 443}.get(a.get("protocol"), 0))
            socket.create_connection((a["host"], port), timeout=8).close()
            return {"ok": True, "detail": "%s answers on port %d." % (a["host"], port)}
        except OSError as e:
            return {"ok": False, "error": "Couldn't reach %s: %s" % (a.get("host"), e)}
    m = a.get("mail") or {}
    if not m.get("imap_host") or m.get("incoming") == "ews":
        return {"ok": True, "detail": "Nothing to try here."}
    user = a.get("username") or a.get("email")
    try:
        ctx = ssl.create_default_context()
        port = int(m.get("imap_port") or 993)
        c = imaplib.IMAP4_SSL(m["imap_host"], port, ssl_context=ctx, timeout=15) if port == 993 else imaplib.IMAP4(m["imap_host"], port, timeout=15)
        if a.get("kind") in PROVIDERS:
            tok = access_token(a["id"], "mail")["token"]
            c.authenticate("XOAUTH2", lambda _: ("user=%s\x01auth=Bearer %s\x01\x01" % (a.get("email"), tok)).encode())
        else:
            c.login(user, secret_get(a["id"], "password") or "")
        c.logout()
    except AccountError as e:
        return {"ok": False, "error": str(e)}
    except (OSError, imaplib.IMAP4.error, ssl.SSLError) as e:
        return {"ok": False, "error": "Mail sign-in failed: %s" % e}
    return {"ok": True, "detail": "Signed in to %s." % m["imap_host"]}


# ------------------------------------------------------------------ D-Bus service

SERVICE = None


def serve():
    global SERVICE
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()

    def dbus_error(e):
        name = IFACE + "." + (e.kind if isinstance(e, AccountError) and e.kind in ("SignedOut", "NotAllowed", "Cancelled") else "Failed")
        return dbus.DBusException(str(e), name=name)

    def in_thread(fn, ok, err):
        def run():
            try:
                r = fn()
                GLib.idle_add(lambda: (ok(r), False)[1])
            except Exception as e:  # noqa: BLE001 (every failure goes back to the caller)
                GLib.idle_add(lambda e=e: (err(dbus_error(e)), False)[1])
        threading.Thread(target=run, daemon=True).start()

    class Service(dbus.service.Object):
        def __init__(self):
            super().__init__(dbus.service.BusName(BUS_NAME, bus), PATH)
            self._pending = False

        def changed_soon(self):
            if not self._pending:
                self._pending = True
                GLib.idle_add(self._emit)

        def _emit(self):
            self._pending = False
            self.Changed()
            return False

        @dbus.service.signal(IFACE, signature="")
        def Changed(self):
            pass

        @dbus.service.signal(IFACE, signature="ss")
        def SignInDone(self, session, result):
            pass

        @dbus.service.method(IFACE, in_signature="", out_signature="s")
        def List(self):
            d = load()
            return json.dumps([public(a) for a in d["accounts"]])

        @dbus.service.method(IFACE, in_signature="s", out_signature="s", async_callbacks=("ok", "err"))
        def Password(self, aid, ok, err):
            def get():
                a = get_account(aid)
                if a is None:
                    raise AccountError("Failed", "No such account.")
                pw = secret_get(a["id"], "password")
                if pw is None:
                    raise AccountError("Failed", "%s: the password isn't in the keyring. Type it again in Settings > Accounts." % a.get("name"))
                return pw
            in_thread(get, ok, err)

        @dbus.service.method(IFACE, in_signature="ss", out_signature="s", async_callbacks=("ok", "err"))
        def AccessToken(self, aid, purpose, ok, err):
            in_thread(lambda: json.dumps(access_token(aid, purpose)), ok, err)

        @dbus.service.method(IFACE, in_signature="s", out_signature="s", async_callbacks=("ok", "err"))
        def Save(self, rec, ok, err):
            def run():
                aid = do_save(json.loads(rec))
                self.changed_soon()
                return aid
            in_thread(run, ok, err)

        @dbus.service.method(IFACE, in_signature="s", out_signature="", async_callbacks=("ok", "err"))
        def Remove(self, aid, ok, err):
            def run():
                do_remove(aid)
                self.changed_soon()
            in_thread(run, ok, err)

        @dbus.service.method(IFACE, in_signature="", out_signature="s")
        def Registrations(self):
            d = load()
            out = {}
            for k in PROVIDERS:
                r = registration(k, d)
                out[k] = {"ready": bool(r), "client_id": (r or {}).get("client_id", ""), "has_secret": bool((r or {}).get("client_secret")),
                          "source": "saved" if d["registrations"].get(k, {}).get("client_id") else ("built in" if r else ""),
                          "project": d["registrations"].get(k, {}).get("project", ""), "needs_secret": PROVIDERS[k].get("secret", True),
                          "name": PROVIDERS[k]["name"], "what": PROVIDERS[k]["what"], "paste": bool(PROVIDERS[k].get("paste"))}
            return json.dumps(out)

        @dbus.service.method(IFACE, in_signature="ss", out_signature="")
        def SaveRegistration(self, provider, rec):
            r = json.loads(rec) if rec else {}
            with _lock:
                d = load()
                if not r.get("client_id"):
                    d["registrations"].pop(provider, None)
                else:
                    old = d["registrations"].get(provider, {})
                    if not r.get("client_secret") and old.get("client_secret") and old.get("client_id") == r.get("client_id"):
                        r["client_secret"] = old["client_secret"]
                    d["registrations"][provider] = {**old, **r}
                save_store(d)
            self.changed_soon()

        @dbus.service.method(IFACE, in_signature="ss", out_signature="s")
        def SignIn(self, provider, aid):
            session = new_id("s")

            def opener(url):
                try:
                    subprocess.Popen([os.environ.get("HEARTH_ACCOUNTS_BROWSER", "xdg-open"), url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except OSError:
                    pass
                GLib.idle_add(lambda: (self.SignInOpened(session, url), False)[1])

            def run():
                try:
                    if provider == "nextcloud":
                        r = nextcloud_sign_in(aid, opener)
                    else:
                        r = sign_in(provider, opener, aid)
                    r["ok"] = True
                except AccountError as e:
                    r = {"ok": False, "error": str(e), "cancelled": e.kind == "Cancelled"}
                except Exception as e:  # noqa: BLE001
                    r = {"ok": False, "error": "Sign-in failed: %s" % e}
                GLib.idle_add(lambda: (self.SignInDone(session, json.dumps(r)), self.changed_soon(), False)[2])
            threading.Thread(target=run, daemon=True).start()
            return session

        @dbus.service.signal(IFACE, signature="ss")
        def SignInOpened(self, session, url):
            pass

        @dbus.service.method(IFACE, in_signature="s", out_signature="")
        def SubmitCode(self, code):
            submit_code(code)

        @dbus.service.method(IFACE, in_signature="", out_signature="")
        def CancelSignIn(self):
            cancel_sign_in()

        @dbus.service.method(IFACE, in_signature="s", out_signature="b")
        def OpenSettings(self, aid):
            try:
                r = subprocess.run(["hearth-ipc", "call", "settings", "openPane", "accounts" + ((":" + aid) if aid else "")],
                                   capture_output=True, timeout=10)
                return r.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                return False

    SERVICE = Service()
    GLib.MainLoop().run()


