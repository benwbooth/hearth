def p_spotlight(o, offset, seen, minsize):
    loc = o.get("market") or "en-US"
    country = loc.split("-")[-1]
    j = get_json(f"https://fd.api.iris.microsoft.com/v4/api/selection?placement=88000820&bcnt=4&country={country}&locale={loc}&fmt=json")
    cands = []
    for it in j.get("batchrsp", {}).get("items", []):
        try:
            ad = json.loads(it["item"])["ad"]
        except (KeyError, ValueError):
            continue
        url = (ad.get("landscapeImage") or {}).get("asset")
        if not url:
            continue
        hover = (ad.get("iconHoverText") or "").split("\r\n")
        link = ad.get("ctaUri") or ""
        if not link.startswith("http"):
            m = re.search(r"https?%3a%2f%2f[^&]+", link, re.I)
            link = urllib.parse.unquote(m.group(0)) if m else ""
        cands.append({"id": "sp-" + safe_id(os.path.basename(urllib.parse.urlsplit(url).path).rsplit(".", 1)[0][-60:]),
                      "url": url, "title": ad.get("title") or (hover[0] if hover else ""),
                      "copyright": " – ".join(x for x in hover[:2] if x),
                      "link": link, "date": dt.date.today().strftime("%Y%m%d")})
    if not cands:
        raise Fail("Windows Spotlight: no pictures")
    fresh = [c for c in cands if c["id"] not in seen]
    return (fresh or cands)[0]


def p_earthview(o, offset, seen, minsize):
    for _ in range(25):
        n = random.randint(1003, 14800)
        if f"ev-{n}" in seen:
            continue
        try:
            meta = get_json(f"https://www.gstatic.com/prettyearth/assets/data/v3/{n}.json")
        except Fail:
            continue
        geo = meta.get("geocode") or {}
        place = ", ".join(x for x in (geo.get("locality") or geo.get("administrative_area_level_1"), geo.get("country")) if x)
        return {"id": f"ev-{n}", "url": f"https://www.gstatic.com/prettyearth/assets/full/{n}.jpg",
                "title": place or "Google Earth View", "copyright": meta.get("attribution", ""),
                "link": f"https://earthview.withgoogle.com/{n}", "date": ""}
    raise Fail("Google Earth View: no picture found (try again)")


def p_wallhaven(o, offset, seen, minsize):
    q = {
        "q": o.get("query", ""),
        "categories": o.get("categories") or "100",       # general/anime/people
        "purity": o.get("purity") or "100",               # SFW only by default
        "sorting": o.get("sorting") or "toplist",
        "order": "desc",
    }
    if q["sorting"] == "toplist":
        q["topRange"] = o.get("topRange") or "1w"
    if q["sorting"] == "random":
        q["seed"] = "".join(random.choice("abcdefghijklmnopqrstuvwxyz") for _ in range(6))
    if minsize[0] and o.get("atLeastScreen", True):
        q["atleast"] = f"{minsize[0]}x{minsize[1]}"
    if o.get("ratios"):
        q["ratios"] = o["ratios"]
    headers = {}
    key = secret_get("wallhaven")
    if key:
        headers["X-API-Key"] = key
    elif q["purity"][-1:] == "1" or q["purity"][1:2] == "1":
        q["purity"] = "100"   # sketchy/NSFW need an API key; stay SFW
    for page in (1, 2, 3):
        q["page"] = page
        j = get_json("https://wallhaven.cc/api/v1/search?" + urllib.parse.urlencode(q), headers)
        for w in j.get("data", []):
            if "wh-" + w["id"] in seen:
                continue
            title = "Wallhaven " + w["id"]
            credit = ""
            try:
                d = get_json(f"https://wallhaven.cc/api/v1/w/{w['id']}", headers).get("data", {})
                tags = [t["name"] for t in d.get("tags", [])][:4]
                if tags:
                    title = ", ".join(tags).capitalize()
                up = (d.get("uploader") or {}).get("username")
                credit = " – ".join(x for x in (f"uploaded by {up}" if up else "", d.get("source") or "") if x)
            except Fail:
                pass
            return {"id": "wh-" + w["id"], "url": w["path"], "title": title, "copyright": credit,
                    "link": w.get("url", ""), "date": (w.get("created_at") or "")[:10].replace("-", "")}
        if not j.get("data"):
            break
    raise Fail("Wallhaven: nothing new matches (loosen the search or resolution)")


def p_reddit(o, offset, seen, minsize):
    subs = re.sub(r"[^A-Za-z0-9_+]", "", (o.get("subreddits") or "EarthPorn").replace(",", "+").replace(" ", ""))
    t = o.get("top") or "day"
    minw = int(o.get("minWidth") or (minsize[0] if o.get("atLeastScreen", True) else 0) or 0)
    minaspect = float(o.get("minAspect") or 0)
    try:
        j = get_json(f"https://www.reddit.com/r/{subs}/top.json?t={t}&limit=100&raw_json=1")
    except Fail as e:
        raise Fail(f"Reddit refused the request ({e}); Reddit blocks some networks without sign-in")
    for c in j.get("data", {}).get("children", []):
        d = c.get("data", {})
        if d.get("over_18") or d.get("is_video"):
            continue
        url = d.get("url_overridden_by_dest") or d.get("url") or ""
        if not re.search(r"\.(jpe?g|png|webp)$", urllib.parse.urlsplit(url).path, re.I):
            continue
        try:
            src = d["preview"]["images"][0]["source"]
            w, h = int(src["width"]), int(src["height"])
        except (KeyError, IndexError, ValueError, TypeError):
            m = re.search(r"(\d{3,5})\s*[x×X]\s*(\d{3,5})", d.get("title", ""))
            w, h = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
        if minw and w and w < minw:
            continue
        if w and h and (w / h < max(minaspect, 1.0)):
            continue      # wallpapers: landscape only
        pid = "rd-" + d.get("id", safe_id(url))
        if pid in seen:
            continue
        return {"id": pid, "url": url, "title": d.get("title", ""),
                "copyright": f"u/{d.get('author', '')} in r/{d.get('subreddit', subs)}",
                "link": "https://www.reddit.com" + d.get("permalink", ""),
                "date": dt.datetime.fromtimestamp(d.get("created_utc", 0)).strftime("%Y%m%d")}
    raise Fail(f"Reddit: nothing new in r/{subs} matches the size filter")


def p_unsplash(o, offset, seen, minsize):
    key = secret_get("unsplash")
    if not key:
        raise Fail("Unsplash needs an access key (Settings > Wallpaper)")
    q = {"orientation": "landscape", "content_filter": "high"}
    if o.get("query"):
        q["query"] = o["query"]
    h = {"Authorization": "Client-ID " + key, "Accept-Version": "v1"}
    p = get_json("https://api.unsplash.com/photos/random?" + urllib.parse.urlencode(q), h)
    w = max(minsize[0], 3840)
    user = p.get("user", {})
    return {"id": "us-" + p["id"], "url": p["urls"]["raw"] + f"&w={w}&fm=jpg&q=85",
            "title": strip_html(p.get("description") or p.get("alt_description") or "Unsplash photo").capitalize(),
            "copyright": f"Photo by {user.get('name', '')} on Unsplash",
            "link": (p.get("links", {}).get("html") or "https://unsplash.com") + "?utm_source=hearth&utm_medium=referral",
            "date": (p.get("created_at") or "")[:10].replace("-", ""),
            # Unsplash API guidelines: report the download.
            "after": ("https://" + p["links"]["download_location"].split("://", 1)[1], h) if p.get("links", {}).get("download_location") else None}


def p_pexels(o, offset, seen, minsize):
    key = secret_get("pexels")
    if not key:
        raise Fail("Pexels needs an API key (Settings > Wallpaper)")
    h = {"Authorization": key}
    if o.get("query"):
        url = "https://api.pexels.com/v1/search?" + urllib.parse.urlencode(
            {"query": o["query"], "orientation": "landscape", "size": "large", "per_page": 60})
    else:
        url = "https://api.pexels.com/v1/curated?per_page=60"
    photos = get_json(url, h).get("photos", [])
    photos = [p for p in photos if p.get("width", 0) > p.get("height", 1)
              and (not minsize[0] or p.get("width", 0) >= minsize[0] * 0.8)] or photos
    fresh = [p for p in photos if f"px-{p['id']}" not in seen] or photos
    if not fresh:
        raise Fail("Pexels: no photos")
    p = random.choice(fresh)
    return {"id": f"px-{p['id']}", "url": p["src"]["original"], "title": p.get("alt") or "Pexels photo",
            "copyright": f"Photo by {p.get('photographer', '')} on Pexels", "link": p.get("url", ""), "date": ""}


def p_flickr(o, offset, seen, minsize):
    key = secret_get("flickr")
    if not key:
        raise Fail("Flickr needs an API key (Settings > Wallpaper)")
    day = dt.date.today() - dt.timedelta(days=2 + offset)
    q = urllib.parse.urlencode({"method": "flickr.interestingness.getList", "api_key": key, "date": day.isoformat(),
                                "extras": "url_k,url_h,url_o,owner_name,o_dims", "per_page": 100,
                                "format": "json", "nojsoncallback": 1})
    photos = get_json("https://api.flickr.com/services/rest/?" + q).get("photos", {}).get("photo", [])
    best = []
    for p in photos:
        for k in ("url_k", "url_h", "url_o"):
            if p.get(k) and int(p.get("width_" + k[4:], 0) or 0) > int(p.get("height_" + k[4:], 1) or 1):
                best.append((p, p[k]))
                break
    fresh = [b for b in best if f"fl-{b[0]['id']}" not in seen] or best
    if not fresh:
        raise Fail("Flickr: no landscape photos for " + day.isoformat())
    p, url = random.choice(fresh)
    return {"id": f"fl-{p['id']}", "url": url, "title": p.get("title") or "Flickr photo",
            "copyright": f"Photo by {p.get('ownername', '')} on Flickr",
            "link": f"https://www.flickr.com/photos/{p.get('owner')}/{p['id']}", "date": day.strftime("%Y%m%d")}


