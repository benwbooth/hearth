def cmd_fetch(args):
    source = args.pop(0)
    opts, offset, cache, minsize = {}, 0, None, (0, 0)
    while args:
        a = args.pop(0)
        if a == "--opts":
            opts = json.loads(args.pop(0) or "{}")
        elif a == "--offset":
            offset = max(0, int(args.pop(0)))
        elif a == "--dir":
            cache = args.pop(0)
        elif a == "--min":
            m = re.match(r"(\d+)x(\d+)", args.pop(0))
            if m:
                minsize = (int(m.group(1)), int(m.group(2)))
    if source not in PROVIDERS or not cache:
        raise Fail("unknown source " + source)
    d = os.path.join(cache, source)
    os.makedirs(d, exist_ok=True)
    hist_path = os.path.join(d, "history.json")
    try:
        hist = json.load(open(hist_path))
    except (OSError, ValueError):
        hist = []
    seen = {h["id"] for h in hist if os.path.exists(h.get("file", ""))}
    c = PROVIDERS[source](opts, offset, seen, minsize)
    existing = next((h for h in hist if h["id"] == c["id"] and os.path.exists(h.get("file", ""))), None)
    if existing:
        existing["checked"] = dt.datetime.now().isoformat(timespec="seconds")
        item = existing
    else:
        dest = os.path.join(d, safe_id(c["id"]) + ext_of(c["url"]))
        try:
            w, h = download(c["url"], dest, c.get("headers"))
        except Fail:
            if not c.get("fallback"):
                raise
            w, h = download(c["fallback"], dest)
        if c.get("after"):
            try:
                curl(c["after"][0], c["after"][1])
            except Fail:
                pass
        item = {k: c.get(k, "") for k in ("id", "title", "copyright", "link", "date")}
        item.update({"source": source, "file": dest, "width": w, "height": h,
                     "fetched": dt.datetime.now().isoformat(timespec="seconds")})
        if c.get("fit"):
            item["fit"] = c["fit"]
        hist.insert(0, item)
        # Daily sources browse back in time: keep the history sorted by date.
        if source in ("bing", "apod", "wikimedia", "earthobs", "flickr"):
            hist.sort(key=lambda x: x.get("date", ""), reverse=True)
    # A NOAA picture every half hour would fill the disk: keep only a few.
    limit = 6 if source == "noaa" else HISTORY_MAX
    keep, drop = hist[:limit], hist[limit:]
    for h in drop:
        if h.get("file") and h is not item:
            try:
                os.unlink(h["file"])
            except OSError:
                pass
    tmp = hist_path + ".tmp"
    json.dump(keep, open(tmp, "w"), indent=1)
    os.replace(tmp, hist_path)
    out({"item": item, "history": keep})


