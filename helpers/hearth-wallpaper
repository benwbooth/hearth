def steam_libraries():
    """Steam library roots: the default install plus libraryfolders.vdf."""
    roots = []
    for base in ("~/.local/share/Steam", "~/.steam/steam", "~/.var/app/com.valvesoftware.Steam/data/Steam"):
        base = os.path.realpath(os.path.expanduser(base))
        if os.path.isdir(base) and base not in roots:
            roots.append(base)
            try:
                vdf = open(os.path.join(base, "steamapps", "libraryfolders.vdf"), encoding="utf-8", errors="replace").read()
                for m in re.findall(r'"path"\s+"([^"]+)"', vdf):
                    m = os.path.realpath(m.replace("\\\\", "/"))
                    if os.path.isdir(m) and m not in roots:
                        roots.append(m)
            except OSError:
                pass
    return roots


def cmd_scan_we(args):
    res = []
    seen = set()
    assets = ""
    dirs = [a for a in args if a != "--steam"]
    if "--steam" in args:
        for lib in steam_libraries():
            we = os.path.join(lib, "steamapps", "common", "wallpaper_engine")
            if os.path.isdir(os.path.join(we, "assets")) and not assets:
                assets = os.path.join(we, "assets")
            dirs += [os.path.join(we, "projects", "myprojects"), os.path.join(lib, "steamapps", "workshop", "content", "431960"),
                     os.path.join(we, "projects", "defaultprojects")]
    for d in dirs:
        d = os.path.expanduser(d)
        if not os.path.isdir(d):
            continue
        for pj in sorted(glob.glob(os.path.join(d, "*", "project.json"))):
            proj = os.path.dirname(pj)
            real = os.path.realpath(proj)
            if real in seen:
                continue
            seen.add(real)
            try:
                j = json.load(open(pj, encoding="utf-8-sig"))
            except (OSError, ValueError):
                continue
            typ = (j.get("type") or "").lower()
            if not typ:
                f = (j.get("file") or "").lower()
                typ = "web" if f.endswith(".html") else "video" if f.endswith(VIDEO_EXT) else "scene"
            prev = j.get("preview") or ""
            res.append({
                "id": os.path.basename(proj), "path": proj, "title": j.get("title") or os.path.basename(proj),
                "type": typ, "preview": os.path.join(proj, prev) if prev else "",
                "file": os.path.join(proj, j["file"]) if j.get("file") else "",
                "workshop": os.path.basename(proj).isdigit(),
                "rating": j.get("contentrating") or "", "tags": j.get("tags") or [],
            })
    out({"assets": assets, "projects": res})


