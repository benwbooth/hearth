def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------- network

def curl(url, headers=None, timeout=30, binary=False):
    """GET url with curl (follows redirects); returns bytes or str."""
    cmd = ["curl", "-fsSL", "--max-time", str(timeout), "--retry", "1", "-A", UA]
    for k, v in (headers or {}).items():
        cmd += ["-H", f"{k}: {v}"]
    cmd.append(url)
    p = subprocess.run(cmd, capture_output=True)
    if p.returncode != 0:
        msg = p.stderr.decode(errors="replace").strip() or f"curl exit {p.returncode}"
        raise Fail(f"{urllib.parse.urlsplit(url).netloc}: {msg}")
    return p.stdout if binary else p.stdout.decode("utf-8", errors="replace")


def get_json(url, headers=None):
    text = curl(url, headers)
    try:
        return json.loads(text)
    except ValueError:
        raise Fail(f"{urllib.parse.urlsplit(url).netloc}: not JSON")


def image_size(path):
    try:
        w = subprocess.run(["vipsheader", "-f", "width", path], capture_output=True, text=True, timeout=30)
        h = subprocess.run(["vipsheader", "-f", "height", path], capture_output=True, text=True, timeout=30)
        if w.returncode == 0 and h.returncode == 0:
            return int(w.stdout.strip()), int(h.stdout.strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return 0, 0


def download(url, dest, headers=None):
    """Download to dest atomically; checks that it really is a picture."""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    cmd = ["curl", "-fsSL", "--max-time", "300", "--retry", "2", "-A", UA, "-o", part]
    for k, v in (headers or {}).items():
        cmd += ["-H", f"{k}: {v}"]
    cmd.append(url)
    p = subprocess.run(cmd, capture_output=True)
    if p.returncode != 0:
        try:
            os.unlink(part)
        except OSError:
            pass
        raise Fail("download failed: " + (p.stderr.decode(errors="replace").strip() or url))
    w, h = image_size(part)
    if not w:
        os.unlink(part)
        raise Fail("download is not a picture: " + url)
    os.replace(part, dest)
    return w, h


def strip_html(s):
    s = re.sub(r"<[^>]+>", "", s or "")
    return re.sub(r"\s+", " ", html.unescape(s)).strip()


def ext_of(url, default=".jpg"):
    path = urllib.parse.urlsplit(url).path.lower()
    for e in (".jpg", ".jpeg", ".png", ".webp"):
        if path.endswith(e):
            return e
    return default


def safe_id(s):
    return re.sub(r"[^A-Za-z0-9._-]+", "_", s)[:120] or hashlib.sha1(s.encode()).hexdigest()[:16]


# ---------------------------------------------------------------- providers
#
# Each returns a candidate dict: {id, url, title, copyright, link, date,
# headers?, after?}. `seen` is the set of ids already in the history, so
# providers with many pictures (random, top lists) can pick a new one.

def p_bing(o, offset, seen, minsize):
    mkt = o.get("market") or "en-US"
    j = get_json(f"https://www.bing.com/HPImageArchive.aspx?format=js&idx={min(offset, 7)}&n=1&mkt={mkt}")
    img = (j.get("images") or [None])[0]
    if not img or not img.get("urlbase"):
        raise Fail("Bing: no picture")
    pid = img["urlbase"].split("id=")[-1]
    return {
        "id": pid, "url": "https://www.bing.com" + img["urlbase"] + "_UHD.jpg",
        "fallback": "https://www.bing.com" + img.get("url", ""),
        "title": img.get("title") or "", "copyright": img.get("copyright") or "",
        "link": img.get("copyrightlink") or "", "date": img.get("startdate") or "",
    }


def p_apod(o, offset, seen, minsize):
    items = get_json("https://science.nasa.gov/wp-json/wp/v2/apod-basic")
    imgs = [i for i in items if i.get("media_type") == "image" and (i.get("hdurl") or i.get("url"))]
    if not imgs:
        raise Fail("APOD: no picture (today's may be a video)")
    i = imgs[min(offset, len(imgs) - 1)]
    return {
        "id": "apod-" + (i.get("date") or i.get("post_id") or ""), "url": i.get("hdurl") or i.get("url"),
        "title": strip_html(i.get("title")), "copyright": strip_html(i.get("credit") or i.get("copyright")),
        "link": i.get("permalink") or "https://apod.nasa.gov/apod/", "date": (i.get("date") or "").replace("-", ""),
    }


def p_wikimedia(o, offset, seen, minsize):
    day = dt.datetime.now(dt.timezone.utc).date() - dt.timedelta(days=offset)
    api = "https://commons.wikimedia.org/w/api.php"

    def expand(text):
        q = urllib.parse.urlencode({"action": "expandtemplates", "text": text, "prop": "wikitext", "format": "json"})
        return get_json(f"{api}?{q}").get("expandtemplates", {}).get("wikitext", "").strip()
    name = expand("{{Potd/%s}}" % day.isoformat())
    if not name or "Template:" in name or "\n" in name:
        raise Fail("Wikimedia Commons: no picture for " + day.isoformat())
    caption = ""
    try:
        caption = strip_html(re.sub(r"\[\[(?:[^|\]]*\|)?([^\]]*)\]\]", r"\1", expand("{{Potd/%s (en)}}" % day.isoformat())))
        if "Template:" in caption:
            caption = ""
    except Fail:
        pass
    credit = ""
    try:
        q = urllib.parse.urlencode({"action": "query", "titles": "File:" + name, "prop": "imageinfo",
                                    "iiprop": "extmetadata", "format": "json"})
        pages = get_json(f"{api}?{q}").get("query", {}).get("pages", {})
        for pg in pages.values():
            md = (pg.get("imageinfo") or [{}])[0].get("extmetadata", {})
            artist = strip_html(md.get("Artist", {}).get("value", ""))
            lic = strip_html(md.get("LicenseShortName", {}).get("value", ""))
            credit = ", ".join(x for x in (artist, lic) if x)
    except Fail:
        pass
    width = max(3840, minsize[0])
    return {
        "id": "wc-" + day.isoformat(),
        # Originals can be 100 MB TIFFs: ask for a screen-sized rendering.
        "url": "https://commons.wikimedia.org/wiki/Special:FilePath/" + urllib.parse.quote(name) + f"?width={width}",
        "title": caption or os.path.splitext(name)[0].replace("_", " "), "copyright": credit,
        "link": "https://commons.wikimedia.org/wiki/File:" + urllib.parse.quote(name.replace(" ", "_")),
        "date": day.strftime("%Y%m%d"),
    }


def p_earthobs(o, offset, seen, minsize):
    # NASA Earth Observatory moved into science.nasa.gov; its old feed URL
    # redirects to a NASA Science feed that also carries other posts.
    s = curl("https://earthobservatory.nasa.gov/feeds/image-of-the-day.rss")
    items = []
    for it in re.findall(r"<item>(.*?)</item>", s, re.S):
        if "CDATA[Earth Observatory]" not in it:
            continue
        title = strip_html(re.sub(r"<!\[CDATA\[|\]\]>", "", (re.search(r"<title>(.*?)</title>", it, re.S) or [None, ""])[1]))
        link = (re.search(r"<link>(.*?)</link>", it, re.S) or [None, ""])[1].strip()
        date = (re.search(r"<pubDate>(.*?)</pubDate>", it, re.S) or [None, ""])[1].strip()
        imgs = [html.unescape(u) for u in re.findall(r"(https://assets\.science\.nasa\.gov/content/dam/[^\"' ]+?/iotd/[^\"' ]+?\.(?:jpe?g|png))", it)]
        imgs = [u for u in dict.fromkeys(imgs) if not re.search(r"_th\.\w+$", u)]
        if not imgs:
            continue
        big = [u for u in imgs if "_lrg." in u]
        items.append({"title": title, "link": link, "date": date, "url": (big or imgs)[0]})
    if not items:
        raise Fail("Earth Observatory: no picture in the feed")
    i = items[min(offset, len(items) - 1)]
    try:
        d = dt.datetime.strptime(i["date"][:16], "%a, %d %b %Y").strftime("%Y%m%d")
    except ValueError:
        d = ""
    return {"id": "eo-" + safe_id(os.path.basename(urllib.parse.urlsplit(i["url"]).path)), "url": i["url"],
            "title": i["title"], "copyright": "NASA Earth Observatory", "link": i["link"], "date": d}


