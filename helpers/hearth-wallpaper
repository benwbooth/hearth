def cmd_crop(args):
    """Resize and crop SRC to exactly W x H around its most interesting part
    (libvips' attention: edges, skin tones and saturated colour)."""
    src, w, h, dest = args[0], int(args[1]), int(args[2]), args[3]
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part.jpg"
    p = subprocess.run(["vips", "thumbnail", src, part + "[Q=92,optimize_coding]", str(w), "--height", str(h),
                        "--crop", "attention", "--size", "both"], capture_output=True, text=True)
    if p.returncode != 0:
        raise Fail("crop failed: " + p.stderr.strip())
    os.replace(part, dest)
    # Slideshows crop every picture once: keep the newest 200 crops.
    crops = sorted(glob.glob(os.path.join(os.path.dirname(dest), "*.jpg")), key=os.path.getmtime, reverse=True)
    for old in crops[200:]:
        try:
            os.unlink(old)
        except OSError:
            pass
    out({"file": dest, "width": w, "height": h})


def convert_for_qt(src, cache):
    """JPEG XL / HEIC / AVIF pictures Qt may not read: convert once with vips."""
    if not src.lower().endswith((".jxl", ".heic", ".avif", ".tif", ".tiff")):
        return src
    key = hashlib.sha1((src + str(os.path.getmtime(src))).encode()).hexdigest()[:16]
    dest = os.path.join(cache, "converted", key + ".jpg")
    if not os.path.exists(dest):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        p = subprocess.run(["vips", "copy", src, dest + ".part.jpg[Q=94]"], capture_output=True, text=True)
        if p.returncode != 0:
            raise Fail(f"can't read {os.path.basename(src)}: {p.stderr.strip()}")
        os.replace(dest + ".part.jpg", dest)
    return dest


# ---------------------------------------------------------------- dynamic wallpapers
#
# Normalized schedule: {name, kind: "time"|"appearance", frames: [{file,
# start (seconds after midnight when the fade to it begins), fade
# (seconds)}], light, dark, preview}. A frame shows fully from start+fade
# until the next frame's start.

def hhmm(s):
    m = re.match(r"(\d{1,2}):(\d{2})", str(s))
    if not m:
        raise Fail("bad time " + str(s))
    return int(m.group(1)) * 3600 + int(m.group(2)) * 60


def gnome_timed(path, root):
    st = root.find("starttime")
    start = 0
    if st is not None:
        start = int(st.findtext("hour", "0")) * 3600 + int(st.findtext("minute", "0")) * 60 + int(float(st.findtext("second", "0")))
    t = start
    frames = []
    base = os.path.dirname(path)

    def fix(f):
        f = (f or "").strip()
        return f if os.path.exists(f) else os.path.join(base, os.path.basename(f))
    for el in root:
        if el.tag == "static":
            dur = float(el.findtext("duration", "0"))
            f = el.find("file")
            fname = fix(f.findtext("size") if f is not None and f.find("size") is not None else el.findtext("file"))
            if not frames or frames[-1]["file"] != fname:
                frames.append({"file": fname, "start": t % 86400, "fade": 0})
            t += dur
        elif el.tag == "transition":
            dur = float(el.findtext("duration", "0"))
            frames.append({"file": fix(el.findtext("to")), "start": t % 86400, "fade": int(dur)})
            t += dur
    if not frames:
        raise Fail("no frames in " + path)
    return {"kind": "time", "frames": frames}


def sun_altitude(when, lat, lon):
    """Solar elevation in degrees (NOAA's approximation)."""
    utc = when.astimezone(dt.timezone.utc)
    doy = utc.timetuple().tm_yday
    hour = utc.hour + utc.minute / 60
    g = 2 * math.pi / 365 * (doy - 1 + (hour - 12) / 24)
    decl = 0.006918 - 0.399912 * math.cos(g) + 0.070257 * math.sin(g) - 0.006758 * math.cos(2 * g) \
        + 0.000907 * math.sin(2 * g) - 0.002697 * math.cos(3 * g) + 0.00148 * math.sin(3 * g)
    eqt = 229.18 * (0.000075 + 0.001868 * math.cos(g) - 0.032077 * math.sin(g) - 0.014615 * math.cos(2 * g) - 0.040849 * math.sin(2 * g))
    tst = hour * 60 + eqt + 4 * lon
    ha = math.radians(tst / 4 - 180)
    la = math.radians(lat)
    cz = math.sin(la) * math.sin(decl) + math.cos(la) * math.cos(decl) * math.cos(ha)
    return math.degrees(math.asin(max(-1, min(1, cz))))


def heic_dynamic(path, cache, lat, lon):
    data = open(path, "rb").read()
    key = hashlib.sha1((path + str(os.path.getmtime(path))).encode()).hexdigest()[:16]
    d = os.path.join(cache, "heic", key)
    files = sorted(glob.glob(os.path.join(d, "frame-*.jpg")), key=lambda f: int(re.findall(r"(\d+)\.jpg$", f)[0]))
    if not files:
        os.makedirs(d, exist_ok=True)
        tool = shutil.which("heif-dec") or shutil.which("heif-convert")
        if not tool:
            raise Fail("macOS dynamic wallpapers need libheif's heif-dec")
        # Every top-level image, numbered frame-1.jpg, frame-2.jpg ...
        p = subprocess.run([tool, "-q", "92", path, os.path.join(d, "frame.jpg")], capture_output=True, text=True)
        files = sorted(glob.glob(os.path.join(d, "frame*.jpg")))
        if p.returncode != 0 and not files:
            raise Fail("heif-dec: " + p.stderr.strip())
        if len(files) == 1 and not re.search(r"-\d+\.jpg$", files[0]):
            os.replace(files[0], os.path.join(d, "frame-1.jpg"))
        files = sorted(glob.glob(os.path.join(d, "frame-*.jpg")), key=lambda f: int(re.findall(r"(\d+)\.jpg$", f)[0]))
    if not files:
        raise Fail("no pictures in " + os.path.basename(path))

    def plist(attr):
        m = re.search(rb"apple_desktop:" + attr + rb"=\"([A-Za-z0-9+/=]+)\"", data) \
            or re.search(rb"<apple_desktop:" + attr + rb">([A-Za-z0-9+/=]+)</apple_desktop:" + attr + rb">", data)
        if not m:
            return None
        try:
            return plistlib.loads(base64.b64decode(m.group(1)))
        except Exception:
            return None
    res = {"preview": files[0]}
    apr = plist(b"apr")
    if apr and "l" in apr and "d" in apr:
        res.update({"kind": "appearance", "light": files[min(apr["l"], len(files) - 1)],
                    "dark": files[min(apr["d"], len(files) - 1)]})
    h24 = plist(b"h24")
    if h24 and h24.get("ti"):
        frames = [{"file": files[min(e["i"], len(files) - 1)], "start": int(float(e["t"]) * 86400) % 86400, "fade": 1800}
                  for e in h24["ti"]]
        res.update({"kind": "time", "frames": sorted(frames, key=lambda f: f["start"])})
        if apr:
            res["light"], res["dark"] = res.get("light"), res.get("dark")
        return res
    solar = plist(b"solar")
    if solar and solar.get("si"):
        # Pick, for each 10 minutes of today, the picture whose sun altitude
        # is closest (rising pictures in the morning, setting ones after noon).
        today = dt.datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
        noon_alt = max(sun_altitude(today + dt.timedelta(minutes=m), lat, lon) for m in range(0, 1440, 10))
        entries = solar["si"]
        frames = []
        for m in range(0, 1440, 10):
            t = today + dt.timedelta(minutes=m)
            alt = sun_altitude(t, lat, lon)
            morning = m < 720
            best = min(entries, key=lambda e: abs(float(e.get("a", 0)) - alt)
                       + (0 if (float(e.get("z", 180)) < 180) == morning else 15))
            f = files[min(int(best.get("i", 0)), len(files) - 1)]
            if not frames or frames[-1]["file"] != f:
                frames.append({"file": f, "start": m * 60, "fade": 1200})
        res.update({"kind": "time", "frames": frames, "solarDay": today.strftime("%Y%m%d"), "noonAltitude": round(noon_alt, 1)})
        return res
    if "kind" in res:
        return res
    if len(files) >= 2:
        # No metadata: spread the pictures over the day.
        n = len(files)
        res.update({"kind": "time", "frames": [{"file": f, "start": int(i * 86400 / n), "fade": 1800} for i, f in enumerate(files)]})
        return res
    return {"kind": "appearance", "light": files[0], "dark": files[0], "preview": files[0]}


def hearth_json(path):
    j = json.load(open(path))
    base = os.path.dirname(path)
    absf = lambda f: f if os.path.isabs(f) else os.path.join(base, f)
    res = {"name": j.get("name") or os.path.basename(base)}
    if j.get("light") or j.get("dark"):
        res.update({"kind": "appearance", "light": absf(j.get("light") or j.get("dark")), "dark": absf(j.get("dark") or j.get("light"))})
    if j.get("frames"):
        frames = [{"file": absf(f["file"]), "start": hhmm(f["time"]), "fade": int(float(f.get("fade", 30)) * 60)} for f in j["frames"]]
        res.update({"kind": "time", "frames": sorted(frames, key=lambda f: f["start"])})
    if "kind" not in res:
        raise Fail("dynamic.json needs \"frames\" or \"light\"/\"dark\"")
    return res


def load_dynamic(path, cache, index=0, lat=40.0, lon=0.0):
    if os.path.isdir(path):
        for n in ("dynamic.json", "hearth-dynamic.json"):
            if os.path.exists(os.path.join(path, n)):
                return hearth_json(os.path.join(path, n))
        xmls = glob.glob(os.path.join(path, "*.xml"))
        if xmls:
            return load_dynamic(xmls[0], cache, index, lat, lon)
        heics = glob.glob(os.path.join(path, "*.heic"))
        if heics:
            return load_dynamic(heics[0], cache, index, lat, lon)
        raise Fail("no dynamic.json, XML or .heic in " + path)
    low = path.lower()
    if low.endswith(".json"):
        return hearth_json(path)
    if low.endswith((".heic", ".heif")):
        r = heic_dynamic(path, cache, lat, lon)
        r.setdefault("name", os.path.splitext(os.path.basename(path))[0])
        return r
    if low.endswith(".xml"):
        root = ET.parse(path).getroot()
        if root.tag == "background":
            r = gnome_timed(path, root)
            r["name"] = os.path.splitext(os.path.basename(path))[0].replace("-", " ").replace("_", " ").title()
            return r
        if root.tag == "wallpapers":
            wps = [w for w in root.findall("wallpaper") if w.get("deleted") != "true"]
            w = wps[min(index, len(wps) - 1)]
            base = os.path.dirname(path)

            def fix(f):
                f = (f or "").strip()
                if os.path.exists(f):
                    return f
                # nixpkgs points these at /run/current-system/sw; look next
                # to the XML's share dir instead.
                for cand in (os.path.join(base, "..", "backgrounds", "gnome", os.path.basename(f)),
                             os.path.join(base, os.path.basename(f))):
                    if os.path.exists(cand):
                        return os.path.normpath(cand)
                return f
            light, dark = fix(w.findtext("filename")), fix(w.findtext("filename-dark") or w.findtext("filename"))
            if light.lower().endswith(".xml"):
                return load_dynamic(light, cache, 0, lat, lon)
            return {"name": w.findtext("name") or "Wallpaper", "kind": "appearance", "light": light, "dark": dark}
    raise Fail("not a dynamic wallpaper: " + path)


def cmd_dynamic(args):
    path = args.pop(0)
    cache, index, lat, lon = None, 0, None, None
    while args:
        a = args.pop(0)
        if a == "--dir":
            cache = args.pop(0)
        elif a == "--index":
            index = int(args.pop(0))
        elif a == "--lat":
            lat = float(args.pop(0))
        elif a == "--lon":
            lon = float(args.pop(0))
    if lon is None:
        off = dt.datetime.now().astimezone().utcoffset().total_seconds() / 3600
        lon = off * 15
    if lat is None:
        lat = 40.0
    r = load_dynamic(path, cache, index, lat, lon)
    # Qt reads JPEG/PNG/WebP/SVG; convert the rest once.
    for f in r.get("frames", []):
        f["file"] = convert_for_qt(f["file"], cache)
    for k in ("light", "dark", "preview"):
        if r.get(k):
            r[k] = convert_for_qt(r[k], cache)
    r.setdefault("preview", r.get("light") or (r["frames"][len(r["frames"]) // 2]["file"] if r.get("frames") else ""))
    r["path"] = path
    r["index"] = index
    out(r)


def thumb_for(src, cache, size=480):
    """Small JPEG for the Settings grid (Qt can't read JXL/HEIC itself)."""
    if not src or not os.path.exists(src):
        return ""
    if src.lower().endswith((".jpg", ".jpeg", ".png", ".webp")) or not cache:
        return src
    key = hashlib.sha1((src + str(os.path.getmtime(src))).encode()).hexdigest()[:16]
    dest = os.path.join(cache, "thumbs", key + ".jpg")
    if not os.path.exists(dest):
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        p = subprocess.run(["vips", "thumbnail", src, dest + ".part.jpg[Q=85]", str(size)], capture_output=True)
        if p.returncode != 0:
            return ""
        os.replace(dest + ".part.jpg", dest)
    return dest


def cmd_scan_dynamic(args):
    found = []
    cache = None
    if "--dir" in args:
        i = args.index("--dir")
        cache = args[i + 1]
        args = args[:i] + args[i + 2:]
    for d in args:
        d = os.path.expanduser(d)
        if not os.path.isdir(d):
            continue
        for root, dirs, files in os.walk(d):
            if root[len(d):].count(os.sep) > 2:
                dirs[:] = []
            if "dynamic.json" in files:
                try:
                    j = json.load(open(os.path.join(root, "dynamic.json")))
                    first = (j.get("frames") or [{}])[0].get("file") or j.get("light") or ""
                    found.append({"path": root, "index": 0, "name": j.get("name") or os.path.basename(root),
                                  "kind": "time" if j.get("frames") else "appearance",
                                  "preview": first if os.path.isabs(first) else os.path.join(root, first)})
                except (OSError, ValueError):
                    pass
                dirs[:] = []
                continue
            for f in sorted(files):
                p = os.path.join(root, f)
                low = f.lower()
                if low.endswith((".heic", ".heif")):
                    found.append({"path": p, "index": 0, "name": os.path.splitext(f)[0], "kind": "heic", "preview": ""})
                elif low.endswith(".xml"):
                    try:
                        r = ET.parse(p).getroot()
                    except ET.ParseError:
                        continue
                    if r.tag == "background":
                        first = r.find(".//static/file")
                        prev = (first.findtext("size") if first is not None and first.find("size") is not None
                                else (first.text if first is not None else "")) or ""
                        prev = prev.strip()
                        if prev and not os.path.exists(prev):
                            prev = os.path.join(root, os.path.basename(prev))
                        found.append({"path": p, "index": 0, "kind": "time",
                                      "name": os.path.splitext(f)[0].replace("-", " ").replace("_", " ").title(), "preview": prev})
                    elif r.tag == "wallpapers":
                        for i, w in enumerate(x for x in r.findall("wallpaper") if x.get("deleted") != "true"):
                            fn = (w.findtext("filename") or "").strip()
                            if fn.lower().endswith(".xml"):
                                continue    # the timed XML itself is found on its own
                            dark = w.findtext("filename-dark")
                            prev = fn if os.path.exists(fn) else os.path.normpath(os.path.join(root, "..", "backgrounds", "gnome", os.path.basename(fn)))
                            found.append({"path": p, "index": i, "name": w.findtext("name") or f,
                                          "kind": "appearance" if dark else "still", "preview": prev})
    # Dedupe by name+preview (several share dirs list the same sets).
    seen, res = set(), []
    for f in found:
        k = (f["name"], os.path.basename(f["preview"] or f["path"]))
        if k in seen:
            continue
        seen.add(k)
        f["preview"] = thumb_for(f["preview"] or (f["path"] if f["kind"] == "heic" else ""), cache)
        res.append(f)
    out(res)


