def cmd_scan_folder(args):
    d = os.path.expanduser(args[0])
    recursive = "--recursive" in args
    files = []
    if os.path.isdir(d):
        for root, dirs, fs in os.walk(d):
            dirs[:] = sorted(x for x in dirs if not x.startswith(".")) if recursive else []
            files += [os.path.join(root, f) for f in sorted(fs) if f.lower().endswith(IMAGE_EXT) and not f.startswith(".")]
    out({"folder": d, "files": files})


def cmd_poster(args):
    video, dest = args[0], args[1]
    if os.path.exists(dest) and os.path.getmtime(dest) >= os.path.getmtime(video):
        out({"file": dest})
        return
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part.jpg"
    for ss in ("1", "0"):
        p = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", ss, "-i", video, "-frames:v", "1",
                            "-q:v", "3", part], capture_output=True, text=True)
        if p.returncode == 0 and os.path.exists(part) and os.path.getsize(part):
            os.replace(part, dest)
            out({"file": dest})
            return
    raise Fail("ffmpeg: " + p.stderr.strip())


# ---------------------------------------------------------------- shaders

SHADER_HEAD = """#version 440
// Generated by hearth-wallpaper from a Shadertoy-style shader.
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 hearth_fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    float iTime;
    vec2 res;
    float dark;
};
#define iResolution vec3(res, 1.0)
#define iMouse vec4(0.0)
#define iFrame int(iTime * 60.0)
#define iTimeDelta (1.0 / 60.0)
#define iDate vec4(0.0)
#define texture2D texture
"""

SHADER_TAIL = """
void main() {
    vec4 c = vec4(0.0, 0.0, 0.0, 1.0);
    mainImage(c, vec2(qt_TexCoord0.x, 1.0 - qt_TexCoord0.y) * res);
    hearth_fragColor = vec4(c.rgb, 1.0) * qt_Opacity;
}
"""


def cmd_shader(args):
    src, dest = args[0], args[1]
    code = open(src, encoding="utf-8").read()
    if "iChannel" in code:
        raise Fail("this shader reads textures (iChannel), which hearth doesn't provide")
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    if re.search(r"^\s*#version", code, re.M) and "qt_TexCoord0" in code:
        frag = code     # already a Qt Quick fragment shader
    else:
        code = re.sub(r"^\s*#version.*$", "", code, flags=re.M)
        code = re.sub(r"^\s*precision\s+\w+\s+float\s*;", "", code, flags=re.M)
        frag = SHADER_HEAD + code + SHADER_TAIL
    with tempfile.TemporaryDirectory() as td:
        f = os.path.join(td, "shader.frag")
        open(f, "w").write(frag)
        qsb = shutil.which("qsb") or "qsb"
        p = subprocess.run([qsb, "--qt6", "-o", dest + ".part", f], capture_output=True, text=True)
        if p.returncode != 0:
            raise Fail("shader didn't compile: " + (p.stderr or p.stdout).strip()[-600:])
    os.replace(dest + ".part", dest)
    out({"file": dest})


# ---------------------------------------------------------------- secrets
#
# API keys: the Secret Service (KWallet or GNOME Keyring) via secret-tool;
# without one, a 0600 file in ~/.config/hearth.

def secret_file():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hearth", "wallpaper-keys.json")


def secret_get(name):
    try:
        p = subprocess.run(["secret-tool", "lookup", "application", "hearth", "key", name],
                           capture_output=True, text=True, timeout=10)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        return json.load(open(secret_file())).get(name, "")
    except (OSError, ValueError):
        return ""


def cmd_secret(args):
    op, name = args[0], args[1]
    if op == "get":
        out({"name": name, "set": bool(secret_get(name))})
        return
    path = secret_file()
    try:
        data = json.load(open(path))
    except (OSError, ValueError):
        data = {}
    if op == "delete":
        subprocess.run(["secret-tool", "clear", "application", "hearth", "key", name], capture_output=True)
        data.pop(name, None)
        where = "removed"
    else:
        value = sys.stdin.read().strip()
        where = "file"
        try:
            p = subprocess.run(["secret-tool", "store", "--label", f"hearth wallpaper: {name} API key",
                                "application", "hearth", "key", name], input=value, capture_output=True, text=True, timeout=20)
            if p.returncode == 0:
                where = "keyring"
                data.pop(name, None)
        except (OSError, subprocess.TimeoutExpired):
            pass
        if where == "file":
            data[name] = value
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(path + ".tmp", path)
    out({"name": name, "stored": where})


# ---------------------------------------------------------------- export

def cmd_export(args):
    """Copy the current wallpaper where the lock and login screens read it.

    JSONFILE is ~/.cache/hearth/wallpaper.json (already written by the
    shell). With --system DIR (default /var/lib/hearth/wallpaper) the still
    (and a video under 1 GB) are copied there with wallpaper.json pointing at
    the copies, readable by the greeter user. A missing or read-only DIR is
    reported, not an error."""
    src = args[0]
    sysdir = "/var/lib/hearth/wallpaper"
    if "--system" in args:
        sysdir = args[args.index("--system") + 1]
    if "--data" in args:
        j = json.loads(args[args.index("--data") + 1])
        os.makedirs(os.path.dirname(src), exist_ok=True)
        with open(src + ".tmp", "w") as f:
            json.dump(j, f, indent=2)
        os.replace(src + ".tmp", src)
    else:
        j = json.load(open(src))
    status = {"system": "off"}
    if j.get("lockScreen") is False:
        out(status)
        return
    if not os.path.isdir(sysdir):
        status["system"] = "missing"
        out(status)
        return
    if not os.access(sysdir, os.W_OK):
        status["system"] = "not-writable"
        out(status)
        return
    os.umask(0o002)
    res = dict(j)

    def copy(path, name):
        if not path or not os.path.isfile(path):
            return ""
        ext = os.path.splitext(path)[1].lower() or ".jpg"
        dest = os.path.join(sysdir, name + ext)
        try:
            same = os.path.exists(dest) and os.path.getsize(dest) == os.path.getsize(path) \
                and os.path.getmtime(dest) >= os.path.getmtime(path)
        except OSError:
            same = False
        if not same:
            shutil.copyfile(path, dest + ".part")
            os.chmod(dest + ".part", 0o664)
            os.replace(dest + ".part", dest)
        # Remove stale copies with other extensions.
        for old in glob.glob(os.path.join(sysdir, name + ".*")):
            if old != dest and not old.endswith(".json"):
                try:
                    os.unlink(old)
                except OSError:
                    pass
        return dest
    res["path"] = copy(j.get("path"), "wallpaper")
    video = j.get("video") or ""
    if video and os.path.isfile(video) and os.path.getsize(video) < (1 << 30):
        res["video"] = copy(video, "video")
    else:
        res["video"] = ""
        for old in glob.glob(os.path.join(sysdir, "video.*")):
            try:
                os.unlink(old)
            except OSError:
                pass
    if j.get("shader") and os.path.isfile(j["shader"]):
        res["shader"] = copy(j["shader"], "shader")
    tmp = os.path.join(sysdir, ".wallpaper.json.tmp")
    with open(tmp, "w") as f:
        json.dump(res, f, indent=2)
    os.chmod(tmp, 0o664)
    os.replace(tmp, os.path.join(sysdir, "wallpaper.json"))
    status["system"] = "ok"
    status["dir"] = sysdir
    out(status)


COMMANDS = {
    "fetch": cmd_fetch, "crop": cmd_crop, "dynamic": cmd_dynamic, "scan-dynamic": cmd_scan_dynamic,
    "scan-we": cmd_scan_we, "scan-media": cmd_scan_media, "scan-folder": cmd_scan_folder, "poster": cmd_poster,
    "shader": cmd_shader, "secret": cmd_secret, "export": cmd_export,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.stderr.write(__doc__)
        sys.exit(2)
    try:
        COMMANDS[sys.argv[1]](sys.argv[2:])
    except Fail as e:
        out({"error": str(e)})
        sys.exit(1)
    except Exception as e:     # keep the shell informed, never a traceback only
        out({"error": f"{type(e).__name__}: {e}"})
        sys.exit(1)


if __name__ == "__main__":
    main()
