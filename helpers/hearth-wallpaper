    url = f"https://cdn.star.nesdis.noaa.gov/{sat}/ABI/FD/GEOCOLOR/5424x5424.jpg"
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d%H%M")
    return {"id": f"noaa-{sat}-{stamp[:11]}", "url": url,
            "title": f"Earth right now from {names.get(sat, sat)}",
            "copyright": "NOAA / NESDIS STAR (GeoColor)",
            "link": f"https://www.star.nesdis.noaa.gov/GOES/fulldisk.php?sat=G{sat[4:]}",
            "date": stamp[:8], "fit": "fit"}


def p_stalenhag(o, offset, seen, minsize):
    entry = get_json("https://raw.githubusercontent.com/a-andreyev/simonstalenhag-se-metadata/main/entrypoint.json")
    pool = []
    for url in entry.get("simonstalenhag-se-entrypoint", []):
        if not url.startswith("https://"):
            continue
        try:
            pool += get_json(url).get("simonstalenhag.se", [])
        except Fail:
            pass
    pool = [p for p in pool if p.get("imagebig")]
    if not pool:
        raise Fail("Simon Stålenhag: no pictures")
    fresh = [p for p in pool if "ss-" + safe_id(p.get("name", "")) not in seen] or pool
    p = random.choice(fresh)
    url = p["imagebig"].replace("http://", "https://", 1)
    title = p.get("name", "")
    if p.get("section"):
        title = p["section"].title() + " – " + title
    return {"id": "ss-" + safe_id(p.get("name", "")), "url": url, "title": title,
            "copyright": "Simon Stålenhag", "link": "https://www.simonstalenhag.se/", "date": ""}


def p_davidrevoy(o, offset, seen, minsize):
