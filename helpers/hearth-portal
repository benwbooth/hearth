            out.append({"id": str(c), "name": info.get_display_name() or info.get_name(), "icon": app_icon(info),
                        "comment": info.get_description() or ""})
        # Two apps with one name (a Flatpak and a system copy): say which.
        names = [a["name"] for a in out]
        for a in out:
            if names.count(a["name"]) > 1:
                a["comment"] = (a["comment"] + " · " if a["comment"] else "") + a["id"]
        return out

