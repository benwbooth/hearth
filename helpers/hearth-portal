# --- helpers for the interfaces ------------------------------------------------------

def type_name(ctype):
    if not ctype:
        return ""
    if ctype.startswith("x-scheme-handler/"):
        return ctype.split("/", 1)[1] + " link"
    return Gio.content_type_get_description(ctype)


def target_name(target):
    """What the sheet calls the thing being opened: a file's name, a link's host."""
    if not target:
        return ""
    u = urllib.parse.urlparse(target)
    if u.scheme and u.scheme != "file" and u.netloc:
        return u.netloc
    return os.path.basename(urllib.parse.unquote(u.path if u.scheme == "file" else target).rstrip("/"))


def user_info():
    pw = pwd.getpwuid(os.getuid())
    name = pw.pw_gecos.split(",")[0] if pw.pw_gecos else ""
    image = ""
    try:
        sysbus = dbus.SystemBus()
        acc = sysbus.get_object("org.freedesktop.Accounts", "/org/freedesktop/Accounts")
        path = acc.FindUserByName(pw.pw_name, dbus_interface="org.freedesktop.Accounts", timeout=3)
        u = sysbus.get_object("org.freedesktop.Accounts", path)
        p = u.GetAll("org.freedesktop.Accounts.User", dbus_interface=PROPS, timeout=3)
        name = str(p.get("RealName") or name)
        icon = str(p.get("IconFile") or "")
        if icon and os.path.isfile(icon):
            image = icon
    except Exception as e:
        log("AccountsService:", e)
    if not image:
        for f in (os.path.expanduser("~/.face"), os.path.expanduser("~/.face.icon")):
            if os.path.isfile(f):
                image = f
                break
    return {"id": pw.pw_name, "name": name or pw.pw_name, "image": image}


def mailto_uri(o):
    q = urllib.parse.quote
    to = list(o.get("addresses") or [])
    if o.get("address"):
        to.insert(0, o["address"])
    params = []
    for k in ("cc", "bcc"):
        if o.get(k):
            params.append((k, ",".join(o[k])))
    for k in ("subject", "body"):
        if o.get(k):
            params.append((k, o[k]))
    for a in o.get("attachments") or []:
        params.append(("attach", a))
    uri = "mailto:" + ",".join(q(a, safe="@") for a in to)
    if params:
        uri += "?" + "&".join("%s=%s" % (k, q(v, safe="")) for k, v in params)
    return uri


def mail_app():
    """almanac when it handles mailto:, else the default mail app."""
    apps = Gio.AppInfo.get_all_for_type("x-scheme-handler/mailto")
    for a in apps:
        if "almanac" in (a.get_id() or "").lower():
            return a
    return Gio.AppInfo.get_default_for_uri_scheme("mailto") or (apps[0] if apps else None)


def spawn_detached(argv):
    """Start a program in its own systemd scope, so it outlives this service."""
    try:
        subprocess.Popen(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--"] + argv,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        try:
            subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True)
            return True
        except OSError as e:
            log("launch:", e)
            return False


def open_mailto(uri):
    app = mail_app()
    if app is None:
        log("no mail app for", uri)
        return False
    path = app.get_filename() if isinstance(app, DesktopAppInfo) else None
    if path:
        return spawn_detached(["gio", "launch", path, uri])
    return spawn_detached(["xdg-open", uri])


def list_printers():
    try:
        out = subprocess.run(["hearth-printers", "list"], capture_output=True, text=True, timeout=10).stdout
        data = json.loads(out.strip().splitlines()[-1])
    except Exception as e:
        log("printers:", e)
        return {"default": "", "printers": []}
    printers = []
    for p in data.get("printers", []):
        printers.append({"value": p.get("name", ""), "label": p.get("info") or p.get("name", ""),
                         "state": p.get("state", ""), "media": printer_media(p.get("name", ""))})
    return {"default": data.get("default") or (printers[0]["value"] if printers else ""), "printers": printers}


def printer_media(name):
    try:
        out = subprocess.run(["lpoptions", "-p", name], capture_output=True, text=True, timeout=5).stdout
        for tok in shlex.split(out):
            if tok.startswith("media="):
                return tok.split("=", 1)[1]
    except Exception:
        pass
    return ""


PAPER = {  # PWG self-describing name -> (GTK/PPD name, label, width mm, height mm)
    "na_letter_8.5x11in": ("Letter", "US Letter", 215.9, 279.4),
    "na_legal_8.5x14in": ("Legal", "US Legal", 215.9, 355.6),
    "iso_a4_210x297mm": ("A4", "A4", 210.0, 297.0),
    "iso_a5_148x210mm": ("A5", "A5", 148.0, 210.0),
    "iso_a3_297x420mm": ("A3", "A3", 297.0, 420.0),
}


def paper_for(media):
    if media in PAPER:
        return PAPER[media]
    # Any other PWG name: its last part is the size ("4x6in", "100x150mm").
    size = media.rsplit("_", 1)[-1] if media else ""
    for unit, mm in (("in", 25.4), ("mm", 1.0)):
        if size.endswith(unit):
            try:
                w, h = (float(x) * mm for x in size[:-len(unit)].split("x"))
                return (media, media, w, h)
            except ValueError:
                pass
    return PAPER["na_letter_8.5x11in"]


def gtk_print_settings(job):
    s = {"printer": job["printer"], "n-copies": str(job["copies"]),
         "orientation": job["orientation"], "output-file-format": "pdf"}
    if job["pages"]:
        s["print-pages"] = "ranges"
        # GTK's page ranges count from 0.
        s["page-ranges"] = ",".join(gtk_ranges(job["pages"]))
    else:
        s["print-pages"] = "all"
    if job["duplex"]:
        s["duplex"] = {"long": "vertical", "short": "horizontal"}.get(job["duplex"], "simplex")
    return {k: dbus.String(v) for k, v in s.items()}


def gtk_ranges(pages):
    """ "1-3,5" (pages as people count them) -> ["0-2", "4"]."""
    out = []
    for part in pages.split(","):
        a, dash, b = part.partition("-")
        try:
            lo = int(a)
            hi = int(b) if dash and b else lo
        except ValueError:
            continue
        out.append("%d-%d" % (lo - 1, hi - 1) if hi != lo else "%d" % (lo - 1))
    return out


def gtk_page_setup(job):
    name, label, w, h = paper_for(job.get("media", ""))
    m = 6.35
    return {"PPDName": dbus.String(name), "Name": dbus.String(name), "DisplayName": dbus.String(label),
            "Width": dbus.Double(w), "Height": dbus.Double(h),
            "MarginTop": dbus.Double(m), "MarginBottom": dbus.Double(m),
            "MarginLeft": dbus.Double(m), "MarginRight": dbus.Double(m),
            "Orientation": dbus.String(job["orientation"])}


def run_print(fd, title, job):
    """Send the app's document (already laid out by it, only the chosen pages)
    to CUPS with lp."""
    argv = ["lp", "-d", job["printer"], "-n", str(job["copies"]), "-t", title or "Document"]
    if job["duplex"] in ("long", "short"):
        argv += ["-o", "sides=two-sided-%s-edge" % job["duplex"]]
    elif job["duplex"] == "none":
        argv += ["-o", "sides=one-sided"]
    if job.get("color") is False:
        argv += ["-o", "print-color-mode=monochrome"]
    try:
        os.lseek(fd, 0, os.SEEK_SET)
    except OSError:
        pass
    try:
        r = subprocess.run(argv, stdin=fd, capture_output=True, text=True, timeout=60)
        log("print:", " ".join(argv), "->", (r.stdout or r.stderr).strip())
        return r.returncode == 0
    except Exception as e:
        log("lp:", e)
        return False


# --- the relay hearth runs -------------------------------------------------------------

class Relay(dbus.service.Object):
    @dbus.service.method(UI_IFACE, in_signature="s", out_signature="")
    def Show(self, text):
        emit_line(str(text))

    @dbus.service.method(UI_IFACE, in_signature="i", out_signature="")
    def Dismiss(self, rid):
        emit_line(json.dumps({"id": int(rid), "type": "close"}))


def emit_line(text):
    try:
        print(text, flush=True)
    except BrokenPipeError:
        GLib.idle_add(loop.quit)


def run_relay(backend_name):
    relay = Relay(bus, UI_PATH)
    name = dbus.service.BusName(UI_NAME, bus, do_not_queue=True)

    def on_stdin(source, condition):
        line = sys.stdin.readline()
        if line.strip():
            try:
                msg = json.loads(line)
                rid = int(msg.pop("id"))
            except (ValueError, KeyError, TypeError):
                log("bad answer line")
                return True
            bus.get_object(backend_name, PATH).Answer(
                dbus.Int32(rid), json.dumps(msg), dbus_interface=BACKEND_IFACE,
                reply_handler=lambda: None, error_handler=lambda e: log("Answer:", e))
        if not line or condition & (GLib.IO_HUP | GLib.IO_ERR):
            loop.quit()
            return False
        return True

    GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, on_stdin)
    log("dialog relay up as", bus.get_unique_name())
    return relay, name


ui = None


def main():
    global bus, loop, ui
    mode = sys.argv[1] if len(sys.argv) > 1 else "serve"
    name = BUS_NAME
    if "--name" in sys.argv:
        name = sys.argv[sys.argv.index("--name") + 1]
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    loop = GLib.MainLoop()
    if mode == "ui":
        keep = run_relay(name)
    elif mode == "serve":
        ui = UiLink()
        keep = Backend()
        bus_name = dbus.service.BusName(name, bus, do_not_queue=True)
        log("serving", name)
    else:
        sys.exit(__doc__)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass


