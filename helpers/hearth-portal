# --- GVariant <-> dbus-python -----------------------------------------------

def gv_to_dbus(v, level=0):
    """A GLib.Variant as the dbus-python value that sends the same type."""
    t = v.get_type_string()
    simple = {"b": dbus.Boolean, "y": dbus.Byte, "n": dbus.Int16, "q": dbus.UInt16,
              "i": dbus.Int32, "u": dbus.UInt32, "x": dbus.Int64, "t": dbus.UInt64,
              "d": dbus.Double, "s": dbus.String, "o": dbus.ObjectPath, "g": dbus.Signature}
    if t in simple:
        return simple[t](v.unpack(), variant_level=level)
    if t == "v":
        return gv_to_dbus(v.get_variant(), level + 1)
    if t == "ay":
        return dbus.ByteArray(bytes(v.unpack()), variant_level=level)
    if t.startswith("a{"):
        sig = t[2:-1]
        d = {}
        for i in range(v.n_children()):
            e = v.get_child_value(i)
            d[gv_to_dbus(e.get_child_value(0))] = gv_to_dbus(e.get_child_value(1))
        return dbus.Dictionary(d, signature=sig, variant_level=level)
    if t.startswith("a"):
        return dbus.Array([gv_to_dbus(v.get_child_value(i)) for i in range(v.n_children())],
                          signature=t[1:], variant_level=level)
    if t.startswith("("):
        return dbus.Struct([gv_to_dbus(v.get_child_value(i)) for i in range(v.n_children())],
                           variant_level=level)
    if t.startswith("m"):
        return gv_to_dbus(v.get_maybe(), level) if v.get_maybe() is not None else dbus.String("", variant_level=level)
    raise TypeError("unsupported GVariant type " + t)


def plain(v):
    """dbus-python value -> plain Python (for JSON and checks)."""
    if isinstance(v, dbus.Boolean):
        return bool(v)
    if isinstance(v, (dbus.Byte, dbus.Int16, dbus.UInt16, dbus.Int32, dbus.UInt32, dbus.Int64, dbus.UInt64)):
        return int(v)
    if isinstance(v, dbus.Double):
        return float(v)
    if isinstance(v, (dbus.String, dbus.ObjectPath, dbus.Signature)):
        return str(v)
    if isinstance(v, dbus.ByteArray):
        return bytes(v)
    if isinstance(v, dict):
        return {plain(k): plain(x) for k, x in v.items()}
    if isinstance(v, (list, tuple)):
        if v and all(isinstance(x, dbus.Byte) for x in v):
            return bytes(int(x) for x in v)
        return [plain(x) for x in v]
    return v


def icon_from_serialized(v, cache_dir):
    """A serialized GIcon (('themed', ['name']), ('file', 'uri'), ('bytes', ay))
    -> an icon name or a file path hearth can show, or ""."""
    try:
        v = plain(v)
        if isinstance(v, (list, tuple)) and len(v) == 2:
            kind, data = v
            if kind == "themed" and data:
                return data[0] if isinstance(data, list) else str(data)
            if kind == "file":
                return Gio.File.new_for_uri(data).get_path() or ""
            if kind == "bytes" and isinstance(data, (bytes, bytearray)):
                os.makedirs(cache_dir, exist_ok=True)
                path = os.path.join(cache_dir, hashlib.sha1(data).hexdigest()[:16])
                if not os.path.exists(path):
                    with open(path, "wb") as f:
                        f.write(data)
                return path
        if isinstance(v, str):
            return v
    except Exception as e:
        log("icon:", e)
    return ""


def app_info(app_id):
    if not app_id:
        return None
    try:
        return DesktopAppInfo.new(app_id + ".desktop")
    except TypeError:
        return None


def app_label(app_id):
    info = app_info(app_id)
    if info:
        return info.get_display_name() or info.get_name()
    if app_id:
        return app_id.rsplit(".", 1)[-1]
    return "An app"


def app_icon(info):
    if not info:
        return ""
    icon = info.get_icon()
    if isinstance(icon, Gio.ThemedIcon):
        names = icon.get_names()
        return names[0] if names else ""
    if isinstance(icon, Gio.FileIcon):
        return icon.get_file().get_path() or ""
    return icon.to_string() if icon else ""


def runtime_dir(*parts):
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, "hearth-portal", *parts)


# --- dconf (org.gnome.* settings) -----------------------------------------------

class Dconf:
    """The org.gnome.* keys set in dconf, read with `dconf dump` and kept up
    to date by a `dconf watch` child. Unset keys are left out: GTK uses its
    own defaults for them, as with GNOME's backend minus schema defaults."""

    def __init__(self, on_change):
        self.values = {}  # namespace -> {key: GLib.Variant}
        self.on_change = on_change
        self.timer = 0
        self.reload(initial=True)
        self.watch()

    def dump(self):
        try:
            text = subprocess.run(["dconf", "dump", "/org/gnome/"], capture_output=True, text=True,
                                  timeout=5).stdout
        except Exception as e:
            log("dconf dump:", e)
            return {}
        out, ns = {}, None
        for line in text.splitlines():
            if line.startswith("[") and line.endswith("]"):
                sect = line[1:-1].strip("/")
                ns = "org.gnome" + ("." + sect.replace("/", ".") if sect else "")
                out.setdefault(ns, {})
            elif ns and "=" in line:
                k, val = line.split("=", 1)
                try:
                    out[ns][k] = GLib.Variant.parse(None, val, None, None)
                except GLib.Error:
                    pass
        return out

    def reload(self, initial=False):
        self.timer = 0
        new = self.dump()
        old = self.values
        self.values = new
        if initial:
            return False
        for ns in set(old) | set(new):
            for k in set(old.get(ns, {})) | set(new.get(ns, {})):
                a, b = old.get(ns, {}).get(k), new.get(ns, {}).get(k)
                if b is not None and (a is None or not a.equal(b)):
                    self.on_change(ns, k, b)
        return False

    def watch(self):
        try:
            proc = Gio.Subprocess.new(["dconf", "watch", "/org/gnome/"],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as e:
            log("no dconf watch:", e.message)
            return
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def got(src, res):
            try:
                line, _ = src.read_line_finish_utf8(res)
            except GLib.Error:
                line = None
            if line is None:
                GLib.timeout_add_seconds(5, lambda: (self.watch(), False)[1])
                return
            if not self.timer:
                self.timer = GLib.timeout_add(200, self.reload)
            src.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    def get(self, path, key, default=None):
        v = self.values.get(path, {}).get(key)
        return v.unpack() if v is not None else default


# --- hearth's appearance ------------------------------------------------------------

def hex_to_rgb(text):
    t = (text or "").lstrip("#")
    if len(t) == 8:  # #AARRGGBB (Qt)
        t = t[2:]
    if len(t) != 6:
        return None
    try:
        return tuple(int(t[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    except ValueError:
        return None


class Appearance:
    """hearth's light/dark and accent, from the state file hearth-color-scheme
    writes on every change; dconf's color-scheme before hearth ever ran."""

    def __init__(self, dconf, on_change):
        self.dconf = dconf
        self.on_change = on_change
        self.state = {}
        self.read()
        d = Gio.File.new_for_path(os.path.dirname(STATE_FILE))
        try:
            d.make_directory_with_parents(None)
        except GLib.Error:
            pass
        self.monitor = d.monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.connect("changed", self.changed)

    def read(self):
        try:
            with open(STATE_FILE) as f:
                s = json.load(f)
            self.state = s if isinstance(s, dict) else {}
        except (OSError, ValueError):
            self.state = {}

    def changed(self, _m, f, other, _event):
        names = {x.get_basename() for x in (f, other) if x}
        if os.path.basename(STATE_FILE) not in names:
            return
        before = self.values()
        self.read()
        after = self.values()
        for k, v in after.items():
            if k not in before or before[k] != v:
                self.on_change(APPEARANCE, k, v)

    def values(self):
        mode = self.state.get("mode")
        if mode not in ("dark", "light"):
            cs = self.dconf.get("org.gnome.desktop.interface", "color-scheme", "default")
            mode = {"prefer-dark": "dark", "prefer-light": "light"}.get(cs, "")
        out = {"color-scheme": dbus.UInt32({"dark": 1, "light": 2}.get(mode, 0))}
        rgb = hex_to_rgb(self.state.get("accent", ""))
        if rgb:
            out["accent-color"] = dbus.Struct([dbus.Double(c) for c in rgb], signature="ddd")
        out["contrast"] = dbus.UInt32(1 if self.state.get("contrast") else 0)
        anim = self.dconf.get("org.gnome.desktop.interface", "enable-animations", True)
        out["reduced-motion"] = dbus.UInt32(1 if (self.state.get("reducedMotion") or not anim) else 0)
        return out


# --- requests ---------------------------------------------------------------------

class Request(dbus.service.Object):
    """The Request object xdg-desktop-portal closes when the app gives up."""

    def __init__(self, handle, on_close):
        super().__init__(bus, handle)
        self.on_close = on_close
        self.closed = False

    @dbus.service.method(REQUEST, in_signature="", out_signature="")
    def Close(self):
        if not self.closed:
            self.closed = True
            self.on_close()
        self.drop()

    def drop(self):
        try:
            self.remove_from_connection()
        except LookupError:
            pass


class UiLink:
    """Talks to the dialog relay (`hearth-portal ui`) when hearth runs one."""

    def __init__(self):
        self.ids = itertools.count(1)
        self.pending = {}  # id -> callback(answer dict or None)
        self.owner = None
        bus.watch_name_owner(UI_NAME, self.owner_changed)

    def owner_changed(self, owner):
        self.owner = owner or None
        if not owner:
            for cb in list(self.pending.values()):
                cb(None)
            self.pending.clear()

    def ask(self, kind, payload, cb):
        """Show a dialog; cb(answer) later (None: no answer). Returns the id,
        or None when no hearth is there to ask."""
        if not self.owner:
            return None
        rid = next(self.ids)
        self.pending[rid] = cb
        msg = dict(payload, id=rid, type=kind)
        bus.get_object(self.owner, UI_PATH, introspect=False).Show(
            json.dumps(msg), dbus_interface=UI_IFACE,
            reply_handler=lambda: None,
            error_handler=lambda e: self.answer(rid, None))
        return rid

    def update(self, rid, payload):
        if self.owner and rid in self.pending:
            msg = dict(payload, id=rid, type="update")
            bus.get_object(self.owner, UI_PATH, introspect=False).Show(
                json.dumps(msg), dbus_interface=UI_IFACE,
                reply_handler=lambda: None, error_handler=lambda e: None)

    def dismiss(self, rid):
        cb = self.pending.pop(rid, None)
        if self.owner:
            bus.get_object(self.owner, UI_PATH, introspect=False).Dismiss(
                dbus.Int32(rid), dbus_interface=UI_IFACE,
                reply_handler=lambda: None, error_handler=lambda e: None)
        return cb

    def answer(self, rid, ans):
        cb = self.pending.pop(rid, None)
        if cb:
            cb(ans)


def dialog(handle, kind, payload, finish, reply, error, threaded=False):
    """Run one portal request through a hearth dialog.

    finish(answer) -> (response, results) for an answer from the sheet; with
    threaded=True it runs on a worker thread (slow work: printing), so
    other portal calls (Settings reads at every app start) never wait.
    reply/error are the D-Bus method's async callbacks."""
    state = {"done": False, "rid": None}

    def send(resp, results):
        if state["done"]:
            return
        state["done"] = True
        req.drop()
        try:
            reply(dbus.UInt32(resp), dbus.Dictionary(results, signature="sv"))
        except Exception as e:
            log("reply:", e)

    def answered(ans):
        if ans is None or int(ans.get("response", ENDED)) != OK:
            send(CANCELLED if ans is not None else ENDED, {})
            return
        def work():
            try:
                return finish(ans)
            except Exception as e:
                log(kind, "answer failed:", e)
                return ENDED, {}

        if threaded:
            threading.Thread(target=lambda: GLib.idle_add(lambda r: (send(*r), False)[1], work()),
                             daemon=True).start()
        else:
            send(*work())

    def closed():
        if state["rid"] is not None:
            ui.dismiss(state["rid"])
        send(ENDED, {})

    req = Request(handle, closed)
    state["rid"] = ui.ask(kind, payload, answered)
    if state["rid"] is None:
        log(kind, "asked with no hearth running: cancelled")
        send(ENDED, {})
    state["send"] = send
    return state


# --- the backend ---------------------------------------------------------------------

def props(**kw):
    return dbus.Dictionary(kw, signature="sv")


class Backend(dbus.service.Object):
    INTERFACES = {
        IMPL + "Settings": {"version": dbus.UInt32(1)},
        IMPL + "Notification": {"version": dbus.UInt32(1)},
        IMPL + "Lockdown": None,  # computed
        IMPL + "Account": {"version": dbus.UInt32(1)},
        IMPL + "Access": {"version": dbus.UInt32(1)},
        IMPL + "AppChooser": {"version": dbus.UInt32(2)},
        IMPL + "Email": {"version": dbus.UInt32(3)},
        IMPL + "DynamicLauncher": {"version": dbus.UInt32(1), "SupportedLauncherTypes": dbus.UInt32(3)},
        IMPL + "Print": {"version": dbus.UInt32(1)},
    }

    def __init__(self):
        super().__init__(bus, PATH)
        self.dconf = Dconf(self.dconf_changed)
        self.appearance = Appearance(self.dconf, self.setting_changed)
        self.lockdown_last = self.lockdown()
        self.notes = {}       # (app_id, id) -> fdo id
        self.notes_back = {}  # fdo id -> (app_id, id, {action key: (action, target)})
        self.print_tokens = {}
        self.print_token_ids = itertools.count(1)
        bus.add_signal_receiver(self.fdo_action, "ActionInvoked", "org.freedesktop.Notifications",
                                path="/org/freedesktop/Notifications")
        bus.add_signal_receiver(self.fdo_closed, "NotificationClosed", "org.freedesktop.Notifications",
                                path="/org/freedesktop/Notifications")

    # -- Properties --------------------------------------------------------------

    def lockdown(self):
        lk, pv = "org.gnome.desktop.lockdown", "org.gnome.desktop.privacy"
        g = self.dconf.get
        return {
            "disable-printing": dbus.Boolean(g(lk, "disable-printing", False)),
            "disable-save-to-disk": dbus.Boolean(g(lk, "disable-save-to-disk", False)),
            "disable-application-handlers": dbus.Boolean(g(lk, "disable-application-handlers", False)),
            "disable-location": dbus.Boolean(not g("org.gnome.system.location", "enabled", True)),
            "disable-camera": dbus.Boolean(g(pv, "disable-camera", False)),
            "disable-microphone": dbus.Boolean(g(pv, "disable-microphone", False)),
            "disable-sound-output": dbus.Boolean(g(pv, "disable-sound-output", False)),
            "version": dbus.UInt32(1),
        }

    def all_props(self, iface):
        if iface == IMPL + "Lockdown":
            return self.lockdown()
        p = self.INTERFACES.get(iface)
        if p is None:
            raise dbus.DBusException("No such interface " + iface, name="org.freedesktop.DBus.Error.UnknownInterface")
        return p

    @dbus.service.method(PROPS, in_signature="ss", out_signature="v")
    def Get(self, iface, prop):
        p = self.all_props(str(iface))
        if str(prop) not in p:
            raise dbus.DBusException("No such property " + prop, name="org.freedesktop.DBus.Error.UnknownProperty")
        return p[str(prop)]

    @dbus.service.method(PROPS, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return dbus.Dictionary(self.all_props(str(iface)), signature="sv")

    @dbus.service.method(PROPS, in_signature="ssv", out_signature="")
    def Set(self, iface, prop, value):
        raise dbus.DBusException("Read-only", name="org.freedesktop.DBus.Error.PropertyReadOnly")

    @dbus.service.signal(PROPS, signature="sa{sv}as")
    def PropertiesChanged(self, iface, changed, invalidated):
        pass

    # -- Settings ---------------------------------------------------------------

    def namespaces(self):
        out = {APPEARANCE: self.appearance.values()}
        for ns, keys in self.dconf.values.items():
            out[ns] = {k: gv_to_dbus(v) for k, v in keys.items()}
        return out

    @staticmethod
    def wanted(ns, patterns):
        if not patterns:
            return True
        for p in patterns:
            p = str(p)
            if p == "" or p == ns or (p.endswith("*") and ns.startswith(p[:-1])):
                return True
        return False

    @dbus.service.method(IMPL + "Settings", in_signature="as", out_signature="a{sa{sv}}")
    def ReadAll(self, patterns):
        return dbus.Dictionary({ns: dbus.Dictionary(v, signature="sv")
                                for ns, v in self.namespaces().items() if self.wanted(ns, patterns)},
                               signature="sa{sv}")

    @dbus.service.method(IMPL + "Settings", in_signature="ss", out_signature="v")
    def Read(self, ns, key):
        v = self.namespaces().get(str(ns), {}).get(str(key))
        if v is None:
            raise dbus.DBusException("Requested setting not found", name="org.freedesktop.portal.Error.NotFound")
        return v

    @dbus.service.signal(IMPL + "Settings", signature="ssv")
    def SettingChanged(self, ns, key, value):
        pass

    def setting_changed(self, ns, key, value):
        log("setting changed: %s %s" % (ns, key))
        self.SettingChanged(ns, key, value)

    def dconf_changed(self, ns, key, gv):
        self.setting_changed(ns, key, gv_to_dbus(gv))
        if ns == "org.gnome.desktop.interface" and key in ("color-scheme", "enable-animations"):
            # appearance falls back to / derives from these
            for k, v in self.appearance.values().items():
                if k in ("color-scheme", "reduced-motion"):
                    self.SettingChanged(APPEARANCE, k, v)
        now = self.lockdown()
        diff = {k: v for k, v in now.items() if self.lockdown_last.get(k) != v}
        self.lockdown_last = now
        if diff:
            self.PropertiesChanged(IMPL + "Lockdown", dbus.Dictionary(diff, signature="sv"),
                                   dbus.Array([], signature="s"))

    # -- Notification --------------------------------------------------------------

    def fdo(self):
        return bus.get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications", introspect=False)

    @dbus.service.method(IMPL + "Notification", in_signature="ssa{sv}", out_signature="",
                         async_callbacks=("reply", "error"))
    def AddNotification(self, app_id, nid, n, reply, error):
        app_id, nid = str(app_id), str(nid)
        n = {str(k): v for k, v in n.items()}
        actions, keys = [], {}
        if "default-action" in n:
            keys["default"] = (str(n["default-action"]), n.get("default-action-target"))
            actions += ["default", ""]
        for i, b in enumerate(n.get("buttons", [])):
            b = {str(k): v for k, v in b.items()}
            if "action" not in b:
                continue
            k = "button-%d" % i
            keys[k] = (str(b["action"]), b.get("target"))
            actions += [k, str(b.get("label", b["action"]))]
        icon = icon_from_serialized(n["icon"], runtime_dir("icons")) if "icon" in n else ""
        info = app_info(app_id)
        hints = {"desktop-entry": dbus.String(app_id)} if app_id else {}
        urgency = {"low": 0, "normal": 1, "high": 1, "urgent": 2}.get(str(n.get("priority", "normal")), 1)
        hints["urgency"] = dbus.Byte(urgency)
        if icon.startswith("/"):
            hints["image-path"] = dbus.String(icon)
        if "category" in n:
            hints["category"] = dbus.String(str(n["category"]))
        body = str(n.get("markup-body", n.get("body", "")))
        if "markup-body" not in n:
            body = GLib.markup_escape_text(body)
        replaces = self.notes.get((app_id, nid), 0)
        app_icon = icon if icon and not icon.startswith("/") else app_icon_name(info)

        def done(fid):
            fid = int(fid)
            self.notes[(app_id, nid)] = fid
            self.notes_back[fid] = (app_id, nid, keys)
            reply()

        self.fdo().Notify(
            dbus.String(app_label(app_id) if app_id else "An app"), dbus.UInt32(replaces),
            dbus.String(app_icon), dbus.String(str(n.get("title", ""))), dbus.String(body),
            dbus.Array(actions, signature="s"), dbus.Dictionary(hints, signature="sv"), dbus.Int32(-1),
            dbus_interface="org.freedesktop.Notifications",
            reply_handler=done,
            error_handler=lambda e: (log("Notify failed:", e), error(e)))

    @dbus.service.method(IMPL + "Notification", in_signature="ss", out_signature="")
    def RemoveNotification(self, app_id, nid):
        fid = self.notes.pop((str(app_id), str(nid)), None)
        if fid is None:
            return
        self.notes_back.pop(fid, None)
        self.fdo().CloseNotification(dbus.UInt32(fid), dbus_interface="org.freedesktop.Notifications",
                                     reply_handler=lambda: None, error_handler=lambda e: None)

    @dbus.service.signal(IMPL + "Notification", signature="sssav")
    def ActionInvoked(self, app_id, nid, action, parameter):
        pass

    def fdo_action(self, fid, key):
        entry = self.notes_back.get(int(fid))
        if not entry:
            return
        app_id, nid, keys = entry
        if str(key) not in keys:
            return
        action, target = keys[str(key)]
        params = dbus.Array([target] if target is not None else [], signature="v")
        info = app_info(app_id)
        # A D-Bus activatable app gets "app.*" actions straight through
        # org.freedesktop.Application (started if needed), as GNOME does.
        if info and info.get_boolean("DBusActivatable") and action.startswith("app."):
            path = "/" + app_id.replace(".", "/").replace("-", "_")
            bus.get_object(app_id, path).ActivateAction(
                dbus.String(action[4:]), params, dbus.Dictionary({}, signature="sv"),
                dbus_interface="org.freedesktop.Application",
                reply_handler=lambda: None,
                error_handler=lambda e: (log("ActivateAction:", e), self.ActionInvoked(app_id, nid, action, params)))
        else:
            self.ActionInvoked(app_id, nid, action, params)

    def fdo_closed(self, fid, reason):
        entry = self.notes_back.pop(int(fid), None)
        if entry:
            self.notes.pop((entry[0], entry[1]), None)

