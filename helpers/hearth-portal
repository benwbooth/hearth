    @dbus.service.method(IMPL + "Print", in_signature="osssa{sv}a{sv}a{sv}", out_signature="ua{sv}",
                         async_callbacks=("reply", "error"))
    def PreparePrint(self, handle, app_id, window, title, settings, page_setup, options, reply, error):
        self.print_dialog(handle, app_id, title, plain(settings), plain(options), None, reply, error)

    @dbus.service.method(IMPL + "Print", in_signature="osssha{sv}", out_signature="ua{sv}",
                         async_callbacks=("reply", "error"))
    def Print(self, handle, app_id, window, title, fd, options, reply, error):
        o = plain(options)
        fd = fd.take()
        prepared = self.print_tokens.pop(int(o.get("token", 0)), None)
        if prepared:
            def work():
                ok = run_print(fd, str(title), prepared)
                os.close(fd)
                GLib.idle_add(lambda: (reply(dbus.UInt32(OK if ok else ENDED),
                                             dbus.Dictionary({}, signature="sv")), False)[1])
            threading.Thread(target=work, daemon=True).start()
            return
        self.print_dialog(handle, app_id, title, {}, o, fd, reply, error)

    def print_dialog(self, handle, app_id, title, settings, options, fd, reply, error):
        # Asking CUPS takes a second or two (network printers): off the loop.
        def listed(printers):
            self.print_dialog_ready(handle, app_id, title, settings, options, fd, reply, error, printers)
            return False
        threading.Thread(target=lambda: GLib.idle_add(listed, list_printers()), daemon=True).start()

    def print_dialog_ready(self, handle, app_id, title, settings, options, fd, reply, error, printers):
        media = {p["value"]: p["media"] for p in printers["printers"]}
        payload = {"app": app_label(str(app_id)) if str(app_id) else "", "title": str(title),
                   "printers": printers["printers"],
                   "printer": settings.get("printer") or printers["default"],
                   "copies": int(settings.get("n-copies", "1") or 1),
                   "acceptLabel": options.get("accept_label", ""),
                   "preparing": fd is None}

        def finish(ans):
            job = {"printer": str(ans.get("printer", "")), "copies": max(1, int(ans.get("copies", 1))),
                   "pages": str(ans.get("pages", "")).replace(" ", ""),
                   "duplex": str(ans.get("duplex", "")), "orientation": str(ans.get("orientation", "portrait")),
                   "color": ans.get("color")}
            job["media"] = media.get(job["printer"], "")
            if not job["printer"]:
                return ENDED, {}
            if fd is not None:
                return (OK if run_print(fd, str(title), job) else ENDED), {}
            token = next(self.print_token_ids)
            self.print_tokens[token] = job
            return OK, {"settings": dbus.Dictionary(gtk_print_settings(job), signature="sv"),
                        "page-setup": dbus.Dictionary(gtk_page_setup(job), signature="sv"),
                        "token": dbus.UInt32(token)}

        def reply_closing(*a):
            # The document is printed (or not) by now; let it go.
            if fd is not None:
                os.close(fd)
            reply(*a)

        dialog(handle, "print", payload, finish, reply_closing, error, threaded=True)

