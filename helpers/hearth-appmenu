X11_PROPS = ["_KDE_NET_WM_APPMENU_SERVICE_NAME", "_KDE_NET_WM_APPMENU_OBJECT_PATH",
             "_GTK_UNIQUE_BUS_NAME", "_GTK_MENUBAR_OBJECT_PATH", "_GTK_APP_MENU_OBJECT_PATH",
             "_GTK_APPLICATION_OBJECT_PATH", "_GTK_WINDOW_OBJECT_PATH", "_NET_WM_NAME"]


def xprop(args):
    try:
        env = dict(os.environ, LC_ALL="C.UTF-8")  # titles as UTF-8, not escaped
        r = subprocess.run(["xprop"] + args, capture_output=True, text=True, timeout=2, env=env)
        return r.stdout
    except Exception:
        return ""


def x11_active_window():
    o = xprop(["-root", "-notype", "_NET_ACTIVE_WINDOW"])
    if "#" not in o:
        return 0
    try:
        return int(o.split("#", 1)[1].split(",")[0].strip(), 16)
    except ValueError:
        return 0


def x11_props(xid):
    props = {}
    for line in xprop(["-id", hex(xid), "-notype"] + X11_PROPS).splitlines():
        if " = " not in line:
            continue
        k, v = line.split(" = ", 1)
        v = v.strip()
        if v.startswith('"') and v.endswith('"'):
            v = v[1:-1]
        props[k.strip()] = v
    return props


def x11_pid(xid):
    """_NET_WM_PID of an X11 window, 0 if unknown."""
    o = xprop(["-id", hex(xid), "-notype", "_NET_WM_PID"])
    try:
        return int(o.split("=", 1)[1].strip())
    except (IndexError, ValueError):
        return 0


def is_satellite(pid):
    """Whether the Wayland client `pid` is xwayland-satellite (X11 windows)."""
    try:
        with open(f"/proc/{int(pid)}/comm") as f:
            # NixOS wraps it: ".xwayland-satel" (comm is cut at 15 bytes).
            return "xwayland-sat" in f.read()
    except (OSError, ValueError):
        return False


class AppActions:
    """A GTK window without menus (libadwaita apps: a ☰ instead) still
    exports its actions (org.gtk.Actions at the app and window object paths
    arbor reports). The ones every user expects in an app menu and that have
    no hearth equivalent become a GNOME 3 style app menu (root child -2,
    shown at the top of the bold app-name menu): Settings…, Keyboard
    Shortcuts, Help. Activated over D-Bus, not by clicking the app.
    About, New Window and Quit are hearth's own items already."""

    KNOWN = [("app", "preferences", "Settings…"), ("app", "settings", "Settings…"),
             ("app", "prefs", "Settings…"), ("app", "shortcuts", "Keyboard Shortcuts"),
             ("win", "show-help-overlay", "Keyboard Shortcuts"),
             ("app", "show-help-overlay", "Keyboard Shortcuts"), ("app", "help", "Help")]
    FIRST_ID = -3000

    def __init__(self, key, busname, app="", win=""):
        self.key, self.bus, self.alive, self.ids, self.sent = key, busname, True, {}, None
        self.groups = {}
        for prefix, path in (("app", app), ("win", win)):
            if path:
                try:
                    self.groups[prefix] = ActionGroup(self, path)
                except dbus.DBusException as e:
                    err(e)

    def rebuild(self):
        if not self.alive or not all(g.ready for g in self.groups.values()):
            return
        items, seen, self.ids = [], set(), {}
        for prefix, name, label in self.KNOWN:
            g = self.groups.get(prefix)
            a = g.actions.get(name) if g else None
            if not a or a[1] != "" or label in seen:  # parameterless only
                continue
            nid = self.FIRST_ID - len(items)
            self.ids[nid] = (prefix, name)
            seen.add(label)
            items.append(item(nid, label, enabled=a[0]))
        menu = item(-2, submenu=True, children=items) if items else None
        if menu != self.sent:
            self.sent = menu
            out({"type": "appactions", "key": self.key, "menu": menu})

    def click(self, nid):
        prefix, name = self.ids.get(nid, (None, None))
        g = self.groups.get(prefix)
        if g:
            g.iface.Activate(name, dbus.Array([], signature="v"), dbus.Dictionary({}, signature="sv"),
                             reply_handler=lambda *a: None, error_handler=err)

    def stop(self):
        self.alive = False
        for g in self.groups.values():
            g.stop()


# ---------------------------------------------------------------- modules

# Menu modules (menu-survey/MODULES.md): declarative menus for apps that
# export none, from hearth's catalog (share/hearth/menus) and the user's
# ~/.config/hearth/menus (which wins, file by file). Data only: the action
# kinds below are all a module can do, each aimed at the focused window.
MODULE_DIRS = [
    os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "menus")),
    os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "hearth", "menus"),
]
MODULE_SCHEMA = "hearth-menu-module/1"
ACTION_KINDS = {"keys", "gtk_action", "open_help"}
ITEM_KEYS = {"id", "label", "shortcut", "do", "enabled", "checked", "items", "separator", "place", "safe", "names"}
_modules = {"stamp": None, "by_key": {}}


def _module_files():
    files = {}
    for d in MODULE_DIRS:
        try:
            for f in sorted(os.listdir(d)):
                if f.endswith((".yaml", ".yml", ".json")):
                    files[f.rsplit(".", 1)[0]] = os.path.join(d, f)  # later dirs win
        except OSError:
            pass
    return files


def _check_items(items, depth=0):
    if not isinstance(items, list) or depth > 4:
        raise ValueError("items must be a list (at most 4 levels)")
    for it in items:
        if it == "separator" or (isinstance(it, dict) and it.get("separator")):
            continue
        if not isinstance(it, dict) or not isinstance(it.get("label"), str):
            raise ValueError(f"item without a label: {it!r}"[:200])
        bad = set(it) - ITEM_KEYS
        if bad:
            raise ValueError(f"unknown item keys {sorted(bad)} in {it['label']!r}")
        if "items" in it:
            _check_items(it["items"], depth + 1)
        elif not isinstance(it.get("do"), dict) or len(it["do"]) != 1 or set(it["do"]) - ACTION_KINDS:
            raise ValueError(f"{it['label']!r}: 'do' must be one of {sorted(ACTION_KINDS)}")
        else:
            kind, arg = next(iter(it["do"].items()))
            if not isinstance(arg, str) or len(arg) > 200:
                raise ValueError(f"{it['label']!r}: bad {kind} argument")
            if kind == "open_help" and not arg.startswith("https://"):
                raise ValueError(f"{it['label']!r}: open_help takes an https:// URL")


def load_module(path):
    with open(path) as f:
        if os.path.getsize(path) > 256 * 1024:
            raise ValueError("module over 256 KB")
        text = f.read()
    if path.endswith(".json"):
        m = json.loads(text)
    else:
        import yaml  # python3Packages.pyyaml (flake.nix)
        m = yaml.safe_load(text)
    if not isinstance(m, dict) or m.get("schema") != MODULE_SCHEMA:
        raise ValueError(f"not a {MODULE_SCHEMA} file")
    if not isinstance(m.get("menus"), list):
        raise ValueError("no menus")
    for menu in m["menus"]:
        if not isinstance(menu, dict) or not isinstance(menu.get("title"), str):
            raise ValueError("a menu needs a title")
        _check_items(menu.get("items", []))
    return m


def module_for(app_id):
    """The module whose app.match names this app id (or desktop/flatpak
    id), reloading the catalog when a file changed."""
    if not app_id:
        return None
    files = _module_files()
    stamp = tuple(sorted((k, v, os.path.getmtime(v)) for k, v in files.items() if os.path.exists(v)))
    if stamp != _modules["stamp"]:
        by_key = {}
        for name, path in files.items():
            try:
                m = load_module(path)
            except Exception as e:  # a broken module must not take the menu bar down
                err(f"menu module {path}: {e}")
                continue
            match = (m.get("app") or {}).get("match") or {}
            keys = {name}
            for k in ("app_id", "desktop", "flatpak"):
                v = match.get(k) or []
                keys |= set(v if isinstance(v, list) else [v])
            for k in keys:
                by_key[str(k).lower().removesuffix(".desktop")] = (m, path)
        _modules.update(stamp=stamp, by_key=by_key)
    return _modules["by_key"].get(app_id.lower().removesuffix(".desktop"))


class ModuleMenu:
    """A window's menus from its module. Items act on that window only:
    keys through arbor (SendKeys: the window is focused, the chord goes
    straight to it), GTK actions over org.gtk.Actions on the window's own
    bus name, help pages in the browser. Enabled/checked states follow the
    app's GTK actions where the module names one (live: Changed signals)."""

    FIRST_ID = -5000

    def __init__(self, key, module, path, window, gtk=None):
        self.key, self.module, self.path, self.window, self.alive = key, module, path, window, True
        gbus, gapp, gwin = gtk or ("", "", "")
        self.bus, self.groups, self.actions = gbus, {}, {}
        for prefix, p in (("app", gapp), ("win", gwin)):
            if gbus and p:
                try:
                    self.groups[prefix] = ActionGroup(self, p)
                except dbus.DBusException as e:
                    err(e)
        self.rebuild()

    def request(self):
        return {"cmd": "watch", "key": self.key, "kind": "module", "path": self.path}

    def same(self, other):
        return isinstance(other, ModuleMenu) and other.key == self.key and other.path == self.path

    def _state(self, name):
        prefix, _, act = name.partition(".")
        g = self.groups.get(prefix)
        return g.actions.get(act) if g else None

    def _convert(self, items, counter):
        out = []
        for it in items:
            if it == "separator" or (isinstance(it, dict) and it.get("separator")):
                out.append(item(counter[0], type="separator"))
                counter[0] -= 1
                continue
            nid = counter[0]
            counter[0] -= 1
            kw = {"shortcut": it.get("shortcut", "")}
            if "items" in it:
                kw["submenu"] = True
                kw["children"] = self._convert(it["items"], counter)
            else:
                kind, arg = next(iter(it["do"].items()))
                self.actions[nid] = (kind, arg)
                if kind == "gtk_action":
                    st = self._state(arg)
                    if st is not None:
                        kw["enabled"] = st[0]
                        if st[2]:  # a stateful action: a checkmark
                            kw["toggleType"] = "checkmark"
                            kw["toggleState"] = 1 if bool(st[2][0]) else 0
                    elif self.groups:
                        kw["enabled"] = False  # the app doesn't have it (any more)
            out.append(item(nid, it["label"], **kw))
        return out

    def rebuild(self):
        if not self.alive:
            return
        self.actions = {}
        counter = [self.FIRST_ID]
        tops = []
        for menu in self.module["menus"]:
            nid = counter[0]
            counter[0] -= 1
            tops.append(item(nid, menu["title"], submenu=True,
                             children=self._convert(menu.get("items", []), counter)))
        out({"type": "menu", "key": self.key, "source": "module", "menu": item(0, children=tops)})

    def click(self, nid):
        kind, arg = self.actions.get(nid, (None, None))
        if kind == "keys" and self.window:
            # After hearth's menu has closed and given the keyboard back.
            GLib.timeout_add(120, lambda: subprocess.Popen(
                ["arbor", "msg", "action", "send-keys", "--id", str(self.window), "--keys", arg],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) and False)
        elif kind == "gtk_action":
            prefix, _, act = arg.partition(".")
            g = self.groups.get(prefix)
            if g:
                g.iface.Activate(act, dbus.Array([], signature="v"), dbus.Dictionary({}, signature="sv"),
                                 reply_handler=lambda *a: None, error_handler=err)
        elif kind == "open_help":
            subprocess.Popen(["xdg-open", arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def open(self, nid):
        pass

    def close(self, nid):
        pass

    def stop(self):
        self.alive = False
        for g in self.groups.values():
            g.stop()


class Mpris:
    """A Playback menu for any media player: the window's process (or a
    parent/child, or its Flatpak sandbox's D-Bus proxy) owns an
    org.mpris.MediaPlayer2.* name. Built from the player's own properties
    (Can*, PlaybackStatus, Shuffle, LoopStatus), kept live through
    PropertiesChanged, and found again when a player appears or leaves
    (a browser starts playing). Sent as an extra top-level menu
    ("extramenus"), next to whatever else the window has."""

    ROOT = "org.mpris.MediaPlayer2"
    PLAYER = "org.mpris.MediaPlayer2.Player"
    PATH = "/org/mpris/MediaPlayer2"
    FIRST_ID = -6000

    def __init__(self, key, pid, sink):
        self.key, self.pid, self.alive, self.sink = key, pid, True, sink
        self.name, self.props, self.matches, self.ids, self.sent = None, {}, [], {}, None
        self.owner_match = bus.add_signal_receiver(
            self.owner_changed, signal_name="NameOwnerChanged", dbus_interface="org.freedesktop.DBus")
        GLib.idle_add(self.find)

    def owner_changed(self, name, old, new):
        if str(name).startswith(self.ROOT + ".") and self.alive:
            GLib.timeout_add(200, self.find)

    def find(self):
        if not self.alive or not self.pid:
            return False
        mine = set(ancestors(self.pid)) | flatpak_proxies(self.pid)
        found = None
        try:
            names = bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus").ListNames(
                dbus_interface="org.freedesktop.DBus", timeout=2)
        except dbus.DBusException:
            names = []
        for n in sorted(str(x) for x in names):
            if not n.startswith(self.ROOT + "."):
                continue
            p = pid_of(n)
            if p and (p in mine or self.pid in ancestors(p)):
                found = n
                break
        if found != self.name:
            for m in self.matches:
                m.remove()
            self.matches, self.name, self.props = [], found, {}
            if found:
                self.matches.append(bus.add_signal_receiver(
                    self.changed, signal_name="PropertiesChanged",
                    dbus_interface="org.freedesktop.DBus.Properties", bus_name=found, path=self.PATH))
                self.read()
            else:
                self.emit()
        return False

    def read(self):
        obj = bus.get_object(self.name, self.PATH, introspect=False)
        props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")

        def got(iface):
            def ok(d):
                self.props.update({str(k): plain(v) for k, v in d.items()})
                self.emit()
            return ok
        for iface in (self.ROOT, self.PLAYER):
            props.GetAll(iface, reply_handler=got(iface), error_handler=lambda e: None)

    def changed(self, iface, changed, invalidated):
        self.props.update({str(k): plain(v) for k, v in changed.items()})
        if invalidated:
            self.read()
        else:
            self.emit()

    def emit(self):
        if not self.alive:
            return
        menus = []
        if self.name:
            pr, ids, items = self.props, {}, []

            def add(label, action, enabled=True, **kw):
                nid = self.FIRST_ID - len(ids)
                ids[nid] = action
                items.append(item(nid, label, enabled=bool(enabled), **kw))
            playing = pr.get("PlaybackStatus") == "Playing"
            add("Pause" if playing else "Play", ("Pause" if playing else "Play",),
                pr.get("CanPause", True) if playing else pr.get("CanPlay", True))
            add("Stop", ("Stop",), pr.get("CanControl", True) and pr.get("PlaybackStatus") != "Stopped")
            items.append(item(self.FIRST_ID - 100, type="separator"))
            add("Next", ("Next",), pr.get("CanGoNext", False))
            add("Previous", ("Previous",), pr.get("CanGoPrevious", False))
            if "Shuffle" in pr or "LoopStatus" in pr:
                items.append(item(self.FIRST_ID - 101, type="separator"))
            if "Shuffle" in pr:
                add("Shuffle", ("set", "Shuffle", not pr["Shuffle"]), True,
                    toggleType="checkmark", toggleState=1 if pr["Shuffle"] else 0)
            if "LoopStatus" in pr:
                for status, label in (("None", "Repeat Off"), ("Track", "Repeat One"), ("Playlist", "Repeat All")):
                    add(label, ("set", "LoopStatus", status), True, toggleType="radio",
                        toggleState=1 if pr["LoopStatus"] == status else 0)
            if pr.get("CanRaise") or pr.get("CanQuit"):
                items.append(item(self.FIRST_ID - 102, type="separator"))
            if pr.get("CanRaise"):
                add("Show Player", ("Raise",))
            self.ids = ids
            menus = [item(self.FIRST_ID - 200, "Playback", submenu=True, children=items)]
        if menus != self.sent:
            self.sent = menus
            self.sink("mpris", menus)

    def click(self, nid):
        action = self.ids.get(nid)
        if not action or not self.name:
            return
        obj = bus.get_object(self.name, self.PATH, introspect=False)
        if action[0] == "set":
            value = action[2]
            value = dbus.Boolean(value, variant_level=1) if isinstance(value, bool) \
                else dbus.String(value, variant_level=1)
            # Explicit signature: without introspection dbus-python would send
            # "sss" and GDBus answers that as an unknown method.
            obj.Set(self.PLAYER, action[1], value, signature="ssv",
                    dbus_interface="org.freedesktop.DBus.Properties",
                    reply_handler=lambda *a: None, error_handler=err)
        else:
            iface = self.ROOT if action[0] == "Raise" else self.PLAYER
            getattr(dbus.Interface(obj, iface), action[0])(reply_handler=lambda *a: None, error_handler=err)

    def stop(self):
        self.alive = False
        self.owner_match.remove()
        for m in self.matches:
            m.remove()


class Shortcuts:
    """Menus from the shortcuts window a GTK app ships in its binary
    (GtkShortcutsWindow help-overlay / AdwShortcutsDialog, in the GResource
    of /proc/PID/exe): every documented command with its title, section and
    accelerator. Sections fold into File / Edit / View / Go by their title
    (the rest keep theirs, at most six menus); pure cursor movement is left
    out. An item runs the action it names when the app exports it, else its
    accelerator through arbor send-keys. Read in a thread (gresource), once
    per binary."""

    FIRST_ID = -7000
    CACHE = {}  # exe path -> parsed sections
    FOLD = [("File", ("window", "tab", "document", "file", "project", "session", "print", "open", "save")),
            ("Edit", ("copy", "paste", "clipboard", "undo", "redo", "edit", "select", "delet", "find",
                      "search", "replace", "text", "format")),
            ("View", ("zoom", "view", "display", "panel", "sidebar", "fullscreen", "layout", "appearance")),
            ("Go", ("navigat", "movement", "go", "history", "jump"))]
    NAV = {"Left", "Right", "Up", "Down", "Home", "End", "PgUp", "PgDown", "Tab", "Return", "Space"}

    def __init__(self, key, pid, window, gtk, sink):
        self.key, self.pid, self.window, self.sink, self.alive = key, pid, window, sink, True
        self.ids = {}
        gbus, gapp, gwin = gtk or ("", "", "")
        self.gtk = (gbus, gapp, gwin)
        try:
            self.exe = os.path.realpath(f"/proc/{pid}/exe")
        except OSError:
            self.exe = ""
        if self.exe.startswith("/app/") or os.path.exists(f"/proc/{pid}/root/.flatpak-info"):
            # A Flatpak's binary: its path is inside the sandbox; the host
            # reads it through the process (cached by its sandbox path).
            self.read_path = f"/proc/{pid}/exe"
        elif self.exe.startswith(("/nix/store/", "/usr/", "/opt/")):
            self.read_path = self.exe
        else:
            self.exe = self.read_path = ""
        if self.exe in self.CACHE:
            GLib.idle_add(self.emit)
        elif self.exe:
            import threading
            threading.Thread(target=self.harvest, daemon=True).start()

    def harvest(self):
        sections = []
        try:
            files = subprocess.run(["gresource", "list", self.read_path], capture_output=True, text=True,
                                   timeout=5).stdout.split()
            ui = [f for f in files if f.endswith(("shortcuts-dialog.ui", "help-overlay.ui", "shortcuts.ui",
                                                  "shortcuts-window.ui"))]
            for f in ui[:1]:
                xml = subprocess.run(["gresource", "extract", self.read_path, f], capture_output=True,
                                     text=True, timeout=5).stdout
                sections = self.parse(xml)
        except Exception as e:
            GLib.idle_add(lambda: err(f"shortcuts of {self.exe}: {e}") and False)
        self.CACHE[self.exe] = sections
        GLib.idle_add(self.emit)

    @staticmethod
    def parse(xml):
        import xml.etree.ElementTree as ET
        root = ET.fromstring(xml)

        def prop(o, name):
            for p in o.findall("property"):
                if p.get("name") == name:
                    return (p.text or "").strip()
            return ""
        sections = []
        for sec in root.iter("object"):
            if sec.get("class") not in ("AdwShortcutsSection", "GtkShortcutsGroup"):
                continue
            items = []
            for o in sec.iter("object"):
                if o.get("class") not in ("AdwShortcutsItem", "GtkShortcutsShortcut"):
                    continue
                title, accel = prop(o, "title"), prop(o, "accelerator").split(" ")[0]
                action = prop(o, "action-name")
                if title and (accel or action):
                    items.append((title, accel, action))
            if items:
                sections.append((prop(sec, "title") or "", items))
        return sections

    def emit(self):
        if not self.alive:
            return False
        sections = self.CACHE.get(self.exe) or []
        menus, order, self.ids = {}, [], {}
        nid = [self.FIRST_ID]

        def new_id():
            nid[0] -= 1
            return nid[0]
        for title, items in sections:
            low = title.lower()
            name = next((m for m, words in self.FOLD if any(w in low for w in words)), title or "Commands")
            entries = []
            for label, accel, action in items:
                text = gtk_accel_text(accel) if accel else ""
                if text and "+" not in text.rstrip("+") and text in self.NAV:
                    continue  # plain cursor keys are not commands
                if text.split("+")[-1] in self.NAV and len(text.split("+")) == 2 and text.startswith("Ctrl+") \
                        and "Move" in label:
                    continue
                i = new_id()
                self.ids[i] = (action, text)
                entries.append(item(i, label[:1].upper() + label[1:], shortcut=text))
            if not entries:
                continue
            if name not in menus:
                menus[name] = []
                order.append(name)
            elif menus[name]:
                menus[name].append(item(new_id(), type="separator"))
            menus[name].extend(entries)
        known = [m for m, _ in self.FOLD]
        order.sort(key=lambda m: known.index(m) if m in known else len(known))
        if len(order) > 6:
            rest = order[6:]
            order = order[:6]
            more = []
            for m in rest:
                more.append(item(new_id(), m, submenu=True, children=menus[m]))
            menus["More"] = more
            order.append("More")
        tops = [item(new_id(), m, submenu=True, children=menus[m]) for m in order]
        self.sink("shortcuts", tops)
        return False

    def click(self, nid):
        action, keys = self.ids.get(nid, ("", ""))
        gbus, gapp, gwin = self.gtk
        prefix, _, name = action.partition(".")
        path = {"app": gapp, "win": gwin}.get(prefix, "")
        if gbus and path and name:
            obj = bus.get_object(gbus, path, introspect=False)
            dbus.Interface(obj, GTK_ACTIONS).Activate(
                name, dbus.Array([], signature="v"), dbus.Dictionary({}, signature="sv"),
                reply_handler=lambda *a: None, error_handler=err)
        elif keys and self.window:
            GLib.timeout_add(120, lambda: subprocess.Popen(
                ["arbor", "msg", "action", "send-keys", "--id", str(self.window), "--keys", keys],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) and False)

    def stop(self):
        self.alive = False


class ElectronMenus:
    """An Electron app's menu bar from its own code (hearth_electron_menu:
    the Menu template in its app.asar, labels through its translations),
    for an Electron app that exports none. Items run their accelerator (or
    their role's default key) through arbor send-keys. Read in a thread,
    once per app archive."""

    FIRST_ID = -8000
    CACHE = {}

    def __init__(self, key, pid, window, sink):
        self.key, self.window, self.sink, self.alive, self.ids = key, window, sink, True, {}
        try:
            import hearth_electron_menu as hem
        except Exception as e:
            err(f"electron menus: {e}")
            return
        self.hem = hem
        self.path = hem.app_path(pid)
        if not self.path:
            return
        if self.path in self.CACHE:
            GLib.idle_add(self.emit)
        else:
            import threading
            threading.Thread(target=self.harvest, daemon=True).start()

    def harvest(self):
        try:
            menus = self.hem.menus_for(self.path)
        except Exception as e:
            menus = []
            GLib.idle_add(lambda: err(f"electron menus of {self.path}: {e}") and False)
        self.CACHE[self.path] = menus
        GLib.idle_add(self.emit)

    def emit(self):
        if not self.alive:
            return False
        nid = [self.FIRST_ID]
        self.ids = {}

        def conv(items):
            out_items = []
            for it in items:
                nid[0] -= 1
                if it == "separator":
                    out_items.append(item(nid[0], type="separator"))
                elif "items" in it:
                    out_items.append(item(nid[0], it["label"], submenu=True, children=conv(it["items"])))
                else:
                    self.ids[nid[0]] = it["keys"]
                    out_items.append(item(nid[0], it["label"], shortcut=it["keys"]))
            return out_items
        tops = []
        for m in self.CACHE.get(self.path) or []:
            nid[0] -= 1
            tops.append(item(nid[0], m["title"], submenu=True, children=conv(m["items"])))
        self.sink("electron", tops)
        return False

    def click(self, nid):
        keys = self.ids.get(nid)
        if keys and self.window:
            GLib.timeout_add(120, lambda: subprocess.Popen(
                ["arbor", "msg", "action", "send-keys", "--id", str(self.window), "--keys", keys],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) and False)

    def stop(self):
        self.alive = False


class X11Window:
    """The focused X11 window (xwayland-satellite): resolve, then delegate."""

    def __init__(self, key, title, pid=0, window=0, gtk=None, appid=""):
        self.key, self.title = key, title
        self.inner, self.xid, self.alive, self.tries = None, 0, True, 0
        # A GTK window with actions but no menus (arbor's gtk_menu without
        # a menu bar): its app actions, besides whatever is found below.
        gbus, gapp, gwin = gtk or ("", "", "")
        self.actions = AppActions(key, gbus, gapp, gwin) if gbus and (gapp or gwin) else None
        # Menus added to whatever else is found: a media player's Playback
        # (MPRIS), the commands of a GTK app's shortcuts window.
        self.extras = {}
        self.mpris = Mpris(key, pid, self.set_extra) if pid else None
        self.shortcuts = Shortcuts(key, pid, window, gtk, self.set_extra) \
            if pid and not is_satellite(pid) and not module_for(appid) else None
        self.electron = ElectronMenus(key, pid, window, self.set_extra) \
            if pid and not is_satellite(pid) and not module_for(appid) else None
        # A menu module for this app (no native menus to read): its menus.
        found = module_for(appid)
        self.module = None
        if found:
            self.module = ModuleMenu(key, found[0], found[1], window, gtk)
            self.inner = self.module
            self.pid, self.window, self.wayland = pid, window, False
            return
        self.wayland = bool(pid) and not is_satellite(pid)
        self.pid, self.window = pid, window
        if self.wayland:
            self.resolve_wayland()
            return
        self.resolve()

    def resolve_wayland(self):
        """A Wayland window without an address for its menu. Electron
        (43+, with the registrar and the appmenu protocol) still exports
        its menu and calls RegisterWindow, with its own window number in
        place of an X11 id: the registration from this window's process is
        its menu. Otherwise its in-window menu bar over AT-SPI (Firefox,
        Electron with a ☰ or a menu bar drawn in the page...)."""
        if getattr(self, "module", None):
            self.module.rebuild()
            return False

        reg = registered_for_pid(self.pid)
        if reg:
            if isinstance(self.inner, DbusMenu) and (self.inner.service, self.inner.path) == reg:
                self.inner.fetch()
                return
            if self.inner:
                self.inner.stop()
            try:
                self.inner = DbusMenu(self.key, *reg)
                out({"type": "resolved", "key": self.key, "request": self.inner.request()})
                return
            except dbus.DBusException as e:
                err(e)
        if isinstance(self.inner, AtspiMenu):
            self.inner.emit()
            return
        if self.inner:
            self.inner.stop()
        self.inner = AtspiMenu(self.key, self.title, self.pid, self.window)

    def set_extra(self, name, menus):
        if not self.alive:
            return
        self.extras[name] = menus
        merged = [m for n in ("electron", "shortcuts", "mpris") for m in self.extras.get(n, [])]
        out({"type": "extramenus", "key": self.key, "menus": merged})

    def same(self, other):
        return isinstance(other, X11Window) and other.key == self.key

    def resolve(self):
        if getattr(self, "module", None):
            self.module.rebuild()
            return False
        if not self.alive:
            return False
        if self.wayland:
            self.resolve_wayland()
            return False
        xid = x11_active_window()
        props = x11_props(xid) if xid else {}
        # The satellite sets _NET_ACTIVE_WINDOW when the Wayland focus
        # arrives, which may be a moment after arbor reports it.
        if self.title and props.get("_NET_WM_NAME", self.title) != self.title and self.tries < 5:
            self.tries += 1
            GLib.timeout_add(80 * self.tries, self.resolve)
            return False
        self.xid = xid
        new = None
        try:
            if props.get("_KDE_NET_WM_APPMENU_SERVICE_NAME") and props.get("_KDE_NET_WM_APPMENU_OBJECT_PATH"):
                new = DbusMenu(self.key, props["_KDE_NET_WM_APPMENU_SERVICE_NAME"],
                               props["_KDE_NET_WM_APPMENU_OBJECT_PATH"])
            elif props.get("_GTK_UNIQUE_BUS_NAME") and (props.get("_GTK_MENUBAR_OBJECT_PATH")
                                                        or props.get("_GTK_APP_MENU_OBJECT_PATH")):
                new = GtkMenu(self.key, props["_GTK_UNIQUE_BUS_NAME"],
                              props.get("_GTK_MENUBAR_OBJECT_PATH", ""),
                              props.get("_GTK_APP_MENU_OBJECT_PATH", ""),
                              props.get("_GTK_APPLICATION_OBJECT_PATH", ""),
                              props.get("_GTK_WINDOW_OBJECT_PATH", ""))
            elif registrar and xid in registrar.windows:
                s, p = registrar.windows[xid]
                new = DbusMenu(self.key, s, p)
            elif registrar and xid:
                # Another window of the same X11 client registered (VLC
                # registers its main window; the active one can be another).
                pid = x11_pid(xid)
                for wid, (s, p) in sorted(registrar.windows.items(), reverse=True):
                    if pid and x11_pid(wid) == pid and has_menu(s, p):
                        new = DbusMenu(self.key, s, p)
                        break
        except dbus.DBusException as e:
            err(e)
        if self.inner and new and self.inner.same(new):
            new.stop()
            return False
        if self.inner:
            self.inner.stop()
        self.inner = new
        if new is None:
            out({"type": "none", "key": self.key})
        else:
            out({"type": "resolved", "key": self.key, "request": new.request()})
        return False

    def registered(self, xid):
        if not self.alive:
            return
        if self.wayland:
            self.resolve_wayland()
        elif xid == self.xid:
            self.resolve()

    def stop(self):
        self.alive = False
        if self.inner:
            self.inner.stop()
        if self.actions:
            self.actions.stop()
        if self.mpris:
            self.mpris.stop()
        if self.shortcuts:
            self.shortcuts.stop()
        if self.electron:
            self.electron.stop()

    def open(self, nid):
        if self.inner:
            self.inner.open(nid)

    def close(self, nid):
        if self.inner:
            self.inner.close(nid)

    def click(self, nid):
        if self.mpris and nid in self.mpris.ids:
            self.mpris.click(nid)
        elif self.shortcuts and nid in self.shortcuts.ids:
            self.shortcuts.click(nid)
        elif self.electron and nid in self.electron.ids:
            self.electron.click(nid)
        elif self.actions and nid in self.actions.ids:
            self.actions.click(nid)
        elif self.inner:
            self.inner.click(nid)


def pid_of(service):
    try:
        return int(bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus").GetConnectionUnixProcessID(
            service, dbus_interface="org.freedesktop.DBus", timeout=2))
    except dbus.DBusException:
        return 0


def ancestors(pid):
    seen = []
    try:
        while pid > 1 and len(seen) < 32:
            seen.append(pid)
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return seen

def flatpak_proxies(pid):
    """Pids of the xdg-dbus-proxy serving the Flatpak sandbox that process
    `pid` runs in. A sandboxed app reaches the session and accessibility
    buses through that proxy, so the buses report the proxy's pid for its
    connections (not the app's, and the two share no ancestor). The proxy
    listens on $XDG_RUNTIME_DIR/.dbus-proxy/*-bus-proxy-XXXXXX, and the
    sandbox bind-mounts exactly those sockets: match the window's mounts
    against each proxy's listening sockets. Empty outside Flatpak."""
    try:
        with open(f"/proc/{pid}/mountinfo") as f:
            names = {os.path.basename(l.split()[3]) for l in f
                     if len(l.split()) > 4 and "/.dbus-proxy/" in l.split()[3]}
    except OSError:
        return set()
    if not names:
        return set()
    inodes = set()
    try:
        with open("/proc/net/unix") as f:
            next(f, None)
            for l in f:
                p = l.split()
                if len(p) >= 8 and "/.dbus-proxy/" in p[7] and os.path.basename(p[7]) in names:
                    inodes.add(p[6])
    except OSError:
        return set()
    found = set()
    for p in os.listdir("/proc"):
        if not p.isdigit():
            continue
        try:
            with open(f"/proc/{p}/comm") as f:
                if f.read().strip() != "xdg-dbus-proxy":
                    continue
            for fd in os.listdir(f"/proc/{p}/fd"):
                link = os.readlink(f"/proc/{p}/fd/{fd}")
                if link.startswith("socket:[") and link[8:-1] in inodes:
                    found.add(int(p))
                    break
        except OSError:
            continue
    return found


def registered_for_pid(pid):
    """(service, path) of the newest RegisterWindow from process `pid` (or
    its parent or child), or None."""
    if not registrar or not pid:
        return None
    mine = set(ancestors(pid)) | flatpak_proxies(pid)
    found = []
    for wid, (service, path) in registrar.windows.items():
        p = pid_of(service)
        if p and (p in mine or pid in ancestors(p)):
            found.append((wid, service, path))
    # Newest first, and only one that has a menu: Electron registers every
    # window, also when the app set no menu (Claude Desktop: the objects
    # don't exist), and such a window goes on to AT-SPI (its ☰).
    for wid, service, path in sorted(found, reverse=True):
        if has_menu(service, path):
            return service, path
    return None


def tray_menu_for_pid(pid):
    """(service, menu path) of a tray icon (StatusNotifierItem) of process
    `pid` (or a parent/child) whose menu has items, or None."""
    if not pid:
        return None
    try:
        watcher = bus.get_object("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher")
        entries = watcher.Get("org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems",
                              dbus_interface="org.freedesktop.DBus.Properties", timeout=2)
    except dbus.DBusException:
        return None
    mine = set(ancestors(pid)) | flatpak_proxies(pid)
    for entry in entries:
        service, _, path = str(entry).partition("/")
        path = "/" + path if path else "/StatusNotifierItem"
        p = pid_of(service)
        if not p or not (p in mine or pid in ancestors(p)):
            continue
        try:
            menu = str(bus.get_object(service, path, introspect=False).Get(
                "org.kde.StatusNotifierItem", "Menu",
                dbus_interface="org.freedesktop.DBus.Properties", timeout=2))
        except dbus.DBusException:
            continue
        if menu and menu != "/NO_DBUSMENU" and has_menu(service, menu):
            return service, menu
    return None


def has_menu(service, path):
    try:
        obj = bus.get_object(service, path, introspect=False)
        _rev, layout = dbus.Interface(obj, DBUSMENU).GetLayout(
            0, 1, dbus.Array([], signature="s"), timeout=1.5)
        return len(layout[2]) > 0
    except dbus.DBusException:
        return False


# ---------------------------------------------------------------- AT-SPI

# Apps that export no menu (Firefox, Thunderbird, Electron on Wayland) still
# show their in-window menu bar to accessibility tools: helpers/hearth-atspi-
# menu reads it, in its own process (see there), started on first use.

class AtspiWorker:
    proc = None
    buf = b""
    owner = None  # the AtspiMenu whose window the worker watches

    @classmethod
    def send(cls, obj):
        if cls.proc is None or cls.proc.poll() is not None:
            here = os.path.dirname(os.path.abspath(__file__))
            try:
                cls.proc = subprocess.Popen([os.path.join(here, "hearth-atspi-menu")],
                                            stdin=subprocess.PIPE, stdout=subprocess.PIPE)
            except OSError as e:
                err(f"hearth-atspi-menu: {e}")
                return False
            cls.buf = b""
            GLib.io_add_watch(cls.proc.stdout.fileno(), GLib.IO_IN | GLib.IO_HUP, cls.on_out)
        try:
            cls.proc.stdin.write((json.dumps(obj) + "\n").encode())
            cls.proc.stdin.flush()
            return True
        except (BrokenPipeError, OSError):
            cls.proc = None
            return False

    @classmethod
    def on_out(cls, fd, cond):
        data = os.read(fd, 65536)
        if not data:
            return False
        cls.buf += data
        while b"\n" in cls.buf:
            line, cls.buf = cls.buf.split(b"\n", 1)
            try:
                m = json.loads(line)
            except ValueError:
                continue
            # Only for the window still watched.
            inner = getattr(current, "inner", None)
            if m.get("type") == "error":
                out(m)
            elif isinstance(inner, AtspiMenu) and inner.alive and m.get("key") == inner.key:
                inner.from_worker(m)
        return True


class AtspiMenu:
    """The focused window's menu through hearth-atspi-menu."""

    def __init__(self, key, title, pid, window=0):
        self.key, self.title, self.pid, self.window, self.alive = key, title, pid, window, True
        self.tray = None  # the app's tray icon menu, while AT-SPI has none
        if not AtspiWorker.send(self.watch_cmd()):
            out({"type": "none", "key": key})

    def same(self, other):
        return isinstance(other, AtspiMenu) and other.key == self.key

    def from_worker(self, m):
        """A message from the worker for this window. With no menu over
        AT-SPI either, the app's tray icon menu (same process) stands in as
        its app menu (Teams, Insync...); a real menu found later (Electron
        builds its tree late) replaces it."""
        if m.get("type") == "none":
            if self.tray is None:
                found = tray_menu_for_pid(self.pid)
                if found:
                    try:
                        self.tray = DbusMenu(self.key, *found, wrap=True)
                        return
                    except dbus.DBusException as e:
                        err(e)
            if self.tray is not None:
                return
        elif m.get("type") == "menu" and self.tray is not None:
            self.tray.stop()
            self.tray = None
        out(m)

    def watch_cmd(self):
        AtspiWorker.owner = self
        return {"cmd": "watch", "key": self.key, "title": self.title, "pid": self.pid,
                "window": self.window}

    def emit(self):
        AtspiWorker.send(self.watch_cmd())

    def stop(self):
        self.alive = False
        if self.tray is not None:
            self.tray.stop()
        if AtspiWorker.owner is self:  # not another window's watch
            AtspiWorker.owner = None
            AtspiWorker.send({"cmd": "unwatch"})

    def open(self, nid):
        if self.tray is not None:
            self.tray.open(nid)
        else:
            AtspiWorker.send({"cmd": "open", "id": nid})

    def close(self, nid):
        if self.tray is not None:
            self.tray.close(nid)

    def click(self, nid):
        if self.tray is not None:
            self.tray.click(nid)
        else:
            AtspiWorker.send({"cmd": "click", "id": nid})


# ---------------------------------------------------------------- commands

def unwatch():
    global current
    if current:
        current.stop()
    current = None


def watch(c):
    global current
    kind = c.get("kind", "dbusmenu")
    key = c.get("key") or (c.get("service", "") + "\n" + c.get("path", ""))
    if kind == "dbusmenu":
        new = DbusMenu(key, c["service"], c["path"])
    elif kind == "gtk":
        new = GtkMenu(key, c["bus"], c.get("menubar", ""), c.get("appmenu", ""),
                      c.get("app", ""), c.get("win", ""))
    elif kind == "x11":
        # The same window again: look again, without a throwaway copy (its
        # AT-SPI proxy would unwatch the worker the current one uses).
        if isinstance(current, X11Window) and current.key == key and current.alive:
            current.resolve()
            return
        new = X11Window(key, c.get("title", ""), c.get("pid", 0), c.get("window", 0),
                        (c.get("gbus", ""), c.get("gapp", ""), c.get("gwin", "")), c.get("appid", ""))
    else:
        return
    if current and current.same(new) and getattr(current, "key", None) == key:
        new.stop()
        if hasattr(current, "fetch"):
            current.fetch()
        elif hasattr(current, "rebuild"):
            current.rebuild()
        elif isinstance(current, X11Window):
            current.resolve()
        return
    unwatch()
    current = new


inbuf = b""


def on_stdin(fd, cond):
    # Read whatever is there and handle every complete line: several
    # commands often arrive in one chunk (close + open when switching menus).
    global inbuf
    data = os.read(fd, 65536)
    if not data:
        loop.quit()
        return False
    inbuf += data
    while b"\n" in inbuf:
        line, inbuf = inbuf.split(b"\n", 1)
        handle(line.decode("utf-8", "replace"))
    return True


def handle(line):
    try:
        c = json.loads(line)
    except ValueError:
        return
    cmd = c.get("cmd")
    try:
        if cmd == "watch":
            watch(c)
        elif cmd == "unwatch":
            unwatch()
        elif current and cmd == "open":
            current.open(int(c["id"]))
        elif current and cmd == "close":
            current.close(int(c["id"]))
        elif current and cmd == "click":
            current.click(int(c["id"]))
    except Exception as e:
        err(e)


class Registrar(dbus.service.Object):
    """Minimal com.canonical.AppMenu.Registrar (X11 window id -> menu)."""

    # Kept across restarts of this helper (every hearth restart, every
    # deploy): apps call RegisterWindow once, when their window opens, and
    # would lose their global menu until reopened.
    STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "hearth-appmenu-registrar.json")

    def __init__(self, conn):
        super().__init__(conn, REGISTRAR_PATH)
        self.windows = {}
        # Forget windows whose app left the bus.
        conn.add_signal_receiver(self.owner_changed, signal_name="NameOwnerChanged",
                                 dbus_interface="org.freedesktop.DBus")
        try:
            with open(self.STATE) as f:
                saved = json.load(f)
            dbus_obj = conn.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus")
            for wid, (service, path) in saved.items():
                # Unique names are never reused: one still on the bus is the
                # same app.
                if dbus_obj.NameHasOwner(service, dbus_interface="org.freedesktop.DBus"):
                    self.windows[int(wid)] = (service, path)
        except (OSError, ValueError, dbus.DBusException):
            pass

    def save(self):
        try:
            tmp = self.STATE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({str(k): v for k, v in self.windows.items()}, f)
            os.replace(tmp, self.STATE)
        except OSError:
            pass

    def owner_changed(self, name, old, new):
        if old and not new:
            for w in [w for w, (s, _) in self.windows.items() if s == old]:
                self.UnregisterWindow(dbus.UInt32(w))

    @dbus.service.method(REGISTRAR, in_signature="uo", sender_keyword="sender")
    def RegisterWindow(self, window_id, menu_path, sender=None):
        self.windows[int(window_id)] = (str(sender), str(menu_path))
        self.save()
        self.WindowRegistered(window_id, sender, menu_path)
        if isinstance(current, X11Window):
            current.registered(int(window_id))

    @dbus.service.method(REGISTRAR, in_signature="u")
    def UnregisterWindow(self, window_id):
        if self.windows.pop(int(window_id), None):
            self.save()
            self.WindowUnregistered(window_id)
            if isinstance(current, X11Window):
                current.registered(int(window_id))

    @dbus.service.method(REGISTRAR, in_signature="u", out_signature="so")
    def GetMenuForWindow(self, window_id):
        s, p = self.windows.get(int(window_id), ("", "/"))
        return s, dbus.ObjectPath(p)

    @dbus.service.method(REGISTRAR, out_signature="a(uso)")
    def GetMenus(self):
        return [(dbus.UInt32(w), s, dbus.ObjectPath(p)) for w, (s, p) in self.windows.items()]

    @dbus.service.signal(REGISTRAR, signature="uso")
    def WindowRegistered(self, window_id, service, path):
        pass

    @dbus.service.signal(REGISTRAR, signature="u")
    def WindowUnregistered(self, window_id):
        pass


def main():
    global bus, loop, registrar
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    loop = GLib.MainLoop()

    owned = False
    # Plasma's kded owns the registrar there. An arbor session says
    # "arbor:KDE" (for KDE apps' sake) but has no kded appmenu module.
    desktops = os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")
    in_kde = "KDE" in desktops and "arbor" not in desktops
    if not in_kde and os.environ.get("HEARTH_APPMENU_REGISTRAR", "1") != "0":
        try:
            r = bus.request_name(REGISTRAR, dbus.bus.NAME_FLAG_DO_NOT_QUEUE)
            if r in (dbus.bus.REQUEST_NAME_REPLY_PRIMARY_OWNER, dbus.bus.REQUEST_NAME_REPLY_ALREADY_OWNER):
                registrar = Registrar(bus)
                owned = True
        except dbus.DBusException as e:
            err(e)
    out({"type": "registrar", "owned": owned})

    GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP, on_stdin)
    loop.run()


if __name__ == "__main__":
    main()
