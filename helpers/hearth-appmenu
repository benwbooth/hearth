#!/usr/bin/env python3
"""Global menu relay: reads apps' menus off the session bus for hearth's menu bar.

The compositor tells hearth where the focused window's menu lives. Quickshell
can't call arbitrary DBus, so hearth runs this and talks JSON lines. Three
kinds of menus, all turned into the same tree:

  dbusmenu  com.canonical.dbusmenu (Qt/KDE apps, LibreOffice, Chromium and
            Electron on X11, Java with jayatana). arbor IPC `Window.app_menu`
            (KDE appmenu Wayland protocol), or the X11 window's
            _KDE_NET_WM_APPMENU_* properties / RegisterWindow on our registrar.
  gtk       GMenuModel: org.gtk.Menus + org.gtk.Actions (GtkApplication menu
            bars in GTK 3 and 4, and plain GtkMenuBars exported by
            appmenu-gtk-module). arbor IPC `Window.gtk_menu` (gtk_shell1
            set_dbus_properties) or the X11 window's _GTK_* properties.
  x11       an X11 window through xwayland-satellite: the helper finds the X
            window (_NET_ACTIVE_WINDOW, which the satellite sets on focus) and
            then one of the two above.

stdin (one command per line):
  {"cmd": "watch", "key": K, "kind": "dbusmenu", "service": S, "path": P}
  {"cmd": "watch", "key": K, "kind": "gtk", "bus": B, "menubar": P,
   "appmenu": P, "app": P, "win": P}
  {"cmd": "watch", "key": K, "kind": "x11", "title": T, "pid": N}
      (any window without an address: "none" unless pid is the satellite)
  {"cmd": "unwatch"}
  {"cmd": "open", "id": N}     a (sub)menu is about to show
  {"cmd": "close", "id": N}    it closed
  {"cmd": "click", "id": N}    an item was activated

stdout:
  {"type": "registrar", "owned": bool}
  {"type": "menu", "key": K, "source": "dbusmenu"|"gtk", "menu": ITEM}
      ITEM = {id, label, enabled, visible, type ("standard"|"separator"),
              toggleType (""|"checkmark"|"radio"), toggleState (-1|0|1),
              icon, shortcut ("Ctrl+S"), submenu (bool), children: [ITEM]}
      Labels have their mnemonic underscores removed. A GTK app menu (GNOME 3
      style) comes as a root child with id -2 and an empty label.
  {"type": "none", "key": K}   the window has no exported menu (x11)
  {"type": "resolved", "key": K, "request": R}  the x11 window's menu, as a
      dbusmenu/gtk watch command (hearth keeps it for the app's other windows)
  {"type": "error", "message": str}

Qt (plasma-integration), Chromium, Electron and appmenu-gtk-module only
export menus when the session bus has `com.canonical.AppMenu.Registrar`;
Plasma provides it (kded's appmenu module). Outside Plasma this registers a
minimal one, which records X11 window ids for apps that use RegisterWindow.
"""
import json
import os
import subprocess
import sys
import time

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

DBUSMENU = "com.canonical.dbusmenu"
GTK_MENUS = "org.gtk.Menus"
GTK_ACTIONS = "org.gtk.Actions"
REGISTRAR = "com.canonical.AppMenu.Registrar"
REGISTRAR_PATH = "/com/canonical/AppMenu/Registrar"

bus = None
registrar = None
current = None  # the watched source (DbusMenu / GtkMenu / X11Window)


def out(obj):
    try:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        GLib.idle_add(loop.quit)


def err(e):
    out({"type": "error", "message": str(e)})


def strip_mnemonic(s):
    res, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "_":
            if i + 1 < len(s) and s[i + 1] == "_":
                res.append("_")
                i += 2
                continue
            i += 1
            continue
        res.append(c)
        i += 1
    return "".join(res)


KEYNAMES = {"Control": "Ctrl", "Super": "Meta", "Alt": "Alt", "Shift": "Shift"}


def shortcut_text(sc):
    try:
        return ", ".join("+".join(KEYNAMES.get(str(k), str(k)) for k in combo) for combo in sc)
    except Exception:
        return ""


def item(nid, label="", **kw):
    d = {"id": nid, "label": label, "enabled": True, "visible": True, "type": "standard",
         "toggleType": "", "toggleState": -1, "icon": "", "shortcut": "",
         "submenu": False, "children": []}
    d.update(kw)
    return d


# ---------------------------------------------------------------- dbusmenu

class DbusMenu:
    """com.canonical.dbusmenu at (service, path)."""

    def __init__(self, key, service, path):
        self.key, self.service, self.path = key, service, path
        self.matches, self.pending, self.alive = [], False, True
        obj = bus.get_object(service, path, introspect=False)
        self.iface = dbus.Interface(obj, DBUSMENU)
        for sig in ("LayoutUpdated", "ItemsPropertiesUpdated", "ItemActivationRequested"):
            self.matches.append(bus.add_signal_receiver(
                lambda *a: self.fetch(), signal_name=sig, dbus_interface=DBUSMENU,
                bus_name=service, path=path))

        # GTK (appmenu-gtk-module's dbusmenu mode) and Chromium fill submenus
        # on AboutToShow: ask for the root and every top-level menu once.
        def after_root(*_):
            def got(revision, layout):
                ids = [int(c[0]) for c in layout[2]]
                self.about_to_show(ids, self.fetch)

            self.iface.GetLayout(0, 1, dbus.Array([], signature="s"),
                                 reply_handler=got, error_handler=lambda e: self.fetch())

        self.iface.AboutToShow(dbus.Int32(0), reply_handler=after_root, error_handler=after_root)

    def request(self):
        return {"key": "d\n" + self.service + "\n" + self.path, "kind": "dbusmenu",
                "service": self.service, "path": self.path}

    def same(self, other):
        return isinstance(other, DbusMenu) and other.service == self.service and other.path == self.path

    def stop(self):
        self.alive = False
        for m in self.matches:
            m.remove()

    @staticmethod
    def convert(node):
        nid, props, children = node
        p = {str(k): v for k, v in props.items()}
        kids = [DbusMenu.convert(c) for c in children]
        return item(
            int(nid), strip_mnemonic(str(p.get("label", ""))),
            enabled=bool(p.get("enabled", True)), visible=bool(p.get("visible", True)),
            type=str(p.get("type", "standard")), toggleType=str(p.get("toggle-type", "")),
            toggleState=int(p.get("toggle-state", -1)), icon=str(p.get("icon-name", "")),
            shortcut=shortcut_text(p.get("shortcut", [])),
            submenu=str(p.get("children-display", "")) == "submenu" or len(kids) > 0,
            children=kids)

    def fetch(self):
        """Fetch the whole layout and print it (debounced)."""
        if not self.alive or self.pending:
            return
        self.pending = True

        def run():
            self.pending = False
            if not self.alive:
                return False

            def ok(revision, layout):
                if self.alive:
                    out({"type": "menu", "key": self.key, "source": "dbusmenu",
                         "menu": self.convert(layout)})

            self.iface.GetLayout(0, -1, dbus.Array([], signature="s"),
                                 reply_handler=ok, error_handler=lambda e: self.alive and err(e))
            return False

        GLib.timeout_add(40, run)

    def about_to_show(self, ids, then=None):
        left = [len(ids)]

        def done(*_):
            left[0] -= 1
            if left[0] <= 0 and then:
                then()

        if not ids:
            if then:
                then()
            return
        for i in ids:
            self.iface.AboutToShow(dbus.Int32(i), reply_handler=done, error_handler=done)

    def event(self, nid, name):
        self.iface.Event(dbus.Int32(nid), name, dbus.Int32(0, variant_level=1),
                         dbus.UInt32(int(time.time()) & 0xFFFFFFFF),
                         reply_handler=lambda *a: None, error_handler=err)

    def open(self, nid):
        self.event(nid, "opened")
        self.about_to_show([nid], self.fetch)

    def close(self, nid):
        self.event(nid, "closed")

    def click(self, nid):
        self.event(nid, "clicked")


