#!/usr/bin/env python3
"""Switch apps between light and dark: hearth-color-scheme light|dark [--accent #RRGGBB]

hearth runs this when its own light/dark changes (Settings > Appearance,
including Auto's 7:00/19:00 switch), so the whole desktop follows:

- Qt/KDE apps: Breeze Light/Dark colours and icon theme in kdeglobals, then
  the signals running KDE apps listen for (they recolour live).
- Browsers, Electron, Qt (xdgdesktopportal theme), GTK 4 and Flatpak apps:
  the settings portal's color-scheme and accent-color, which hearth's own
  portal backend (helpers/hearth-portal) serves from
  $XDG_STATE_HOME/hearth/appearance.json, written here; it announces the
  change itself when the file changes.
- GTK 3/4: gtk-theme / color-scheme / icon-theme in dconf (GSettings) and
  ~/.config/gtk-{3,4}.0/settings.ini; and in ~/.config/gtk-{3,4}.0/gtk.css a
  block (between hearth's markers) that draws menus as hearth's apps do
  (shared/app-menus/MacMenuStyle.qml): Chromium and Electron take their menu
  colours from it too.

Only what differs is written; with nothing to change it does nothing.
Prints one JSON line: {"changed": [...]}.
"""
import json
import os
import sys
import tempfile

MODE = sys.argv[1] if len(sys.argv) > 1 else ""
if MODE not in ("light", "dark"):
    sys.exit("usage: hearth-color-scheme light|dark [--accent #RRGGBB]")
ACCENT = sys.argv[sys.argv.index("--accent") + 1] if "--accent" in sys.argv[:-1] else ""
DARK = MODE == "dark"

CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
SCHEME = "BreezeDark" if DARK else "BreezeLight"
ICONS = "breeze-dark" if DARK else "breeze"
LOOK = "org.kde.breezedark.desktop" if DARK else "org.kde.breeze.desktop"
changed = []


def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    rest = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home] + [d for d in rest.split(":") if d] + ["/run/current-system/sw/share"]


def gtk_theme():
    """Breeze when its GTK theme is installed, else GTK's own Adwaita (built
    into GTK, always there). A theme that isn't installed left GTK on light
    Adwaita whatever the mode (2026-11-25: Breeze went with Plasma)."""
    name = "Breeze-Dark" if DARK else "Breeze"
    dirs = data_dirs() + [os.path.expanduser("~/.themes")]
    if any(os.path.isdir(os.path.join(d, "themes", name, "gtk-3.0")) or os.path.isdir(os.path.join(d, name, "gtk-3.0")) for d in dirs):
        return name
    return "Adwaita-dark" if DARK else "Adwaita"


GTK_THEME = gtk_theme()


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".hearth-")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    except FileNotFoundError:
        pass
    os.replace(tmp, path)


# --- INI files that keep their order and anything we don't touch ------------

def read_sections(path):
    """[(header line or None, [lines])], in file order."""
    sections = [(None, [])]
    try:
        with open(path) as f:
            for line in f.read().splitlines():
                if line.startswith("["):
                    sections.append((line.strip(), []))
                else:
                    sections[-1][1].append(line)
    except FileNotFoundError:
        pass
    return sections


def render(sections):
    out = []
    for header, lines in sections:
        if header is not None:
            if out and out[-1] != "":
                out.append("")
            out.append(header)
        out.extend(lines)
    while out and out[-1] == "":
        out.pop()
    return "\n".join(out) + "\n"


def set_key(sections, header, key, value):
    for h, lines in sections:
        if h == header:
            for i, line in enumerate(lines):
                if line.split("=", 1)[0].strip() == key:
                    lines[i] = f"{key}={value}"
                    return
            # Before trailing blank lines.
            at = len(lines)
            while at > 0 and lines[at - 1].strip() == "":
                at -= 1
            lines.insert(at, f"{key}={value}")
            return
    sections.append((header, [f"{key}={value}"]))


def drop_key(sections, header, key):
    for h, lines in sections:
        if h == header:
            lines[:] = [l for l in lines if l.split("=", 1)[0].strip() != key]


# --- kdeglobals ---------------------------------------------------------------

def scheme_file():
    for d in data_dirs():
        p = os.path.join(d, "color-schemes", SCHEME + ".colors")
        if os.path.isfile(p):
            return p
    return None


def apply_kdeglobals():
    path = os.path.join(CONFIG, "kdeglobals")
    src = scheme_file()
    if not src:
        return False
    before = render(read_sections(path)) if os.path.exists(path) else ""
    sections = read_sections(path)
    scheme = read_sections(src)
    # The scheme's colour sections replace ours (plasma-apply-colorscheme does
    # the same); its [General]/[KDE] only carry its name and contrast.
    colour = lambda h: h and (h.startswith("[Colors:") or h.startswith("[ColorEffects:") or h == "[WM]")
    sections = [s for s in sections if not colour(s[0])]
    first = next((i for i, s in enumerate(sections) if s[0] is not None), len(sections))
    sections[first:first] = [(h, [l for l in lines if l.strip()]) for h, lines in scheme if colour(h)]
    set_key(sections, "[General]", "ColorScheme", SCHEME)
    drop_key(sections, "[General]", "ColorSchemeHash")
    set_key(sections, "[Icons]", "Theme", ICONS)
    set_key(sections, "[KDE]", "LookAndFeelPackage", LOOK)
    after = render(sections)
    if after == before:
        return False
    write_atomic(path, after)
    changed.append("kdeglobals")
    return True


def notify_kde():
    try:
        import dbus
        bus = dbus.SessionBus()
        # KConfigWatcher (KDE apps, the KDE portal backend: color-scheme).
        msg = dbus.lowlevel.SignalMessage("/kdeglobals", "org.kde.kconfig.notify", "ConfigChanged")
        groups = {"General": [b"ColorScheme"], "Icons": [b"Theme"], "KDE": [b"LookAndFeelPackage"]}
        msg.append(dbus.Dictionary({k: dbus.Array([dbus.ByteArray(v) for v in vs], signature="ay")
                                    for k, vs in groups.items()}, signature="saay"))
        bus.send_message(msg)
        # KGlobalSettings: palette (0) and icons (4) changed, for older Qt apps.
        for kind in (0, 4):
            m = dbus.lowlevel.SignalMessage("/KGlobalSettings", "org.kde.KGlobalSettings", "notifyChange")
            m.append(dbus.Int32(kind), dbus.Int32(0))
            bus.send_message(m)
        bus.flush()
    except Exception as e:  # no bus (tests): the files are still right
        print(f"hearth-color-scheme: no D-Bus notify: {e}", file=sys.stderr)


# --- GTK ------------------------------------------------------------------------

def apply_settings_ini():
    for ver in ("gtk-3.0", "gtk-4.0"):
        path = os.path.join(CONFIG, ver, "settings.ini")
        if not os.path.exists(path):
            continue
        sections = read_sections(path)
        before = render(sections)
        set_key(sections, "[Settings]", "gtk-application-prefer-dark-theme", "true" if DARK else "false")
        set_key(sections, "[Settings]", "gtk-icon-theme-name", ICONS)
        if ver == "gtk-3.0":
            set_key(sections, "[Settings]", "gtk-theme-name", GTK_THEME)
        after = render(sections)
        if after != before:
            write_atomic(path, after)
            changed.append(ver + "/settings.ini")


MENU_BEGIN = "/* hearth menus: begin (written by hearth-color-scheme; edits here are replaced) */"
MENU_END = "/* hearth menus: end */"


def menu_css(gtk4):
    """Menus as hearth's apps draw theirs (MacMenuStyle.qml), in GTK CSS. GTK
    can't blur what's behind a menu, so the glass is its solid colour."""
    if DARK:
        c = dict(bg="#2b2d30", fg="#f5f5f7", accent="#0a84ff", dim="rgba(255, 255, 255, 0.55)",
                 dimHover="rgba(255, 255, 255, 0.85)", disabled="rgba(255, 255, 255, 0.28)",
                 sep="rgba(255, 255, 255, 0.13)", edge="rgba(0, 0, 0, 0.28)",
                 rim="rgba(255, 255, 255, 0.05)", shadow="rgba(0, 0, 0, 0.32)")
    else:
        c = dict(bg="#f9f9fa", fg="#1d1d1f", accent="#007aff", dim="rgba(0, 0, 0, 0.5)",
                 dimHover="rgba(255, 255, 255, 0.85)", disabled="rgba(0, 0, 0, 0.26)",
                 sep="rgba(0, 0, 0, 0.11)", edge="rgba(0, 0, 0, 0.09)",
                 rim="rgba(255, 255, 255, 0.40)", shadow="rgba(0, 0, 0, 0.2)")
    font = 'font-family: Inter, "Inter Variable", "SF Pro", "Noto Sans", sans-serif; font-size: 14.1px; letter-spacing: -0.09px;'
    if gtk4:
        return f"""popover.menu > contents {{
  background-color: {c['bg']}; color: {c['fg']}; border-radius: 14px; padding: 5px;
  box-shadow: 0 9px 26px {c['shadow']}, 0 0 0 1px {c['edge']}, inset 0 0 0 1px {c['rim']};
  {font}
}}
popover.menu > arrow {{ background-color: {c['bg']}; border-color: {c['edge']}; }}
popover.menu modelbutton {{ min-height: 27px; padding: 0 11px; border-radius: 9px; color: {c['fg']}; }}
popover.menu modelbutton:hover, popover.menu modelbutton:selected {{ background-color: {c['accent']}; color: #ffffff; }}
popover.menu modelbutton:disabled {{ color: {c['disabled']}; }}
popover.menu modelbutton accelerator {{ color: {c['dim']}; letter-spacing: 0.6px; }}
popover.menu modelbutton:hover accelerator {{ color: {c['dimHover']}; }}
popover.menu modelbutton arrow {{ color: {c['dim']}; }}
popover.menu modelbutton:hover arrow {{ color: #ffffff; }}
popover.menu separator {{ min-height: 1px; margin: 4px 11px; background-color: {c['sep']}; }}
"""
    return f"""window.popup decoration, .csd.popup decoration {{
  border-radius: 14px;
  box-shadow: 0 9px 26px {c['shadow']}, 0 0 0 1px {c['edge']};
}}
menu, .menu, .context-menu {{
  background-color: {c['bg']}; color: {c['fg']}; border-radius: 14px; border: none; padding: 5px;
  box-shadow: inset 0 0 0 1px {c['rim']};
  {font}
}}
menu menuitem, .menu menuitem, .context-menu menuitem {{
  min-height: 27px; min-width: 193px; padding: 0 11px; border-radius: 9px; color: {c['fg']}; text-shadow: none;
}}
menu menuitem:hover, .menu menuitem:hover, .context-menu menuitem:hover {{ background-color: {c['accent']}; color: #ffffff; }}
menu menuitem:disabled, .menu menuitem:disabled {{ color: {c['disabled']}; }}
menu menuitem accelerator {{ color: {c['dim']}; letter-spacing: 0.6px; }}
menu menuitem:hover accelerator {{ color: {c['dimHover']}; }}
menu menuitem arrow {{ min-width: 12px; min-height: 12px; color: {c['dim']}; }}
menu menuitem:hover arrow {{ color: #ffffff; }}
menu menuitem check, menu menuitem radio {{
  min-width: 14px; min-height: 14px; margin-right: 6px; background: none; border: none; box-shadow: none; color: inherit;
}}
menu separator, .menu separator {{ min-height: 1px; margin: 4px 11px; background-color: {c['sep']}; }}
menu > arrow {{ background-color: {c['bg']}; border: none; color: {c['dim']}; }}
popover.menu, popover.background.menu {{
  background-color: {c['bg']}; border-radius: 14px; border: 1px solid {c['edge']}; padding: 5px;
}}
popover.menu modelbutton {{ min-height: 27px; padding: 0 11px; border-radius: 9px; color: {c['fg']}; }}
popover.menu modelbutton:hover {{ background-color: {c['accent']}; color: #ffffff; }}
popover.menu separator {{ margin: 4px 11px; background-color: {c['sep']}; }}
"""


def apply_menu_css():
    """hearth's block in gtk.css: replaced in place, everything else kept."""
    for ver in ("gtk-3.0", "gtk-4.0"):
        path = os.path.join(CONFIG, ver, "gtk.css")
        try:
            with open(path) as f:
                before = f.read()
        except FileNotFoundError:
            before = ""
        block = MENU_BEGIN + "\n" + menu_css(ver == "gtk-4.0") + MENU_END + "\n"
        if MENU_BEGIN in before and MENU_END in before:
            head, rest = before.split(MENU_BEGIN, 1)
            tail = rest.split(MENU_END, 1)[1].lstrip("\n")
            after = head + block + tail
        else:
            after = before + ("" if before.endswith("\n") or not before else "\n") + block
        if after != before:
            write_atomic(path, after)
            changed.append(ver + "/gtk.css")


def apply_gsettings():
    """GSettings keys GTK and the GTK portal read, written straight to dconf
    (as services/Mouse.qml does): no schemas needed, which hearth's
    environment doesn't carry."""
    import shutil
    import subprocess
    dconf = shutil.which("dconf")
    if not dconf:
        return
    want = {
        "color-scheme": "prefer-dark" if DARK else "prefer-light",
        "gtk-theme": GTK_THEME,
        "icon-theme": ICONS,
    }
    for k, v in want.items():
        key = "/org/gnome/desktop/interface/" + k
        try:
            cur = subprocess.run([dconf, "read", key], capture_output=True, text=True, timeout=5).stdout.strip()
            if cur == f"'{v}'":
                continue
            subprocess.run([dconf, "write", key, f"'{v}'"], check=True, timeout=5)
            changed.append("gsettings " + k)
        except Exception as e:
            print(f"hearth-color-scheme: dconf {k}: {e}", file=sys.stderr)


def apply_portal_state():
    """What hearth-portal's Settings serve (org.freedesktop.appearance)."""
    state = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    path = os.path.join(state, "hearth", "appearance.json")
    want = {"mode": MODE}
    if ACCENT:
        want["accent"] = ACCENT
    try:
        with open(path) as f:
            have = json.load(f)
    except (OSError, ValueError):
        have = {}
    if {k: have.get(k) for k in want} == want:
        return
    have.update(want)
    write_atomic(path, json.dumps(have) + "\n")
    changed.append("portal")


apply_portal_state()
if apply_kdeglobals():
    notify_kde()
apply_settings_ini()
apply_menu_css()
apply_gsettings()
print(json.dumps({"mode": MODE, "changed": changed}))
