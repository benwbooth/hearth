#!/usr/bin/env python3
"""BlueZ pairing agent for hearth (Quickshell has none).

Registers an org.bluez.Agent1 with capability "KeyboardDisplay" as the
default agent and relays its requests to the shell as JSON lines on stdout:

  {"id": 3, "type": "RequestConfirmation", "device": "/org/bluez/hci0/dev_..",
   "name": "WH-1000XM6", "address": "..", "icon": "audio-headset",
   "passkey": "012345"}

Types: RequestConfirmation, RequestPinCode, RequestPasskey, DisplayPasskey,
DisplayPinCode, RequestAuthorization, AuthorizeService, Cancel, Release.
Display* and Cancel/Release are informational (no reply needed).

Replies come back on stdin, one JSON object per line:

  {"id": 3, "accept": true}                 # confirm / authorize
  {"id": 4, "accept": true, "value": "1234"} # PIN code or passkey
  {"id": 5, "accept": false}                 # reject

Options: --no-default registers the agent without making it the default
(for testing next to another desktop's agent).
"""
import itertools
import json
import sys

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

AGENT_PATH = "/org/hearth/BtAgent"
AGENT_IFACE = "org.bluez.Agent1"
CAPABILITY = "KeyboardDisplay"

ids = itertools.count(1)
# id -> (type, ok, err)
pending = {}
bus = None
make_default = "--no-default" not in sys.argv


class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"


class Canceled(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Canceled"


def emit(obj):
    try:
        print(json.dumps(obj), flush=True)
    except BrokenPipeError:
        GLib.idle_add(loop.quit)


def device_info(path):
    info = {"device": str(path), "name": "", "address": "", "icon": ""}
    try:
        props = dbus.Interface(bus.get_object("org.bluez", path),
                               "org.freedesktop.DBus.Properties")
        allp = props.GetAll("org.bluez.Device1")
        info["name"] = str(allp.get("Alias", allp.get("Name", "")))
        info["address"] = str(allp.get("Address", ""))
        info["icon"] = str(allp.get("Icon", ""))
    except dbus.DBusException:
        pass
    if not info["name"]:
        info["name"] = info["address"] or str(path).rsplit("/", 1)[-1]
    return info


def request(kind, device, ok=None, err=None, **extra):
    rid = next(ids)
    msg = {"id": rid, "type": kind}
    if device is not None:
        msg.update(device_info(device))
    msg.update(extra)
    if ok is not None:
        pending[rid] = (kind, ok, err)
    emit(msg)
    return rid


def cancel_all():
    for rid, (_kind, _ok, err) in list(pending.items()):
        err(Canceled("Canceled"))
    pending.clear()


class Agent(dbus.service.Object):
    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Release(self):
        cancel_all()
        emit({"id": next(ids), "type": "Release"})

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="",
                         async_callbacks=("ok", "err"))
    def AuthorizeService(self, device, uuid, ok, err):
        request("AuthorizeService", device, ok, err, uuid=str(uuid))

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="s",
                         async_callbacks=("ok", "err"))
    def RequestPinCode(self, device, ok, err):
        request("RequestPinCode", device, ok, err)

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="u",
                         async_callbacks=("ok", "err"))
    def RequestPasskey(self, device, ok, err):
        request("RequestPasskey", device, ok, err)

    @dbus.service.method(AGENT_IFACE, in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        request("DisplayPasskey", device, passkey="%06d" % int(passkey), entered=int(entered))

    @dbus.service.method(AGENT_IFACE, in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        request("DisplayPinCode", device, pincode=str(pincode))

    @dbus.service.method(AGENT_IFACE, in_signature="ou", out_signature="",
                         async_callbacks=("ok", "err"))
    def RequestConfirmation(self, device, passkey, ok, err):
        request("RequestConfirmation", device, ok, err, passkey="%06d" % int(passkey))

    @dbus.service.method(AGENT_IFACE, in_signature="o", out_signature="",
                         async_callbacks=("ok", "err"))
    def RequestAuthorization(self, device, ok, err):
        request("RequestAuthorization", device, ok, err)

    @dbus.service.method(AGENT_IFACE, in_signature="", out_signature="")
    def Cancel(self):
        cancel_all()
        emit({"id": next(ids), "type": "Cancel"})


def handle_reply(line):
    try:
        msg = json.loads(line)
        rid = int(msg["id"])
    except (ValueError, KeyError, TypeError):
        print("hearth-bt-agent: bad reply %r" % line, file=sys.stderr, flush=True)
        return
    entry = pending.pop(rid, None)
    if entry is None:
        return
    kind, ok, err = entry
    if not msg.get("accept"):
        err(Rejected("Rejected by user"))
        return
    value = msg.get("value")
    try:
        if kind == "RequestPinCode":
            if not value:
                raise ValueError("empty PIN")
            ok(dbus.String(str(value)))
        elif kind == "RequestPasskey":
            ok(dbus.UInt32(int(value)))
        else:
            ok()
    except (ValueError, TypeError):
        err(Rejected("Invalid value"))


def on_stdin(source, condition):
    if condition & (GLib.IO_HUP | GLib.IO_ERR):
        line = sys.stdin.readline()
        if line.strip():
            handle_reply(line)
        loop.quit()
        return False
    line = sys.stdin.readline()
    if not line:  # EOF: the shell went away.
        loop.quit()
        return False
    if line.strip():
        handle_reply(line)
    return True


def register():
    try:
        mgr = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")
        try:
            mgr.RegisterAgent(AGENT_PATH, CAPABILITY)
        except dbus.DBusException as e:
            if e.get_dbus_name() != "org.bluez.Error.AlreadyExists":
                raise
        if make_default:
            mgr.RequestDefaultAgent(AGENT_PATH)
        print("hearth-bt-agent: registered as %s%s" % (bus.get_unique_name(),
              " (default)" if make_default else ""),
              file=sys.stderr, flush=True)
    except dbus.DBusException as e:
        print("hearth-bt-agent: register failed: %s" % e, file=sys.stderr, flush=True)


def unregister():
    try:
        mgr = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")
        mgr.UnregisterAgent(AGENT_PATH)
    except dbus.DBusException:
        pass


def on_bluez_owner(owner):
    # (Re)register whenever bluetoothd (re)appears.
    if owner:
        register()
    else:
        cancel_all()


def main():
    global bus, loop
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    Agent(bus, AGENT_PATH)
    loop = GLib.MainLoop()
    bus.watch_name_owner("org.bluez", on_bluez_owner)
    GLib.io_add_watch(sys.stdin.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, on_stdin)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    cancel_all()
    unregister()


if __name__ == "__main__":
    main()
