class ComputerUse:
    """Client for the computer-use MCP server Codex uses
    (codex-computer-use-linux, /etc/nixos packages): it reads windows
    through AT-SPI, takes screenshots, and clicks and types through the
    portal or ydotool. One server process, started on first use."""

    # System setup, and window geometry the assistant has no use for. Each
    # tool's description is part of every prompt, and a local model reads
    # prompts at a few hundred tokens a second, so fewer tools answer sooner.
    # list_windows needs a GNOME Shell backend (arbor has none): list_apps.
    HIDDEN = {"doctor", "setup_accessibility", "setup_window_targeting", "move_window", "resize_window",
              "drag", "focused_window", "list_windows"}
    BIN = "codex-computer-use-linux"

    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()
        self.waiting = {}
        self.nid = 0
        self.defs = []          # MCP tool definitions
        self.readonly = set()

    def available(self):
        return bool(shutil.which(self.BIN))

    def _reader(self, proc):
        for line in proc.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            qu = self.waiting.get(m.get("id"))
            if qu:
                qu.put(m)

    def _rpc(self, method, params=None, timeout=60):
        with self.lock:
            self.nid += 1
            rid = self.nid
            qu = queue.Queue()
            self.waiting[rid] = qu
            self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": rid, "method": method,
                                              "params": params or {}}) + "\n")
            self.proc.stdin.flush()
        try:
            m = qu.get(timeout=timeout)
        except queue.Empty:
            raise RuntimeError("the computer-use server didn't answer %s" % method)
        finally:
            self.waiting.pop(rid, None)
        if m.get("error"):
            raise RuntimeError(m["error"].get("message") or str(m["error"]))
        return m.get("result") or {}

    def start(self):
        if self.proc and self.proc.poll() is None:
            return True
        exe = shutil.which(self.BIN)
        if not exe:
            return False
        self.proc = subprocess.Popen([exe, "mcp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True, bufsize=1, start_new_session=True)
        threading.Thread(target=self._reader, args=(self.proc,), daemon=True).start()
        self._rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "hearth", "version": "1"}}, timeout=20)
        with self.lock:
            self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
            self.proc.stdin.flush()
        tools = self._rpc("tools/list", timeout=20).get("tools") or []
        self.defs = [t for t in tools if t["name"] not in self.HIDDEN]
        # A screenshot changes nothing, whatever its annotation says.
        self.readonly = {t["name"] for t in self.defs
                         if (t.get("annotations") or {}).get("readOnlyHint") or t["name"] == "screenshot"}
        return True

    def tools(self, vision):
        try:
            if not self.start():
                return []
        except Exception as e:  # noqa: BLE001
            log("computer use: %s" % e)
            return []
        return [{"type": "function", "function": {"name": t["name"], "description": brief(t.get("description", ""), 240),
                                                  "parameters": slim_schema(t.get("inputSchema") or {"type": "object", "properties": {}})}}
                for t in self.defs if vision or t["name"] != "screenshot"]

    def names(self):
        return {t["name"] for t in self.defs}

    def call(self, name, args):
        """-> (text, [(mime, base64)...])"""
        self.start()
        r = self._rpc("tools/call", {"name": name, "arguments": args or {}}, timeout=90)
        texts, images = [], []
        for c in r.get("content") or []:
            if c.get("type") == "text":
                texts.append(c.get("text", ""))
            elif c.get("type") == "image" and c.get("data"):
                images.append((c.get("mimeType") or "image/png", c["data"]))
        if r.get("structuredContent") and not texts:
            texts.append(json.dumps(r["structuredContent"]))
        text = "\n".join(texts).strip() or ("Error." if r.get("isError") else "Done.")
        if len(text) > 6000:
            text = text[:6000] + "\n[cut: %d more characters]" % (len(text) - 6000)
        if r.get("isError") and not text.startswith("Error"):
            text = "Error: " + text
        return text, images


def brief(text, limit):
    """The first sentences of a description, up to `limit` characters."""
    text = " ".join((text or "").split())
    if len(text) <= limit:
        return text
    cut = text[:limit]
    end = cut.rfind(". ")
    return cut[:end + 1] if end > limit // 3 else cut.rstrip() + "…"


def slim_schema(schema):
    """The same parameters with shorter descriptions (they repeat in every prompt)."""
    if isinstance(schema, dict):
        out = {}
        for k, v in schema.items():
            if k == "description" and isinstance(v, str):
                out[k] = brief(v, 90)
            elif k in ("examples", "default", "title", "$schema", "format"):
                continue
            else:
                out[k] = slim_schema(v)
        return out
    if isinstance(schema, list):
        return [slim_schema(v) for v in schema]
    return schema


