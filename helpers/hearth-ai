]


def vram_processes():
    """Per process VRAM from amdgpu's fdinfo (drm-memory-vram), each DRM
    client counted once."""
    per = {}
    for fdinfo in glob.glob("/proc/[0-9]*/fdinfo"):
        pid = fdinfo.split("/")[2]
        seen = set()
        try:
            fds = os.listdir(fdinfo)
        except OSError:
            continue
        for fd in fds:
            try:
                with open(os.path.join(fdinfo, fd)) as f:
                    txt = f.read()
            except OSError:
                continue
            if "drm-client-id" not in txt:
                continue
            cid = re.search(r"drm-client-id:\s*(\d+)", txt)
            pdev = re.search(r"drm-pdev:\s*(\S+)", txt)
            key = (cid.group(1) if cid else fd, pdev.group(1) if pdev else "")
            if key in seen:
                continue
            seen.add(key)
            m = re.search(r"drm-memory-vram:\s*(\d+)\s*KiB", txt)
            if m:
                e = per.setdefault((pid, key[1]), 0)
                per[(pid, key[1])] = e + int(m.group(1)) * 1024
    out = []
    for (pid, pdev), vram in per.items():
        if vram < 32 << 20:
            continue
        try:
            comm = open("/proc/%s/comm" % pid).read().strip()
            cmd = open("/proc/%s/cmdline" % pid).read().replace("\0", " ").strip()
        except OSError:
            continue
        # comm is cut at 15 characters; Nix wrappers add ".x-wrapped".
        exe = os.path.basename(cmd.split(" ", 1)[0]) if cmd else comm
        label = re.sub(r"-wrapped$", "", exe.lstrip(".")) or comm
        for pat, name in KNOWN:
            if re.search(pat, cmd):
                label = name
                break
        out.append({"pid": int(pid), "pci": pdev, "name": label, "comm": comm, "vram": vram,
                    "vramText": human_bytes(vram)})
    out.sort(key=lambda p: -p["vram"])
    return out[:20]


