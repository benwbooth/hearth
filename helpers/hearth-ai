def parse_bytes(s):
    m = re.match(r"^\s*([\d.]+)\s*([KMGT]?)i?B?\s*$", s, re.I)
    if not m:
        return None
    return int(float(m.group(1)) * (1024 ** "BKMGT".index((m.group(2) or "B").upper())))


def keep_minutes(cfg):
    """How long a server keeps a model hearth loaded (Ollama's keep_alive).
    With "Unload unused models" on, the memory manager decides (it may keep
    a slow-loading model longer than idleMinutes), so the server's own timer
    only backs it up at its one-hour ceiling; off, the server unloads after
    idleMinutes itself. (Replaces the separate keepAlive setting.)"""
    if cfg.get("autoUnload", True):
        return 60
    return max(1, int(float(cfg.get("idleMinutes", 5) or 5)))


def provider_unit(pid):
    """The systemd user unit behind a local server, or "" (Ollama runs as
    a system service; a llama-server started by hand has no unit)."""
    if pid == "llamacpp":
        return LLAMA_UNIT
    if pid.startswith("service:"):
        return pid[len("service:"):]
    if pid == "magnitude":
        now = time.time()
        if now - _magnitude_unit[1] > 60:
            r = subprocess.run(["systemctl", "--user", "cat", "magnitude.service"],
                               capture_output=True, timeout=5, stdin=subprocess.DEVNULL)
            _magnitude_unit[:] = ["magnitude.service" if r.returncode == 0 else "", now]
        return _magnitude_unit[0]
    return ""


_magnitude_unit = ["", 0.0]   # [unit or "", when checked]


def make_room_cli(arg):
    """hearth-ai --make-room inkling-2-mini.service | 20G: evict idle models
    until that much VRAM is free (a unit's need is its peak VRAM last time,
    else its model file plus room for context). Always exits 0: a unit
    must still start when nothing can be freed."""
    need = parse_bytes(arg)
    key = ""
    if need is None:
        unit = arg if arg.endswith(".service") else arg + ".service"
        key = "service:" + unit
        size = 0
        for svc in hm.services():
            if svc["unit"] == unit:
                for f in glob.glob(re.sub(r"-00001-of-(\d+)\.gguf$", r"-*-of-\1.gguf", hm.service_model_path(svc))):
                    size += os.path.getsize(f)
        need = ARB.need_for(key, size)
    free = ARB.make_room(need, exclude=(key,))
    reserve = int(settings()[0].get("desktopReserveMB", 2048) or 0) << 20
    print("hearth-ai: %s free of %s needed (%s for the model, %s kept for the desktop)"
          % (human_bytes(free), human_bytes(need + reserve), human_bytes(need), human_bytes(reserve)), file=sys.stderr)
    ARB.mem.save(force=True)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--state":
        print(json.dumps(full_state(True), indent=1))
        return
    if len(sys.argv) > 2 and sys.argv[1] == "--make-room":
        make_room_cli(sys.argv[2])
        return
    asst = Assistant()
    watching = {"on": False}
    # A test shell doesn't serve apps (it would take the real one's place),
    # unless the test gives it a port of its own.
    serve_apps = os.environ.get("HEARTH_SESSION_DRYRUN") != "1" or bool(os.environ.get("HEARTH_AI_API_PORT"))

    def poller():
        # The memory manager looks every 5 s (2 s while a UI watches); the
        # shell gets the state every 30 s unless it watches.
        last = last_emit = 0
        while True:
            time.sleep(0.5)
            now = time.time()
            period = 2 if watching["on"] else 5
            if now - last >= period:
                last = now
                if serve_apps:
                    try:
                        API.sync(settings()[0])
                    except Exception as e:  # noqa: BLE001
                        log("app API:", e)
                try:
                    st = ARB.snapshot(watching["on"], manage=True)
                    while ARB.notices:
                        emit(ARB.notices.pop(0))
                    # The menu bar's GPU % / VRAM % stay current.
                    emit({"type": "gpu", "gpu": st["gpu"], "loadedCount": len(st["loaded"])})
                    if watching["on"] or now - last_emit >= 30:
                        last_emit = now
                        emit(st)
                except Exception as e:  # noqa: BLE001
                    log("state:", e)

    threading.Thread(target=poller, daemon=True).start()

    def bg(fn, *a):
        threading.Thread(target=fn, args=a, daemon=True).start()

    def find_key(key):
        for fresh in (False, True):
            st = ARB.snapshot(False) if fresh or not ARB.last else ARB.last
            for e in st["loaded"]:
                if e["key"] == key:
                    return "loaded", e
            for it in st["installed"]:
                if it["key"] == key:
                    return "installed", it
        return None, None

    def timed_load(p, pid, model, key, size, cfg):
        """Load a model, making room first, and remember how long it took."""
        need = ARB.need_for(key, size)
        g = (ARB.last or {}).get("gpu")
        if g and g["free"] < need:
            emit({"type": "busy", "provider": pid, "model": model, "what": "making room"})
            ARB.make_room(need, exclude=(key,))
        emit({"type": "busy", "provider": pid, "model": model, "what": "loading"})
        t0 = time.time()
        p.load(model, keep_minutes(cfg))
        ARB.mem.note(key, loadSec=round(time.time() - t0, 1), loadMeasured=True, lastActive=time.time())
        ARB.mem.save(force=True)

    def keyed(req):
        cmd, key = req["cmd"], req.get("key", "")
        cfg, _ = settings()
        name = key
        try:
            kind, item = find_key(key)
            if item is None:
                raise RuntimeError("that model is gone")
            name = item.get("name", key)
            if cmd == "unloadKey":
                if kind != "loaded":
                    raise RuntimeError("%s isn't loaded" % name)
                ARB.unloading[key] = time.time()
                unload_entry(item)
            elif cmd == "loadKey":
                runners = item.get("runners") or []
                r = next((x for x in runners if x["provider"] == req.get("provider")), runners[0] if runners else None)
                if not r:
                    raise RuntimeError("nothing here can load %s" % name)
                p = providers(cfg).get(r["provider"])
                if p is None:
                    raise RuntimeError("%s is turned off" % r["provider"])
                lkey = r["provider"] + ":" + r["model"] if not r["provider"].startswith("service:") else r["provider"]
                timed_load(p, r["provider"], r["model"], lkey, item.get("size", 0), cfg)
            elif cmd == "remove":
                if kind != "installed" or not item.get("deletable"):
                    raise RuntimeError("%s can't be removed from here" % name)
                via = item.get("deleteVia")
                if via:
                    p = providers(cfg).get(via["provider"])
                    if p is None or not hasattr(p, "delete"):
                        raise RuntimeError("%s can't delete models" % via["provider"])
                    p.delete(via["model"])
                else:
                    hm.trash(item.get("deletePaths") or [])
                ARB.inv = (0, [])
            emit({"type": "done", "cmd": cmd, "key": key, "model": name})
        except Exception as e:  # noqa: BLE001
            emit({"type": "done", "cmd": cmd, "key": key, "model": name, "error": str(e)})
        emit(ARB.snapshot(watching["on"]))

    def pin(req):
        cfg, data = settings()
        pins = [k for k in (cfg.get("pinned") or []) if k != req.get("key")]
        if req.get("on"):
            pins.append(req.get("key"))
        # The shell owns settings.json: ask it to write.
        emit({"type": "setting", "path": "ai.pinned", "value": pins})

    def catalog(req):
