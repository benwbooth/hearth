class Ollama:
    id = "ollama"
    label = "Ollama"

    def __init__(self, cfg):
        self.url = cfg.get("url", "http://127.0.0.1:11434").rstrip("/")

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": False,
              "installed": [], "loaded": [], "error": ""}
        try:
            tags = http(self.url + "/api/tags", timeout=2)
            ps = http(self.url + "/api/ps", timeout=2)
        except (OSError, ValueError) as e:
            st["error"] = "Ollama isn't running at %s" % self.url if isinstance(e, (urllib.error.URLError, OSError)) else str(e)
            return st
        st["running"] = True
        for m in tags.get("models", []):
            d = m.get("details") or {}
            st["installed"].append({
                "name": m["name"], "size": m.get("size", 0), "sizeText": human_bytes(m.get("size")),
                "params": d.get("parameter_size", ""), "quant": d.get("quantization_level", ""),
                "family": d.get("family", ""), "capabilities": m.get("capabilities") or [],
                "modified": m.get("modified_at", ""),
            })
        for m in ps.get("models", []):
            st["loaded"].append({
                "name": m["name"], "vram": m.get("size_vram", 0), "vramText": human_bytes(m.get("size_vram")),
                "size": m.get("size", 0), "expires": m.get("expires_at", ""),
                "context": m.get("context_length", 0),
            })
        return st

    def load(self, model, keep_minutes):
        http(self.url + "/api/generate", {"model": model, "prompt": "", "keep_alive": "%dm" % keep_minutes},
             timeout=300)

    def unload(self, model):
        http(self.url + "/api/generate", {"model": model, "prompt": "", "keep_alive": 0}, timeout=60)

    def delete(self, model):
        http(self.url + "/api/delete", {"model": model}, timeout=60, method="DELETE")

    def pull(self, model, progress):
        req = urllib.request.Request(self.url + "/api/pull", data=json.dumps({"model": model}).encode(),
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=3600) as r:
            for line in r:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                progress(ev.get("status", ""), ev.get("completed", 0), ev.get("total", 0), ev.get("error", ""))

    def chat(self, model, messages, tools, keep_minutes, reasoning=None):
        body = {"model": model, "messages": messages, "stream": False, "think": False,
                "keep_alive": "%dm" % keep_minutes, "options": {"temperature": 0.2}}
        if tools:
            body["tools"] = tools
        r = http(self.url + "/api/chat", body, timeout=180)
        msg = r.get("message") or {}
        calls = []
        for c in msg.get("tool_calls") or []:
            fn = c.get("function") or {}
            args = fn.get("arguments") or {}
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except ValueError:
                    args = {}
            calls.append({"name": fn.get("name", ""), "args": args})
        return msg.get("content") or "", calls, msg


class LlamaCpp:
    """llama-server in router mode (--models-dir): GET /models lists every
    GGUF with its status, POST /models/load and /models/unload switch them."""
    id = "llamacpp"
    label = "llama.cpp"

    def __init__(self, cfg):
        self.url = cfg.get("url", "http://127.0.0.1:8181").rstrip("/")
        self.models_dir = os.path.expanduser(cfg.get("modelsDir", "~/models"))

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": False,
              "installed": [], "loaded": [], "error": "", "modelsDir": self.models_dir,
              "serverAvailable": bool(shutil.which("llama-server")), "managed": True}
        # GGUFs on disk, even while the server is stopped.
        on_disk = {}
        for f in sorted(glob.glob(os.path.join(self.models_dir, "**", "*.gguf"), recursive=True)):
            if "mmproj" in os.path.basename(f).lower():
                continue
            name = os.path.splitext(os.path.basename(f))[0]
            try:
                size = os.path.getsize(f)
            except OSError:
                size = 0
            on_disk[name] = {"name": name, "size": size, "sizeText": human_bytes(size), "path": f,
                             "params": "", "quant": "", "capabilities": []}
        try:
            r = http(self.url + "/models", timeout=2)
            st["running"] = True
        except (OSError, ValueError):
            st["installed"] = list(on_disk.values())
            st["error"] = "llama-server isn't running"
            return st
        for m in r.get("data", []):
            name = m.get("id", "")
            status = (m.get("status") or {}).get("value", "") if isinstance(m.get("status"), dict) else str(m.get("status", ""))
            entry = on_disk.pop(name, {"name": name, "size": 0, "sizeText": "", "params": "", "quant": "",
                                       "capabilities": []})
            st["installed"].append(entry)
            if status in ("loaded", "loading"):
                st["loaded"].append({"name": name, "vram": 0, "vramText": "", "status": status})
        st["installed"] += list(on_disk.values())
        return st

    def chat_url(self):
        return self.url + "/v1/chat/completions"

    def load(self, model, keep_minutes):
        http(self.url + "/models/load", {"model": model}, timeout=300)

    def unload(self, model):
        http(self.url + "/models/unload", {"model": model}, timeout=60)

    def chat(self, model, messages, tools, keep_minutes, reasoning=None):
        body = {"model": model, "messages": messages, "temperature": 0.2, "stream": False}
        if tools:
            body["tools"] = tools
        if reasoning:
            # llama.cpp's --jinja templates read reasoning_effort (Inkling,
            # gpt-oss); a request's kwargs override the server's own, so
            # the assistant can think less than a coding session does.
            body["chat_template_kwargs"] = {"reasoning_effort": reasoning}
        r = http(self.chat_url(), body, timeout=180)
        msg = (r.get("choices") or [{}])[0].get("message") or {}
        calls = []
        for c in msg.get("tool_calls") or []:
            fn = c.get("function") or {}
            try:
                args = json.loads(fn.get("arguments") or "{}")
            except ValueError:
                args = {}
            calls.append({"name": fn.get("name", ""), "args": args, "id": c.get("id")})
        return msg.get("content") or "", calls, msg


class AgentCli:
    """Claude Code / Codex / Gemini CLI, one non-interactive prompt per turn.
    They get no tools of their own here: hearth describes its tools in the
    prompt and the CLI answers with a JSON line choosing one."""

    def __init__(self, pid, cfg):
        self.id = pid
        self.label = CLI[pid]["label"]
        self.bin = shutil.which(CLI[pid]["bin"])
        self.model = cfg.get("model", "")

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "cloud", "running": bool(self.bin),
              "installed": [], "loaded": [], "error": "" if self.bin else "%s isn't installed" % self.label,
              "path": self.bin or ""}
        if self.bin:
            st["installed"] = [{"name": n, "size": 0, "sizeText": "", "params": "", "quant": "", "capabilities": ["tools"]}
                               for n in self.models()]
        return st

    def models(self):
        return {"claude": ["default", "sonnet", "opus", "haiku"],
                "codex": ["default"],
                "gemini": ["default", "gemini-2.5-flash", "gemini-2.5-pro"]}[self.id]

    def command(self, model, prompt):
        m = [] if not model or model == "default" else None
        if self.id == "claude":
            return [self.bin, "-p", "--output-format", "text", "--max-turns", "1"] + \
                   ([] if m is not None else ["--model", model]) + [prompt]
        if self.id == "codex":
            return [self.bin, "exec", "--skip-git-repo-check", "--sandbox", "read-only"] + \
                   ([] if m is not None else ["-m", model]) + [prompt]
        return [self.bin] + ([] if m is not None else ["-m", model]) + ["-p", prompt]

    def chat(self, model, messages, tools, keep_minutes, reasoning=None):
        if not self.bin:
            raise RuntimeError("%s isn't installed" % self.label)
        tool_text = "\n".join("- %s(%s): %s" % (t["function"]["name"],
                                                ", ".join(t["function"]["parameters"].get("properties", {}).keys()),
                                                t["function"]["description"]) for t in tools)
        convo = "\n".join("%s: %s" % (m["role"].upper(), m.get("content") or json.dumps(m.get("tool_calls", "")))
                          for m in messages)
        prompt = ("You are answering for a desktop assistant. Do not use any tools of your own and do not edit files.\n"
                  "Available desktop tools:\n%s\n\n"
                  "Reply with exactly one JSON object on one line and nothing else: "
                  '{"tool": "<name>", "args": {...}} to use a tool, or {"answer": "<short spoken reply>"}.\n\n%s'
                  % (tool_text, convo))
        r = subprocess.run(self.command(model, prompt), capture_output=True, text=True, timeout=240, cwd=HOME,
                           stdin=subprocess.DEVNULL)
        text = (r.stdout or "").strip()
        m = re.search(r"\{.*\}", text, re.S)
        if m:
            try:
                obj = json.loads(m.group(0))
                if "tool" in obj:
                    return "", [{"name": obj["tool"], "args": obj.get("args") or {}}], {"role": "assistant", "content": text}
                if "answer" in obj:
                    return obj["answer"], [], {"role": "assistant", "content": obj["answer"]}
            except ValueError:
                pass
        if r.returncode != 0 and not text:
            raise RuntimeError((r.stderr or "").strip().splitlines()[-1:] or ["%s failed" % self.label])
        return text, [], {"role": "assistant", "content": text}


class LlamaInstance(LlamaCpp):
    """A llama-server hearth didn't start (found by its process): one model,
    used through its OpenAI API; "unload" stops the process."""

    def __init__(self, pid, port, alias, model_path):
        self.id = "llamacpp:%d" % port
        self.label = "llama.cpp :%d" % port
        self.url = "http://127.0.0.1:%d" % port
        self.pid = pid
        self.alias = alias or os.path.splitext(os.path.basename(model_path))[0]
        self.model_path = model_path
        self.models_dir = os.path.dirname(model_path)

    def state(self):
        size = 0
        try:
            size = os.path.getsize(self.model_path)
        except OSError:
            pass
        m = {"name": self.alias, "size": size, "sizeText": human_bytes(size), "path": self.model_path,
             "params": "", "quant": "", "capabilities": []}
        return {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": True,
                "external": True, "pid": self.pid, "installed": [m],
                "loaded": [{"name": self.alias, "vram": 0, "vramText": "", "pid": self.pid}], "error": ""}

    def load(self, model, keep_minutes):
        pass

    def unload(self, model):
        os.kill(self.pid, 15)


class Magnitude(LlamaCpp):
    """Magnitude (magnitude.dev): its own engine that spreads a model over
    VRAM, RAM and SSD. `magnitude serve` on :10100; models are listed,
    loaded and stopped with its CLI, chat goes through its OpenAI API."""
    id = "magnitude"
    label = "Magnitude"

    def __init__(self, cfg):
        self.url = "http://127.0.0.1:10100/inference"
        self.models_dir = ""

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": "http://127.0.0.1:10100",
              "running": False, "installed": [], "loaded": [], "error": "", "available": hm.magnitude_installed()}
        if not st["available"]:
            st["error"] = "Magnitude isn't installed"
            return st
        health = hm.magnitude_running()
        if not health:
            st["error"] = "Magnitude isn't running (magnitude serve)"
            return st
        st["running"] = True
        hw = ((health.get("state") or {}).get("hardware") or {})
        st["backend"] = hw.get("backend", "")
        inst, loaded = hm.magnitude_models()
        st["installed"] = [{"name": m["id"], "label": m["name"] + (" " + m["quant"] if m["quant"] else ""),
                            "size": m["size"], "sizeText": m["sizeText"], "params": "", "quant": m["quant"],
                            "context": m["context"], "maxContext": m["maxContext"], "fits": m["fits"],
                            "note": m["note"], "arch": m["arch"], "capabilities": ["vision"] if m["vision"] else []}
                           for m in inst]
        st["loaded"] = [{"name": m["id"], "label": m["name"], "vram": 0, "vramText": "", "context": m["context"]}
                        for m in loaded]
        return st

    def load(self, model, keep_minutes):
        hm.magnitude("models", "load", model, timeout=900)

    def unload(self, model):
        hm.magnitude("models", "stop", model, timeout=60)

    def delete(self, model):
        hm.magnitude("models", "rm", model, timeout=120)

    def pull(self, model, progress):
        progress("downloading", 0, 0, "")
        hm.magnitude("models", "pull", model, timeout=6 * 3600)


class ModelService(LlamaCpp):
    """A systemd user unit that serves one model (inkling-2-mini.service):
    loaded while the unit runs, Load starts it, Unload stops it. Units
    behind a socket (inkling-2-mini-proxy.socket) start on demand anyway."""

    def __init__(self, svc):
        self.svc = svc
        self.unit = svc["unit"]
        self.id = "service:" + self.unit
        base = self.unit[:-len(".service")]
        self.label = re.sub(r"\s*local inference server.*$|\s*inference server.*$", "", svc["desc"], flags=re.I) or base
        self.model_path = hm.service_model_path(svc)
        self.models_dir = os.path.dirname(self.model_path)
        self.alias = base
        self.url = "http://127.0.0.1:%d" % self.port()

    def port(self):
        env = hm._read(self.svc["env"])
        m = re.search(r"^\w*PORT=(\d+)", env, re.M) or re.search(r'port="\$\{\w+:-(\d+)\}"', self.svc["body"]) \
            or re.search(r"--port\s+(\d+)", self.svc["body"])
        return int(m.group(1)) if m else 8080

    def state(self):
        info = hm.unit_info(self.unit)
        active = info.get("ActiveState", "")
        size = 0
        for f in glob.glob(re.sub(r"-00001-of-(\d+)\.gguf$", r"-*-of-\1.gguf", self.model_path)) or [self.model_path]:
            try:
                size += os.path.getsize(f)
            except OSError:
                pass
        m = {"name": self.alias, "label": self.label, "size": size, "sizeText": human_bytes(size),
             "path": self.model_path, "params": "", "quant": "", "capabilities": []}
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": active == "active",
              "service": True, "unit": self.unit, "socket": self.svc["socket"], "activeState": active,
              "installed": [m], "loaded": [], "error": "", "unitInfo": info}
        if active in ("active", "activating", "reloading"):
            st["loaded"] = [{"name": self.alias, "label": self.label, "vram": 0, "vramText": "",
                             "pid": int(info.get("MainPID") or 0), "status": active}]
        return st

    def load(self, model, keep_minutes):
        r = subprocess.run(["systemctl", "--user", "start", self.unit], capture_output=True, text=True, timeout=600)
        if r.returncode:
            raise RuntimeError((r.stderr or "couldn't start %s" % self.unit).strip())

    def unload(self, model):
        r = subprocess.run(["systemctl", "--user", "stop", self.unit], capture_output=True, text=True, timeout=120)
        if r.returncode:
            raise RuntimeError((r.stderr or "couldn't stop %s" % self.unit).strip())


def context_for(cfg, path):
    """Tokens of context for a model hearth starts: its own choice in
    modelContext, else contextSize; 0 = automatic."""
    per = cfg.get("modelContext") or {}
    v = per.get(path, per.get(os.path.realpath(path), None)) if isinstance(per, dict) else None
    if v is None:
        v = cfg.get("contextSize", 0)
    try:
        return max(0, int(v or 0))
    except (TypeError, ValueError):
        return 0


_ctx_cache = {}   # (port, unit) -> n_ctx


def served_context(port, unit=""):
    """The context a running llama-server actually got (its /props), so an
    automatic choice shows what it came to."""
    k = (port, unit)
    if _ctx_cache.get(k):
        return _ctx_cache[k]
    try:
        p = http("http://127.0.0.1:%d/props" % port, timeout=1)
        n = int((p.get("default_generation_settings") or {}).get("n_ctx") or p.get("n_ctx") or 0)
    except (OSError, ValueError, AttributeError, TypeError):
        n = 0
    if n:
        _ctx_cache[k] = n
    return n


class GgufRunner(LlamaCpp):
    """Runs a GGUF nothing else is set up to run (a model file in a folder,
    an older quant beside a model unit's): its own llama-server in a
    transient user unit, hearth-gguf-<n>.service, on a free local port,
    with the llama.cpp build hm.pick_llama_server chooses. Load starts it,
    Unload stops it; the memory manager treats it like a model unit."""
    id = "gguf"
    label = "llama.cpp"
    PREFIX = "hearth-gguf-"

    def __init__(self, cfg):
        self.cfg = cfg
        self.url = ""
        self.models_dir = ""

    def running(self):
        """[{unit, path, port, pid}] of the servers it started."""
        r = subprocess.run(["systemctl", "--user", "list-units", "--plain", "--no-legend", "--all",
                            self.PREFIX + "*.service"], capture_output=True, text=True, timeout=10)
        out = []
        for line in r.stdout.splitlines():
            unit = line.split()[0] if line.split() else ""
            if not unit.startswith(self.PREFIX):
                continue
            info = hm.unit_info(unit)
            if info.get("ActiveState") not in ("active", "activating"):
                continue
            d = subprocess.run(["systemctl", "--user", "show", "-p", "Description", "--value", unit],
                               capture_output=True, text=True, timeout=10).stdout.strip()
            m = re.match(r"hearth: (.+) on :(\d+)$", d)
            if m:
                out.append({"unit": unit, "path": m.group(1), "port": int(m.group(2)),
                            "pid": int(info.get("MainPID") or 0), "state": info.get("ActiveState")})
        return out

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": "", "running": True,
              "gguf": True, "installed": [], "loaded": [], "error": ""}
        for r in self.running():
            st["loaded"].append({"name": r["path"], "label": os.path.splitext(os.path.basename(r["path"]))[0],
                                 "unit": r["unit"], "port": r["port"], "pid": r["pid"], "vram": 0, "vramText": "",
                                 "context": served_context(r["port"], r["unit"])})
        return st

    def _start(self, exe, path, extra):
        """Start its llama-server with these sizing args; wait until it answers.
        Returns the unit."""
        used = {r["port"] for r in self.running()}
        port = next(p for p in range(18400, 18500) if p not in used and not rt.port_open(p))
        n = 1
        while hm.unit_info("%s%d.service" % (self.PREFIX, n)).get("ActiveState") in ("active", "activating"):
            n += 1
        unit = "%s%d.service" % (self.PREFIX, n)
        args = [exe, "-m", path, "--host", "127.0.0.1", "--port", str(port), "--jinja"] + extra
        if model_category(path) == "embedding":
            args.append("--embeddings")
        since = time.strftime("%Y-%m-%d %H:%M:%S")
        r = subprocess.run(["systemd-run", "--user", "--unit", unit, "--collect", "--quiet",
                            "--description", "hearth: %s on :%d" % (path, port), "-p", "KillMode=mixed"] + args,
                           capture_output=True, text=True, timeout=30)
        if r.returncode:
            raise RuntimeError((r.stderr or "couldn't start llama-server").strip())
        t0 = time.time()
        while time.time() - t0 < 900:
            # Only a definite answer counts (systemctl can time out while the
            # GPU is busy loading, which reads as no state at all).
            if hm.unit_info(unit).get("ActiveState") in ("inactive", "failed"):
                log_tail = subprocess.run(["journalctl", "--user", "-u", unit, "--since", since, "-n", "3",
                                           "--no-pager", "-o", "cat"], capture_output=True, text=True, timeout=10).stdout
                raise RuntimeError("llama-server stopped: " + (log_tail.strip().splitlines() or ["see its log"])[-1])
            try:
                if http("http://127.0.0.1:%d/health" % port, timeout=2).get("status") == "ok":
                    return unit
            except (OSError, ValueError, AttributeError):
                pass
            time.sleep(1)
        subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, timeout=60)
        raise RuntimeError("llama-server didn't come up in 15 minutes")

    def _spill(self, unit):
        """Bytes it holds in system RAM through the GPU (GTT): a buffer that
        didn't fit in graphics memory."""
        time.sleep(2)
        return sum(c["gtt"] for c in hm.gpu_clients() if c["unit"] == unit)

    def load(self, model, keep_minutes):
        path = model
        if any(r["path"] == path for r in self.running()):
            return
        exe = hm.pick_llama_server(path)
        if not exe:
            raise RuntimeError("no llama-server here can run it")
        ctx = context_for(self.cfg, path)
        if ctx:   # the user's size: as asked, all on the GPU
            self._start(exe, path, ["-c", str(ctx), "-ngl", "999"])
            return
        # Automatic: llama.cpp's --fit sizes what's left unset (the context
        # first, then layers) to the free graphics memory with a margin. It
        # can still miss a compute buffer that grows with context x
        # micro-batch (Inkling's relative-position bias), which then lands in
        # system RAM and slows everything: so check, and retry with a smaller
        # micro-batch, then half the context. What worked is remembered.
        fit = ["--fit", "on", "--fit-target", "1536", "--fit-ctx", "4096"]
        key = "gguf:" + path
        known = ARB.mem.get(key).get("ggufArgs")
        tries = [known] if known else [[], ["-ub", "128"], ["-ub", "32"]]
        limit = 1 << 30
        for extra in tries:
            unit = self._start(exe, path, fit + extra)
            if known or self._spill(unit) < limit:
                ARB.mem.note(key, ggufArgs=extra)
                return
            subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, timeout=120)
        # Still spilling at the smallest micro-batch: halve the context it got.
        ctx = 0
        for _ in range(3):
            unit = self._start(exe, path, fit + ["-ub", "32"] + (["-c", str(ctx)] if ctx else []))
            got = 0
            for r in self.running():
                if r["unit"] == unit:
                    got = served_context(r["port"], unit)
            if self._spill(unit) < limit:
                ARB.mem.note(key, ggufArgs=["-ub", "32"] + (["-c", str(ctx)] if ctx else []))
                return
            subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, timeout=120)
            ctx = max(4096, (got or 32768) // 2)
        unit = self._start(exe, path, fit + ["-ub", "32", "-c", str(ctx)])
        log("gguf: %s still spills into system RAM at %d context" % (path, ctx))

    def unload(self, model):
        for r in self.running():
            if r["path"] == model:
                subprocess.run(["systemctl", "--user", "stop", r["unit"]], capture_output=True, timeout=120)

    def chat_url(self):
        return self._chat

    def chat(self, model, messages, tools, keep_minutes, reasoning=None):
        r = next((x for x in self.running() if x["path"] == model), None)
        if not r:
            self.load(model, keep_minutes)
            r = next((x for x in self.running() if x["path"] == model), None)
        self._chat = "http://127.0.0.1:%d/v1/chat/completions" % r["port"]
        return LlamaCpp.chat(self, model, messages, tools, keep_minutes, reasoning)


class Runtime(LlamaCpp):
    """Any other model server found listening here (hearth_ai_runtimes):
    LM Studio, vLLM, SGLang, KoboldCpp, text-generation-webui, TabbyAPI,
    LocalAI, llamafile, Lemonade, Jan, GPT4All, Docker Model Runner,
    ComfyUI, or an unknown OpenAI-compatible one. Models come from its
    OpenAI-style /models (and its own API where that says more: which are
    loaded); load and unload use its own API or CLI; a one-model server
    unloads by stopping (its user unit, else the process: only on request,
    never automatically). Chat goes through its /chat/completions."""

    def __init__(self, found):
        self.rt = rt.BY_ID.get(found["runtime"], rt.GENERIC)
        self.port = found["port"]
        self.pid = found.get("pid") or 0
        self.proc = found.get("proc") or {}
        self.id = "runtime:%s:%d" % (self.rt["id"], self.port)
        name = self.rt["label"]
        if self.rt is rt.GENERIC and self.proc.get("comm"):
            name = "%s (%s)" % (self.proc["comm"], self.rt["label"])
        self.label = name
        self.root = "http://127.0.0.1:%d" % self.port
        self.url = self.root + self.rt["api"]
        self.models_dir = ""
        unit = hm._unit_of(self.pid) if self.pid else ""
        # Its own user service (not an app scope): Stop stops the unit.
        self.unit = unit if unit.endswith(".service") and not unit.startswith("app-") else ""
        self.flavor = self.rt.get("flavor", "")

    # -- reading
    def _ids(self):
        data = rt._models(self.url, timeout=2) or []
        ids = [str(m.get("id") or m.get("name") or "") for m in data if isinstance(m, dict)]
        # Placeholders some servers list with no model (KoboldCpp --nomodel: "inactive").
        return [i for i in ids if i.lower() not in ("", "inactive", "none", "null", "no model")], data

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.root, "running": True,
              "runtime": self.rt["id"], "found": {"runtime": self.rt["id"], "pid": self.pid, "proc": self.proc}, "installed": [], "loaded": [], "error": "", "pid": self.pid,
              "pids": rt.children(self.pid) if self.pid else [], "app": bool(self.rt.get("app")),
              "multi": bool(self.rt.get("multi")), "runtimeUnit": self.unit,
              # Stopped (not unloaded) and only on request: a one-model
              # server, or an unknown one with no unload call, that hearth
              # didn't start.
              "external": not self.unit and not self.rt.get("app")
                          and (not self.rt.get("multi") or self.rt is rt.GENERIC)}
        f = self.flavor
        try:
            if f == "comfyui":
                rt.get(self.root + "/system_stats", timeout=2)
                st["loaded"] = [{"name": "ComfyUI", "label": "ComfyUI models", "vram": 0, "vramText": ""}]
                return st
            ids, data = self._ids()
        except Exception as e:  # noqa: BLE001
            st["running"] = False
            st["error"] = "%s isn't answering (%s)" % (self.label, e)
            return st
        info = {}
        loaded = set()
        if f == "lmstudio":
            # REST v1 (key, loaded_instances, size); older builds: v0 (id, state).
            try:
                for m in (rt.get(self.root + "/api/v1/models", timeout=2) or {}).get("models", []):
                    k = m.get("key", "")
                    q = m.get("quantization") or {}
                    info[k] = {"type": {"embedding": "embeddings"}.get(m.get("type"), m.get("type", "")),
                               "quantization": q.get("name", "") if isinstance(q, dict) else str(q),
                               "max_context_length": m.get("max_context_length", 0),
                               "publisher": m.get("publisher", ""), "size": m.get("size_bytes", 0),
                               "vision": bool((m.get("capabilities") or {}).get("vision")),
                               "instances": [i.get("id", "") for i in m.get("loaded_instances") or []]}
                    if info[k]["instances"]:
                        loaded.add(k)
            except Exception:  # noqa: BLE001
                pass
            if not info:
                try:
                    for m in (rt.get(self.root + "/api/v0/models", timeout=2) or {}).get("data", []):
                        info[m.get("id", "")] = m
                        if m.get("state") == "loaded":
                            loaded.add(m.get("id", ""))
                except Exception:  # noqa: BLE001
                    pass
            ids = list(info) or ids
            self._lms_info = info
        elif f == "textgen":
            try:
                cur = (rt.get(self.root + "/v1/internal/model/info", timeout=2) or {}).get("model_name", "")
                if cur and cur != "None":
                    loaded.add(cur)
                ids = (rt.get(self.root + "/v1/internal/model/list", timeout=2) or {}).get("model_names", ids) or ids
            except Exception:  # noqa: BLE001
                pass
        elif f == "tabby":
            try:
                cur = (rt.get(self.root + "/v1/model", timeout=2) or {}).get("id", "")
                if cur:
                    loaded.add(cur)
                lst = (rt.get(self.root + "/v1/model/list", timeout=2) or {}).get("data", [])
                ids = [m.get("id", "") for m in lst] or ids
            except Exception:  # noqa: BLE001
                pass
        elif f == "localai":
            try:
                sysinfo = rt.get(self.root + "/system", timeout=2) or {}
                for m in sysinfo.get("loaded_models", []) or []:
                    loaded.add(m.get("id") or m.get("name") or "")
            except Exception:  # noqa: BLE001
                pass
        elif f == "lemonade":
            try:
                h = rt.get(self.root + "/api/v1/health", timeout=2) or {}
                for m in h.get("all_models_loaded", []) or []:
                    loaded.add(m.get("model_name") or m.get("id") or "")
                if h.get("model_loaded"):
                    loaded.add(h["model_loaded"])
            except Exception:  # noqa: BLE001
                pass
        elif f == "docker":
            pass  # loads on first use; `docker model ps` would say, but needs the CLI
        if not self.rt.get("multi"):
            loaded = set(ids[:1])       # a one-model server holds its model while it runs
        for i in ids:
            if not i:
                continue
            m = info.get(i, {})
            caps = []
            typ = m.get("type", "")
            if typ == "embeddings":
                caps.append("embedding")
            if typ == "vlm" or m.get("vision"):
                caps.append("vision")
            size = m.get("size", 0) or 0
            st["installed"].append({"name": i, "size": size, "sizeText": human_bytes(size) if size else "", "params": "",
                                    "quant": m.get("quantization", ""), "context": m.get("max_context_length", 0),
                                    "capabilities": caps, "family": m.get("publisher", "")})
        for i in ids:
            if i in loaded:
                st["loaded"].append({"name": i, "vram": 0, "vramText": ""})
        return st

    def chat_url(self):
        return self.url + "/chat/completions"     # url already ends in its API base (/v1, /api/v1)

    # -- changing
    def _stop(self):
        if self.unit:
            r = subprocess.run(["systemctl", "--user", "stop", self.unit], capture_output=True, text=True, timeout=120)
            if r.returncode:
                raise RuntimeError((r.stderr or "couldn't stop %s" % self.unit).strip())
        elif self.pid and not self.rt.get("app"):
            os.kill(self.pid, 15)
        else:
            raise RuntimeError("%s manages its own models: unload them there" % self.label)

    def load(self, model, keep_minutes):
        f, root = self.flavor, self.root
        if not self.rt.get("multi") or f == "comfyui":
            return  # its model is in memory while it runs
        if f == "lmstudio":
            try:
                rt.post(root + "/api/v1/models/load", {"model": model}, timeout=900)
            except Exception:  # noqa: BLE001 (older LM Studio: it loads on first request)
                rt.post(self.url + "/chat/completions", {"model": model, "max_tokens": 1,
                                                         "messages": [{"role": "user", "content": "hi"}]}, timeout=900)
        elif f == "textgen":
            rt.post(root + "/v1/internal/model/load", {"model_name": model}, timeout=900)
        elif f == "tabby":
            rt.post(root + "/v1/model/load", {"model_name": model}, timeout=900,
                    headers={"x-admin-key": rt.tabby_admin_key(self.proc.get("cwd", ""))})
        elif f == "lemonade":
            rt.post(root + "/api/v1/load", {"model_name": model}, timeout=900)
        else:
            # Everything else loads a model on its first request.
            rt.post(self.url + "/chat/completions", {"model": model, "max_tokens": 1,
                                                     "messages": [{"role": "user", "content": "hi"}]}, timeout=900)

    def unload(self, model):
        f, root = self.flavor, self.root
        if f == "comfyui":
            rt.post(root + "/free", {"unload_models": True, "free_memory": True}, timeout=60)
        elif not self.rt.get("multi"):
            self._stop()
        elif f == "lmstudio":
            # Every loaded instance of it (REST v1), else its CLI.
            try:
                self.state()
                ids = (getattr(self, "_lms_info", {}).get(model) or {}).get("instances") or [model]
                for iid in ids:
                    rt.post(root + "/api/v1/models/unload", {"instance_id": iid}, timeout=120)
            except Exception:  # noqa: BLE001
                if not rt.lms_bin():
                    raise
                rt.run([rt.lms_bin(), "unload", model], timeout=120)
        elif f == "textgen":
            rt.post(root + "/v1/internal/model/unload", {}, timeout=120)
        elif f == "tabby":
            rt.post(root + "/v1/model/unload", {}, timeout=120,
                    headers={"x-admin-key": rt.tabby_admin_key(self.proc.get("cwd", ""))})
        elif f == "localai":
            rt.post(root + "/backend/shutdown", {"model": model}, timeout=120)
        elif f == "lemonade":
            rt.post(root + "/api/v1/unload", {"model_name": model}, timeout=120)
        elif f == "docker" and shutil.which("docker"):
            rt.run(["docker", "model", "unload", model], timeout=120)
        else:
            self._stop()


def llama_instances(managed_url):
    out = []
    for cmdf in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            argv = open(cmdf).read().split("\0")
        except OSError:
            continue
        if not argv or not argv[0].endswith("llama-server"):
            continue
        def opt(*names):
            for n in names:
                if n in argv and argv.index(n) + 1 < len(argv):
                    return argv[argv.index(n) + 1]
            return ""
        if opt("--models-dir"):
            continue  # router mode: the managed server
        port = int(opt("--port") or 8080)
        if managed_url.endswith(":%d" % port):
            continue
        pid = cmdf.split("/")[2]
        if hm._unit_of(pid) in service_units or hm._unit_of(pid).startswith(GgufRunner.PREFIX):
            continue  # shown as its model service, or one hearth started for a GGUF
        ppid = (re.search(r"^PPid:\s*(\d+)", hm._read("/proc/%s/status" % pid), re.M) or [None, "0"])[1]
        if "ollama" in hm._read("/proc/%s/cmdline" % ppid) or "/ollama/" in opt("--model", "-m"):
            continue  # Ollama's own runner: shown as the Ollama model
        out.append(LlamaInstance(int(pid), port, opt("--alias", "-a"), opt("--model", "-m")))
    return out


service_units = set()


def _port_of(url):
    m = re.search(r":(\d+)(?:/|$)", url or "")
    return int(m.group(1)) if m else 0


def runtime_servers(known):
    """The other runtimes listening here (hearth_ai_runtimes.discover), minus
    what the other providers cover: their ports, llama-server processes
    (LlamaInstance), model units' processes, and Magnitude."""
    skip = {_port_of(getattr(p, "url", "")) for p in known.values()} | {10100}
    skip.discard(0)

    def covered(pid):
        argv0 = hm._read("/proc/%d/cmdline" % pid).split("\0")[0]
        unit = hm._unit_of(pid)
        # A model unit's on-demand proxy (inkling-2-mini-proxy.service running
        # systemd-socket-proxyd) forwards to that unit: it is the unit.
        proxied = unit.endswith("-proxy.service") and unit.replace("-proxy.service", ".service") in service_units
        return argv0.endswith("llama-server") or unit in service_units or proxied \
            or hm._read("/proc/%d/comm" % pid).strip() in ("ollama", "magnitude") \
            or os.path.basename(argv0) == "systemd-socket-proxyd"
    return [Runtime(f) for f in rt.discover(skip, covered)]


def providers(cfg):
    out = {}
    pc = cfg["providers"]
    if pc["ollama"].get("enabled", True):
        out["ollama"] = Ollama(pc["ollama"])
    if pc["llamacpp"].get("enabled", True):
        out["llamacpp"] = LlamaCpp(pc["llamacpp"])
    if pc.get("magnitude", {}).get("enabled", True) and hm.magnitude_installed():
        out["magnitude"] = Magnitude(pc["magnitude"])
    if pc.get("services", {}).get("enabled", True):
        for svc in hm.services():
            p = ModelService(svc)
            service_units.add(p.unit)
            out[p.id] = p
    out["gguf"] = GgufRunner(cfg)
    for inst in llama_instances(pc["llamacpp"].get("url", "")):
        out[inst.id] = inst
    if pc.get("runtimes", {}).get("enabled", True):
        for p in runtime_servers(out):
            out[p.id] = p
    for pid in CLI:
        if pc.get(pid, {}).get("enabled"):
            out[pid] = AgentCli(pid, pc[pid])
    return out


# --- GPUs and VRAM -------------------------------------------------------------

_gpu_names = {}
_busy_avg = {}


def gpu_name(dev):
    if dev in _gpu_names:
        return _gpu_names[dev]
    name = ""
    try:
        with open(os.path.join(dev, "uevent")) as f:
            slot = next((l.split("=", 1)[1].strip() for l in f if l.startswith("PCI_SLOT_NAME=")), "")
        if slot and shutil.which("lspci"):
            r = subprocess.run(["lspci", "-s", slot, "-mm"], capture_output=True, text=True, timeout=3)
            parts = re.findall(r'"([^"]*)"', r.stdout)
            if len(parts) >= 3:
                name = parts[2]
                br = re.search(r"\[(.+)\]", name)
                name = br.group(1) if br else name
    except (OSError, subprocess.SubprocessError, StopIteration):
        pass
    _gpu_names[dev] = name or os.path.basename(os.path.dirname(dev))
    return _gpu_names[dev]


def gpus():
    out = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
        if "-" in os.path.basename(card):
            continue
        dev = os.path.join(card, "device")
        try:
            total = int(open(os.path.join(dev, "mem_info_vram_total")).read())
            used = int(open(os.path.join(dev, "mem_info_vram_used")).read())
        except (OSError, ValueError):
            continue
        # gpu_busy_percent is an instant reading that asks the SMU firmware:
        # read it once per poll and smooth across polls (never a burst; a
        # wedged SMU blocks every reader).
        busy = None
        try:
            cur = int(open(os.path.join(dev, "gpu_busy_percent")).read())
            prev = _busy_avg.get(card)
            busy = cur if prev is None else round(0.5 * prev + 0.5 * cur)
            _busy_avg[card] = busy
        except (OSError, ValueError):
            pass
        gtt_used = gtt_total = 0
        try:
            gtt_used = int(open(os.path.join(dev, "mem_info_gtt_used")).read())
            gtt_total = int(open(os.path.join(dev, "mem_info_gtt_total")).read())
        except (OSError, ValueError):
            pass
        try:
            pci = os.path.basename(os.path.realpath(dev))
        except OSError:
            pci = ""
        # A small "VRAM" carve-out is an integrated GPU.
        out.append({"card": os.path.basename(card), "pci": pci, "name": gpu_name(dev), "total": total,
                    "used": used, "totalText": human_bytes(total), "usedText": human_bytes(used),
                    "free": max(0, total - used), "freeText": human_bytes(max(0, total - used)),
                    "percent": round(100 * used / total) if total else 0,
                    "gttUsed": gtt_used, "gttTotal": gtt_total, "gttText": human_bytes(gtt_used),
                    "busy": busy, "integrated": total < 4 << 30})
    return out


def main_gpu(gs):
    d = [g for g in gs if not g["integrated"]] or gs
    return max(d, key=lambda g: g["total"]) if d else None


