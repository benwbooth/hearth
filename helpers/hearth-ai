def model_vision(p):
    """Whether a llama.cpp-style server's model takes images (/props)."""
    url = getattr(p, "url", "")
    if not url:
        return False
    try:
        return bool(((http(url + "/props", timeout=3) or {}).get("modalities") or {}).get("vision"))
    except Exception:  # noqa: BLE001
        return False


def run_command(command, timeout=120):
    try:
        r = subprocess.run(["bash", "-lc", command], capture_output=True, text=True, timeout=timeout,
                           cwd=HOME, stdin=subprocess.DEVNULL, start_new_session=True)
    except subprocess.TimeoutExpired as e:
        out = e.stdout or b""
        out = out.decode(errors="replace") if isinstance(out, bytes) else out
        return "Stopped after %d s. Output so far:\n%s" % (timeout, out[-6000:])
    out = (r.stdout or "") + (("\n[stderr]\n" + r.stderr) if r.stderr.strip() else "")
    if len(out) > 8000:
        out = "[first %d characters cut]\n" % (len(out) - 8000) + out[-8000:]
    return "Exit code %d.\n%s" % (r.returncode, out.strip() or "(no output)")


def describe_action(name, a):
    if name == "click":
        what = a.get("name") or a.get("text")
        return "click %s" % (("“%s”" % what) if what else "on the screen")
    if name == "type_text":
        t = str(a.get("text", ""))
        return "type “%s”" % (t[:60] + ("…" if len(t) > 60 else ""))
    if name == "press_key":
        return "press %s" % (a.get("key") or a.get("keys") or "a key")
    return name.replace("_", " ")


def system_prompt(ctx, computer=False, commands=False):
    extra = ""
    if computer:
        extra += ("You can use the computer like the user does: list_apps and get_app_state read what's on screen "
                  "(get_app_state lists a window's controls as text with element_index numbers; call it before acting "
                  "and again after to check), and click, type_text, press_key, scroll, set_value and perform_action act "
                  "on it (prefer element_index from the latest get_app_state). Open apps with launch_app first. "
                  "Keep going until the task is done, then say briefly what you did. ")
    if commands:
        extra += ("run_command runs a bash command after the user allows it; use it for files, settings and "
                  "system questions a command answers directly, and give a short 'why'. ")
    return (
        "You are the voice assistant of the user's Linux desktop (hearth). Each message starts with the date and time. %s"
        "Do what the user asks by calling tools; you may call several in a row. Never take an action the user didn't "
        "ask for (don't open apps, files or websites unless asked). "
        "For files the user 'edited yesterday' etc., work out the dates and pass modified_after/modified_before. "
        "When a search finds what they asked to open, open the best match. If a search finds nothing, search again "
        "right away with fewer filters (drop the kind, then widen the dates) before telling the user. "
        "If nothing matches, say so in one sentence and offer one next step. Answer in one or two short, friendly sentences meant to be spoken aloud: no markdown, no lists, no file paths "
        "unless asked. If you can't do something, say so plainly."
    ) % (("The user is in %s. " % ctx["place"]) if ctx.get("place") else "") + extra


class Assistant:
    def __init__(self):
        self.pending = {}     # (id, call) -> Queue
        self.cancelled = set()

    def run_local_tool(self, name, args):
        if name == "search_files":
            q = {"q": args.get("query", ""), "limit": 8}
            if args.get("kind"):
                q["kind"] = args["kind"]
            if args.get("modified_after"):
                q["after"] = args["modified_after"]
            if args.get("modified_before"):
                q["before"] = args["modified_before"]
            r = subprocess.run(["hearth-search", "--once", json.dumps(q)], capture_output=True, text=True, timeout=20)
            try:
                items = json.loads(r.stdout or "[]")
            except ValueError:
                items = []
            if not items:
                return "No files found."
            return json.dumps([{"path": i["path"], "kind": i["kind"],
                                "modified": time.strftime("%Y-%m-%d %H:%M", time.localtime(i["mtime"])) if i["mtime"] else ""}
                               for i in items[:8]])
        if name == "open_file":
            p = os.path.expanduser(args.get("path", ""))
            if not os.path.exists(p):
                return "That file doesn't exist."
            if os.environ.get("HEARTH_AI_DRYRUN"):
                return "Opened %s (dry run)." % os.path.basename(p)
            subprocess.Popen(["xdg-open", p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return "Opened %s." % os.path.basename(p)
        if name == "reveal_file":
            p = os.path.expanduser(args.get("path", ""))
            subprocess.Popen(["busctl", "--user", "call", "org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                              "org.freedesktop.FileManager1", "ShowItems", "ass", "1", "file://" + p, ""],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return "Showing it in the file manager."
        if name in ("set_volume", "change_volume", "mute"):
            if name == "set_volume":
                v = max(0, min(150, float(args.get("percent", 50))))
                cmd = ["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "%.2f" % (v / 100)]
                done = "Volume set to %d%%." % v
            elif name == "change_volume":
                d = float(args.get("delta", 10))
                cmd = ["wpctl", "set-volume", "-l", "1.5", "@DEFAULT_AUDIO_SINK@", "%.0f%%%s" % (abs(d), "+" if d >= 0 else "-")]
                done = "Volume turned %s." % ("up" if d >= 0 else "down")
            else:
                cmd = ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if args.get("muted", True) else "0"]
                done = "Muted." if args.get("muted", True) else "Unmuted."
            if os.environ.get("HEARTH_AI_DRYRUN"):
                return done + " (dry run)"
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            return done if r.returncode == 0 else "Couldn't change the volume: " + (r.stderr or "").strip()
        if name == "calculate":
            r = subprocess.run(["qalc", "-t", "-defaults", "-s", "max_decimals 4", args.get("expression", "")],
                               capture_output=True, text=True, timeout=5)
            return (r.stdout or "").strip() or "Couldn't calculate that."
        if name in ("web_search", "open_url"):
            import urllib.parse
            url = args.get("url") if name == "open_url" else \
                "https://duckduckgo.com/?q=" + urllib.parse.quote(args.get("query", ""))
            if not re.match(r"^https?://", url or ""):
                url = "https://" + (url or "")
            if os.environ.get("HEARTH_AI_DRYRUN"):
                return "Opened the browser (dry run)."
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return "Opened the browser."
        return "Unknown tool."

    def shell_tool(self, rid, call, name, args):
        qu = queue.Queue()
        self.pending[(rid, call)] = qu
        emit({"type": "tool", "id": rid, "call": call, "name": name, "args": args})
        try:
            return qu.get(timeout=15)
        except queue.Empty:
            return "The desktop didn't answer."
        finally:
            self.pending.pop((rid, call), None)

    def approve(self, rid, call, kind, title, detail):
        """Ask the user (an Allow/Deny card in the shell). True when allowed."""
        qu = queue.Queue()
        self.pending[(rid, call)] = qu
        emit({"type": "approve", "id": rid, "call": call, "kind": kind, "title": title, "detail": detail})
        try:
            return qu.get(timeout=300) == "allow"
        except queue.Empty:
            return False
        finally:
            self.pending.pop((rid, call), None)
            emit({"type": "approved", "id": rid, "call": call})

    def tool_result(self, rid, call, result):
        qu = self.pending.get((rid, call))
        if qu:
            qu.put(result)

    def ask(self, req):
        rid = int(req.get("id", 0))
        cfg, _ = settings()
        feature = cfg.get(req.get("feature", "assistant")) or cfg["assistant"]
        pid = req.get("provider") or feature.get("provider", "ollama")
        model = req.get("model") or feature.get("model", "")
        provs = providers(cfg)
        p = provs.get(pid)
        if p is None:
            emit({"type": "reply", "id": rid, "done": True, "error": True,
                  "text": "The assistant's AI (%s) is turned off. Choose one in Settings > AI." % pid})
            return
        if isinstance(p, AgentCli) and not cfg.get("allowCloud"):
            emit({"type": "reply", "id": rid, "done": True, "error": True,
                  "text": "%s sends what you say to the cloud. Allow cloud AI in Settings > AI first." % p.label})
            return
        if not isinstance(p, AgentCli):
            make_room_for(pid, model)
        # Computer use and shell commands (Settings > AI), for models that
        # call tools themselves (the agent CLIs bring their own).
        tools = list(TOOLS)
        computer = commands = vision = False
        if not isinstance(p, AgentCli):
            if cfg.get("computerUse", "ask") != "off" and COMPUTER.available():
                vision = model_vision(p)
                ct = COMPUTER.tools(vision)
                computer = bool(ct)
                tools += ct
            if cfg.get("runCommands", "ask") != "off":
                tools.append(RUN_COMMAND)
                commands = True
        computer_ok = cfg.get("computerUse", "ask") == "allow"
        messages = [{"role": "system", "content": system_prompt(req.get("context") or {}, computer, commands)}]
        messages += req.get("history") or []
        messages.append({"role": "user", "content": "[%s] %s" % (
            time.strftime("%A, %B %-d, %Y, %-I:%M %p"), req.get("text", ""))})
        call = 0
        try:
            for _ in range(30 if computer else 8):
                if rid in self.cancelled:
                    return
                text, calls, raw = p.chat(model, messages, tools, keep_minutes(cfg),
                                          cfg.get("assistantReasoning", "low") or None)
                if not calls:
                    emit({"type": "reply", "id": rid, "done": True, "text": (text or "").strip() or "Done."})
                    return
                if isinstance(p, AgentCli):
                    messages.append(raw)
                else:
                    messages.append({"role": "assistant", "content": raw.get("content") or "",
                                     "tool_calls": raw.get("tool_calls")})
                for c in calls:
                    call += 1
                    emit({"type": "step", "id": rid, "name": c["name"], "args": c["args"]})
                    images = []
                    if rid in self.cancelled:
                        return
                    if c["name"] in SHELL_TOOLS:
                        result = self.shell_tool(rid, call, c["name"], c["args"])
                    elif c["name"] == "run_command" and commands:
                        cmdline = str(c["args"].get("command", "")).strip()
                        if not cmdline:
                            result = "No command given."
                        elif cfg.get("runCommands", "ask") == "allow" or \
                                self.approve(rid, call, "command", c["args"].get("why") or "Run this command?", cmdline):
                            result = run_command(cmdline) if not os.environ.get("HEARTH_AI_DRYRUN") \
                                else "Exit code 0.\n(dry run)"
                        else:
                            result = "The user didn't allow that command. Don't retry it; ask what they'd like instead."
                    elif computer and c["name"] in COMPUTER.names():
                        acts = c["name"] not in COMPUTER.readonly
                        if acts and not computer_ok:
                            computer_ok = self.approve(rid, call, "computer", "Let the assistant use your computer?",
                                                       "It wants to %s, and may keep clicking and typing in your apps "
                                                       "until this request is done." % describe_action(c["name"], c["args"]))
                        if acts and not computer_ok:
                            result = "The user didn't allow using the computer for this request. Stop and say so."
                        else:
                            try:
                                result, images = COMPUTER.call(c["name"], c["args"])
                            except Exception as e:  # noqa: BLE001
                                result = "Error: %s" % e
                    else:
                        try:
                            result = self.run_local_tool(c["name"], c["args"])
                        except Exception as e:  # noqa: BLE001
                            result = "Error: %s" % e
                    tm = {"role": "tool", "content": str(result)}
                    if isinstance(p, LlamaCpp) and c.get("id"):
                        tm["tool_call_id"] = c["id"]
                    if pid == "ollama":
                        tm["tool_name"] = c["name"]
                    if isinstance(p, AgentCli):
                        tm = {"role": "user", "content": "Result of %s: %s" % (c["name"], result)}
                    messages.append(tm)
                    if images and vision:
                        # Tool messages can't carry images in the OpenAI format: hand it over as the user.
                        messages.append({"role": "user", "content": [{"type": "text", "text": "The screenshot:"}] + [
                            {"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % im}} for im in images[:1]]})
            emit({"type": "reply", "id": rid, "done": True, "text": "That took too many steps; I stopped."})
        except urllib.error.URLError as e:
            emit({"type": "reply", "id": rid, "done": True, "error": True,
                  "text": "I can't reach %s (%s). Is it running? See Settings > AI." % (p.label, e.reason)})
        except Exception as e:  # noqa: BLE001
            emit({"type": "reply", "id": rid, "done": True, "error": True, "text": "Something went wrong: %s" % e})


# --- the app API ------------------------------------------------------------------
#
# Any app can use the desktop's models through an OpenAI-compatible server
# on 127.0.0.1 (README "AI > Apps"), with the same models, cloud rule and
# memory manager as the assistant. Requests need the bearer token; apps find
# both in $XDG_RUNTIME_DIR/hearth/ai-api.json (readable only by you):
#
#   {"url": "http://127.0.0.1:18380/v1", "token": "...", "pid": 1234, "version": 1}
#
#   GET  /v1/models            "default" and "fast" (Settings > AI > Apps), then
#                              every language model as "<provider>/<model>";
#                              each entry's "hearth" says what it runs on
#   POST /v1/chat/completions  OpenAI chat, streamed or not; tools pass through
#                              to local servers. Cloud CLIs answer only with
#                              ai.allowCloud, as one non-streamed reply.

import hmac         # noqa: E402
import http.server as httpserver  # noqa: E402  (not `http`: that's the http() helper above)
import secrets      # noqa: E402

API_PORT = 18380
API_FILE = os.environ.get("HEARTH_AI_API_FILE") or \
    os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "hearth", "ai-api.json")
API_TOKEN_FILE = os.path.join(hm.STATE_HOME, "hearth", "ai-api-token")


def api_token():
    """Kept across restarts, so an app configured by hand keeps working."""
    try:
        with open(API_TOKEN_FILE) as f:
            t = f.read().strip()
        if t:
            return t
    except OSError:
        pass
    t = secrets.token_urlsafe(32)
    os.makedirs(os.path.dirname(API_TOKEN_FILE), exist_ok=True)
    fd = os.open(API_TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(t + "\n")
    return t


_api_provs = [0.0, "", None]   # [when, settings it was made from, providers]
_api_lock = threading.Lock()


def api_providers(cfg, fresh=False):
    """providers() looks at every process: reuse it for a while, so typing in
    an app (a request per keystroke pause) stays quick."""
    sig = json.dumps(cfg, sort_keys=True)
    with _api_lock:
        if fresh or _api_provs[2] is None or _api_provs[1] != sig or time.time() - _api_provs[0] > 20:
            _api_provs[:] = [time.time(), sig, providers(cfg)]
        return _api_provs[2]


def api_alias(cfg, name):
    """(provider, model) behind "default" / "fast": Settings > AI > Apps, else the assistant's."""
    f = {}
    if name == "fast":
        f = cfg.get("appsFast") or {}
    if not f.get("provider"):
        f = cfg.get("apps") or {}
    if not f.get("provider"):
        f = cfg["assistant"]
    return f.get("provider", ""), f.get("model", "")


def api_resolve(cfg, name):
    if name in ("", "default", "hearth", "fast"):
        return api_alias(cfg, name)
    if "/" in name:
        return tuple(name.split("/", 1))
    return "", name


def api_label(p, pid, model):
    if p is None:
        return "%s (turned off)" % (model or pid)
    if pid.startswith("service:"):
        return p.label
    name = os.path.splitext(os.path.basename(model))[0] if pid == "gguf" else model
    return "%s (%s)" % (name, p.label)


def api_models(cfg):
    provs = api_providers(cfg)
    cloud = bool(cfg.get("allowCloud"))

    def usable(p):
        return p is not None and (cloud or not isinstance(p, AgentCli))

    out = []
    for alias in ("default", "fast"):
        pid, model = api_alias(cfg, alias)
        p = provs.get(pid)
        out.append({"id": alias, "object": "model", "owned_by": "hearth",
                    "hearth": {"provider": pid, "model": model, "label": api_label(p, pid, model),
                               "available": usable(p), "cloud": isinstance(p, AgentCli)}})
    inv = ARB.inv[1] or (ARB.last or ARB.snapshot(False)).get("installed", [])
    seen = set()
    for it in inv:
        if it.get("category") != "llm":
            continue
        for r in it.get("runners") or []:
            p = provs.get(r["provider"])
            mid = "%s/%s" % (r["provider"], r["model"])
            if usable(p) and mid not in seen:
                seen.add(mid)
                out.append({"id": mid, "object": "model", "owned_by": r["provider"],
                            "hearth": {"provider": r["provider"], "model": r["model"],
                                       "label": api_label(p, r["provider"], r["model"]), "available": True}})
    for pid, p in provs.items():
        if isinstance(p, AgentCli) and cloud and p.bin:
            for m in p.models():
                out.append({"id": "%s/%s" % (pid, m), "object": "model", "owned_by": pid,
                            "hearth": {"provider": pid, "model": m, "label": "%s %s" % (p.label, m),
                                       "available": True, "cloud": True}})
    return out


def api_cli_reply(p, model, messages):
    """A cloud CLI: the conversation as one prompt, its answer as the reply."""
    def text(c):
        if isinstance(c, list):
            return " ".join(x.get("text", "") for x in c if isinstance(x, dict))
        return c or ""
    convo = "\n\n".join("%s: %s" % (m.get("role", "user").upper(), text(m.get("content"))) for m in messages)
    prompt = ("Answer the last USER message for the app that sent this conversation. Do not use any tools of "
              "your own and do not edit files. Reply with the answer only.\n\n" + convo)
    r = subprocess.run(p.command(model, prompt), capture_output=True, text=True, timeout=240, cwd=HOME,
                       stdin=subprocess.DEVNULL)
    out = (r.stdout or "").strip()
    if r.returncode != 0 and not out:
        raise RuntimeError(((r.stderr or "").strip().splitlines() or ["%s failed" % p.label])[-1])
    return out


def api_chat_url(p, model):
    """Where the model's server takes OpenAI chat, starting it when hearth starts it."""
    if isinstance(p, Ollama):
        return p.url + "/v1/chat/completions"
    if isinstance(p, GgufRunner):
        r = next((x for x in p.running() if x["path"] == model), None)
        if not r:
            p.load(model, 60)
            r = next((x for x in p.running() if x["path"] == model), None)
        if not r:
            raise RuntimeError("couldn't start a server for %s" % model)
        return "http://127.0.0.1:%d/v1/chat/completions" % r["port"]
    return p.chat_url()


class ApiHandler(httpserver.BaseHTTPRequestHandler):
    server_version = "hearth-ai"
    protocol_version = "HTTP/1.0"   # one request per connection; the reply ends when it closes

    def log_message(self, fmt, *a):
        pass

    def reply(self, code, obj):
        data = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def error(self, code, msg, kind="hearth_error"):
        self.reply(code, {"error": {"message": msg, "type": kind, "code": code}})

    def authorized(self):
        got = self.headers.get("Authorization", "")
        if hmac.compare_digest(got.encode(), ("Bearer " + self.server.token).encode()):
            return True
        self.error(401, "Missing or wrong token: read it from %s" % API_FILE, "authentication_error")
        return False

    def do_GET(self):
        if not self.authorized():
            return
        path = self.path.split("?")[0].rstrip("/")
        cfg, _ = settings()
        if path in ("/v1/models", "/models"):
            self.reply(200, {"object": "list", "data": api_models(cfg)})
        else:
            self.error(404, "Not found: GET %s" % path)

    def do_POST(self):
        if not self.authorized():
            return
        path = self.path.split("?")[0].rstrip("/")
        if path not in ("/v1/chat/completions", "/chat/completions"):
            self.error(404, "Not found: POST %s" % path)
            return
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
        except ValueError:
            self.error(400, "The body isn't JSON")
            return
        cfg, _ = settings()
        asked = str(body.get("model") or "")
        pid, model = api_resolve(cfg, asked)
        p = api_providers(cfg).get(pid) or api_providers(cfg, fresh=True).get(pid)
        if p is None:
            self.error(404, "%s isn't available: its server is off or gone. Choose a model in Settings > AI."
                       % (asked or "The model"), "model_not_found")
            return
        stream = bool(body.get("stream"))
        try:
            if isinstance(p, AgentCli):
                if not cfg.get("allowCloud"):
                    self.error(403, "%s sends what you type to the cloud. Allow cloud AI in Settings > AI first."
                               % p.label, "permission_error")
                    return
                self.send_text(api_cli_reply(p, model, body.get("messages") or []), asked, stream)
                return
            key = pid if pid.startswith("service:") else "%s:%s" % (pid, model)
            loaded = make_room_for(pid, model)
            if not loaded and isinstance(p, (ModelService, Magnitude)):
                t0 = time.time()
                p.load(model, keep_minutes(cfg))
                ARB.mem.note(key, loadSec=round(time.time() - t0, 1), loadMeasured=True)
            url = api_chat_url(p, model)
            fwd = dict(body, model=model)
            if isinstance(p, Ollama) and "reasoning_effort" not in fwd:
                fwd["reasoning_effort"] = "none"   # as the assistant: no thinking out loud
            ARB.mem.note(key, lastActive=time.time())
            self.relay(url, fwd)
            ARB.mem.note(key, lastActive=time.time())
        except (BrokenPipeError, ConnectionResetError):
            pass   # the app gave up (a newer keystroke): drop the upstream reply too
        except urllib.error.URLError as e:
            self.error(502, "Can't reach %s (%s). Is it running? See Settings > AI." % (p.label, e.reason))
        except Exception as e:  # noqa: BLE001
            self.error(500, "Something went wrong: %s" % e)

    def relay(self, url, body):
        req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
        try:
            r = urllib.request.urlopen(req, timeout=600)
        except urllib.error.HTTPError as e:
            r = e
        with r:
            self.send_response(r.status if hasattr(r, "status") else r.code)
            self.send_header("Content-Type", r.headers.get("Content-Type", "application/json"))
            self.end_headers()
            while True:
                chunk = r.read1(65536) if hasattr(r, "read1") else r.read(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()

    def send_text(self, text, model, stream):
        now = int(time.time())
        rid = "chatcmpl-hearth-%d" % now
        if not stream:
            self.reply(200, {"id": rid, "object": "chat.completion", "created": now, "model": model,
                             "choices": [{"index": 0, "finish_reason": "stop",
                                          "message": {"role": "assistant", "content": text}}]})
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.end_headers()
        for delta, fin in (({"role": "assistant", "content": text}, None), ({}, "stop")):
            ev = {"id": rid, "object": "chat.completion.chunk", "created": now, "model": model,
                  "choices": [{"index": 0, "delta": delta, "finish_reason": fin}]}
            self.wfile.write(b"data: " + json.dumps(ev).encode() + b"\n\n")
        self.wfile.write(b"data: [DONE]\n\n")


class ApiServer:
    """Runs while ai.api.enabled is on (checked as settings change)."""

    def __init__(self):
        self.httpd = None
        self.port = 0

    def wanted(self, cfg):
        api = cfg.get("api") or {}
        if os.environ.get("HEARTH_AI_API") == "0" or api.get("enabled") is False:
            return 0
        return int(os.environ.get("HEARTH_AI_API_PORT") or api.get("port") or API_PORT)

    def sync(self, cfg):
        port = self.wanted(cfg)
        if port == self.port and (self.httpd or not port):
            return
        self.stop()
        if not port:
            return
        try:
            httpd = httpserver.ThreadingHTTPServer(("127.0.0.1", port), ApiHandler)
        except OSError as e:
            log("app API: can't listen on 127.0.0.1:%d (%s)" % (port, e))
            self.port = port          # don't retry every 5 s; a port change retries
            return
        httpd.daemon_threads = True
        httpd.token = api_token()
        self.httpd, self.port = httpd, port
        threading.Thread(target=httpd.serve_forever, daemon=True).start()
        os.makedirs(os.path.dirname(API_FILE), exist_ok=True)
        tmp = API_FILE + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump({"url": "http://127.0.0.1:%d/v1" % port, "token": httpd.token, "pid": os.getpid(),
                       "version": 1}, f)
        os.replace(tmp, API_FILE)

    def stop(self):
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()
            self.httpd = None
            try:
                with open(API_FILE) as f:
                    mine = json.load(f).get("pid") == os.getpid()
            except (OSError, ValueError):
                mine = False
            if mine:
                os.unlink(API_FILE)
        self.port = 0


API = ApiServer()


