def unit_active(unit):
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True, timeout=5)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return "unknown"


def full_state(with_procs):
    cfg, _ = settings()
    provs = providers(cfg)
    st = {"type": "state", "time": int(time.time()), "providers": [], "gpus": gpus(),
          "allowCloud": bool(cfg.get("allowCloud")),
          "clis": [{"id": k, "label": v["label"], "installed": bool(shutil.which(v["bin"]))} for k, v in CLI.items()]}
    for p in provs.values():
        try:
            s = p.state()
        except Exception as e:  # noqa: BLE001
            s = {"id": p.id, "label": p.label, "installed": [], "loaded": [], "error": str(e)}
        if p.id == "llamacpp":
            s["unit"] = unit_active(LLAMA_UNIT)
        st["providers"].append(s)
    if with_procs:
        st["processes"] = vram_processes()
    return st


