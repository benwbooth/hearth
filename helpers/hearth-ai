    def install(req):
        prov, model = req.get("provider", ""), req.get("model", "")

        def prog(status, done, total, err):
            emit({"type": "pull", "provider": prov, "model": model, "status": status,
                  "completed": done, "total": total, "error": err})
        try:
            if prov == "lmstudio":
                # One GGUF (Q4_K_M or near it, plus the vision projector) into
                # LM Studio's own publisher/repo folder: LM Studio lists it
                # (`lms get` can't run without asking which file).
                files, total = rt.pick_gguf(model)
                dest = os.path.join(rt.lmstudio_models_dir(), model)
                os.makedirs(dest, exist_ok=True)
                hf_download([model] + files + ["--local-dir", dest], prog)
            elif prov == "hf":
                hf_download([model], prog)
            elif prov.startswith("runtime:"):
                cfg, _ = settings()
                p = providers(cfg).get(prov)
                if p is None or getattr(p, "flavor", "") != "localai":
                    raise RuntimeError("%s can't download models" % prov)
                prog("starting", 0, 0, "")
                rt.localai_install(p.root, model, prog)
            else:
                cfg, _ = settings()
                p = providers(cfg).get(prov)
                if p is None or not hasattr(p, "pull"):
                    raise RuntimeError("%s can't download models" % prov)
                p.pull(model, prog)
            emit({"type": "pull", "provider": prov, "model": model, "status": "success", "done": True})
            ARB.inv = (0, [])
        except Exception as e:  # noqa: BLE001
            emit({"type": "pull", "provider": prov, "model": model, "status": "error", "error": str(e), "done": True})
        emit(ARB.snapshot(watching["on"]))

    def hf_download(args, prog):
        """`hf download ARGS`, its percentages as progress."""
        hf = shutil.which("hf") or shutil.which("huggingface-cli")
        if not hf:
            raise RuntimeError("the Hugging Face CLI (hf) isn't installed")
        prog("downloading", 0, 0, "")
        proc = subprocess.Popen([hf, "download"] + args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                text=True, bufsize=1)
        buf, err_tail = "", ""
        while True:
            ch = proc.stderr.read(256)
            if not ch:
                break
            buf += ch
            parts = re.split(r"[\r\n]", buf)
            buf = parts.pop()
            for line in parts:
                if line.strip():
                    err_tail = line.strip()
                m = re.search(r"(\d+)%", line)
                if m:
                    prog("downloading", int(m.group(1)), 100, "")
        if proc.wait() != 0:
            raise RuntimeError(err_tail or "download failed")

    def act(req):
        cfg, _ = settings()
        provs = providers(cfg)
        pid, model = req.get("provider", ""), req.get("model", "")
        cmd = req["cmd"]
        try:
            if cmd == "unloadAll":
                st = ARB.snapshot(False)
                for e in st["loaded"]:
                    if e["auto"] and not e["pinned"]:
                        try:
                            unload_entry(e)
                        except Exception as ex:  # noqa: BLE001
                            log("unload", e["key"], ex)
            else:
                p = provs.get(pid)
                if p is None:
                    raise RuntimeError("%s is turned off" % pid)
                if cmd == "load":
                    size = next((m.get("size", 0) for m in (p.state().get("installed") or []) if m["name"] == model), 0)
                    timed_load(p, pid, model, pid + ":" + model, size, cfg)
                elif cmd == "unload":
                    p.unload(model)
                elif cmd == "delete":
                    p.delete(model)
                elif cmd == "pull":
                    def prog(status, done, total, err):
                        emit({"type": "pull", "provider": pid, "model": model, "status": status,
                              "completed": done, "total": total, "error": err})
                    p.pull(model, prog)
                    emit({"type": "pull", "provider": pid, "model": model, "status": "success", "done": True})
            emit({"type": "done", "cmd": cmd, "provider": pid, "model": model})
        except Exception as e:  # noqa: BLE001
            emit({"type": "done", "cmd": cmd, "provider": pid, "model": model, "error": str(e)})
        emit(full_state(watching["on"]))

    def server(req):
        pid = req.get("provider") or "llamacpp"
        unit = provider_unit(pid) or getattr(providers(settings()[0]).get(pid), "unit", "")
        if not unit:
            emit({"type": "done", "cmd": "server", "provider": pid, "error": "hearth can't start or stop that server"})
            return
        verb = "start" if req.get("on") else "stop"
        if verb == "start":
            make_room_cli(unit)  # free graphics memory first, like the units' own ExecStartPre
        r = subprocess.run(["systemctl", "--user", verb, unit], capture_output=True, text=True, timeout=360)
        emit({"type": "done", "cmd": "server", "provider": pid,
              "error": (r.stderr or "").strip() if r.returncode else ""})
        time.sleep(1.5)
        emit(full_state(watching["on"]))

    # A test shell (smoke tests, the menu survey's rigs: HEARTH_SESSION_DRYRUN=1)
    # never makes the machine load or run a model. The smoke test opens the AI
    # menu, and a test shell's assistant loaded qwen3.5 into the real ollama on
    # the display GPU: ROCm hung starting there and froze the desktop
    # (2026-11-25, fans at full). It still reads state (what's installed).
    test_shell = os.environ.get("HEARTH_SESSION_DRYRUN") == "1"

    for line in sys.stdin:
        try:
            req = json.loads(line)
        except ValueError:
            continue
        cmd = req.get("cmd")
        if test_shell and cmd in ("load", "unload", "unloadAll", "delete", "pull", "server",
                                  "loadKey", "unloadKey", "remove", "install"):
            emit({"type": "done", "cmd": cmd, "provider": req.get("provider"), "model": req.get("model"),
                  "error": "not in a test session"})
            continue
        if test_shell and cmd == "ask":
            emit({"type": "reply", "id": int(req.get("id", 0)), "done": True,
                  "text": "(Test session: the assistant doesn't run models here.)"})
            continue
        if cmd == "refresh":
            bg(lambda: emit(full_state(watching["on"])))
        elif cmd == "watch":
            watching["on"] = bool(req.get("on"))
            if watching["on"]:
                bg(lambda: emit(full_state(True)))
        elif cmd in ("load", "unload", "unloadAll", "delete", "pull"):
            bg(act, req)
        elif cmd in ("loadKey", "unloadKey", "remove"):
            bg(keyed, req)
        elif cmd == "pin":
            pin(req)
        elif cmd == "catalog":
            bg(catalog, req)
        elif cmd == "install":
            bg(install, req)
        elif cmd == "server":
            bg(server, req)
        elif cmd == "ask":
            asst.cancelled.discard(int(req.get("id", 0)))
            bg(asst.ask, req)
        elif cmd == "toolResult":
            asst.tool_result(int(req.get("id", 0)), int(req.get("call", 0)), req.get("result", ""))
        elif cmd == "cancel":
            asst.cancelled.add(int(req.get("id", 0)))
    API.stop()   # the shell went away: so does the app API


if __name__ == "__main__":
    main()
