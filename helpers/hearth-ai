class Ollama:
    id = "ollama"
    label = "Ollama"

    def __init__(self, cfg):
        self.url = cfg.get("url", "http://127.0.0.1:11434").rstrip("/")

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": False,
              "installed": [], "loaded": [], "error": ""}
        try:
            tags = http(self.url + "/api/tags", timeout=2)
            ps = http(self.url + "/api/ps", timeout=2)
        except (OSError, ValueError) as e:
            st["error"] = "Ollama isn't running at %s" % self.url if isinstance(e, (urllib.error.URLError, OSError)) else str(e)
            return st
        st["running"] = True
        for m in tags.get("models", []):
            d = m.get("details") or {}
            st["installed"].append({
                "name": m["name"], "size": m.get("size", 0), "sizeText": human_bytes(m.get("size")),
                "params": d.get("parameter_size", ""), "quant": d.get("quantization_level", ""),
                "family": d.get("family", ""), "capabilities": m.get("capabilities") or [],
                "modified": m.get("modified_at", ""),
            })
        for m in ps.get("models", []):
            st["loaded"].append({
                "name": m["name"], "vram": m.get("size_vram", 0), "vramText": human_bytes(m.get("size_vram")),
                "size": m.get("size", 0), "expires": m.get("expires_at", ""),
                "context": m.get("context_length", 0),
            })
        return st

    def load(self, model, keep_minutes):
        http(self.url + "/api/generate", {"model": model, "prompt": "", "keep_alive": "%dm" % keep_minutes},
             timeout=300)

    def unload(self, model):
        http(self.url + "/api/generate", {"model": model, "prompt": "", "keep_alive": 0}, timeout=60)

    def delete(self, model):
        http(self.url + "/api/delete", {"model": model}, timeout=60, method="DELETE")

    def pull(self, model, progress):
        req = urllib.request.Request(self.url + "/api/pull", data=json.dumps({"model": model}).encode(),
                                     headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=3600) as r:
            for line in r:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                progress(ev.get("status", ""), ev.get("completed", 0), ev.get("total", 0), ev.get("error", ""))

    def chat(self, model, messages, tools, keep_minutes):
        body = {"model": model, "messages": messages, "stream": False, "think": False,
                "keep_alive": "%dm" % keep_minutes, "options": {"temperature": 0.2}}
        if tools:
            body["tools"] = tools
        r = http(self.url + "/api/chat", body, timeout=180)
        msg = r.get("message") or {}
        calls = []
        for c in msg.get("tool_calls") or []:
            fn = c.get("function") or {}
            args = fn.get("arguments") or {}
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except ValueError:
                    args = {}
            calls.append({"name": fn.get("name", ""), "args": args})
        return msg.get("content") or "", calls, msg


class LlamaCpp:
    """llama-server in router mode (--models-dir): GET /models lists every
    GGUF with its status, POST /models/load and /models/unload switch them."""
    id = "llamacpp"
    label = "llama.cpp"

    def __init__(self, cfg):
        self.url = cfg.get("url", "http://127.0.0.1:8181").rstrip("/")
        self.models_dir = os.path.expanduser(cfg.get("modelsDir", "~/models"))

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": False,
              "installed": [], "loaded": [], "error": "", "modelsDir": self.models_dir,
              "serverAvailable": bool(shutil.which("llama-server")), "managed": True}
        # GGUFs on disk, even while the server is stopped.
        on_disk = {}
        for f in sorted(glob.glob(os.path.join(self.models_dir, "**", "*.gguf"), recursive=True)):
            if "mmproj" in os.path.basename(f).lower():
                continue
            name = os.path.splitext(os.path.basename(f))[0]
            try:
                size = os.path.getsize(f)
            except OSError:
                size = 0
            on_disk[name] = {"name": name, "size": size, "sizeText": human_bytes(size), "path": f,
                             "params": "", "quant": "", "capabilities": []}
        try:
            r = http(self.url + "/models", timeout=2)
            st["running"] = True
        except (OSError, ValueError):
            st["installed"] = list(on_disk.values())
            st["error"] = "llama-server isn't running"
            return st
        for m in r.get("data", []):
            name = m.get("id", "")
            status = (m.get("status") or {}).get("value", "") if isinstance(m.get("status"), dict) else str(m.get("status", ""))
            entry = on_disk.pop(name, {"name": name, "size": 0, "sizeText": "", "params": "", "quant": "",
                                       "capabilities": []})
            st["installed"].append(entry)
            if status in ("loaded", "loading"):
                st["loaded"].append({"name": name, "vram": 0, "vramText": "", "status": status})
        st["installed"] += list(on_disk.values())
        return st

    def load(self, model, keep_minutes):
        http(self.url + "/models/load", {"model": model}, timeout=300)

    def unload(self, model):
        http(self.url + "/models/unload", {"model": model}, timeout=60)

    def chat(self, model, messages, tools, keep_minutes):
        body = {"model": model, "messages": messages, "temperature": 0.2, "stream": False}
        if tools:
            body["tools"] = tools
        r = http(self.url + "/v1/chat/completions", body, timeout=180)
        msg = (r.get("choices") or [{}])[0].get("message") or {}
        calls = []
        for c in msg.get("tool_calls") or []:
            fn = c.get("function") or {}
            try:
                args = json.loads(fn.get("arguments") or "{}")
            except ValueError:
                args = {}
            calls.append({"name": fn.get("name", ""), "args": args, "id": c.get("id")})
        return msg.get("content") or "", calls, msg


class AgentCli:
    """Claude Code / Codex / Gemini CLI, one non-interactive prompt per turn.
    They get no tools of their own here: hearth describes its tools in the
    prompt and the CLI answers with a JSON line choosing one."""

    def __init__(self, pid, cfg):
        self.id = pid
        self.label = CLI[pid]["label"]
        self.bin = shutil.which(CLI[pid]["bin"])
        self.model = cfg.get("model", "")

    def state(self):
        st = {"id": self.id, "label": self.label, "kind": "cloud", "running": bool(self.bin),
              "installed": [], "loaded": [], "error": "" if self.bin else "%s isn't installed" % self.label,
              "path": self.bin or ""}
        if self.bin:
            st["installed"] = [{"name": n, "size": 0, "sizeText": "", "params": "", "quant": "", "capabilities": ["tools"]}
                               for n in self.models()]
        return st

    def models(self):
        return {"claude": ["default", "sonnet", "opus", "haiku"],
                "codex": ["default"],
                "gemini": ["default", "gemini-2.5-flash", "gemini-2.5-pro"]}[self.id]

    def command(self, model, prompt):
        m = [] if not model or model == "default" else None
        if self.id == "claude":
            return [self.bin, "-p", "--output-format", "text", "--max-turns", "1"] + \
                   ([] if m is not None else ["--model", model]) + [prompt]
        if self.id == "codex":
            return [self.bin, "exec", "--skip-git-repo-check", "--sandbox", "read-only"] + \
                   ([] if m is not None else ["-m", model]) + [prompt]
        return [self.bin] + ([] if m is not None else ["-m", model]) + ["-p", prompt]

    def chat(self, model, messages, tools, keep_minutes):
        if not self.bin:
            raise RuntimeError("%s isn't installed" % self.label)
        tool_text = "\n".join("- %s(%s): %s" % (t["function"]["name"],
                                                ", ".join(t["function"]["parameters"].get("properties", {}).keys()),
                                                t["function"]["description"]) for t in tools)
        convo = "\n".join("%s: %s" % (m["role"].upper(), m.get("content") or json.dumps(m.get("tool_calls", "")))
                          for m in messages)
        prompt = ("You are answering for a desktop assistant. Do not use any tools of your own and do not edit files.\n"
                  "Available desktop tools:\n%s\n\n"
                  "Reply with exactly one JSON object on one line and nothing else: "
                  '{"tool": "<name>", "args": {...}} to use a tool, or {"answer": "<short spoken reply>"}.\n\n%s'
                  % (tool_text, convo))
        r = subprocess.run(self.command(model, prompt), capture_output=True, text=True, timeout=240, cwd=HOME,
                           stdin=subprocess.DEVNULL)
        text = (r.stdout or "").strip()
        m = re.search(r"\{.*\}", text, re.S)
        if m:
            try:
                obj = json.loads(m.group(0))
                if "tool" in obj:
                    return "", [{"name": obj["tool"], "args": obj.get("args") or {}}], {"role": "assistant", "content": text}
                if "answer" in obj:
                    return obj["answer"], [], {"role": "assistant", "content": obj["answer"]}
            except ValueError:
                pass
        if r.returncode != 0 and not text:
            raise RuntimeError((r.stderr or "").strip().splitlines()[-1:] or ["%s failed" % self.label])
        return text, [], {"role": "assistant", "content": text}


class LlamaInstance(LlamaCpp):
    """A llama-server hearth didn't start (found by its process): one model,
    used through its OpenAI API; "unload" stops the process."""

    def __init__(self, pid, port, alias, model_path):
        self.id = "llamacpp:%d" % port
        self.label = "llama.cpp :%d" % port
        self.url = "http://127.0.0.1:%d" % port
        self.pid = pid
        self.alias = alias or os.path.splitext(os.path.basename(model_path))[0]
        self.model_path = model_path
        self.models_dir = os.path.dirname(model_path)

    def state(self):
        size = 0
        try:
            size = os.path.getsize(self.model_path)
        except OSError:
            pass
        m = {"name": self.alias, "size": size, "sizeText": human_bytes(size), "path": self.model_path,
             "params": "", "quant": "", "capabilities": []}
        return {"id": self.id, "label": self.label, "kind": "local", "url": self.url, "running": True,
                "external": True, "pid": self.pid, "installed": [m],
                "loaded": [{"name": self.alias, "vram": 0, "vramText": "", "pid": self.pid}], "error": ""}

    def load(self, model, keep_minutes):
        pass

    def unload(self, model):
        os.kill(self.pid, 15)


def llama_instances(managed_url):
    out = []
    for cmdf in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            argv = open(cmdf).read().split("\0")
        except OSError:
            continue
        if not argv or not argv[0].endswith("llama-server"):
            continue
        def opt(*names):
            for n in names:
                if n in argv and argv.index(n) + 1 < len(argv):
                    return argv[argv.index(n) + 1]
            return ""
        if opt("--models-dir"):
            continue  # router mode: the managed server
        port = int(opt("--port") or 8080)
        if managed_url.endswith(":%d" % port):
            continue
        out.append(LlamaInstance(int(cmdf.split("/")[2]), port, opt("--alias", "-a"), opt("--model", "-m")))
    return out


def providers(cfg):
    out = {}
    pc = cfg["providers"]
    if pc["ollama"].get("enabled", True):
        out["ollama"] = Ollama(pc["ollama"])
    if pc["llamacpp"].get("enabled", True):
        out["llamacpp"] = LlamaCpp(pc["llamacpp"])
    for inst in llama_instances(pc["llamacpp"].get("url", "")):
        out[inst.id] = inst
    for pid in CLI:
        if pc.get(pid, {}).get("enabled"):
            out[pid] = AgentCli(pid, pc[pid])
    return out


# --- GPUs and VRAM -------------------------------------------------------------

_gpu_names = {}


def gpu_name(dev):
    if dev in _gpu_names:
        return _gpu_names[dev]
    name = ""
    try:
        with open(os.path.join(dev, "uevent")) as f:
            slot = next((l.split("=", 1)[1].strip() for l in f if l.startswith("PCI_SLOT_NAME=")), "")
        if slot and shutil.which("lspci"):
            r = subprocess.run(["lspci", "-s", slot, "-mm"], capture_output=True, text=True, timeout=3)
            parts = re.findall(r'"([^"]*)"', r.stdout)
            if len(parts) >= 3:
                name = parts[2]
                br = re.search(r"\[(.+)\]", name)
                name = br.group(1) if br else name
    except (OSError, subprocess.SubprocessError, StopIteration):
        pass
    _gpu_names[dev] = name or os.path.basename(os.path.dirname(dev))
    return _gpu_names[dev]


def gpus():
    out = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
        if "-" in os.path.basename(card):
            continue
        dev = os.path.join(card, "device")
        try:
            total = int(open(os.path.join(dev, "mem_info_vram_total")).read())
            used = int(open(os.path.join(dev, "mem_info_vram_used")).read())
        except (OSError, ValueError):
            continue
        busy = None
        try:
            busy = int(open(os.path.join(dev, "gpu_busy_percent")).read())
        except (OSError, ValueError):
            pass
        try:
            pci = os.path.basename(os.path.realpath(dev))
        except OSError:
            pci = ""
        # A small "VRAM" carve-out is an integrated GPU.
        out.append({"card": os.path.basename(card), "pci": pci, "name": gpu_name(dev), "total": total,
                    "used": used, "totalText": human_bytes(total), "usedText": human_bytes(used),
                    "busy": busy, "integrated": total < 4 << 30})
    return out


KNOWN = [
