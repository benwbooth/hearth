def unit_active(unit):
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True, timeout=5)
        return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return "unknown"


HIDDEN_APPS = {"hearth", "arbor (compositor)", "Xwayland"}


def model_category(name, caps=(), arch=""):
    if "embedding" in caps:
        return "embedding"
    return hm.classify(name, arch=arch, default="llm")


class Arbiter:
    """Who holds graphics memory, and the memory manager.

    Each snapshot lists every loaded model (server models and models other
    apps hold) with its VRAM, GTT spill, when it last used the GPU (GPU
    time of its processes from fdinfo; Ollama's expiry moving forward) and
    how long it takes to load (measured: our own loads, systemd start to
    ready; else estimated from size and disk speed). manage() then unloads
    idle models and evicts under memory pressure."""

    def __init__(self):
        self.mem = hm.Memory()
        self.lock = threading.RLock()
        self.prev_engine = {}      # pid -> (engine ns, time)
        self.ollama_exp = {}       # model -> expires_at
        self.present = set()       # loaded keys in the last snapshot
        self.unloading = {}        # key -> time an unload was sent
        self.last_evict = 0
        self.inv = (0, [])
        self.last = None           # last snapshot
        self.notices = []          # [{"type": "evicted", ...}] to emit

    # --- installed models ---
    def inventory(self, cfg, pstates, force=False):
        now = time.time()
        if not force and now - self.inv[0] < 30 and self.inv[1]:
            return self.inv[1]
        items, by_path = [], {}
        dirs = list(cfg.get("modelDirs") or [])
        llama = pstates.get("llamacpp") or {}
        if llama.get("modelsDir"):
            dirs.append(llama["modelsDir"])
        for s in pstates.values():
            if s.get("service"):
                for m in s.get("installed", []):
                    if m.get("path"):
                        dirs.append(os.path.dirname(os.path.dirname(m["path"])))
        mcfg = hm._json(os.path.join(HOME, ".magnitude", "config.json"), {}) or {}
        dirs += ((mcfg.get("models") or {}).get("paths") or [])
        dirs.append(os.path.join(HOME, ".magnitude", "models"))
        seen, uniq = set(), []
        for d in dirs:
            d = os.path.realpath(os.path.expanduser(d))
            if d not in seen and not any(d.startswith(s + "/") for s in seen) and d != HOME and d != "/":
                seen.add(d)
                uniq.append(d)
        for it in hm.scan_gguf(uniq, "Folder"):
            if "/.magnitude/models" in it["path"]:
                it["source"] = "Magnitude"
            by_path[it["path"]] = it
            items.append(it)
        # Every runtime's own model folders (hearth_ai_runtimes.RUNTIMES:
        # LM Studio, Jan, GPT4All, text-generation-webui, TabbyAPI, LocalAI
        # ...), whether it's running or not, and llama.cpp's download cache.
        rdirs = rt.model_dirs([s["found"] for s in pstates.values() if s.get("found")])
        extra = [(os.path.join(hm.CACHE_HOME, "llama.cpp"), "llama.cpp cache")] + rdirs
        for d, label in extra:
            for it in hm.scan_gguf([d], label) + hm.scan_weight_dirs([d], label):
                if it["path"] not in by_path:
                    by_path[it["path"]] = it
                    items.append(it)
        items += hm.scan_hf()
        items += hm.scan_misc()
        # Server models.
        for pid, s in pstates.items():
            if s.get("kind") == "cloud":
                continue
            for m in s.get("installed", []):
                runner = {"provider": pid, "model": m["name"], "label": s.get("label", pid)}
                path = m.get("path", "")
                if pid == "magnitude":
                    # A GGUF Magnitude found in a folder: same architecture and
                    # quant, closest size (Magnitude counts the projector too).
                    msize, quant = m.get("size", 0), (m.get("quant") or "").lower()
                    cands = [i for i in items if i.get("path", "").endswith(".gguf") and i.get("size")
                             and (not m.get("arch") or not i.get("arch") or i["arch"] == m["arch"])
                             and abs(i["size"] - msize) < 0.12 * msize]
                    cands = [i for i in cands if quant and quant in i["name"].lower()] or cands
                    match = min(cands, key=lambda i: abs(i["size"] - msize)) if cands else None
                    runner.update(fits=m.get("fits", ""), note=m.get("note", ""), context=m.get("context", 0))
                    if match:
                        match["runners"].append(runner)
                        continue
                    items.append({"key": "magnitude:" + m["name"], "name": m.get("label") or m["name"],
                                  "family": "", "category": "llm", "source": "Magnitude", "size": m.get("size", 0),
                                  "sizeText": m.get("sizeText", ""), "quant": m.get("quant", ""),
                                  "context": m.get("context", 0), "arch": m.get("arch", ""), "deletable": True,
                                  "deleteVia": runner, "runners": [runner], "note": m.get("note", "")})
                    continue
                if path and os.path.realpath(path) in by_path:
                    by_path[os.path.realpath(path)]["runners"].append(runner)
                    if s.get("service"):
                        by_path[os.path.realpath(path)]["serviceLabel"] = s.get("label")
                    continue
                if path and path in by_path:
                    by_path[path]["runners"].append(runner)
                    continue
                if not path and s.get("runtime"):
                    # A runtime names models by id ("publisher/file.gguf",
                    # "Qwen3-8B-Q4_K_M"): the same model found on disk runs there.
                    n = m["name"].lower().rsplit("/", 1)[-1]
                    n = re.sub(r"\.(gguf|safetensors)$", "", n)
                    same = next((i for i in items if n and (i.get("name", "").lower() == n or
                                 os.path.splitext(os.path.basename(i.get("path", "")))[0].lower() == n or
                                 (i.get("repo") or "").lower().endswith("/" + n))), None)
                    if same:
                        same["runners"].append(runner)
                        continue
                items.append({
                    "key": "%s:%s" % (pid, m["name"]), "name": m.get("label") or m["name"], "family": m.get("family", ""),
                    "category": model_category(m["name"], m.get("capabilities") or [], m.get("family", "")),
                    "source": s.get("label", pid), "size": m.get("size", 0), "sizeText": m.get("sizeText", ""),
                    "params": m.get("params", ""), "quant": m.get("quant", ""), "path": path,
                    "deletable": pid == "ollama", "deleteVia": runner if pid == "ollama" else None,
                    "runners": [runner], "capabilities": m.get("capabilities") or []})
        # A GGUF nothing runs gets its own llama-server (GgufRunner).
        if "gguf" in pstates:
            for it in items:
                p = it.get("path", "")
                if not it["runners"] and p.endswith(".gguf") and it["category"] in ("llm", "embedding", "vision") \
                        and not re.search(r"mmproj|-0000[2-9]-of-", os.path.basename(p).lower()):
                    it["runners"].append({"provider": "gguf", "model": p, "label": "llama.cpp"})
        for it in items:
            it["categoryLabel"] = hm.CATEGORY_LABEL.get(it["category"], "Other")
            it["loadable"] = bool(it["runners"])
        items.sort(key=lambda i: (i["category"] != "llm", i["category"], i["name"].lower()))
        self.inv = (now, items)
        return items

    # --- snapshot ---
    def snapshot(self, with_procs=True, manage=False):
        with self.lock:
            return self._snapshot(with_procs, manage)

    def _snapshot(self, with_procs, manage):
        cfg, _ = settings()
        provs = providers(cfg)
        gs = gpus()
        g = main_gpu(gs)
        now = time.time()
        # The main GPU's clients only: a process with a context on both the
        # card and the integrated GPU has an entry for each, and by_pid kept
        # whichever came last (Inkling's 19.8 GB showed as the iGPU's 12 KB).
        clients = [c for c in hm.gpu_clients() if not g or not c.get("pci") or c["pci"] == g.get("pci")]
        active_pids = set()
        alive = set()
        for c in clients:
            alive.add(c["pid"])
            prev = self.prev_engine.get(c["pid"])
            c["gpuPercent"] = 0
            if prev and now > prev[1]:
                frac = (c["engineNs"] - prev[0]) / 1e9 / (now - prev[1])
                c["gpuPercent"] = round(max(0.0, min(1.0, frac)) * 100)
                if frac > 0.02:
                    active_pids.add(c["pid"])
            self.prev_engine[c["pid"]] = (c["engineNs"], now)
        for pid in list(self.prev_engine):
            if pid not in alive:
                del self.prev_engine[pid]
        pstates = {}
        for p in provs.values():
            try:
                s = p.state()
            except Exception as e:  # noqa: BLE001
                s = {"id": p.id, "label": p.label, "installed": [], "loaded": [], "error": str(e)}
            if p.id == "llamacpp":
                s["unit"] = unit_active(LLAMA_UNIT)
            pstates[p.id] = s
        by_pid = {c["pid"]: c for c in clients}
        covered = set()
        loaded = []
        pinned = set(cfg.get("pinned") or [])

        def entry(key, name, cat, pid_, s, pids=(), vram=None, extra=None):
            cs = [by_pid[x] for x in pids if x in by_pid]
            covered.update(c["pid"] for c in cs)
            e = {"key": key, "name": name, "category": cat, "categoryLabel": hm.CATEGORY_LABEL.get(cat, "Other"),
                 "provider": pid_, "providerLabel": s.get("label", pid_), "kind": "server",
                 "vram": vram if vram is not None else sum(c["vram"] for c in cs),
                 "gtt": sum(c["gtt"] for c in cs), "pids": [c["pid"] for c in cs],
                 "active": any(c["pid"] in active_pids for c in cs),
                 "gpuPercent": max([c["gpuPercent"] for c in cs] or [0]), "auto": True, "canUnload": True,
                 "unloadLabel": "Unload", "unit": "", "model": name, "partial": False}
            e.update(extra or {})
            loaded.append(e)
            return e

        for pid_, s in pstates.items():
            for m in s.get("loaded", []):
                name = m["name"]
                if pid_ == "ollama":
                    inst = next((i for i in s.get("installed", []) if i["name"] == name), {})
                    e = entry("ollama:" + name, name, model_category(name, inst.get("capabilities") or [],
                                                                       inst.get("family", "")),
                              pid_, s, vram=m.get("vram", 0), extra={"size": m.get("size", 0),
                                                                     "context": m.get("context", 0)})
                    e["partial"] = bool(m.get("size")) and m.get("vram", 0) < 0.97 * m["size"]
                    exp = m.get("expires", "")
                    if self.ollama_exp.get(name) not in (None, exp):
                        e["active"] = True       # a request moved its expiry
                    self.ollama_exp[name] = exp
                elif pid_ == "magnitude":
                    mp = [c["pid"] for c in clients if c["name"] == "Magnitude"]
                    entry("magnitude:" + name, m.get("label") or name, "llm", pid_, s, mp,
                          extra={"context": m.get("context", 0)})
                elif s.get("service"):
                    unit = s["unit"]
                    sp = [c["pid"] for c in clients if c["unit"] == unit]
                    inst = (s.get("installed") or [{}])[0]
                    e = entry("service:" + unit, s.get("label") or name, model_category(inst.get("path", name)),
                              pid_, s, sp, extra={"unit": unit, "unloadLabel": "Stop", "size": inst.get("size", 0),
                                                  "path": inst.get("path", ""), "socket": s.get("socket", "")})
                    info = s.get("unitInfo") or {}
                    try:
                        t0 = int(info.get("InactiveExitTimestampMonotonic") or 0)
                        t1 = int(info.get("ActiveEnterTimestampMonotonic") or 0)
                        if t1 > t0 > 0:
                            self.mem.note(e["key"], loadSec=round((t1 - t0) / 1e6, 1), loadMeasured=True)
                    except ValueError:
                        pass
                elif s.get("gguf"):
                    sp = [c["pid"] for c in clients if c["unit"] == m["unit"]]
                    size = 0
                    try:
                        size = os.path.getsize(name)
                    except OSError:
                        pass
                    entry("gguf:" + name, m.get("label") or name, model_category(name), pid_, s, sp,
                          extra={"unit": m["unit"], "path": name, "size": size, "model": name,
                                 "context": m.get("context", 0)})
                elif s.get("runtime"):
                    # Its processes (the server and its model workers), split
                    # between its loaded models by the model each has open
                    # or names on its command line; the rest go to the first.
                    names = [x["name"] for x in s["loaded"]]
                    tree = [c for c in clients if c["pid"] in (s.get("pids") or [])]

                    def holds(c, n):
                        t = (c["cmd"] + " " + " ".join(c["models"])).lower()
                        return n.lower().rsplit("/", 1)[-1].replace(".gguf", "") in t
                    mine = [c["pid"] for c in tree if len(names) == 1 or holds(c, name)]
                    if not mine and name == names[0]:
                        mine = [c["pid"] for c in tree if not any(holds(c, n) for n in names)]
                    single = not s.get("multi") and s.get("runtime") != "comfyui"
                    entry(pid_ + ":" + name, m.get("label") or name, "image" if s.get("runtime") == "comfyui"
                          else model_category(name), pid_, s, mine,
                          extra={"unloadLabel": "Stop" if single else "Unload", "pid": s.get("pid", 0),
                                 "external": bool(s.get("external")), "unit": s.get("runtimeUnit", ""),
                                 # Never automatically: a server someone started by
                                 # hand, or an app that manages its own models.
                                 "auto": not s.get("external") and not s.get("app"),
                                 "canUnload": not s.get("app")})
                elif s.get("external"):
                    entry(pid_ + ":" + name, name, model_category(name), pid_, s, [s["pid"]],
                          extra={"unloadLabel": "Stop", "external": True, "pid": s["pid"]})
                else:
                    entry(pid_ + ":" + name, name, model_category(name), pid_, s)
        # Models other apps hold (found by the model files they have open).
        apps = {}
        for c in clients:
            if c["pid"] in covered:
                continue
            if c["models"] and c["name"] not in HIDDEN_APPS:
                first = c["models"][0]
                mname = first.split("/", 1)[-1] if first.startswith("hf:") else \
                    os.path.splitext(os.path.basename(first))[0]
                cat = hm.classify(" ".join(c["models"]) + " " + c["cmd"], default="other")
                unit = c["unit"]
                more = len(c["models"]) - 1
                entry("process:%d" % c["pid"], mname + (" +%d" % more if more > 0 else ""), cat, "process",
                      {"label": c["name"]}, [c["pid"]],
                      extra={"kind": "process", "auto": False, "canUnload": bool(unit), "unit": unit,
                             "unloadLabel": "Stop", "models": c["models"], "app": c["name"], "pid": c["pid"]})
                continue
            a = apps.setdefault(c["name"], {"name": c["name"], "vram": 0, "gtt": 0, "count": 0, "gpuPercent": 0})
            a["vram"] += c["vram"]
            a["gtt"] += c["gtt"]
            a["count"] += 1
            a["gpuPercent"] = max(a["gpuPercent"], c["gpuPercent"])
        # History: last use, load time, idle limit.
        idle_min = float(cfg.get("idleMinutes", 5) or 5)
        factor = float(cfg.get("loadTimeFactor", 10) or 10)
        keys = set()
        for e in loaded:
            k = e["key"]
            keys.add(k)
            h = self.mem.get(k)
            if k not in self.present:
                self.mem.note(k, firstSeen=now)
                h["lastActive"] = max(h.get("lastActive", 0), now)
            if e["active"]:
                h["lastActive"] = now
                self.mem.dirty = True
            if e["vram"] > h.get("peakVram", 0):
                self.mem.note(k, peakVram=e["vram"])
            if not h.get("loadSec"):
                size = e.get("size") or e["vram"]
                h["loadSec"] = round(2 + size / hm.load_speed(e.get("path", "")), 1)
            e["loadSec"] = h["loadSec"]
            e["loadMeasured"] = bool(h.get("loadMeasured"))
            e["lastActive"] = h.get("lastActive", now)
            e["idleSec"] = max(0, int(now - e["lastActive"]))
            e["firstSeen"] = h.get("firstSeen", now)
            e["pinned"] = k in pinned
            e["idleLimit"] = int(min(3600, max(idle_min * 60, e["loadSec"] * factor)))
            # Seconds until it unloads by itself; -1: never (pinned, not managed).
            e["unloadIn"] = max(0, e["idleLimit"] - e["idleSec"]) if e["auto"] and cfg.get("autoUnload", True) \
                and not e["pinned"] else -1
            e["vramText"] = human_bytes(e["vram"]) if e["vram"] else ""
            e["gttText"] = human_bytes(e["gtt"]) if e["gtt"] >= 256 << 20 else ""
            e["unloading"] = now - self.unloading.get(k, 0) < 30
        for k in list(self.unloading):
            if k not in keys or now - self.unloading[k] > 120:
                self.unloading.pop(k, None)
        self.present = keys
        self.mem.save()
        loaded.sort(key=lambda e: -(e["vram"] + e["gtt"]))
        inv = self.inventory(cfg, pstates)
        held = set()
        for e in loaded:
            held.add(e["key"])
            held.update(e.get("models") or [])
            if e.get("path"):
                held.add("file:" + e["path"])
        for it in inv:
            it["loaded"] = it["key"] in held or any(
                ("%s:%s" % (r["provider"], r["model"]) in held) or
                (r["provider"].startswith("service:") and r["provider"] in held) for r in it["runners"])
        model_vram = sum(e["vram"] for e in loaded)
        # What no process here accounts for: buffers apps share with the
        # compositor (counted in no one's own memory), the kernel's, and
        # processes of other users (Ollama's runner, as root, is counted
        # from Ollama's API instead).
        own = sum(c["vram"] for c in clients) + sum(e["vram"] for e in loaded if e.get("provider") == "ollama")
        other_vram = max(0, (g["used"] if g else 0) - own)
        for ps in pstates.values():
            # The user unit that runs this server, when there is one:
            # Settings lists every server with Start / Stop from this, so a
            # new one (a model unit, Magnitude's service) needs no code.
            if ps.get("kind") == "local":
                ps["controlUnit"] = provider_unit(ps["id"]) or ps.get("runtimeUnit", "")
        st = {"type": "state", "time": int(now), "providers": list(pstates.values()), "gpus": gs, "gpu": g,
              "allowCloud": bool(cfg.get("allowCloud")),
              "clis": [{"id": k, "label": v["label"], "installed": bool(shutil.which(v["bin"]))} for k, v in CLI.items()],
              "loaded": loaded, "installed": inv,
              "apps": sorted([a for a in apps.values() if a["vram"] >= 16 << 20], key=lambda a: -a["vram"]),
              "modelVram": model_vram, "otherVram": other_vram, "otherVramText": human_bytes(other_vram),
              "categories": [{"id": k, "label": v} for k, v in hm.CATEGORIES],
              "policy": {"autoUnload": bool(cfg.get("autoUnload", True)), "idleMinutes": idle_min,
                         "evictOnPressure": bool(cfg.get("evictOnPressure", True))}}
        for a in st["apps"]:
            a["vramText"] = human_bytes(a["vram"])
        if with_procs:
            st["processes"] = [dict(c, cmd="") for c in clients if c["vram"] >= 32 << 20][:20]
        self.last = st
        if manage:
            self.manage(cfg, st)
        return st

    # --- memory manager ---
    def victims(self, st, exclude=()):
        """Models that may be evicted, best first. Never the newest one (the
        request that needs the room) nor one using the GPU right now."""
        cands = [e for e in st["loaded"] if e["auto"] and not e["pinned"] and not e["active"]
                 and e["idleSec"] >= 20 and not e["unloading"] and e["key"] not in exclude]
        newest = max((e["firstSeen"] for e in st["loaded"]), default=0)
        cands = [e for e in cands if e["firstSeen"] < newest]
        # Idle longest and quickest to load again go first.
        cands.sort(key=lambda e: e["loadSec"] / (e["idleSec"] + 30.0))
        return cands

    def manage(self, cfg, st):
        g = st["gpu"]
        now = time.time()
        if cfg.get("autoUnload", True):
            for e in st["loaded"]:
                if e["auto"] and not e["pinned"] and not e["active"] and not e["unloading"] \
                        and e["unloadIn"] == 0:
                    idle = e["idleSec"]
                    self.unload(e, "unused for %s" % ("%d min" % (idle // 60) if idle >= 60 else "%d s" % idle))
        if not cfg.get("evictOnPressure", True) or not g or now - self.last_evict < 8:
            return
        spill = any(e["gtt"] >= 1 << 30 for e in st["loaded"])
        partial = any(e["partial"] for e in st["loaded"])
        if g["total"] and (g["used"] / g["total"] > 0.94 or spill or partial):
            vs = self.victims(st)
            if vs:
                self.last_evict = now
                self.unload(vs[0], "make room")

    def unload(self, e, reason, wait=False):
        self.unloading[e["key"]] = time.time()
        # Test shells (HEARTH_SESSION_DRYRUN=1) only report, never unload.
        dry = bool(os.environ.get("HEARTH_AI_MANAGE_DRYRUN")) or os.environ.get("HEARTH_SESSION_DRYRUN") == "1"
        self.notices.append({"type": "evicted", "key": e["key"], "name": e["name"], "reason": reason,
                             "vramText": e.get("vramText", ""), "dryRun": dry})
        log("%sunloading %s (%s)" % ("[dry run] " if dry else "", e["key"], reason))
        if dry:
            return

        def go():
            try:
                unload_entry(e)
            except Exception as ex:  # noqa: BLE001
                log("unload %s: %s" % (e["key"], ex))
                self.unloading.pop(e["key"], None)
        if wait:
            go()
        else:
            threading.Thread(target=go, daemon=True).start()

    def make_room(self, need, exclude=(), timeout=45):
        """Evict idle models (best victims first) until `need` bytes of VRAM
        are free. Returns the free bytes."""
        if not self.prev_engine:
            # GPU time needs two samples to tell a busy model from an idle one.
            self.snapshot(False)
            time.sleep(1.0)
        st = self.snapshot(False)
        g = st["gpu"]
        if not g:
            return 0
        # Keep room for the desktop's own buffers on top of the model.
        try:
            need += max(0, int(settings()[0].get("desktopReserveMB", 2048))) << 20
        except (TypeError, ValueError):
            need += 2048 << 20
        deadline = time.time() + timeout
        tried = set(exclude)
        while g["free"] < need and time.time() < deadline:
            vs = [v for v in self.victims(st) if v["key"] not in tried] or \
                 [v for v in st["loaded"] if v["auto"] and not v["pinned"] and not v["active"] and v["key"] not in tried]
            if not vs:
                break
            tried.add(vs[0]["key"])
            self.unload(vs[0], "make room for a new model", wait=True)
            for _ in range(30):
                time.sleep(0.5)
                st = self.snapshot(False)
                g = st["gpu"]
                if g["free"] >= need or vs[0]["key"] not in {e["key"] for e in st["loaded"]}:
                    break
        return g["free"]

    def need_for(self, key, size=0):
        """VRAM a model is expected to take: its peak last time, else its
        size plus some room for context."""
        h = self.mem.get(key)
        # The larger of the two: a peak noted while the model was still
        # loading (or misattributed) once read 24 KB for Inkling, and nothing
        # was unloaded to make room for its 19 GB.
        return max(h.get("peakVram") or 0, int(size * 1.1 + (768 << 20)) if size else 0) or (1 << 30)


def unload_entry(e):
    if e["kind"] == "process":
        if not e.get("unit"):
            raise RuntimeError("%s isn't a service hearth can stop" % e.get("app", "That app"))
        r = subprocess.run(["systemctl", "--user", "stop", e["unit"]], capture_output=True, text=True, timeout=120)
        if r.returncode:
            raise RuntimeError((r.stderr or "couldn't stop %s" % e["unit"]).strip())
        return
    cfg, _ = settings()
    p = providers(cfg).get(e["provider"])
    if p is None:
        raise RuntimeError("%s is turned off" % e["provider"])
    p.unload(e["model"])


ARB = Arbiter()


def make_room_for(pid, model):
    """A new request evicts idle models when its model needs the room.
    Returns True when the model was already loaded."""
    key = pid if pid.startswith("service:") else "%s:%s" % (pid, model)
    st = ARB.last or ARB.snapshot(False)
    if key in {e["key"] for e in st["loaded"]}:
        return True
    size = next((i.get("size", 0) for i in st["installed"]
                 if any(r["provider"] == pid and r["model"] == model for r in i["runners"])), 0)
    need = ARB.need_for(key, size)
    if st["gpu"] and st["gpu"]["free"] < need:
        ARB.make_room(need, exclude=(key,))
    return False


def full_state(with_procs):
    return ARB.snapshot(with_procs)


