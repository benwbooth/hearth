#!/usr/bin/env python3
"""Print which process owns each tray icon: {"<StatusNotifierItem Id>": pid}.

The tray (bar/Tray.qml) uses it to find a tray app's windows (same pid), so
a click can bring them to the front or, when they already are, minimize
them. Quickshell's tray items don't carry their D-Bus address, so this asks
the StatusNotifierWatcher for the items and the bus for each owner's pid.
One JSON line, then exits.
"""
import json

import dbus

out = {}
try:
    bus = dbus.SessionBus()
    watcher = bus.get_object("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher")
    items = watcher.Get("org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems",
                        dbus_interface="org.freedesktop.DBus.Properties")
    dbus_obj = bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus")
    for entry in items:
        entry = str(entry)
        # "service/path" or just "service" (then the path is the default).
        service, _, path = entry.partition("/")
        path = "/" + path if path else "/StatusNotifierItem"
        try:
            item = bus.get_object(service, path)
            sid = str(item.Get("org.kde.StatusNotifierItem", "Id",
                               dbus_interface="org.freedesktop.DBus.Properties", timeout=2))
            pid = int(dbus_obj.GetConnectionUnixProcessID(service, dbus_interface="org.freedesktop.DBus"))
            out.setdefault(sid, pid)
        except dbus.DBusException:
            continue
except dbus.DBusException:
    pass
print(json.dumps(out))
