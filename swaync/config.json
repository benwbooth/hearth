{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 52,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "control-center-width": 440,
  "control-center-height": 640,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "script-fail-notify": true,
  "widgets": ["title", "dnd", "inhibitors", "notifications"],
  "widget-config": {
    "notifications": { "vexpand": true },
    "title": { "text": "Notifications", "clear-all-button": true, "button-text": "Clear all" },
    "dnd": { "text": "Do not disturb" },
    "inhibitors": { "text": "Inhibitors", "button-text": "Clear all", "clear-all-button": true }
  }
}
