# hearth's login screen (README "Login screen"): greetd starts a
# greeter-only arbor as the `greeter` user, which runs `hearth-greeter`
# (shell/greeter.qml, Quickshell's Greetd service). Replaces SDDM:
#
#   imports = [ hearth.nixosModules.greeter ];
#   services.hearth-greeter.enable = true;
#
# Switching back to SDDM is removing that line (or setting it false).
# The PAM service `greetd` unlocks KWallet with the login password (as
# SDDM's did) and never asks for a fingerprint: pam_kwallet needs the
# typed password, like macOS's first login after a restart.
self:
{ config, lib, pkgs, ... }:
let
  cfg = config.services.hearth-greeter;
  system = pkgs.stdenv.hostPlatform.system;
  sessions = config.services.displayManager.sessionData.desktops;
  arbor = lib.getExe' cfg.arborPackage "arbor";
  greeter = lib.getExe' cfg.package "hearth-greeter";

  # The greeter's arbor: displays and keyboard layouts from hearth's copies
  # in /var/lib/hearth/greeter (written by hearth whenever you change them
  # in Settings), then the defaults; screen zoom on the usual keys; the
  # screens go dark after five minutes without input.
  arborConfig = pkgs.writeText "hearth-greeter-arbor.kdl" ''
    // hearth's login screen (generated by hearth's nix/greeter.nix).
    include optional=true "/var/lib/hearth/greeter/arbor-displays.kdl"
    ${cfg.extraArborConfig}
    input {
        keyboard {
            numlock
        }
        touchpad {
            tap
            natural-scroll
        }
    }
    include optional=true "/var/lib/hearth/greeter/arbor-keyboard.kdl"
    hotkey-overlay {
        skip-at-startup
    }
    prefer-no-csd
    cursor {
        xcursor-theme "${cfg.cursorTheme}"
        xcursor-size 24
    }
    layout {
        background-color "#000000"
    }
    accessibility {
        zoom-step 1.25
        zoom-max 8
    }
    binds {
        Mod+Alt+Equal { zoom-in; }
        Mod+Alt+Minus { zoom-out; }
        Mod+Alt+0 { zoom-reset; }
        XF86PowerOff { spawn "systemctl" "poweroff"; }
    }
    // Up to three tries if the greeter crashes; when it quits (a session
    // is starting, or it gave up) arbor quits too and greetd takes over.
    spawn-sh-at-startup "for i in 1 2 3; do ${greeter} >>/var/cache/hearth-greeter/shell.log 2>&1 && break; sleep 1; done; ${arbor} msg action quit --skip-confirmation"
    spawn-sh-at-startup "${lib.getExe pkgs.swayidle} -w timeout 300 '${arbor} msg action power-off-monitors'"
  '';

  session = pkgs.writeShellScript "hearth-greeter-session" ''
    state=/var/cache/hearth-greeter
    export XDG_CONFIG_HOME=$state/config XDG_CACHE_HOME=$state/cache \
      XDG_STATE_HOME=$state/state XDG_DATA_HOME=$state/data
    mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME"
    # Logs: arbor's in /var/cache/hearth-greeter/greeter.log, the login
    # screen's own in shell.log (the previous start's in *.log.old).
    for f in greeter shell; do [ -f $state/$f.log ] && mv -f $state/$f.log $state/$f.log.old; done
    exec >$state/greeter.log 2>&1
    export XDG_DATA_DIRS=${pkgs.kdePackages.breeze-icons}/share:${pkgs.hicolor-icon-theme}/share:/run/current-system/sw/share
    export XCURSOR_PATH=/run/current-system/sw/share/icons:${pkgs.adwaita-icon-theme}/share/icons:${pkgs.kdePackages.breeze}/share/icons
    export HEARTH_GREETER=1
    export HEARTH_GREETER_STATE_DIR=$state
    export HEARTH_GREETER_SESSIONS=${sessions}/share/wayland-sessions
    export HEARTH_GREETER_DEFAULT_SESSION=${lib.escapeShellArg cfg.defaultSession}
    ${lib.optionalString (cfg.wallpaper != null) "export HEARTH_GREETER_WALLPAPER=${cfg.wallpaper}"}
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: "export ${n}=${lib.escapeShellArg v}") cfg.environment)}
    exec ${pkgs.dbus}/bin/dbus-run-session -- ${arbor} -c ${arborConfig}
  '';
in
{
  options.services.hearth-greeter = {
    enable = lib.mkEnableOption ''
      hearth's macOS-style login screen (greetd + arbor + Quickshell),
      replacing SDDM
    '';

    package = lib.mkOption {
      type = lib.types.package;
      default = self.packages.${system}.hearth;
      defaultText = lib.literalExpression "hearth.packages.\${system}.hearth";
      description = "The hearth package (provides `hearth-greeter`).";
    };

    arborPackage = lib.mkOption {
      type = lib.types.package;
      default = config.programs.arbor.package or (throw "services.hearth-greeter: set arborPackage or enable programs.arbor (arbor's NixOS module)");
      defaultText = lib.literalExpression "config.programs.arbor.package";
      description = "arbor, the compositor the login screen runs in.";
    };

    defaultSession = lib.mkOption {
      type = lib.types.str;
      default = if config.services.displayManager.defaultSession != null then config.services.displayManager.defaultSession else "arbor";
      defaultText = lib.literalExpression ''config.services.displayManager.defaultSession or "arbor"'';
      description = ''
        Session (wayland-sessions .desktop file name without `.desktop`)
        picked for someone who hasn't logged in here before. Afterwards each
        person gets the one they used last.
      '';
    };

    extraArborConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      example = ''
        output "DP-1" {
            mode "5120x2160@165.058"
            scale 1.333333
        }
      '';
      description = ''
        More arbor config for the login screen, after hearth's copy of your
        display settings (/var/lib/hearth/greeter/arbor-displays.kdl, which
        wins for the outputs it names). Without either, arbor picks each
        screen's preferred mode and a scale for its size, HDR off.
      '';
    };

    wallpaper = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        Picture to show until hearth has copied your wallpaper to
        /var/lib/hearth/wallpaper (Settings > Wallpaper > Show on the lock
        screen and login screen). Null: a built-in gradient.
      '';
    };

    cursorTheme = lib.mkOption {
      type = lib.types.str;
      default = "Adwaita";
      description = "Cursor theme on the login screen.";
    };

    kwallet = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Unlock KWallet with the login password (pam_kwallet in the `greetd`
        PAM service), as SDDM does under Plasma.
      '';
    };

    environment = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = { };
      description = "Extra environment for the login screen (tests: HEARTH_GREETER_TEST, HEARTH_GREETER_DRYRUN).";
    };
  };

  config = lib.mkIf cfg.enable {
    services.displayManager.sddm.enable = lib.mkForce false;

    services.greetd = {
      enable = true;
      settings.default_session = {
        command = "${session}";
        user = "greeter";
      };
    };

    security.pam.services.greetd = {
      # Password only: pam_fprintd would block the stack waiting for a
      # finger, and KWallet needs the password itself.
      fprintAuth = lib.mkDefault false;
      kwallet = lib.mkIf cfg.kwallet {
        enable = true;
        package = pkgs.kdePackages.kwallet-pam;
        # pam_kwallet only starts for sessions it recognises as graphical;
        # greetd sets XDG_SESSION_TYPE from the greeter, but don't depend on it.
        forceRun = true;
      };
    };

    # Real names and pictures (the greeter can't read the users' homes).
    services.accounts-daemon.enable = lib.mkDefault true;

    systemd.tmpfiles.settings."10-hearth-greeter" = {
      # Remembered user and session; Quickshell's cache.
      "/var/cache/hearth-greeter".d = { user = "greeter"; group = "greeter"; mode = "0750"; };
      "/var/lib/hearth".d = { user = "root"; group = "root"; mode = "0755"; };
      # hearth copies the wallpaper and the display/keyboard settings here.
      "/var/lib/hearth/wallpaper".d = { user = "root"; group = "users"; mode = "2775"; };
      "/var/lib/hearth/greeter".d = { user = "root"; group = "users"; mode = "2775"; };
    };

    # Icons and cursors for the greeter's own environment.
    environment.systemPackages = [ pkgs.kdePackages.breeze-icons pkgs.adwaita-icon-theme ];
  };
}
