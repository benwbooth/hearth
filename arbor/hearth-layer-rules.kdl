// hearth's glass for arbor (26.04+): blur what's behind the menu bar,
// menus and popups, and swaync's notifications. Include it from the arbor
// config:   include "/path/to/hearth/arbor/hearth-layer-rules.kdl"
// (or paste it in).
//
// The dock is left out on purpose: its layer surface spans the whole screen
// edge (so it never resizes while magnifying) and niri blurs a layer's
// whole rectangle, not only its opaque pixels like Hyprland's ignore_alpha.
// hearth draws the dock with a more opaque tint there instead.

layer-rule {
    match namespace="^hearth-(menubar|popup)$"
    match namespace="^swaync-(control-center|notification-window)$"
    // hearth's menus have 12 pt (14 px) corners (macOS 26).
    geometry-corner-radius 14
    background-effect {
        xray false
        blur true
        noise 0.02
        // Liquid glass vibrancy: the colours behind come through brighter.
        saturation 1.6
    }
    popups {
        geometry-corner-radius 8
        background-effect {
            xray false
            blur true
            saturation 1.6
        }
    }
}

// Menus and popovers: a large, soft, faint shadow like macOS's (hearth
// leaves its own shadow off on arbor, since the blur covers the layer's
// whole rectangle).
layer-rule {
    match namespace="^hearth-popup$"
    shadow {
        on
        softness 26
        spread 0
        offset x=0 y=9
        color "#00000045"
    }
}

// The menu bar is square-cornered.
layer-rule {
    match namespace="^hearth-menubar$"
    geometry-corner-radius 0
}
