// hearth's glass for arbor (26.04+). Include it from the arbor config:
//   include "/path/to/hearth/arbor/hearth-layer-rules.kdl"
// (or paste it in).
//
// Real glass: with arbor's liquid glass (Settings > Appearance > Real glass)
// hearth registers its panes (dock slab, menus, popovers, tooltips, the
// glass menu bar) over IPC and arbor draws the backdrop refracted under
// exactly those shapes. The rectangular blur and shadow for hearth's menus
// and tooltips are only a fallback for when real glass is off, so hearth
// writes them itself to ~/.config/hearth/arbor-glass-fallback.kdl
// (services/RealGlass.qml) only then. Kept here, they made every menu
// flicker: a menu's first frame (before its glass shapes arrive) and its
// last got the blurred rectangle.
//
// The dock is left out on purpose: its layer surface spans the whole screen
// edge (so it never resizes while magnifying) and the layer-rule blur covers
// a layer's whole rectangle. Without real glass hearth draws the dock with a
// more opaque tint instead.
//
// The menu bar is left out too: its default style is transparent (macOS 26),
// which must not be blurred; its Glass style gets real glass.

// Notifications (swaync draws no glass shapes).
layer-rule {
    match namespace="^swaync-(control-center|notification-window)$"
    geometry-corner-radius 14
    background-effect {
        xray false
        blur true
        noise 0.02
        // Liquid glass vibrancy: the colours behind come through brighter.
        saturation 1.6
    }
}

// The menu bar is square-cornered and not blurred (see above).
layer-rule {
    match namespace="^hearth-menubar$"
    geometry-corner-radius 0
}
