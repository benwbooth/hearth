// Ben's arbor config (KDL). Installed as ~/.config/arbor/config.kdl by
// /etc/nixos.
// Keys follow the Hyprland/Plasma ones wherever arbor has an equivalent.
// Super+Shift+/ shows every shortcut.

input {
    // Tap Super on its own to show the overview (arbor 929425f9+).
    mod-tap-overview
    keyboard {
        numlock
    }
    // Pointer speed (-1..1), accelerated like Plasma's default.
    mouse {
        accel-speed 0.3
        accel-profile "adaptive"
    }
    touchpad {
        tap
        natural-scroll
    }
    // No focus-follows-mouse: like macOS, a window gets focus (and comes
    // forward) when you click it, not when the pointer passes over it.
}

// Displays from hearth's Settings window (Settings > Displays). arbor uses
// the first output block it finds for a screen, so this comes before the
// defaults below; missing until you apply something there.
include optional=true "~/.config/hearth/arbor-displays.kdl"

// 4/3 like Hyprland (KWin's 130% isn't a whole-pixel size on 5120x2160).
// HDR like Plasma/Hyprland: arbor drives the panel in HDR (BT.2020, PQ, 10
// bpc) and shows normal (SDR) content at sdr-brightness nits; ~670 matched
// Hyprland's 560 x 1.2 that looked right. Brighter/dimmer: change it.
// Without HDR, `color-profile "edid"` gives accurate SDR colours instead.
output "DP-1" {
    mode "5120x2160@165.058"
    scale 1.333333
    position x=0 y=0
    hdr {
        sdr-brightness 670
        max-luminance 800
    }
    // Adaptive sync (FreeSync) only while a game or video asks for it (see
    // the window rule below): always-on can flicker on the desktop.
    variable-refresh-rate on-demand=true
}

environment {
    QT_QPA_PLATFORMTHEME "kde"
    QT_QPA_PLATFORM "wayland;xcb"
    XDG_MENU_PREFIX "plasma-"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // Global menu for GTK 3 apps with plain GtkMenuBars (README "Global
    // menu"): hearth ships the module in lib/gtk-3.0/modules, found through
    // GTK_PATH's /run/current-system/sw/lib/gtk-3.0. It only hides the
    // in-window menu bar while hearth's menu bar runs (it watches the
    // com.canonical.AppMenu.Registrar name).
    GTK_MODULES "appmenu-gtk-module"
}

// The shell's own windows (Help, Settings) come back with the shell, never
// as a second copy of it: not relaunched by session restore, nor after arbor
// restarts in place (arbor msg action reload-binary, new devloop builds).
session-restore {
    exclude-app-ids "org.quickshell"
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    gaps 8
    background-color "transparent"
    focus-ring {
        off
    }
    border {
        width 1
        active-color "#3daee9"
        inactive-color "#3f444a"
    }
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=6
        color "#0008"
    }
}

// Rounded windows, macOS-like.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}
// Games get adaptive sync (Steam games, gamescope).
window-rule {
    match app-id=r#"^steam_app_"#
    match app-id=r#"^gamescope$"#
    variable-refresh-rate true
}
window-rule {
    match app-id=r#"^org\.kde\.polkit-kde-authentication-agent-1$"#
    match app-id=r#"^org\.kde\.kdialog$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^com\.gabm\.satty$"#
    open-floating true
}

// hearth's glass: blur behind the menu bar, menus, popups and notifications
// (installed next to this file).
include "hearth-layer-rules.kdl"
// Blur and shadows for menus and tooltips when real glass is off (written
// by hearth, services/RealGlass.qml; missing while real glass is on).
include optional=true "~/.config/hearth/arbor-glass-fallback.kdl"

// Mouse & touchpad from hearth's Settings window (overrides the input block
// above; missing until you change something there).
include optional=true "~/.config/hearth/arbor-input.kdl"
// Keyboard layouts, key repeat and Num Lock (Settings > Keyboard).
include optional=true "~/.config/hearth/arbor-keyboard.kdl"
// Per-app window rules (Settings > Window Rules); later rules win.
include optional=true "~/.config/hearth/arbor-rules.kdl"
// Minimize effect: Genie, Scale or None (Settings > Dock; missing for
// Genie, arbor's default).
include optional=true "~/.config/hearth/arbor-dock.kdl"

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot_%Y%m%d_%H%M%S.png"

// Startup. arbor also starts xwayland-satellite on demand for X11 apps.
// hearth: devloop's copy of the last commit (home-services devloop,
// apps/hearth.conf: restarts the shell after each new commit, never under a
// locked screen); the system's hearth when devloop isn't there or no
// hearth is up 30 s after login.
spawn-sh-at-startup "d=\"$HOME/.local/bin/devloop\"; if [ -x \"$d\" ] && [ -f \"$HOME/src/home-services/devloop/apps/hearth.conf\" ]; then \"$d\" start hearth; sleep 30; pgrep -u \"$(id -u)\" -f 'quickshell -p /nix/store/[^ ]*-hearth-[^ ]*/share/hearth/shell' >/dev/null && exit 0; fi; exec hearth"
spawn-at-startup "vicinae" "server"
// The wallpaper is drawn by hearth itself (a background-layer surface per
// screen, cross-faded; Settings > Wallpaper), so there's no swaybg. Until
// hearth is up (about a second at login) the screen is black; if a
// swaybg is still running from an older config, hearth stops it once its
// own wallpaper is on screen.
// "Set as wallpaper" from apps goes to hearth's wallpaper.
portal {
    wallpaper-command "hearth-ipc" "call" "wallpaper" "setImage"
}
// Night light (4500 K from 19:00 to 07:00) is run by hearth: Settings >
// Night Light, or the brightness menu.
// X11 apps (Steam, older tools) scale themselves from Xft.dpi: 128 = 96 x
// 4/3, the screen's scale (Plasma loads this at login).
spawn-sh-at-startup "printf 'Xft.dpi: 128\\nXcursor.size: 32\\n' | xrdb -merge"
// Screen off, lock and sleep when idle are run by hearth (swayidle with
// the times from Settings > Sleep & Power).
// KWallet gets SDDM's password (as Plasma's startup does).
spawn-at-startup "/run/current-system/sw/libexec/pam_kwallet_init"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Slash hotkey-overlay-title="Keyboard shortcuts and help" { spawn "hearth-ipc" "call" "help" "shortcuts"; }

    // Launcher and clipboard (Vicinae).
    // Spotlight (hearth): apps, files, settings, calculator. Voice
    // assistant: speak after pressing, it stops when you stop talking.
    Mod+Space hotkey-overlay-title="Search" { spawn "hearth-ipc" "call" "spotlight" "toggle"; }
    F4 hotkey-overlay-title="Launchpad (all apps)" { spawn "hearth-ipc" "call" "launchpad" "toggle"; }
    Mod+Alt+Space hotkey-overlay-title="Voice assistant" { spawn "hearth-ipc" "call" "voice" "toggle"; }
    Alt+Space hotkey-overlay-title="Launcher" { spawn "vicinae" "toggle"; }
    Alt+F1 { spawn "vicinae" "toggle"; }
    // Clipboard history: hearth's popover (like Klipper); Vicinae's own
    // history stays on Super+Shift+V.
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "hearth-ipc" "call" "clipboard" "toggle"; }
    Mod+Shift+V hotkey-overlay-title="Clipboard history (Vicinae)" { spawn "vicinae" "cmd" "launch" "clipboard:history"; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "tessera" "--new-window"; }
    Mod+E hotkey-overlay-title="Files" { spawn "grove"; }

    // Pinned apps 1-9 (hearth's dock order).
    Mod+1 { spawn "hearth-ipc" "call" "tasks" "activate" "1"; }
    Mod+2 { spawn "hearth-ipc" "call" "tasks" "activate" "2"; }
    Mod+3 { spawn "hearth-ipc" "call" "tasks" "activate" "3"; }
    Mod+4 { spawn "hearth-ipc" "call" "tasks" "activate" "4"; }
    Mod+5 { spawn "hearth-ipc" "call" "tasks" "activate" "5"; }
    Mod+6 { spawn "hearth-ipc" "call" "tasks" "activate" "6"; }
    Mod+7 { spawn "hearth-ipc" "call" "tasks" "activate" "7"; }
    Mod+8 { spawn "hearth-ipc" "call" "tasks" "activate" "8"; }
    Mod+9 { spawn "hearth-ipc" "call" "tasks" "activate" "9"; }

    // Windows.
    Alt+F4 repeat=false { close-window; }
    Mod+Q repeat=false { close-window; }
    Mod+Page_Up { maximize-window-to-edges; }
    // Minimize keeps a docked window's place; click it in the dock (or
    // Super+Shift+PgDn) to bring it back there.
    Mod+Page_Down hotkey-overlay-title="Minimize window" { minimize-window; }
    Mod+Shift+Page_Down hotkey-overlay-title="Restore last minimized window" { restore-window; }
    // Window zones (FancyZones; tray picker, ~/.config/hearth/zones.json):
    // Super+Ctrl+N puts the window in zone N, Shift while dragging drops it
    // into the zone under the pointer, Super+Ctrl+PgDn/PgUp switch layouts.
    Mod+Ctrl+1 hotkey-overlay-title="Snap window into zone 1" { move-window-to-zone 1; }
    Mod+Ctrl+2 hotkey-overlay-title="Snap window into zone 2" { move-window-to-zone 2; }
    Mod+Ctrl+3 hotkey-overlay-title="Snap window into zone 3" { move-window-to-zone 3; }
    Mod+Ctrl+4 hotkey-overlay-title="Snap window into zone 4" { move-window-to-zone 4; }
    Mod+Ctrl+5 hotkey-overlay-title="Snap window into zone 5" { move-window-to-zone 5; }
    Mod+Ctrl+6 hotkey-overlay-title="Snap window into zone 6" { move-window-to-zone 6; }
    Mod+Ctrl+7 hotkey-overlay-title="Snap window into zone 7" { move-window-to-zone 7; }
    Mod+Ctrl+8 hotkey-overlay-title="Snap window into zone 8" { move-window-to-zone 8; }
    Mod+Ctrl+9 hotkey-overlay-title="Snap window into zone 9" { move-window-to-zone 9; }
    Mod+Ctrl+Page_Down hotkey-overlay-title="Next zone layout" { spawn "hearth-ipc" "call" "zones" "nextLayout"; }
    Mod+Ctrl+Page_Up hotkey-overlay-title="Previous zone layout" { spawn "hearth-ipc" "call" "zones" "prevLayout"; }
    // Tab groups: drop a window on the middle of a docked one to group them.
    Mod+Comma hotkey-overlay-title="Previous tab" { focus-tab-prev; }
    Mod+Period hotkey-overlay-title="Next tab" { focus-tab-next; }
    Mod+F { fullscreen-window; }
    // Dock / undock (floating windows live on the Desktop).
    Mod+D hotkey-overlay-title="Dock or undock window" { toggle-window-floating; }

    // Focus and move by direction.
    Mod+Alt+Left  { focus-column-left; }
    Mod+Alt+Right { focus-column-right; }
    Mod+Alt+Up    { focus-window-up; }
    Mod+Alt+Down  { focus-window-down; }
    Mod+Left  { move-column-left; }
    Mod+Right { move-column-right; }
    Mod+Up    { move-window-up; }
    Mod+Down  { move-window-down; }
    // Stack with the neighbour / take out of a stack.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // Screen zoom (magnifier) around the pointer, like KWin's Zoom.
    Mod+Alt+Equal hotkey-overlay-title="Zoom screen in (magnifier)" { zoom-in; }
    Mod+Alt+Minus hotkey-overlay-title="Zoom screen out (magnifier)" { zoom-out; }
    Mod+Alt+0 hotkey-overlay-title="Turn screen zoom off" { zoom-reset; }
    Mod+Alt+WheelScrollUp cooldown-ms=50 hotkey-overlay-title="Zoom screen in (magnifier)" { zoom-in; }
    Mod+Alt+WheelScrollDown cooldown-ms=50 hotkey-overlay-title="Zoom screen out (magnifier)" { zoom-out; }

    // Camera: zoom out to see how windows are docked (small ones become app
    // tiles), zoom back in, frame one window. Super+pinch zooms too.
    Mod+Z hotkey-overlay-title="Zoom out (camera)" { camera-zoom-out; }
    Mod+X hotkey-overlay-title="Zoom in (camera)" { camera-zoom-in; }
    Mod+A hotkey-overlay-title="Show all docked windows" { camera-show-all; }
    Mod+Shift+F hotkey-overlay-title="Frame this window" { camera-frame-window; }
    Mod+Ctrl+Up hotkey-overlay-title="Camera back" { camera-back; }
    Mod+Ctrl+Down hotkey-overlay-title="Camera forward" { camera-forward; }

    // Overview (Mission Control) and workspaces.
    Mod+W repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+G repeat=false { toggle-overview; }
    Ctrl+F1 { focus-workspace 1; }
    Ctrl+F2 { focus-workspace 2; }
    Ctrl+F3 { focus-workspace 3; }
    Ctrl+F4 { focus-workspace 4; }
    Ctrl+F5 { focus-workspace 5; }
    Ctrl+F6 { focus-workspace 6; }
    Ctrl+F7 { focus-workspace 7; }
    Ctrl+F8 { focus-workspace 8; }
    Ctrl+F9 { focus-workspace 9; }
    // Workspaces run left to right: Super+Ctrl+arrows go there, with Shift
    // the window comes along. Ctrl+Shift+F-number moves it to that workspace.
    Mod+Ctrl+Left  { focus-workspace-up; }
    Mod+Ctrl+Right { focus-workspace-down; }
    Mod+Ctrl+Shift+Left  { move-window-to-workspace-up; }
    Mod+Ctrl+Shift+Right { move-window-to-workspace-down; }
    Ctrl+Shift+F1 { move-window-to-workspace 1; }
    Ctrl+Shift+F2 { move-window-to-workspace 2; }
    Ctrl+Shift+F3 { move-window-to-workspace 3; }
    Ctrl+Shift+F4 { move-window-to-workspace 4; }
    Ctrl+Shift+F5 { move-window-to-workspace 5; }
    Ctrl+Shift+F6 { move-window-to-workspace 6; }
    Ctrl+Shift+F7 { move-window-to-workspace 7; }
    Ctrl+Shift+F8 { move-window-to-workspace 8; }
    Ctrl+Shift+F9 { move-window-to-workspace 9; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Session.
    Mod+L allow-when-locked=false hotkey-overlay-title="Lock screen" { spawn "hearth-ipc" "call" "session" "lock"; }
    Ctrl+Alt+Delete { spawn "hearth-ipc" "call" "session" "open"; }
    // Does what Settings > Sleep & Power > "When I press the power button" says.
    XF86PowerOff { spawn "hearth-ipc" "call" "power" "button"; }

    // Screenshots: hearth's screenshot tool (Spectacle-style; Settings >
    // Screenshots). Print = the tool (region / window / screen, then copy,
    // save, mark up), Shift+Print = whole screen, Super/Alt+Print = active
    // window, Super+Shift+Print / Super+Shift+S = region, Super+Shift+R =
    // record (again: stop). Ctrl+Print = arbor's quick region to the clipboard.
    Print hotkey-overlay-title="Screenshot tool: region, window or screen" { spawn "hearth-ipc" "call" "screenshot" "printKey"; }
    Shift+Print hotkey-overlay-title="Screenshot of the whole screen" { spawn "hearth-ipc" "call" "screenshot" "screen"; }
    Mod+Print hotkey-overlay-title="Screenshot of the active window" { spawn "hearth-ipc" "call" "screenshot" "activeWindow"; }
    Alt+Print hotkey-overlay-title="Screenshot of the active window" { spawn "hearth-ipc" "call" "screenshot" "activeWindow"; }
    Mod+Shift+Print hotkey-overlay-title="Screenshot of a region" { spawn "hearth-ipc" "call" "screenshot" "region"; }
    Mod+Shift+S hotkey-overlay-title="Screenshot of a region" { spawn "hearth-ipc" "call" "screenshot" "region"; }
    Mod+Shift+R hotkey-overlay-title="Record the screen (again: stop recording)" { spawn "hearth-ipc" "call" "screenshot" "record"; }
    Ctrl+Print hotkey-overlay-title="Quick region screenshot to the clipboard" { screenshot; }

    // Ben's tools (were KDE custom shortcuts).
    Mod+H { spawn "dsnote-tts.sh"; }
    Pause { spawn "whisper-toggle"; }
    Ctrl+Alt+Shift+C { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "cancel"; }
    Ctrl+Alt+Shift+P { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "pause-resume-reading"; }
    Ctrl+Alt+Shift+L { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "start-listening"; }
    Ctrl+Alt+Shift+K { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "start-listening-active-window"; }
    Ctrl+Alt+Shift+J { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "start-listening-clipboard"; }
    Ctrl+Alt+Shift+R { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "start-reading"; }
    Ctrl+Alt+Shift+E { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "start-reading-clipboard"; }
    Ctrl+Alt+Shift+S { spawn "flatpak" "run" "net.mkiol.SpeechNote" "--action" "stop-listening"; }

    // Volume, media, brightness.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "hearth-ipc" "call" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "hearth-ipc" "call" "brightness" "down"; }

    Mod+Shift+E { quit; }
}

// Shortcuts changed in hearth's Settings window (Settings > Keyboard
// Shortcuts): a bind there replaces the one with the same keys above.
include optional=true "~/.config/hearth/arbor-binds.kdl"
